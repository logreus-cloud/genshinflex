{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenshinFlex Overlay",
  "identifier": "com.genshinflex.overlay",
  "version": "0.1.7",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "copyright": "GenshinFlex · genshinflex.com",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["English", "Russian", "Spanish"],
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["genshinflex"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENTkyODMzRUIzM0NGODQKUldTRXp6UHJNeWhaM2VacUROK1pzeEJaNmhGOTNYYnNpS0czOWhmWHp1bmdhaE53MFdOdFVBU2IK",
      "endpoints": ["https://github.com/logreus-cloud/genshinflex/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
