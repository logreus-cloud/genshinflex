# Адреса *.pages.dev (тестовая ветка и служебный адрес основного сайта) не индексируем:
# в поиске должен быть только genshinflex.com
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# CSP: скрипты и запросы только со своих и перечисленных адресов, без фреймирования, плагинов и подмены <base>.
# Встроенные скрипты разрешены (их требует ClientRouter Astro), eval — виджету Telegram, WebAssembly — Pagefind; HTTPS закрепляется на год
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://telegram.org https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://qhfufvdculphsqxuqxsw.supabase.co wss://qhfufvdculphsqxuqxsw.supabase.co https://api.genshinflex.com https://tiles.genshinflex.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://oauth.telegram.org https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
