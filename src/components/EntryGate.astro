---
import { useData } from '../lib/data';
const { t } = useData(Astro.currentLocale);
---
<div id="gf-entry" role="dialog" aria-modal="true" aria-label={t('Вход на сайт')} hidden>
  <div class="panel">
    <button class="menu" type="button" aria-label={t('Открыть меню')}>☰</button>
    <div class="brand">
      <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true"><path d="M16 2 29 9.5v13L16 30 3 22.5v-13Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8.5 22.5 12v8L16 23.5 9.5 20v-8Z" fill="currentColor"/></svg>
      <span>Genshin<b>Flex</b></span>
    </div>
  </div>
  <div class="scene">
    <img src="/img/season/snezhnaya-bg.webp" alt="" width="1920" height="1002" loading="eager" />
    <div class="vignette" aria-hidden="true"></div>
    <button class="light" type="button" aria-label={t('Войти на сайт')}>
      <span class="halo" aria-hidden="true"></span>
      <span class="rays" aria-hidden="true"></span>
      <span class="core" aria-hidden="true"></span>
    </button>
  </div>
  <button class="hint" type="button">{t('Коснитесь света, чтобы войти')} <span aria-hidden="true">◇</span></button>
  <small class="caption">{t('Версия 7.1 · Снежная')}</small>
  <div class="flash" aria-hidden="true"></div>
</div>
<script is:inline>
  (function () {
    var gate = document.getElementById('gf-entry');
    try {
      if (sessionStorage.getItem('gf:entered')) { gate.remove(); return; }
    } catch (e) { gate.remove(); return; }
    var light = gate.querySelector('.light');
    var menu = gate.querySelector('.menu');
    var hint = gate.querySelector('.hint');
    var side = document.getElementById('side');
    var previousOverflow = document.documentElement.style.overflow;
    var entering = false;
    document.body.append(gate);
    gate.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    light.focus({ preventScroll: true });

    function finish() {
      document.removeEventListener('keydown', onKeydown, true);
      document.removeEventListener('focusin', keepFocus, true);
      gate.remove();
      document.documentElement.style.overflow = previousOverflow;
      try { sessionStorage.setItem('gf:entered', '1'); } catch (e) {}
      var content = document.getElementById('content');
      if (side && side.classList.contains('open')) return; // меню открыли во время вспышки — фокус остаётся в нём
      if (content) {
        content.setAttribute('tabindex', '-1');
        content.focus({ preventScroll: true });
      } else document.body.focus();
    }
    function enter() {
      if (entering) return;
      entering = true;
      var rect = light.getBoundingClientRect();
      gate.style.setProperty('--flash-x', rect.left + rect.width / 2 + 'px');
      gate.style.setProperty('--flash-y', rect.top + rect.height / 2 + 'px');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gate.classList.add('fade');
        setTimeout(finish, 300);
      } else {
        gate.classList.add('entering');
        setTimeout(function () {
          gate.classList.add('fade');
          setTimeout(finish, 500);
        }, 700);
      }
    }
    function keepFocus(event) {
      if (!entering && !side.classList.contains('open') && !gate.contains(event.target)) {
        menu.focus({ preventScroll: true });
      }
    }
    function onKeydown(event) {
      if (side.classList.contains('open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        enter();
        return;
      }
      if (event.key !== 'Tab') return;
      var controls = [menu, light, hint];
      var first = controls[0], last = controls[controls.length - 1];
      if (event.shiftKey && (document.activeElement === first || !gate.contains(document.activeElement))) {
        event.preventDefault();
        last.focus({ preventScroll: true });
      } else if (!event.shiftKey && (document.activeElement === last || !gate.contains(document.activeElement))) {
        event.preventDefault();
        first.focus({ preventScroll: true });
      }
    }
    menu.addEventListener('click', function () { document.getElementById('burger')?.click(); });
    light.addEventListener('click', enter);
    hint.addEventListener('click', enter);
    document.addEventListener('keydown', onKeydown, true);
    document.addEventListener('focusin', keepFocus, true);
  })();
</script>
<style>
  /* Фокус переносится на основное содержимое только для скринридеров — рамку вокруг всей страницы не рисуем */
  :global(#content[tabindex="-1"]:focus) { outline: none; }
  #gf-entry { position: fixed; inset: 0; z-index: 54; overflow: hidden; background: #0a0e1a; color: #fff; transition: opacity .5s ease; }
  #gf-entry[hidden] { display: none; }
  #gf-entry.fade { opacity: 0; }
  .scene {
    /* Прижата к верху: на широких низких экранах обрезается туман внизу, а свет всегда остаётся в кадре */
    position: absolute; top: 0; left: 50%; width: max(100vw, calc(100vh * 1920 / 1002)); height: max(100vh, calc(100vw * 1002 / 1920));
    translate: -50% 0; transform-origin: 50% 16%; animation: entry-breathe 20s ease-in-out infinite alternate;
  }
  .scene img { display: block; width: 100%; height: 100%; object-fit: fill; }
  .vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 40%, transparent 40%, rgb(8 12 24 / .55) 100%); }
  .light { position: absolute; top: 16%; left: 50%; z-index: 2; width: clamp(90px, 11vw, 160px); aspect-ratio: 1; translate: -50% -50%; border: 0; border-radius: 50%; background: none; cursor: pointer; transition: filter var(--dur) var(--ease); }
  .light span { position: absolute; border-radius: 50%; pointer-events: none; }
  .core { inset: -15%; background: radial-gradient(circle, #fffbe8 0, rgb(255 236 170 / .85) 25%, rgb(255 214 120 / .35) 50%, transparent 70%); }
  .rays { inset: -65%; mix-blend-mode: screen; background: conic-gradient(transparent 0 8%, rgb(255 246 210 / .7) 8.3% 8.8%, transparent 9% 24%, rgb(255 246 210 / .6) 24.3% 24.8%, transparent 25% 42%, rgb(255 246 210 / .7) 42.3% 42.8%, transparent 43% 58%, rgb(255 246 210 / .6) 58.3% 58.8%, transparent 59% 76%, rgb(255 246 210 / .7) 76.3% 76.8%, transparent 77% 92%, rgb(255 246 210 / .6) 92.3% 92.8%, transparent 93%); animation: entry-rays 60s linear infinite; }
  .halo { inset: -55%; background: radial-gradient(circle, rgb(255 238 181 / .5), transparent 65%); animation: entry-halo 2.6s ease-in-out infinite alternate; }
  .light:hover, .light:focus-visible { filter: brightness(1.25); }
  .light:hover .halo, .light:focus-visible .halo { scale: 1.35; }
  .light:focus-visible { outline: 2px solid #fff6d8; outline-offset: 6px; }
  .panel { position: absolute; top: 1.2rem; left: 2rem; z-index: 3; display: flex; align-items: center; gap: .7rem; }
  .menu { display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 0; background: none; color: #fff; font: 2rem/1 var(--font); cursor: pointer; }
  .brand { display: flex; align-items: center; gap: .5rem; font: 600 1.15rem var(--font-display); white-space: nowrap; }
  .brand svg, .brand b { color: #f3d38a; }
  .brand b { font-weight: 600; }
  .hint { position: absolute; bottom: 2.4rem; left: 50%; z-index: 3; translate: -50% 0; border: 0; padding: .5rem; background: none; color: #fff; font: 500 .9rem var(--font-display); white-space: nowrap; text-shadow: 0 2px 12px #081018; cursor: pointer; opacity: 0; animation: entry-hint .6s 1.2s ease both; }
  .hint span { display: block; margin-top: .3rem; font-size: 1.1rem; animation: entry-chevron 1.4s ease-in-out infinite; }
  .caption { position: absolute; bottom: 1.4rem; left: 2rem; z-index: 3; color: rgb(255 255 255 / .8); text-shadow: 0 2px 10px #081018; }
  .menu:focus-visible, .hint:focus-visible { outline: 2px solid #fff6d8; outline-offset: 4px; }
  .flash { position: absolute; inset: 0; z-index: 4; pointer-events: none; opacity: 0; background: radial-gradient(circle at var(--flash-x) var(--flash-y), #fff 0, #eaf4ff 40%, #fff 70%); }
  .entering .flash { opacity: 1; animation: entry-flash .7s ease-out both; }
  @keyframes entry-breathe { to { transform: scale(1.04); } }
  @keyframes entry-rays { to { rotate: 360deg; } }
  @keyframes entry-halo { from { scale: 1; opacity: .55; } to { scale: 1.25; opacity: .15; } }
  @keyframes entry-hint { to { opacity: 1; } }
  @keyframes entry-chevron { 50% { opacity: .35; translate: 0 4px; } }
  @keyframes entry-flash { from { clip-path: circle(0 at var(--flash-x) var(--flash-y)); } to { clip-path: circle(150% at var(--flash-x) var(--flash-y)); } }
  @media (max-width: 480px) {
    .panel { top: 1rem; left: 1rem; }
    .caption { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #gf-entry { transition-duration: .3s; }
    .scene, .rays, .halo, .hint, .hint span { animation: none; }
    .hint { opacity: 1; }
    .entering .flash { display: none; }
  }
</style>
