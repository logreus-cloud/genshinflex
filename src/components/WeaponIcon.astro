---
import { useData, LANGS } from '../lib/data';
const { getWeapon, base, t } = useData(Astro.currentLocale);

interface Props { slug: string; size?: number; label?: boolean; }
const { slug, size = 48, label = true } = Astro.props;
const w = getWeapon(slug);
---
<a class="wi" href={`${base}/weapons/${w.slug}`} style={`--s:${size}px`} title={w.name}>
  <span class:list={['frame', `r${w.rarity}`]}><img src={w.icon} alt="" width={size} height={size} loading="lazy" /></span>
  {label && <span class="name">{w.name}</span>}
</a>

<style>
  .wi { display: inline-flex; flex-direction: column; align-items: center; gap: .3rem; text-decoration: none; width: calc(var(--s) + 16px); max-width: 100%; flex: none; }
  .frame { width: min(var(--s), 100%); aspect-ratio: 1; border-radius: 10px; overflow: hidden; display: grid; place-items: center; background: linear-gradient(170deg, #36436a, #4b7aa6); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .frame.r4 { background: linear-gradient(170deg, #4a3d6d, #9679c4); }
  .frame.r5 { background: linear-gradient(170deg, #6b4520, #d1953f); }
  .frame img { width: 80%; height: auto; }
  .name {
    width: 100%; font-size: .72rem; text-align: center; line-height: 1.15; hyphens: auto; overflow-wrap: anywhere;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }
  .wi:hover .frame { outline: 2px solid var(--accent); outline-offset: 2px; transform: translateY(-2px); box-shadow: 0 6px 16px rgb(0 0 0 / .2); }
</style>
