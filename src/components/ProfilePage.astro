---
import Layout from '../layouts/Layout.astro';
import { useData } from '../lib/data';
import namecards from '../data/generated/namecards.json';

const { base, t, characters } = useData(Astro.currentLocale);
const cards = namecards as Record<string, string>;
const charsJson = JSON.stringify(characters.map(({ slug, name, icon, element, rarity }) => ({
  slug, name, icon, element, rarity, namecard: cards[slug] ?? '',
}))).replace(/</g, '\\u003c');
---
<Layout title={t('Мой профиль')} description={t('Избранное, персонажи и история круток из этого браузера.')}>
  <div class="profile-root profile-page">
    <section class="profile-card hero">
      <div class="banner" id="profile-banner">
        <img id="profile-cover" alt="" hidden />
        <button class="btn edit-profile" id="edit-profile" type="button">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m4 13 9-9 3 3-9 9-4 1 1-4ZM11.5 5.5l3 3" /></svg>
          {t('Настроить профиль')}
        </button>
      </div>
      <div class="hero-content">
        <div class="hero-info">
          <div class="avatar" id="profile-avatar"><svg viewBox="0 0 20 20" width="42" height="42" aria-hidden="true"><circle cx="10" cy="7" r="3.2" /><path d="M4 17c0-3.2 2.6-5.2 6-5.2s6 2 6 5.2" /></svg></div>
          <div class="identity">
            <h1 id="profile-name">{t('Путешественник')}</h1>
            <p id="profile-about" hidden></p>
            <p class="muted" id="profile-meta" hidden></p>
          </div>
        </div>
        <form id="showcase-form">
          <label for="profile-uid">{t('UID')}</label>
          <div class="uid-row">
            <input class="input" id="profile-uid" inputmode="numeric" pattern="[0-9]{9,10}" maxlength="10" autocomplete="off" placeholder="700000000" />
            <button class="btn primary" id="load-showcase" type="submit">{t('Загрузить витрину')}</button>
          </div>
        </form>
        <p class="status small" id="profile-status" aria-live="polite"></p>
        <div class="showcase" id="showcase" hidden>
          <h2>{t('Витрина')}</h2>
          <div class="strip" id="showcase-list"></div>
        </div>
      </div>
    </section>
    <section class="profile-card favorite-card" id="profile-favorites" hidden>
      <h2>{t('Любимые персонажи')}</h2>
      <div class="favorite-grid" id="profile-favorites-list"></div>
    </section>
    <div class="profile-grid">
      <section class="profile-card">
        <h2>{t('Избранное')}</h2>
        <div class="tile-grid" id="favorites-list"></div>
      </section>
      <section class="profile-card">
        <h2>{t('Мои персонажи')} <small id="roster-count"></small></h2>
        <div class="strip" id="roster-list"></div>
        <a class="card-link" href={`${base}/tools/team-check/`}>{t('Изменить в проверке команды')}</a>
      </section>
      <section class="profile-card">
        <h2>{t('Крутки')}</h2>
        <div class="wish-list" id="wishes-list"></div>
        <a class="card-link" href={`${base}/tools/wishes/`}>{t('Открыть трекер круток')}</a>
      </section>
      <section class="profile-card recent-card" hidden>
        <h2>{t('Недавно просмотренное')}</h2>
        <div class="strip" id="recent-list"></div>
      </section>
    </div>
    <noscript><p class="profile-card">{t('Для профиля нужен JavaScript')}</p></noscript>
    <p class="privacy">{t('Все данные профиля хранятся только в этом браузере и никуда не отправляются, кроме запроса витрины по UID.')}</p>

    <dialog class="profile-dialog" id="profile-dialog" aria-labelledby="editor-title">
      <div class="dialog-head">
        <h2 id="editor-title">{t('Настроить профиль')}</h2>
        <button class="close-editor" id="close-editor" type="button" aria-label={t('Закрыть')}>×</button>
      </div>
      <div class="dialog-body">
        <div class="editor-field">
          <label for="editor-name">{t('Ник')}</label>
          <input class="input" id="editor-name" maxlength="24" autocomplete="nickname" />
        </div>
        <div class="editor-field">
          <label for="editor-about">{t('О себе')}</label>
          <textarea class="input" id="editor-about" maxlength="300" rows="4"></textarea>
          <small id="about-count"></small>
        </div>
        <section class="editor-section">
          <h3>{t('Аватар')}</h3>
          <div class="editor-tabs">
            <button class="btn" id="avatar-character" type="button" aria-pressed="false">{t('Персонаж')}</button>
            <button class="btn" id="avatar-upload" type="button" aria-pressed="false">{t('Своя картинка')}</button>
            <button class="btn" id="avatar-none" type="button" aria-pressed="false">{t('Без аватара')}</button>
          </div>
          <div id="avatar-character-panel">
            <input class="input picker-search" id="avatar-search" type="search" placeholder={t('Поиск персонажа')} aria-label={t('Поиск персонажа')} />
            <div class="choice-grid character-choices" id="avatar-choices"></div>
          </div>
          <div id="avatar-upload-panel" hidden>
            <input id="avatar-file" type="file" accept="image/*" aria-label={t('Своя картинка')} />
            <p class="small status" id="avatar-status" aria-live="polite"></p>
          </div>
        </section>
        <section class="editor-section">
          <h3>{t('Обложка')}</h3>
          <input class="input picker-search" id="cover-search" type="search" placeholder={t('Поиск персонажа')} aria-label={t('Поиск обложки')} />
          <div class="choice-grid cover-choices" id="cover-choices"></div>
        </section>
        <section class="editor-section">
          <h3>{t('Цвет профиля')}</h3>
          <div class="color-choices" id="color-choices"></div>
        </section>
        <section class="editor-section">
          <h3>{t('Любимые персонажи')}</h3>
          <div class="selected-favorites" id="selected-favorites"></div>
          <input class="input picker-search" id="favorite-search" type="search" placeholder={t('Поиск персонажа')} aria-label={t('Поиск персонажа')} />
          <div class="choice-grid character-choices" id="favorite-choices"></div>
        </section>
        <section class="editor-section">
          <h3>{t('Перенос профиля')}</h3>
          <div class="editor-actions">
            <button class="btn" id="export-profile" type="button">{t('Экспорт в файл')}</button>
            <label class="btn file-button" for="import-file">{t('Импорт из файла')}</label>
            <input class="sr-only" id="import-file" type="file" accept=".json,application/json" />
            <button class="btn danger" id="replace-profile" type="button" hidden>{t('Заменить мой профиль')}</button>
          </div>
          <p class="small status" id="import-status" aria-live="polite"></p>
        </section>
        <section class="editor-section">
          <button class="btn" id="reset-profile" type="button">{t('Сбросить оформление')}</button>
          <button class="btn danger" id="confirm-reset" type="button" hidden>{t('Подтвердить сброс оформления')}</button>
        </section>
      </div>
      <div class="dialog-foot">
        <button class="btn" id="cancel-editor" type="button">{t('Отмена')}</button>
        <button class="btn primary" id="save-editor" type="button">{t('Готово')}</button>
      </div>
    </dialog>
  </div>
  <script type="application/json" id="profile-chars" set:html={charsJson}></script>
</Layout>

<script>
  import { favorites, recent, store, type Entry } from '../scripts/common';
  import { BASE, t } from '../scripts/search';

  type Char = { id: number | null; s: string; n: string; i: string };
  type PickerChar = { slug: string; name: string; icon: string; element: string; rarity: number; namecard: string };
  type Profile = { uid: string; time: number; player: { nickname: string; level: number; worldLevel: number; signature: string; profilePictureId?: number }; showcase: number[] };
  type Wish = { id: string; uid: string; gacha_type: string; time: string; name: string; item_type: string; rank_type: string };
  type Avatar = { type: 'none' } | { type: 'character'; slug: string } | { type: 'upload'; data: string };
  type Custom = { v: 1; nick: string; about: string; avatar: Avatar; cover: string; color: string; favorites: string[] };
  type ImportData = { custom: Custom; favs: Entry[]; roster: { s: string }[]; uid: string | null };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const read = (key: string): unknown => { try { return store.get<unknown>(key, null); } catch { return null; } };
  const isRecord = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
  const uidOk = (value: unknown): value is string => typeof value === 'string' && /^\d{9,10}$/.test(value);
  const num = (value: unknown) => value !== null && value !== undefined && Number.isFinite(Number(value)) ? Number(value) : null;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', label = '') => { const node = document.createElement(tag); node.className = className; node.textContent = label; return node; };
  const iconUrl = (value: unknown) => { if (typeof value !== 'string') return null; try { const url = new URL(value, location.origin); return ['http:', 'https:'].includes(url.protocol) ? url.href : null; } catch { return null; } };
  const safeHref = (value: string) => { if (!value.startsWith('/') || value.startsWith('//')) return null; try { const url = new URL(value, location.origin); return url.origin === location.origin ? url.pathname + url.search + url.hash : null; } catch { return null; } };
  const img = (src: string, size: number) => { const node = document.createElement('img'); node.src = src; node.alt = ''; node.width = size; node.height = size; node.loading = 'lazy'; node.decoding = 'async'; return node; };
  const colors = ['accent', 'pyro', 'hydro', 'anemo', 'electro', 'dendro', 'cryo', 'geo'] as const;
  const colorNames = ['Золото сайта', 'Пиро', 'Гидро', 'Анемо', 'Электро', 'Дендро', 'Крио', 'Гео'];
  const elements = ['pyro', 'hydro', 'anemo', 'electro', 'dendro', 'cryo', 'geo'];
  const emptyCustom = (): Custom => ({ v: 1, nick: '', about: '', avatar: { type: 'none' }, cover: '', color: 'accent', favorites: [] });
  const imageOk = (value: unknown): value is string => typeof value === 'string' && /^data:image\/(?:webp|jpeg);base64,[A-Za-z0-9+/]+=*$/.test(value) && Math.ceil((value.length - value.indexOf(',') - 1) * .75) <= 150 * 1024;
  const rawChars: unknown = (() => { try { return JSON.parse($('profile-chars').textContent ?? '[]'); } catch { return []; } })();
  const pickerChars: PickerChar[] = Array.isArray(rawChars) ? rawChars.filter((item): item is PickerChar =>
    isRecord(item) && typeof item.slug === 'string' && /^[a-z0-9-]+$/.test(item.slug) && typeof item.name === 'string' &&
    typeof item.icon === 'string' && typeof item.element === 'string' && typeof item.rarity === 'number' && typeof item.namecard === 'string') : [];
  const pickerBySlug = new Map(pickerChars.map((char) => [char.slug, char]));
  const charsById = new Map<number, Char>();
  const charsBySlug = new Map<string, Char>();
  let charsReady = false, currentProfile: Profile | null = null;
  const root = document.querySelector<HTMLElement>('.profile-root')!;
  const avatar = $('profile-avatar');
  const placeholder = avatar.firstElementChild!.cloneNode(true);
  const dialog = $<HTMLDialogElement>('profile-dialog');
  const editButton = $<HTMLButtonElement>('edit-profile');
  let saved = emptyCustom(), draft = emptyCustom(), avatarTab: Avatar['type'] = 'character';
  let pendingImport: ImportData | null = null, keepChanges = false;
  let editorSession = 0, avatarOperation = 0, importSelection = 0;
  const status = (message: string, bad = false) => { $('profile-status').textContent = message; $('profile-status').classList.toggle('bad', bad); };
  let showcaseRequest = 0;
  let showcaseController: AbortController | null = null;
  const cancelShowcase = () => {
    ++showcaseRequest;
    showcaseController?.abort();
    showcaseController = null;
    $<HTMLButtonElement>('load-showcase').disabled = false;
  };

  function validCustom(value: unknown) {
    const result = emptyCustom();
    if (value === null) return { value: result, valid: true };
    if (!isRecord(value) || value.v !== 1) return { value: result, valid: false };
    let valid = true;
    if (typeof value.nick === 'string' && value.nick.length <= 24) result.nick = value.nick; else valid = false;
    if (typeof value.about === 'string' && value.about.length <= 300) result.about = value.about; else valid = false;
    if (isRecord(value.avatar)) {
      if (value.avatar.type === 'none') result.avatar = { type: 'none' };
      else if (value.avatar.type === 'character' && typeof value.avatar.slug === 'string' && pickerBySlug.has(value.avatar.slug)) result.avatar = { type: 'character', slug: value.avatar.slug };
      else if (value.avatar.type === 'upload' && imageOk(value.avatar.data)) result.avatar = { type: 'upload', data: value.avatar.data };
      else valid = false;
    } else valid = false;
    if (typeof value.cover === 'string' && (!value.cover || !!pickerBySlug.get(value.cover)?.namecard)) result.cover = value.cover; else valid = false;
    if (typeof value.color === 'string' && colors.some((color) => color === value.color)) result.color = value.color; else valid = false;
    if (Array.isArray(value.favorites)) {
      const unique = new Set<string>();
      for (const slug of value.favorites) {
        if (typeof slug === 'string' && pickerBySlug.has(slug) && !unique.has(slug) && unique.size < 6) unique.add(slug);
        else valid = false;
      }
      result.favorites = [...unique];
    } else valid = false;
    return { value: result, valid };
  }
  function validEntries(value: unknown) {
    if (!Array.isArray(value)) return null;
    const list: Entry[] = [];
    let valid = true;
    for (const item of value) {
      if (!isRecord(item) || typeof item.href !== 'string' || !safeHref(item.href) || typeof item.name !== 'string' || typeof item.kind !== 'string' ||
        (item.icon !== undefined && item.icon !== null && (typeof item.icon !== 'string' || !iconUrl(item.icon)))) { valid = false; continue; }
      list.push({ href: item.href, name: item.name, kind: item.kind, icon: item.icon as string | null | undefined });
    }
    return { value: list, valid };
  }
  function validRoster(value: unknown) {
    if (!Array.isArray(value)) return null;
    const list: { s: string }[] = [];
    let valid = true;
    for (const item of value) {
      if (!isRecord(item) || typeof item.s !== 'string' || !pickerBySlug.has(item.s)) { valid = false; continue; }
      list.push({ s: item.s });
    }
    return { value: list, valid };
  }
  function validCache(value: unknown): Profile | null {
    if (!isRecord(value) || !uidOk(value.uid) || typeof value.time !== 'number' || !isRecord(value.player) || !Array.isArray(value.showcase)) return null;
    const player = value.player;
    if (typeof player.nickname !== 'string' || typeof player.level !== 'number' || typeof player.worldLevel !== 'number' || typeof player.signature !== 'string') return null;
    return { uid: value.uid, time: value.time, player: { nickname: player.nickname, level: player.level, worldLevel: player.worldLevel, signature: player.signature,
      profilePictureId: typeof player.profilePictureId === 'number' ? player.profilePictureId : undefined }, showcase: value.showcase.filter((id): id is number => typeof id === 'number' && Number.isFinite(id)) };
  }
  function addChar(parent: HTMLElement, char: Char) {
    const link = document.createElement('a');
    link.href = `${BASE}/characters/${char.s}/`;
    link.title = char.n;
    const src = iconUrl(char.i);
    if (src) link.append(img(src, 56));
    link.append(el('span', '', char.n));
    parent.append(link);
  }
  function renderPersonal() {
    root.style.setProperty('--profile-accent', `var(--${draft.color})`);
    $('profile-name').textContent = draft.nick || currentProfile?.player.nickname || t('Путешественник');
    const about = $('profile-about');
    about.textContent = draft.about;
    about.hidden = !draft.about;
    const cover = $<HTMLImageElement>('profile-cover');
    const coverSrc = iconUrl(pickerBySlug.get(draft.cover)?.namecard);
    cover.hidden = !coverSrc;
    if (coverSrc) cover.src = coverSrc; else cover.removeAttribute('src');
    avatar.replaceChildren(placeholder.cloneNode(true));
    const src = draft.avatar.type === 'character' ? iconUrl(pickerBySlug.get(draft.avatar.slug)?.icon)
      : draft.avatar.type === 'upload' && imageOk(draft.avatar.data) ? draft.avatar.data : null;
    if (src) avatar.replaceChildren(img(src, 96));
    const box = $('profile-favorites-list');
    box.replaceChildren();
    for (const slug of draft.favorites) {
      const char = pickerBySlug.get(slug);
      if (!char) continue;
      const link = document.createElement('a');
      link.href = `${BASE}/characters/${char.slug}/`;
      link.className = `favorite-tile r${char.rarity === 5 ? 5 : 4}`;
      link.setAttribute('data-el', elements.includes(char.element) ? char.element : '');
      const portrait = el('span', 'favorite-portrait');
      const image = iconUrl(char.icon);
      if (image) portrait.append(img(image, 88));
      const name = el('span', 'favorite-name', char.name);
      const element = el('span', 'favorite-element');
      element.setAttribute('aria-label', t(colorNames[colors.indexOf(char.element as typeof colors[number])] ?? 'Персонаж'));
      link.append(portrait, name, element);
      box.append(link);
    }
    $('profile-favorites').hidden = !box.childElementCount;
  }
  function renderProfile() {
    const player = currentProfile?.player;
    const meta = $('profile-meta');
    meta.hidden = !player;
    meta.textContent = player ? t('Ранг приключений {level} · Уровень мира {world}', { level: player.level, world: player.worldLevel }) : '';
    renderPersonal();
    const showcase = $('showcase');
    showcase.hidden = !currentProfile;
    const items = $('showcase-list');
    items.replaceChildren();
    if (currentProfile && charsReady) {
      for (const id of currentProfile.showcase) { const char = charsById.get(id); if (char) addChar(items, char); }
      if (!items.childElementCount) items.textContent = currentProfile.showcase.length ? t('На витрине нет знакомых персонажей.') : t('Витрина пуста или скрыта.');
    }
    $('load-showcase').textContent = currentProfile ? t('Обновить') : t('Загрузить витрину');
  }
  function entries(getter: () => Entry[]) {
    let raw: unknown;
    try { raw = getter(); } catch { raw = []; }
    return validEntries(raw)?.value ?? [];
  }
  function renderEntries(id: string, list: Entry[], empty: string, hideEmpty = false) {
    const box = $(id);
    box.replaceChildren();
    box.closest('section')!.hidden = hideEmpty && !list.length;
    if (!list.length) { if (!hideEmpty) box.textContent = t(empty); return; }
    for (const item of list.slice(0, 100)) {
      const href = safeHref(item.href);
      if (!href) continue;
      const link = document.createElement('a');
      link.href = href;
      const src = iconUrl(item.icon);
      if (src) link.append(img(src, 40));
      link.append(el('span', '', item.name));
      box.append(link);
    }
    if (!box.childElementCount && !hideEmpty) box.textContent = t(empty);
    if (hideEmpty && !box.childElementCount) box.closest('section')!.hidden = true;
  }
  function renderRoster() {
    const box = $('roster-list');
    box.replaceChildren();
    if (!charsReady) { box.textContent = t('Не удалось загрузить данные персонажей.'); return; }
    const raw = read('gf:roster');
    const seen = new Set<string>();
    const valid = validRoster(raw)?.value ?? [];
    const list = valid.filter((item) => charsBySlug.has(item.s) && !seen.has(item.s) && !!seen.add(item.s));
    $('roster-count').textContent = list.length ? t('Персонажей: {n}', { n: list.length }) : '';
    if (!list.length) { box.textContent = t('Добавьте персонажей в проверке команды или загрузите по UID.'); return; }
    for (const item of list.slice(0, 16)) addChar(box, charsBySlug.get(item.s)!);
    if (list.length > 16) box.append(el('span', 'more', `+${list.length - 16}`));
  }
  function renderWishes() {
    const box = $('wishes-list');
    box.replaceChildren();
    const raw = read('gf:wish-uids');
    const uids = Array.isArray(raw) ? [...new Set(raw.filter((uid): uid is string => uidOk(uid) || uid === 'manual'))] : [];
    for (const uid of uids) {
      const saved = read(`gf:wishes:${uid}`);
      const list: Wish[] = Array.isArray(saved) ? saved.filter((item): item is Wish => isRecord(item) && ['id', 'uid', 'gacha_type', 'time', 'name', 'item_type', 'rank_type'].every((key) => typeof item[key] === 'string'))
        .sort((a, b) => a.id.length - b.id.length || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0)) : [];
      if (!list.length) continue;
      const account = el('div', 'account');
      account.append(el('h3', '', uid === 'manual' ? t('Ручной ввод') : t('UID {uid}', { uid })));
      const fives = list.filter((wish) => wish.rank_type === '5').length;
      account.append(el('p', 'summary', t('Молитв: {total} · 5★: {fives}', { total: list.length, fives })));
      for (const [title, types] of [
        [t('Молитва события персонажа'), ['301', '400']], [t('Молитва события оружия'), ['302']], [t('Стандартная молитва'), ['200']],
      ] as [string, string[]][]) {
        const rows = list.filter((wish) => types.includes(wish.gacha_type));
        let pity = 0;
        for (const wish of rows) pity = wish.rank_type === '5' ? 0 : pity + 1;
        const line = el('div', 'pity-row');
        line.append(el('span', '', title), el('span', '', t('Текущий гарант: {n}', { n: pity })));
        account.append(line);
      }
      box.append(account);
    }
    if (!box.childElementCount) box.append(el('p', 'empty', t('История круток не загружена')));
  }
  function choice(char: PickerChar, selected: boolean, cover = false, focusKey = '') {
    const button = el('button', 'choice');
    button.type = 'button';
    button.title = char.name;
    button.dataset.focusKey = focusKey;
    button.setAttribute('aria-pressed', String(selected));
    const src = iconUrl(cover ? char.namecard : char.icon);
    if (src) button.append(img(src, cover ? 160 : 48));
    button.append(el('span', '', char.name));
    return button;
  }
  function renderPickers() {
    const activeKey = dialog.contains(document.activeElement) ? (document.activeElement as HTMLElement).dataset.focusKey : undefined;
    const avatarBox = $('avatar-choices'), coverBox = $('cover-choices'), favoriteBox = $('favorite-choices');
    avatarBox.replaceChildren();
    coverBox.replaceChildren();
    favoriteBox.replaceChildren();
    const avatarQuery = $<HTMLInputElement>('avatar-search').value.trim().toLocaleLowerCase();
    const coverQuery = $<HTMLInputElement>('cover-search').value.trim().toLocaleLowerCase();
    const favoriteQuery = $<HTMLInputElement>('favorite-search').value.trim().toLocaleLowerCase();
    if (!coverQuery) {
      const none = el('button', 'choice no-cover', t('Без обложки'));
      none.type = 'button';
      none.dataset.focusKey = 'cover:none';
      none.setAttribute('aria-pressed', String(!draft.cover));
      none.addEventListener('click', () => { draft.cover = ''; renderPersonal(); renderPickers(); });
      coverBox.append(none);
    }
    for (const char of pickerChars) {
      const name = char.name.toLocaleLowerCase();
      if (name.includes(avatarQuery)) {
        const button = choice(char, draft.avatar.type === 'character' && draft.avatar.slug === char.slug, false, `avatar:${char.slug}`);
        button.addEventListener('click', () => { avatarOperation++; draft.avatar = { type: 'character', slug: char.slug }; setAvatarTab('character'); renderPersonal(); renderPickers(); });
        avatarBox.append(button);
      }
      if (char.namecard && name.includes(coverQuery)) {
        const button = choice(char, draft.cover === char.slug, true, `cover:${char.slug}`);
        button.addEventListener('click', () => { draft.cover = char.slug; renderPersonal(); renderPickers(); });
        coverBox.append(button);
      }
      if (name.includes(favoriteQuery)) {
        const button = choice(char, draft.favorites.includes(char.slug), false, `favorite:${char.slug}`);
        button.addEventListener('click', () => {
          const index = draft.favorites.indexOf(char.slug);
          if (index >= 0) draft.favorites.splice(index, 1);
          else if (draft.favorites.length < 6) draft.favorites.push(char.slug);
          renderPersonal(); renderPickers();
        });
        favoriteBox.append(button);
      }
    }
    const selected = $('selected-favorites');
    selected.replaceChildren();
    for (const [index, slug] of draft.favorites.entries()) {
      const row = el('div', 'selected-row');
      row.tabIndex = -1;
      row.dataset.focusKey = `selected:${slug}`;
      row.append(el('span', '', pickerBySlug.get(slug)?.name ?? slug));
      for (const [offset, label] of [[-1, 'Переместить влево'], [1, 'Переместить вправо']] as const) {
        const button = el('button', 'btn', offset < 0 ? '←' : '→');
        button.type = 'button';
        button.title = t(label);
        button.setAttribute('aria-label', t(label));
        button.dataset.focusKey = `move:${slug}:${offset}`;
        button.disabled = index + offset < 0 || index + offset >= draft.favorites.length;
        button.addEventListener('click', () => {
          [draft.favorites[index], draft.favorites[index + offset]] = [draft.favorites[index + offset], draft.favorites[index]];
          renderPersonal(); renderPickers();
        });
        row.append(button);
      }
      selected.append(row);
    }
    const colorBox = $('color-choices');
    colorBox.replaceChildren();
    colors.forEach((color, index) => {
      const button = el('button', 'color-choice', t(colorNames[index]));
      button.type = 'button';
      button.title = t(colorNames[index]);
      button.dataset.focusKey = `color:${color}`;
      button.setAttribute('aria-pressed', String(draft.color === color));
      button.style.setProperty('--choice-color', `var(--${color})`);
      button.addEventListener('click', () => { draft.color = color; renderPersonal(); renderPickers(); });
      colorBox.append(button);
    });
    const focusTarget = (key: string) => [...dialog.querySelectorAll<HTMLElement>('[data-focus-key]')].find((node) => node.dataset.focusKey === key && !(node instanceof HTMLButtonElement && node.disabled));
    let target = activeKey ? focusTarget(activeKey) : undefined;
    if (!target && activeKey?.startsWith('move:')) {
      const [, slug, offset] = activeKey.split(':');
      target = focusTarget(`move:${slug}:${offset === '-1' ? 1 : -1}`) ?? focusTarget(`selected:${slug}`) ?? $('favorite-search');
    }
    target?.focus({ preventScroll: true });
  }
  function setAvatarTab(tab: Avatar['type']) {
    avatarTab = tab;
    for (const [kind, id] of [['character', 'avatar-character'], ['upload', 'avatar-upload'], ['none', 'avatar-none']] as const) {
      $(id).setAttribute('aria-pressed', String(kind === tab));
    }
    $('avatar-character-panel').hidden = tab !== 'character';
    $('avatar-upload-panel').hidden = tab !== 'upload';
  }
  function closeEditor() { avatarOperation++; importSelection++; editorSession++; dialog.close(); }
  function openEditor() {
    editorSession++; avatarOperation++; importSelection++;
    draft = structuredClone(saved);
    keepChanges = false;
    pendingImport = null;
    $('replace-profile').hidden = true;
    $('confirm-reset').hidden = true;
    $('import-status').textContent = '';
    $('avatar-status').textContent = '';
    $<HTMLInputElement>('avatar-file').value = '';
    $<HTMLInputElement>('import-file').value = '';
    $<HTMLInputElement>('editor-name').value = draft.nick;
    $<HTMLTextAreaElement>('editor-about').value = draft.about;
    $('about-count').textContent = t('Символов: {n}/300', { n: draft.about.length });
    setAvatarTab(draft.avatar.type);
    renderPickers();
    dialog.showModal();
    $<HTMLInputElement>('editor-name').focus();
  }

  renderEntries('favorites-list', entries(favorites.list), 'Добавляйте персонажей и оружие в избранное кнопкой ☆ на их страницах.');
  renderEntries('recent-list', entries(recent.list), '', true);
  renderWishes();
  saved = validCustom(read('gf:profile-custom')).value;
  draft = structuredClone(saved);
  const cachedProfile = validCache(read('gf:profile-cache'));
  const uidInput = $<HTMLInputElement>('profile-uid');
  const storedUid = read('gf:profile-uid');
  const uidCleared = (() => { try { return localStorage.getItem('gf:profile-uid') === 'null'; } catch { return false; } })();
  const selectedUid = uidCleared ? null : uidOk(storedUid) ? storedUid : cachedProfile?.uid;
  if (selectedUid) uidInput.value = selectedUid;
  else if (!uidCleared) for (const key of ['gf:sim-uid', 'gf:wish-uid']) { const value = read(key); if (uidOk(value)) { uidInput.value = value; break; } }
  currentProfile = cachedProfile?.uid === uidInput.value ? cachedProfile : null;
  renderProfile();
  fetch(`${BASE}/data/checker.json`).then(async (response) => { if (!response.ok) throw new Error(); return response.json(); }).then((data: unknown) => {
    if (!isRecord(data) || !Array.isArray(data.characters)) throw new Error();
    for (const value of data.characters) if (isRecord(value) && typeof value.id === 'number' && typeof value.s === 'string' && /^[a-z0-9-]+$/.test(value.s) && typeof value.n === 'string' && typeof value.i === 'string') {
      const char = value as Char; charsById.set(char.id!, char); charsBySlug.set(char.s, char);
    }
    charsReady = true; renderRoster(); renderProfile();
  }).catch(() => { $('roster-list').textContent = t('Не удалось загрузить данные персонажей.'); });
  $('showcase-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const uid = uidInput.value.trim();
    if (!uidOk(uid)) return status(t('UID — это 9 или 10 цифр из правого нижнего угла экрана в игре.'), true);
    cancelShowcase();
    const controller = new AbortController();
    showcaseController = controller;
    const turn = showcaseRequest;
    const active = () => turn === showcaseRequest && !controller.signal.aborted;
    const button = $<HTMLButtonElement>('load-showcase');
    button.disabled = true;
    status(t('Загружаю витрину…'));
    try {
      const response = await fetch(`/api/enka/${uid}`, { signal: controller.signal });
      const body: unknown = await response.json();
      if (!active()) return;
      if (!response.ok) return status(t(isRecord(body) && typeof body.error === 'string' ? body.error : 'Не удалось загрузить профиль.'), true);
      if (!isRecord(body) || !isRecord(body.playerInfo)) return status(t('Не удалось загрузить профиль.'), true);
      const player = body.playerInfo;
      const picture = isRecord(player.profilePicture) ? num(player.profilePicture.avatarId ?? player.profilePicture.id) : null;
      const shown = Array.isArray(player.showAvatarInfoList) && player.showAvatarInfoList.length ? player.showAvatarInfoList : body.avatarInfoList;
      const showcase = Array.isArray(shown) ? shown.map((item) => isRecord(item) ? num(item.avatarId) : null).filter((id): id is number => id !== null) : [];
      currentProfile = { uid, time: Date.now(), player: { nickname: typeof player.nickname === 'string' ? player.nickname : '', level: num(player.level) ?? 0,
        worldLevel: num(player.worldLevel) ?? 0, signature: typeof player.signature === 'string' ? player.signature : '', profilePictureId: picture ?? undefined }, showcase };
      store.set('gf:profile-uid', uid);
      store.set('gf:profile-cache', currentProfile);
      renderProfile();
      status(t('Витрина обновлена.'));
    } catch (error) {
      if (active() && !(error instanceof Error && error.name === 'AbortError')) status(t('Не удалось связаться с сервером. Проверьте интернет и попробуйте ещё раз.'), true);
    } finally {
      if (active()) { button.disabled = false; showcaseController = null; }
    }
  });
  editButton.addEventListener('click', openEditor);
  dialog.addEventListener('close', () => {
    avatarOperation++; importSelection++; editorSession++;
    pendingImport = null;
    if (!keepChanges) { draft = structuredClone(saved); renderPersonal(); }
    editButton.focus({ preventScroll: true });
  });
  $('close-editor').addEventListener('click', closeEditor);
  $('cancel-editor').addEventListener('click', closeEditor);
  $('save-editor').addEventListener('click', () => {
    saved = structuredClone(draft);
    store.set('gf:profile-custom', saved);
    keepChanges = true;
    closeEditor();
  });
  $<HTMLInputElement>('editor-name').addEventListener('input', (event) => {
    draft.nick = (event.target as HTMLInputElement).value;
    renderPersonal();
  });
  $<HTMLTextAreaElement>('editor-about').addEventListener('input', (event) => {
    draft.about = (event.target as HTMLTextAreaElement).value;
    $('about-count').textContent = t('Символов: {n}/300', { n: draft.about.length });
    renderPersonal();
  });
  for (const id of ['avatar-search', 'cover-search', 'favorite-search']) $(id).addEventListener('input', renderPickers);
  $('avatar-character').addEventListener('click', () => { avatarOperation++; setAvatarTab('character'); });
  $('avatar-upload').addEventListener('click', () => { avatarOperation++; setAvatarTab('upload'); });
  $('avatar-none').addEventListener('click', () => { avatarOperation++; draft.avatar = { type: 'none' }; setAvatarTab('none'); renderPersonal(); renderPickers(); });
  $<HTMLInputElement>('avatar-file').addEventListener('change', async (event) => {
    const file = (event.target as HTMLInputElement).files?.[0];
    if (!file) return;
    (event.target as HTMLInputElement).value = '';
    const operation = ++avatarOperation, session = editorSession;
    const active = () => dialog.open && operation === avatarOperation && session === editorSession;
    const message = $('avatar-status');
    if (!file.type.startsWith('image/')) { if (active()) message.textContent = t('Не удалось обработать картинку.'); return; }
    try {
      const bitmap = await createImageBitmap(file);
      if (!active()) { bitmap.close(); return; }
      const canvas = document.createElement('canvas');
      canvas.width = canvas.height = 256;
      const side = Math.min(bitmap.width, bitmap.height);
      const context = canvas.getContext('2d');
      if (!context) throw new Error();
      context.drawImage(bitmap, (bitmap.width - side) / 2, (bitmap.height - side) / 2, side, side, 0, 0, 256, 256);
      bitmap.close();
      let data = canvas.toDataURL('image/webp', .85);
      if (!data.startsWith('data:image/webp')) data = canvas.toDataURL('image/jpeg', .85);
      if (!imageOk(data)) { if (active()) message.textContent = t('Картинка слишком большая'); return; }
      if (!active()) return;
      draft.avatar = { type: 'upload', data };
      message.textContent = '';
      renderPersonal(); renderPickers();
    } catch { if (active()) message.textContent = t('Не удалось обработать картинку.'); }
  });
  $('export-profile').addEventListener('click', () => {
    const rawFavs = read('gf:favs'), rawRoster = read('gf:roster');
    const favs = validEntries(rawFavs), roster = validRoster(rawRoster);
    const damaged = (rawFavs !== null && (!favs || !favs.valid)) || (rawRoster !== null && (!roster || !roster.valid));
    $('import-status').textContent = damaged ? t('Некоторые повреждённые записи не вошли в экспорт.') : '';
    const data = {
      'gf:profile-custom': validCustom(read('gf:profile-custom')).value,
      'gf:favs': favs?.value ?? [],
      'gf:roster': roster?.value ?? [],
      'gf:profile-uid': uidOk(read('gf:profile-uid')) ? read('gf:profile-uid') : null,
    };
    const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = 'genshinflex-profile.json';
    link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
  $<HTMLInputElement>('import-file').addEventListener('change', async (event) => {
    const selection = ++importSelection, session = editorSession;
    pendingImport = null;
    $('replace-profile').hidden = true;
    $('import-status').textContent = '';
    const file = (event.target as HTMLInputElement).files?.[0];
    if (!file) return;
    (event.target as HTMLInputElement).value = '';
    try {
      const raw: unknown = JSON.parse(await file.text());
      if (!dialog.open || selection !== importSelection || session !== editorSession) return;
      if (!isRecord(raw) || !Object.prototype.hasOwnProperty.call(raw, 'gf:profile-custom') ||
        !Object.prototype.hasOwnProperty.call(raw, 'gf:favs') || !Object.prototype.hasOwnProperty.call(raw, 'gf:roster') ||
        !Object.prototype.hasOwnProperty.call(raw, 'gf:profile-uid')) throw new Error();
      const custom = validCustom(raw['gf:profile-custom']);
      const favs = validEntries(raw['gf:favs']);
      const roster = validRoster(raw['gf:roster']);
      const uid = raw['gf:profile-uid'];
      if (!custom.valid || !favs || !roster || (uid !== null && !uidOk(uid))) throw new Error();
      pendingImport = { custom: custom.value, favs: favs.value, roster: roster.value, uid: uid as string | null };
      $('import-status').textContent = favs.valid && roster.valid ? t('Файл готов к импорту.') : t('Файл готов к импорту. Некоторые повреждённые записи будут пропущены.');
      $('replace-profile').hidden = false;
    } catch { if (dialog.open && selection === importSelection && session === editorSession) $('import-status').textContent = t('Неверный файл профиля.'); }
  });
  $('replace-profile').addEventListener('click', () => {
    if (!pendingImport) return;
    cancelShowcase();
    store.set('gf:profile-custom', pendingImport.custom);
    store.set('gf:favs', pendingImport.favs);
    store.set('gf:roster', pendingImport.roster);
    store.set('gf:profile-uid', pendingImport.uid);
    if (pendingImport.uid === null) try { localStorage.removeItem('gf:profile-cache'); } catch {}
    saved = structuredClone(pendingImport.custom);
    draft = structuredClone(saved);
    uidInput.value = pendingImport.uid ?? '';
    const cached = validCache(read('gf:profile-cache'));
    currentProfile = pendingImport.uid && cached?.uid === pendingImport.uid ? cached : null;
    renderProfile();
    status('');
    renderEntries('favorites-list', entries(favorites.list), 'Добавляйте персонажей и оружие в избранное кнопкой ☆ на их страницах.');
    renderRoster();
    pendingImport = null;
    keepChanges = true;
    closeEditor();
  });
  $('reset-profile').addEventListener('click', () => { $('confirm-reset').hidden = false; });
  $('confirm-reset').addEventListener('click', () => {
    try { localStorage.removeItem('gf:profile-custom'); } catch {}
    saved = emptyCustom();
    draft = structuredClone(saved);
    renderPersonal();
    keepChanges = true;
    closeEditor();
  });
</script>

