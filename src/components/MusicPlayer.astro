        player = undefined; playerPromise = undefined; playerReady = false;
        playing = false; loaded = false;
        if (!nextButton || !nextPanel) return;
        button = nextButton; panel = nextPanel;
        title = panel.querySelector<HTMLElement>('.music-title')!; disc = panel.querySelector<HTMLElement>('.music-disc')!;
        miniTitle = panel.querySelector<HTMLElement>('.music-mini-title')!;
        status = panel.querySelector<HTMLElement>('.music-status')!; shuffleButton = panel.querySelector<HTMLButtonElement>('.music-shuffle')!;
        muteButton = panel.querySelector<HTMLButtonElement>('.music-mute')!; volumeInput = panel.querySelector<HTMLInputElement>('.music-volume')!;
        armed = enabled; panel.classList.toggle('collapsed', collapsed);
        bind();
      }
      updateLabels(); render();
    });
  }
</script>

