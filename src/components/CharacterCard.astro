---
import { useData, LANGS } from '../lib/data';
const { getCharacter, base, t } = useData(Astro.currentLocale);

interface Props { slug: string; badge?: string; }
const { slug, badge } = Astro.props;
const c = getCharacter(slug);
---
<a class:list={['cc', `r${c.rarity}`, { emblem: c.emblem }]} href={`${base}/characters/${c.slug}`} data-el={c.element}>
  <img src={c.icon} alt="" loading="lazy" width="140" height="160" />
  {c.emblem && <img class="skill" src={c.emblem} alt="" loading="lazy" width="40" height="40" />}
  <span class="el-dot" title={c.elementText}></span>
  {c.beta ? <span class="badge beta">BETA</span> : badge && <span class="badge">{badge}</span>}
  <span class="name">{c.name}</span>
</a>

<style>
  .cc {
    position: relative; display: block; aspect-ratio: 7 / 8; border-radius: var(--radius); overflow: hidden;
    text-decoration: none; background: linear-gradient(180deg, #5b4b82, #9679c4); isolation: isolate;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .cc.r5 { background: linear-gradient(180deg, #7a5226, #d1953f); }
  /* Путешественник: фон в цвет стихии и иконка навыка в углу — иначе семь карточек неотличимы */
  .cc.emblem { background: linear-gradient(180deg, color-mix(in srgb, var(--el) 55%, #1c2033), color-mix(in srgb, var(--el) 85%, #fff)); }
  .cc .skill { position: absolute; right: 5px; bottom: 28%; width: 26%; height: auto; inset-inline-start: auto; top: auto; z-index: 1;
    border-radius: 50%; padding: 4px; background: rgb(15 18 32 / .75); box-shadow: 0 0 0 2px var(--el); object-fit: contain; }
  .cc img:not(.skill) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; z-index: -1; }
  .cc::after { content: ""; position: absolute; inset: auto 0 0; height: 40%; background: linear-gradient(transparent, rgb(10 10 20 / .85)); z-index: -1; }
  /* Иконка стихии на тёмной подложке — читается на любом портрете */
  .el-dot { position: absolute; top: 5px; left: 5px; width: 24px; height: 24px; border-radius: 50%; background: var(--el-icon) center / 84% no-repeat, rgb(12 14 24 / .6); }
  .badge { position: absolute; top: 6px; right: 6px; background: var(--accent); color: var(--accent-ink); font-size: .68rem; font-weight: 600; padding: .05rem .4rem; border-radius: 4px; }
  .badge.beta { background: #e0457b; color: #fff; letter-spacing: .04em; }
  .name { position: absolute; left: 6px; right: 6px; bottom: 6px; text-align: center; font-size: .8rem; font-weight: 500; line-height: 1.15; color: #fff; }
  .cc:hover { outline: 2px solid var(--accent); outline-offset: 2px; transform: translateY(-3px); box-shadow: 0 8px 20px rgb(0 0 0 / .22); }
</style>
