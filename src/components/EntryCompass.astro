---
// Экран входа «Палочка Весны»: оживлённый арт (8 с, бесшовный цикл), войти — нажать на навершие палочки
import { useData } from '../lib/data';
const { t } = useData(Astro.currentLocale);
// Траектория навершия палочки в видео: [время, x %, y %] — Весна парит, кнопка следует за навершием
const track = [[0.0,25.25,53.13],[0.25,25.24,53.33],[0.5,25.24,53.53],[0.75,25.24,53.7],[1.0,25.24,53.84],[1.25,25.24,53.95],[1.5,25.24,54.02],[1.75,25.24,54.05],[2.0,25.24,54.04],[2.25,25.24,53.98],[2.5,25.25,53.89],[2.75,25.25,53.76],[3.0,25.26,53.61],[3.25,25.26,53.42],[3.5,25.27,53.22],[3.75,25.27,53.01],[4.0,25.27,52.8],[4.25,25.28,52.59],[4.5,25.28,52.4],[4.75,25.28,52.23],[5.0,25.29,52.09],[5.25,25.29,51.98],[5.5,25.29,51.91],[5.75,25.28,51.88],[6.0,25.28,51.89],[6.25,25.28,51.94],[6.5,25.27,52.03],[6.75,25.27,52.16],[7.0,25.27,52.32],[7.25,25.26,52.5],[7.5,25.26,52.7],[7.75,25.25,52.91],[8.0,25.25,53.13]];
// Дополнительные цели (бабочки) — в этом кадре их нет
const butterflies: Record<string, { size: number; track: number[][] }> = {};
---
<div id="gf-entry" data-track={JSON.stringify(track)} data-butterflies={JSON.stringify(butterflies)} role="dialog" aria-modal="true" aria-label={t('Вход на сайт')} hidden>
  <div class="panel">
    <button class="menu" type="button" aria-label={t('Открыть меню')}>☰</button>
    <div class="brand">
      <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
        <path d="M16 2 29 9.5v13L16 30 3 22.5v-13Z" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M16 8.5 22.5 12v8L16 23.5 9.5 20v-8Z" fill="currentColor"/>
      </svg>
      <span>Genshin<b>Flex</b></span>
    </div>
  </div>
  <div class="parallax">
    <div class="scene">
      <!-- Источники проставляет скрипт при показе: если вход уже пройден, видео не качается -->
      <video muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true"
        data-poster="/img/season/vesna-wand-poster.webp" width="1920" height="1080">
        <source data-src="/img/season/vesna-wand.mp4" type="video/mp4" />
      </video>
      <!-- Кнопка стоит на навершии палочки из видео и движется вместе с ним -->
      <button class="light" type="button" aria-label={t('Войти на сайт')}>
        <span class="glow" aria-hidden="true"></span>
        <span class="bubble" aria-hidden="true"></span>
        <span class="ring" aria-hidden="true"></span>
        <span class="glints" aria-hidden="true"></span>
        <span class="shake" aria-hidden="true"></span>
      </button>
      <!-- Дубли входа для мыши/касания: с клавиатуры достаточно основной кнопки -->
      {Object.entries(butterflies).map(([key, b]) => (
        <button class="bfly" type="button" tabindex="-1" aria-hidden="true" data-key={key}
          style={`left: ${b.track[0][1]}%; top: ${b.track[0][2]}%; --size: ${b.size}`}></button>
      ))}
    </div>
  </div>
  <button class="hint" type="button">{t('Коснитесь палочки Весны, чтобы войти')} <span aria-hidden="true">◇</span></button>
  <small class="caption">{t('Версия 7.1 · Снежная')}</small>
  <div class="flash" aria-hidden="true"></div>
  <div class="burst" aria-hidden="true">
    <svg viewBox="0 0 100 100" focusable="false">
      <defs>
        <linearGradient id="entry-burst-gradient" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff6c8" />
          <stop offset=".5" stop-color="#ffd76a" />
          <stop offset="1" stop-color="#7fe3d3" />
        </linearGradient>
      </defs>
      <g fill="url(#entry-burst-gradient)" stroke="#fff" stroke-width="1.4">
        <path d="M48 47C37 21 20 11 10 22 0 34 20 53 47 53Z" />
        <path d="M52 47C63 21 80 11 90 22 100 34 80 53 53 53Z" />
        <path d="M47 54C20 51 15 64 22 76 29 89 43 77 49 59Z" />
        <path d="M53 54C80 51 85 64 78 76 71 89 57 77 51 59Z" />
      </g>
      <path d="M50 39 57 50 50 63 43 50Z" fill="#efffff" stroke="#ffd76a" stroke-width="1.5" />
    </svg>
  </div>
</div>
<script is:inline>
  (function () {
    var gate = document.getElementById('gf-entry');
    try {
      if (sessionStorage.getItem('gf:entered')) { gate.remove(); return; }
    } catch (e) { gate.remove(); return; }
    var light = gate.querySelector('.light');
    var menu = gate.querySelector('.menu');
    var hint = gate.querySelector('.hint');
    var video = gate.querySelector('video');
    var side = document.getElementById('side');
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var previousOverflow = document.documentElement.style.overflow;
    var entering = false;
    var timer;
    document.body.append(gate);
    gate.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    light.focus({ preventScroll: true });
    video.poster = video.dataset.poster;
    // При сниженной анимации остаётся постер
    if (!reduced) {
      video.querySelectorAll('source').forEach(function (source) { source.src = source.dataset.src; });
      video.preload = 'auto';
      video.load();
      var played = video.play();
      if (played && played.catch) played.catch(function () {});
    }
    var track = [];
    try { track = JSON.parse(gate.dataset.track || '[]'); } catch (e) {}
    var extra = {};
    try { extra = JSON.parse(gate.dataset.butterflies || '{}'); } catch (e) {}
    var targets = [{ el: light, track: track }];
    gate.querySelectorAll('.bfly').forEach(function (el) {
      var item = extra[el.dataset.key];
      if (item) targets.push({ el: el, track: item.track });
    });
    var frame = 0;
    function placeOne(el, points, time) {
      if (!points.length) return;
      var i = 0;
      while (i < points.length - 2 && points[i + 1][0] <= time) i++;
      var a = points[i], b = points[i + 1] || a;
      var k = b[0] > a[0] ? Math.min(1, Math.max(0, (time - a[0]) / (b[0] - a[0]))) : 0;
      el.style.left = (a[1] + (b[1] - a[1]) * k) + '%';
      el.style.top = (a[2] + (b[2] - a[2]) * k) + '%';
    }
    function place(time) {
      targets.forEach(function (target) { placeOne(target.el, target.track, time); });
    }
    function follow() {
      place(video.currentTime || 0);
      frame = requestAnimationFrame(follow);
    }
    place(0);
    if (!reduced) frame = requestAnimationFrame(follow);
    var stopParallax = window.gfParallax ? window.gfParallax(gate.querySelector('.parallax'), 16, 10) : function () {};

    function cleanupGate() {
      clearTimeout(timer);
      cancelAnimationFrame(frame);
      try { sessionStorage.setItem('gf:entered', '1'); } catch (e) {}
      document.removeEventListener('astro:before-swap', cleanupGate);
      document.removeEventListener('keydown', onKeydown, true);
      document.removeEventListener('focusin', keepFocus, true);
      stopParallax();
      // Остановить загрузку видео
      video.pause();
      video.querySelectorAll('source').forEach(function (source) { source.removeAttribute('src'); });
      video.load();
      gate.remove();
      document.documentElement.style.overflow = previousOverflow;
    }
    function finish() {
      cleanupGate();
      var content = document.getElementById('content');
      if (side && side.classList.contains('open')) return; // меню открыли во время вспышки — фокус остаётся в нём
      if (content) {
        content.setAttribute('tabindex', '-1');
        content.focus({ preventScroll: true });
      } else document.body.focus();
    }
    function enter(event) {
      if (entering) return;
      entering = true;
      var origin = event && event.currentTarget && event.currentTarget.classList && event.currentTarget.classList.contains('bfly') ? event.currentTarget : light;
      var rect = origin.getBoundingClientRect();
      gate.style.setProperty('--flash-x', rect.left + rect.width / 2 + 'px');
      gate.style.setProperty('--flash-y', rect.top + rect.height / 2 + 'px');
      if (reduced) {
        gate.classList.add('fade');
        timer = setTimeout(finish, 300);
      } else {
        gate.classList.add('entering');
        timer = setTimeout(function () {
          gate.classList.add('fade');
          timer = setTimeout(finish, 500);
        }, 700);
      }
    }
    function keepFocus(event) {
      if (!entering && !(side && side.classList.contains('open')) && !gate.contains(event.target)) {
        menu.focus({ preventScroll: true });
      }
    }
    function onKeydown(event) {
      // Фокус на палочке ставится сразу; клавиатурный вид включается после нажатия клавиши
      gate.classList.add('kbd');
      if (side && side.classList.contains('open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        enter();
        return;
      }
      if (event.key !== 'Tab') return;
      var controls = [menu, light, hint];
      var first = controls[0], last = controls[controls.length - 1];
      if (event.shiftKey && (document.activeElement === first || !gate.contains(document.activeElement))) {
        event.preventDefault();
        last.focus({ preventScroll: true });
      } else if (!event.shiftKey && (document.activeElement === last || !gate.contains(document.activeElement))) {
        event.preventDefault();
        first.focus({ preventScroll: true });
      }
    }
    menu.addEventListener('click', function () { var burger = document.getElementById('burger'); if (burger) burger.click(); });
    light.addEventListener('click', enter);
    gate.querySelectorAll('.bfly').forEach(function (el) { el.addEventListener('click', enter); });
    hint.addEventListener('click', enter);
    document.addEventListener('keydown', onKeydown, true);
    document.addEventListener('focusin', keepFocus, true);
    document.addEventListener('astro:before-swap', cleanupGate, { once: true });
  })();
</script>
<style>
  /* Фокус содержимого не обводим */
  :global(#content[tabindex="-1"]:focus) { outline: none; }
  #gf-entry { position: fixed; inset: 0; z-index: 54; overflow: hidden; background: #5aa5e6; color: #fff; transition: opacity .5s ease; }
  #gf-entry[hidden] { display: none; }
  #gf-entry.fade { opacity: 0; }
  /* Запас масштаба под параллакс, чтобы не открывались края */
  .parallax { position: absolute; inset: 0; transform: translate3d(var(--px, 0px), var(--py, 0px), 0) scale(1.05); }
  /* Сцена покрывает экран с пропорциями видео; на узких экранах сдвигается так, чтобы палочка (≈25%) была в кадре */
  .scene {
    --scene-w: max(100vw, calc(100vh * 1920 / 1080));
    --scene-h: max(100vh, calc(100vw * 1080 / 1920));
    position: absolute; top: 50%; width: var(--scene-w); height: var(--scene-h); translate: 0 -50%;
    left: clamp(calc(100vw - var(--scene-w)), calc(45vw - var(--scene-w) * .25), 0px);
  }
  .scene video { display: block; width: 100%; height: 100%; object-fit: fill; }
  .light {
    position: absolute; top: 53.13%; left: 25.25%; z-index: 2;
    width: max(64px, calc(var(--scene-h) * .19)); aspect-ratio: 1; translate: -50% -50%;
    border: 0; border-radius: 50%; padding: 0; background: none; cursor: pointer;
  }
  /* Остальные бабочки: прозрачная зона нажатия, при наведении — мягкий свет */
  .bfly {
    position: absolute; z-index: 2; width: max(44px, calc(var(--scene-h) * var(--size))); aspect-ratio: 1; translate: -50% -50%;
    border: 0; border-radius: 50%; padding: 0; background: none; cursor: pointer;
    transition: background-color .3s ease, box-shadow .3s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .bfly:hover { background: radial-gradient(circle, rgb(255 250 220 / .35), transparent 70%); box-shadow: 0 0 0 1.5px rgb(255 240 190 / .7), 0 0 22px rgb(150 240 215 / .6); }
  }
  .light span { position: absolute; border-radius: 50%; pointer-events: none; }
  /* Мягкий свет вокруг навершия — сама палочка в видео */
  .glow { inset: -12%; background: radial-gradient(circle, transparent 40%, rgb(255 236 170 / .35) 58%, rgb(150 240 215 / .22) 68%, transparent 78%); animation: entry-glow 1.8s ease-in-out infinite alternate; transition: filter var(--dur) var(--ease); }
  .bubble { inset: -4%; z-index: 1; border: 1.5px solid rgb(225 255 245 / .75); background: radial-gradient(circle at 50% 55%, rgb(143 240 215 / .06) 0, rgb(143 240 215 / .04) 55%, rgb(190 255 235 / .24) 92%, rgb(255 255 255 / .4) 100%); box-shadow: inset 0 0 12px rgb(170 245 225 / .45), inset -4px -6px 14px rgb(255 220 185 / .18), 0 0 18px rgb(143 240 215 / .35); backdrop-filter: saturate(1.2); opacity: 0; transform: scale(.7); transition: opacity .45s cubic-bezier(.3, 1.6, .5, 1), transform .45s cubic-bezier(.3, 1.6, .5, 1); }
  .bubble::before, .bubble::after { content: ''; position: absolute; border-radius: 50%; background: rgb(255 255 255 / .75); filter: blur(2px); }
  .bubble::before { top: 12%; left: 18%; width: 28%; height: 15%; rotate: -30deg; }
  .bubble::after { right: 16%; bottom: 15%; width: 16%; height: 9%; rotate: -30deg; opacity: .35; }
  .ring { inset: 4%; border: 1.5px solid rgb(255 240 190 / .8); box-shadow: 0 0 14px rgb(150 240 215 / .7); opacity: .5; animation: entry-ring 2.6s ease-out infinite; transition: opacity .3s; }
  .glints { inset: -25%; z-index: 2; mix-blend-mode: screen; background: conic-gradient(transparent 0 11%, rgb(255 250 220 / .55) 12%, transparent 13% 36%, rgb(255 250 220 / .55) 37%, transparent 38% 61%, rgb(255 250 220 / .55) 62%, transparent 63% 86%, rgb(255 250 220 / .55) 87%, transparent 88%); opacity: 0; transition: opacity var(--dur) var(--ease); }
  /* Пульсирующее кольцо вокруг навершия; оно же «вибрирует», зазывая нажать */
  .shake { inset: 0; z-index: 3; border: 2.5px solid rgb(255 214 110 / .95); box-shadow: 0 0 0 1.5px rgb(30 110 100 / .45), 0 0 14px rgb(255 205 90 / .8), 0 0 30px rgb(60 190 170 / .6), inset 0 0 0 1.5px rgb(30 110 100 / .35), inset 0 0 16px rgb(150 240 215 / .5); animation: entry-pulse 1.8s ease-in-out infinite alternate, entry-shake 3.2s 1.2s infinite; transition: transform .35s var(--ease); }
  .kbd .light:focus-visible .bubble { opacity: 1; transform: scale(1); animation: entry-bubble 2.4s .45s ease-in-out infinite; }
  .kbd .light:focus-visible .ring { animation: none; opacity: 0; }
  .kbd .light:focus-visible .shake { animation: entry-pulse 1.8s ease-in-out infinite alternate; transform: scale(1.06); }
  .kbd .light:focus-visible .glow { filter: brightness(1.3); }
  .kbd .light:focus-visible .glints { opacity: .6; }
  /* Наведение только для мыши */
  @media (hover: hover) and (pointer: fine) {
    .light:hover .bubble { opacity: 1; transform: scale(1); animation: entry-bubble 2.4s .45s ease-in-out infinite; }
    .light:hover .ring { animation: none; opacity: 0; }
    .light:hover .shake { animation: entry-pulse 1.8s ease-in-out infinite alternate; transform: scale(1.06); }
    .light:hover .glow { filter: brightness(1.3); }
    .light:hover .glints { opacity: .6; }
  }
  .light:focus { outline: none; }
  .kbd .light:focus-visible { outline: 2px solid #e6fff4; outline-offset: 6px; }
  .panel { position: absolute; top: 1.2rem; left: 2rem; z-index: 3; display: flex; align-items: center; gap: .7rem; pointer-events: none; }
  .panel .menu { pointer-events: auto; }
  .menu { display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 10px; background: rgb(15 50 100 / .35); color: #fff; font: 2rem/1 var(--font); cursor: pointer; }
  .brand { display: flex; align-items: center; gap: .5rem; font: 600 1.15rem var(--font-display); white-space: nowrap; text-shadow: 0 2px 10px #0f3564; }
  .brand svg, .brand b { color: #f3d38a; }
  .brand b { font-weight: 600; }
  .hint { position: absolute; bottom: 2.4rem; left: 50%; z-index: 3; translate: -50% 0; border: 0; padding: .5rem; background: none; color: #fff; font: 500 .9rem var(--font-display); white-space: nowrap; text-shadow: 0 2px 12px #0f3564, 0 0 4px #0f3564; cursor: pointer; opacity: 0; animation: entry-hint .6s 1.2s ease both; }
  .hint span { display: block; margin-top: .3rem; font-size: 1.1rem; animation: entry-chevron 1.4s ease-in-out infinite; }
  .caption { position: absolute; bottom: 1.4rem; left: 2rem; z-index: 3; color: rgb(255 255 255 / .85); text-shadow: 0 2px 10px #0f3564; }
  .menu:focus-visible, .hint:focus-visible { outline: 2px solid #fff6d8; outline-offset: 4px; }
  .flash { position: absolute; inset: 0; z-index: 4; pointer-events: none; opacity: 0; background: radial-gradient(circle at var(--flash-x) var(--flash-y), #ffffff 0, #e9fff6 40%, #bff3e6 70%); }
  .burst { position: absolute; top: var(--flash-y); left: var(--flash-x); z-index: 5; width: 60vmin; aspect-ratio: 1; translate: -50% -50%; pointer-events: none; opacity: 0; }
  .burst svg { display: block; width: 100%; height: 100%; filter: drop-shadow(0 0 18px #e9fff6); }
  .entering .flash { opacity: 1; animation: entry-flash .7s ease-out both; }
  .entering .burst { animation: entry-burst .7s ease-out both; }
  .entering .shake { animation: none; }
  @keyframes entry-pulse { from { opacity: .35; } to { opacity: .85; } }
  @keyframes entry-shake {
    0%, 16%, 100% { transform: none; }
    2% { transform: translate(2px, -1px) rotate(4deg); }
    4% { transform: translate(-2px, 1px) rotate(-4deg); }
    6% { transform: translate(1px, 2px) rotate(3deg); }
    8% { transform: translate(-1px, -2px) rotate(-3deg); }
    10% { transform: translate(2px, 1px) rotate(4deg); }
    12% { transform: translate(-2px, -1px) rotate(-4deg); }
    14% { transform: translate(1px, -1px) rotate(2deg); }
  }
  @keyframes entry-bubble { 50% { scale: 1.03; } }
  @keyframes entry-glow { from { opacity: .5; } to { opacity: 1; } }
  @keyframes entry-ring { from { transform: scale(1); opacity: .5; } to { transform: scale(1.35); opacity: 0; } }
  @keyframes entry-hint { to { opacity: 1; } }
  @keyframes entry-chevron { 50% { opacity: .35; translate: 0 4px; } }
  @keyframes entry-flash { from { clip-path: circle(0 at var(--flash-x) var(--flash-y)); } to { clip-path: circle(150% at var(--flash-x) var(--flash-y)); } }
  @keyframes entry-burst { from { transform: scale(.12); opacity: 1; } to { transform: scale(1); opacity: 0; } }
  @media (max-width: 480px) {
    .panel { top: 1rem; left: 1rem; }
    /* На узком экране оставляем только бургер */
    .panel .brand { display: none; }
    .caption { display: none; }
    /* Подсказка длинная — переносим, а не обрезаем */
    .hint { width: calc(100% - 2rem); white-space: normal; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    @media (hover: hover) and (pointer: fine) {
      .light:hover .bubble { transform: none; animation: none; }
      .light:hover .shake { transform: none; animation: none; }
    }
    #gf-entry { transition-duration: .3s; }
    .glow, .ring, .shake, .hint, .hint span { animation: none; }
    .glow, .glints { transition: none; }
    .bubble { transform: none; transition: opacity .3s ease; }
    .kbd .light:focus-visible .bubble { transform: none; animation: none; }
    .kbd .light:focus-visible .shake { transform: none; animation: none; }
    .hint { opacity: 1; }
    .entering .flash, .entering .burst { display: none; }
  }
</style>
