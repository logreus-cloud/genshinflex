    $<HTMLInputElement>('editor-name').value = draft.nick;
    $<HTMLTextAreaElement>('editor-about').value = draft.about;
    $('about-count').textContent = t('Символов: {n}/300', { n: draft.about.length });
    setAvatarTab(draft.avatar.type);
    renderPersonal(); renderPickers();
    $('replace-profile').hidden = true;
    revokeStaged(urls);
    $('import-status').textContent = t('Импорт будет применён после нажатия «Готово».');
  });
  $('reset-profile').addEventListener('click', () => { $('confirm-reset').hidden = false; });
  $('confirm-reset').addEventListener('click', () => {
    importSelection++;
    for (const key of mediaKeys) mediaOperations[key]++;
    const urls = clearStaged();
    draft = emptyCustom();
    pendingImport = null; confirmedImport = null;
    $('replace-profile').hidden = true;
    $('import-status').textContent = '';
    $<HTMLInputElement>('editor-name').value = '';
    $<HTMLTextAreaElement>('editor-about').value = '';
    $('about-count').textContent = t('Символов: {n}/300', { n: 0 });
    setAvatarTab('none');
    renderPersonal(); renderPickers();
    revokeStaged(urls);
    $('confirm-reset').hidden = true;
  });
  cleanup(signal, () => {
    editorSession++;
    importSelection++;
    for (const key of mediaKeys) mediaOperations[key]++;
    cancelShowcase();
    effect.stop();
    revokeStaged(clearStaged());
    for (const url of committedUrls.values()) URL.revokeObjectURL(url);
    committedUrls.clear();
    if (exportTimer !== undefined) clearTimeout(exportTimer);
    for (const url of exportUrls) URL.revokeObjectURL(url);
    exportUrls.clear();
    document.documentElement.classList.remove('profile-custom-bg');
  });
  });
</script>

<script>
