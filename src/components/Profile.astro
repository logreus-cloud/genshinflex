---
import Layout from '../layouts/Layout.astro';
import AccountStrip from './AccountStrip.astro';
import { useData } from '../lib/data';
import namecards from '../data/generated/namecards.json';

interface Props { mode?: 'own' | 'public' }
const { mode = 'own' } = Astro.props;
const { base, t, characters } = useData(Astro.currentLocale);
const cards = namecards as Record<string, string>;
const charsJson = JSON.stringify(characters.map(({ slug, name, icon, element, rarity }) => ({
  slug, name, icon, element, rarity, namecard: cards[slug] ?? '',
}))).replace(/</g, '\\u003c');
---
<Layout title={t(mode === 'public' ? 'Профиль игрока' : 'Мой профиль')} description={t(mode === 'public' ? 'Публичный профиль игрока на GenshinFlex.' : 'Избранное, персонажи и история круток.')} noindex={mode === 'public'}>
  <div class="profile-root profile-page" data-mode={mode}>
    <div class="profile-bg" id="profile-bg" aria-hidden="true"><div class="profile-bg-image"></div></div>
    <canvas class="profile-effect" id="profile-effect" aria-hidden="true" hidden></canvas>
    {mode === 'own' && <AccountStrip />}
    <section class="profile-card hero">
      <div class="banner" id="profile-banner">
        <img id="profile-cover" alt="" hidden />
        {mode === 'own' && <button class="btn edit-profile" id="edit-profile" type="button" disabled>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m4 13 9-9 3 3-9 9-4 1 1-4ZM11.5 5.5l3 3" /></svg>
          {t('Настроить профиль')}
        </button>}
      </div>
      <div class="hero-content">
        <div class="hero-info">
          <div class="avatar-shell" id="profile-avatar-shell" data-frame="none">
            <div class="avatar" id="profile-avatar"><svg viewBox="0 0 20 20" width="42" height="42" aria-hidden="true"><circle cx="10" cy="7" r="3.2" /><path d="M4 17c0-3.2 2.6-5.2 6-5.2s6 2 6 5.2" /></svg></div>
            <span class="frame-decoration">
              <span class="frame-ring"></span>
            </span>
          </div>
          <div class="identity">
            <div class="name-row">
              <h1 id="profile-name">{t('Путешественник')}</h1>
              <span class="title-chip" id="profile-title" hidden></span>
            </div>
            {mode === 'public' && <p class="muted handle" id="profile-handle" hidden></p>}
            <p id="profile-about" hidden></p>
            <p class="muted" id="profile-meta" hidden></p>
          </div>
        </div>
        {mode === 'own' && <div class="public-actions">
          <a class="btn" id="public-link" hidden>{t('Публичная страница')}</a>
          <button class="btn" id="public-copy" type="button" hidden>{t('Скопировать ссылку')}</button>
          <span class="muted" id="public-hidden-note" hidden>{t('Профиль скрыт')}</span>
        </div>}
        {mode === 'public' && <p class="status" id="public-profile-status" aria-live="polite">{t('Загружаю…')}</p>}
        {mode === 'public' && <a class="btn" id="public-own-link" href={`${base}/profile/`} hidden>{t('Это ваш профиль — настроить')}</a>}
    {mode === 'own' && <>
        <form id="showcase-form">
          <label for="profile-uid">{t('UID')}</label>
          <div class="uid-row">
            <input class="input" id="profile-uid" inputmode="numeric" pattern="[0-9]{9,10}" maxlength="10" autocomplete="off" placeholder="700000000" />
            <button class="btn primary" id="load-showcase" type="submit">{t('Загрузить витрину')}</button>
          </div>
        </form>
        <p class="status small" id="profile-status" aria-live="polite"></p>
        <div class="showcase" id="showcase" hidden>
          <h2>{t('Витрина')}</h2>
          <div class="strip" id="showcase-list"></div>
        </div>
        </>}
      </div>
    </section>
    <section class="profile-card favorite-card" id="profile-favorites" hidden>
      <h2>{t('Любимые персонажи')}</h2>
      <div class="favorite-grid" id="profile-favorites-list"></div>
    </section>
    {mode === 'public' && <>
    <section class="profile-card" id="public-showcase" hidden>
      <h2>{t('Витрина')}</h2>
      <div class="public-uid-row">
        <span id="public-showcase-uid"></span>
        <button class="btn" id="public-uid-copy" type="button">{t('Скопировать UID')}</button>
      </div>
      <p class="muted" id="public-showcase-meta" hidden></p>
      <div class="strip" id="public-showcase-list"></div>
      <p class="small muted" id="public-showcase-status" aria-live="polite"></p>
    </section>
    <div class="profile-grid">
      <section class="profile-card" id="public-favorites" hidden>
        <h2>{t('Избранное')}</h2><div class="tile-grid" id="public-favorites-list"></div>
      </section>
      <section class="profile-card" id="public-roster" hidden>
        <h2>{t('Персонажи')} <small id="public-roster-count"></small></h2><div class="strip" id="public-roster-list"></div>
      </section>
      <section class="profile-card" id="public-wishes" hidden>
        <h2>{t('Крутки')}</h2><div class="wish-list" id="public-wishes-list"></div>
      </section>
    </div>
    </>}
    {mode === 'own' && <>
    <div class="profile-grid">
      <section class="profile-card">
        <h2>{t('Избранное')}</h2>
        <div class="tile-grid" id="favorites-list"></div>
      </section>
      <section class="profile-card">
        <h2>{t('Мои персонажи')} <small id="roster-count"></small></h2>
        <div class="strip" id="roster-list"></div>
        <a class="card-link" href={`${base}/tools/team-check/`}>{t('Изменить в проверке команды')}</a>
      </section>
      <section class="profile-card">
        <h2>{t('Крутки')}</h2>
        <div class="wish-list" id="wishes-list"></div>
        <a class="card-link" href={`${base}/tools/wishes/`}>{t('Открыть трекер круток')}</a>
      </section>
      <section class="profile-card recent-card" hidden>
        <h2>{t('Недавно просмотренное')}</h2>
        <div class="strip" id="recent-list"></div>
      </section>
    </div>
    <noscript><p class="profile-card">{t('Для профиля нужен JavaScript')}</p></noscript>
    <p class="privacy">{t('Без входа данные профиля хранятся только в этом браузере. После входа оформление, избранное, персонажи и UID синхронизируются с аккаунтом.')}</p>

    <dialog class="profile-dialog" id="profile-dialog" aria-labelledby="editor-title">
      <div class="dialog-head">
        <h2 id="editor-title">{t('Настроить профиль')}</h2>
        <button class="close-editor" id="close-editor" type="button" aria-label={t('Закрыть')}>×</button>
      </div>
      <div class="editor-nav" aria-label={t('Разделы профиля')}>
        {[
          ['basic', 'Основное'], ['avatar', 'Аватар и рамка'], ['cover', 'Обложка'],
          ['background', 'Фон и эффекты'], ['color', 'Цвет'], ['favorites', 'Любимые'], ['privacy', 'Приватность'], ['transfer', 'Перенос'],
        ].map(([id, label]) => <button class="editor-nav-button" type="button" data-editor-tab={id} aria-pressed={id === 'basic' ? 'true' : 'false'}>{t(label)}</button>)}
      </div>
      <div class="dialog-body">
        <div class="editor-preview">
          <div class="preview-banner" id="preview-banner"><img id="preview-cover" alt="" hidden /></div>
          <div class="preview-info">
            <div class="avatar-shell preview-shell" id="preview-avatar-shell" data-frame="none">
              <div class="avatar" id="preview-avatar"><svg viewBox="0 0 20 20" width="36" height="36" aria-hidden="true"><circle cx="10" cy="7" r="3.2" /><path d="M4 17c0-3.2 2.6-5.2 6-5.2s6 2 6 5.2" /></svg></div>
              <span class="frame-decoration">
                <span class="frame-ring"></span>
              </span>
            </div>
            <span id="preview-name">{t('Путешественник')}</span>
          </div>
        </div>
        <div class="editor-panel" data-panel="basic">
          <div class="editor-field">
            <label for="editor-name">{t('Ник')}</label>
            <input class="input" id="editor-name" maxlength="24" autocomplete="nickname" />
          </div>
          <div class="editor-field">
            <label for="editor-about">{t('О себе')}</label>
            <textarea class="input" id="editor-about" maxlength="300" rows="4"></textarea>
            <small id="about-count"></small>
          </div>
          <!-- Публичный адрес хранится в аккаунте и меняется сразу, без «Готово» -->
          <div class="editor-field" id="public-field" hidden>
            <label for="public-nick">{t('Адрес профиля')}</label>
            <div class="public-nick-row">
              <span class="public-prefix">genshinflex.com/u/</span>
              <input class="input" id="public-nick" maxlength="24" autocomplete="off" spellcheck="false" pattern="[A-Za-z0-9_\-]{3,24}" />
              <button class="btn" id="public-nick-save" type="button">{t('Сохранить')}</button>
            </div>
            <small class="status" id="public-nick-status" aria-live="polite">{t('3–24 символа: латиница, цифры, _ и -')}</small>
          </div>
          <!-- Титул хранится в аккаунте и меняется сразу, без «Готово» -->
          <div class="editor-field" id="title-field" data-none={t('Без титула')} hidden>
            <label for="profile-title-select">{t('Титул')}</label>
            <select class="input" id="profile-title-select"></select>
            <small id="title-hint">{t('Титулы выдаются за ивенты и участие в жизни сайта.')}</small>
          </div>
        </div>
        <div class="editor-panel" data-panel="avatar" hidden>
          <section class="editor-section">
            <h3>{t('Аватар')}</h3>
            <div class="editor-tabs">
              <button class="btn" id="avatar-character" type="button" aria-pressed="false">{t('Персонаж')}</button>
              <button class="btn" id="avatar-upload" type="button" aria-pressed="false">{t('Своя картинка')}</button>
              <button class="btn" id="avatar-none" type="button" aria-pressed="false">{t('Без аватара')}</button>
            </div>
            <div id="avatar-character-panel">
              <input class="input picker-search" id="avatar-search" type="search" placeholder={t('Поиск персонажа')} aria-label={t('Поиск персонажа')} />
              <div class="choice-grid character-choices" id="avatar-choices"></div>
            </div>
            <div id="avatar-upload-panel" hidden>
              <input id="avatar-file" type="file" accept="image/gif,image/png,image/jpeg,image/webp" aria-label={t('Своя картинка')} />
              <p class="small status" id="avatar-status" aria-live="polite"></p>
              <div class="framing-editor" id="avatar-frame-editor" hidden>
                <strong>{t('Кадр')}</strong>
                <div class="framing-preview avatar-framing" id="avatar-frame-preview" tabindex="0" role="application" aria-label={t('Перетащите картинку, чтобы выбрать видимую часть')}><img id="avatar-frame-image" alt="" /></div>
                <small>{t('Перетащите картинку, чтобы выбрать видимую часть')}</small>
                <label for="avatar-frame-zoom">{t('Масштаб')} <output id="avatar-frame-value">100%</output></label>
                <input id="avatar-frame-zoom" type="range" min="100" max="400" />
                <button class="btn" id="avatar-frame-reset" type="button">{t('Сбросить кадр')}</button>
              </div>
            </div>
          </section>
          <section class="editor-section">
            <h3>{t('Рамка')}</h3>
            <div class="frame-choices" id="frame-choices"></div>
          </section>
        </div>
        <div class="editor-panel" data-panel="cover" hidden>
          <section class="editor-section">
            <h3>{t('Обложка')}</h3>
            <div class="editor-tabs" id="cover-tabs">
              <button class="btn" type="button" data-cover-type="namecard">{t('Намкарта')}</button>
              <button class="btn" type="button" data-cover-type="upload">{t('Своя картинка')}</button>
              <button class="btn" type="button" data-cover-type="none">{t('Без обложки')}</button>
            </div>
            <div id="cover-namecard-panel">
              <input class="input picker-search" id="cover-search" type="search" placeholder={t('Поиск персонажа')} aria-label={t('Поиск обложки')} />
              <div class="choice-grid cover-choices" id="cover-choices"></div>
            </div>
            <div id="cover-upload-panel" hidden>
              <input id="cover-file" type="file" accept="image/gif,image/png,image/jpeg,image/webp" aria-label={t('Своя картинка')} />
              <p class="small status" id="cover-status" aria-live="polite"></p>
              <div class="framing-editor" id="cover-frame-editor" hidden>
                <strong>{t('Кадр')}</strong>
                <div class="framing-preview cover-framing" id="cover-frame-preview" tabindex="0" role="application" aria-label={t('Перетащите картинку, чтобы выбрать видимую часть')}><img id="cover-frame-image" alt="" /></div>
                <small>{t('Перетащите картинку, чтобы выбрать видимую часть')}</small>
                <label for="cover-frame-zoom">{t('Масштаб')} <output id="cover-frame-value">100%</output></label>
                <input id="cover-frame-zoom" type="range" min="100" max="400" />
                <button class="btn" id="cover-frame-reset" type="button">{t('Сбросить кадр')}</button>
              </div>
            </div>
            <div id="cover-position-row">
              <label for="cover-position">{t('Положение обложки')}</label>
              <input id="cover-position" type="range" min="0" max="100" />
            </div>
          </section>
        </div>
        <div class="editor-panel" data-panel="background" hidden>
          <section class="editor-section">
            <h3>{t('Фон страницы')}</h3>
            <div class="editor-tabs" id="background-tabs">
              <button class="btn" type="button" data-background-type="default">{t('Стандартный')}</button>
              <button class="btn" type="button" data-background-type="namecard">{t('Намкарта')}</button>
              <button class="btn" type="button" data-background-type="upload">{t('Своя картинка')}</button>
              <button class="btn" type="button" data-background-type="color">{t('Цвет фона')}</button>
            </div>
            <div id="background-namecard-panel" hidden>
              <input class="input picker-search" id="background-search" type="search" placeholder={t('Поиск персонажа')} aria-label={t('Поиск персонажа')} />
              <div class="choice-grid cover-choices" id="background-choices"></div>
            </div>
            <div id="background-upload-panel" hidden>
              <input id="background-file" type="file" accept="image/gif,image/png,image/jpeg,image/webp" aria-label={t('Своя картинка')} />
              <p class="small status" id="background-status" aria-live="polite"></p>
              <div class="framing-editor" id="background-frame-editor" hidden>
                <strong>{t('Кадр')}</strong>
                <div class="framing-preview background-framing" id="background-frame-preview" tabindex="0" role="application" aria-label={t('Перетащите картинку, чтобы выбрать видимую часть')}><img id="background-frame-image" alt="" /></div>
                <small>{t('Перетащите картинку, чтобы выбрать видимую часть')}</small>
                <label for="background-frame-zoom">{t('Масштаб')} <output id="background-frame-value">100%</output></label>
                <input id="background-frame-zoom" type="range" min="100" max="400" />
                <button class="btn" id="background-frame-reset" type="button">{t('Сбросить кадр')}</button>
              </div>
            </div>
            <label class="check-row" id="background-gradient-row"><input id="background-gradient" type="checkbox" />{t('Градиент')}</label>
            <label for="background-darken">{t('Затемнение')}</label>
            <input id="background-darken" type="range" min="0" max="80" />
            <label for="background-blur">{t('Размытие')}</label>
            <input id="background-blur" type="range" min="0" max="12" />
          </section>
          <section class="editor-section">
            <h3>{t('Эффект')}</h3>
            <div class="effect-choices" id="effect-choices"></div>
            <label for="effect-intensity">{t('Интенсивность')}</label>
            <input id="effect-intensity" type="range" min="25" max="100" />
            <p class="small muted" id="effect-reduced" hidden>{t('Эффекты отключены настройками системы')}</p>
          </section>
        </div>
        <div class="editor-panel" data-panel="color" hidden>
          <section class="editor-section">
            <h3>{t('Цвет профиля')}</h3>
            <div class="color-choices" id="color-choices"></div>
            <div class="hex-row">
              <label for="color-picker">{t('Выбрать цвет')}</label>
              <input id="color-picker" type="color" />
              <label for="color-hex">{t('HEX')}</label>
              <input class="input" id="color-hex" maxlength="7" inputmode="text" />
            </div>
            <p class="small status bad" id="color-status" aria-live="polite"></p>
          </section>
        </div>
        <div class="editor-panel" data-panel="favorites" hidden>
          <section class="editor-section">
            <h3>{t('Любимые персонажи')}</h3>
            <div class="selected-favorites" id="selected-favorites"></div>
            <input class="input picker-search" id="favorite-search" type="search" placeholder={t('Поиск персонажа')} aria-label={t('Поиск персонажа')} />
            <div class="choice-grid character-choices" id="favorite-choices"></div>
          </section>
        </div>
        <div class="editor-panel" data-panel="privacy" hidden>
          <p class="small muted" id="privacy-login-note">{t('Войдите в аккаунт, чтобы настроить приватность.')}</p>
          <div class="editor-field" id="privacy-field" hidden>
            <label class="public-visible"><input id="public-visible" type="checkbox" />{t('Показывать профиль всем по ссылке')}</label>
            <h3>{t('Что видно на публичной странице')}</h3>
            <label class="public-visible"><input type="checkbox" data-privacy="uid" />{t('UID и витрина')}</label>
            <label class="public-visible"><input type="checkbox" data-privacy="roster" />{t('Мои персонажи')}</label>
            <label class="public-visible"><input type="checkbox" data-privacy="favorites" />{t('Избранное')}</label>
            <label class="public-visible"><input type="checkbox" data-privacy="wishes" />{t('Крутки (сводка и последние 5★)')}</label>
            <small class="muted">{t('Оформление, «О себе», титул и любимые персонажи видны всегда, если профиль открыт. Без входа в аккаунт настройки недоступны.')}</small>
            <small class="status" id="privacy-status" aria-live="polite"></small>
          </div>
        </div>
        <div class="editor-panel" data-panel="transfer" hidden>
          <section class="editor-section">
            <h3>{t('Перенос профиля')}</h3>
            <div class="editor-actions">
              <button class="btn" id="export-profile" type="button">{t('Экспорт в файл')}</button>
              <label class="btn file-button" for="import-file">{t('Импорт из файла')}</label>
              <input class="sr-only" id="import-file" type="file" accept=".json,application/json" />
              <button class="btn danger" id="replace-profile" type="button" hidden>{t('Заменить мой профиль')}</button>
            </div>
            <p class="small status" id="import-status" aria-live="polite"></p>
          </section>
          <section class="editor-section">
            <button class="btn" id="reset-profile" type="button">{t('Сбросить оформление')}</button>
            <button class="btn danger" id="confirm-reset" type="button" hidden>{t('Подтвердить сброс оформления')}</button>
          </section>
        </div>
      </div>
      <div class="dialog-foot">
        <button class="btn" id="cancel-editor" type="button">{t('Отмена')}</button>
        <button class="btn primary" id="save-editor" type="button">{t('Готово')}</button>
      </div>
    </dialog>
    </>}
  </div>
  <script type="application/json" id="profile-chars" set:html={charsJson}></script>
</Layout>

<script>
  // Титулы из аккаунта: чип рядом с ником и выбор активного титула. Работает только для вошедших.
  import { onPage } from '../scripts/router';
  import { pageLang } from '../i18n/client';
  import { API_URL } from '../lib/platform';
  import { hasSession, onSessionChange } from '../scripts/user-data/session';

  type Title = { id: string; name_ru: string; name_en: string | null; name_es: string | null; color: string; description: string | null; note?: string | null };
  const colorOk = (value: unknown): value is string => typeof value === 'string' && /^#[0-9a-f]{6}$/i.test(value);

  onPage((signal) => {
    if (document.querySelector('.profile-root[data-mode="public"]')) return;
    const chip = document.getElementById('profile-title');
    const field = document.getElementById('title-field');
    const select = document.getElementById('profile-title-select') as HTMLSelectElement | null;
    if (!chip || !field || !select) return;
    const lang = pageLang();
    const nameOf = (title: Title) => (lang === 'en' ? title.name_en : lang === 'es' ? title.name_es : null) || title.name_ru;
    let owned: Title[] = [];
    let active: string | null = null;
    let token = '';

    const renderChip = () => {
      const title = owned.find((item) => item.id === active);
      chip.hidden = !title;
      chip.replaceChildren();
      if (!title) return;
      chip.style.setProperty('--title-color', colorOk(title.color) ? title.color : '#e3b04b');
      chip.append(Object.assign(document.createElement('span'), { className: 'title-mark', textContent: '◆' }), document.createTextNode(nameOf(title)));
      chip.title = title.description || '';
    };
    const renderSelect = () => {
      select.replaceChildren(new Option(select.dataset.none || '—', ''));
      for (const title of owned) select.append(new Option(nameOf(title), title.id, false, title.id === active));
      select.value = active ?? '';
      select.disabled = !owned.length;
    };

    // Выход из аккаунта или сбой — титулы скрываются
    const reset = () => { owned = []; active = null; token = ''; field.hidden = true; renderChip(); };
    let loadRequest = 0;
    const load = async () => {
      const request = ++loadRequest;
      const current = () => !signal.aborted && request === loadRequest;
      reset();
      if (!hasSession()) return;
      try {
        const { getSupabase } = await import('../scripts/auth');
        if (!current()) return;
        const { data } = await getSupabase().auth.getSession();
        if (!current()) return;
        const accessToken = data.session?.access_token || '';
        if (!accessToken) return;
        const response = await fetch(`${API_URL}/me`, { headers: { Authorization: `Bearer ${accessToken}` }, signal });
        if (!current() || !response.ok) return;
        const me = await response.json() as { titles?: Title[]; active_title?: string | null };
        if (!current()) return;
        token = accessToken;
        owned = Array.isArray(me.titles) ? me.titles.filter((item) => item && typeof item.id === 'string' && typeof item.name_ru === 'string') : [];
        active = typeof me.active_title === 'string' && owned.some((item) => item.id === me.active_title) ? me.active_title : null;
        field.hidden = false;
        renderSelect();
        renderChip();
      } catch { /* Нет сети или API — профиль работает и без титулов */ }
    };

    select.dataset.none = select.dataset.none || document.getElementById('title-field')?.dataset.none || '';
    select.addEventListener('change', async () => {
      const request = loadRequest;
      const accessToken = token;
      if (!accessToken) { select.value = active ?? ''; return; }
      const next = select.value || null;
      const previous = active;
      active = next;
      renderChip();
      select.disabled = true;
      try {
        const response = await fetch(`${API_URL}/me/title`, {
          method: 'POST', signal,
          headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: next }),
        });
        if (!response.ok) throw new Error();
      } catch {
        if (signal.aborted || loadRequest !== request) return;
        active = previous;
        renderChip();
        select.value = active ?? '';
      } finally {
        if (!signal.aborted && loadRequest === request) select.disabled = !owned.length;
      }
    }, { signal });

    void load();
    onSessionChange(() => { void load(); }, { signal });
  });
</script>

<script>
  import { onPage } from '../scripts/router';
  import { initPublicSettings } from '../scripts/profile-public-settings';

  onPage((signal) => {
    if (document.querySelector('.profile-root[data-mode="own"]')) initPublicSettings(signal);
  });
</script>

<script>
  import { favorites, recent, store, type Entry } from '../scripts/common';
  import { t } from '../scripts/search';
  import { getMedia, commitMedia, deleteMedia, prepareImage, dataUrlToBlob, blobToDataUrl, ImageError, type MediaKey } from '../scripts/profile-media';
  import { onPage, cleanup } from '../scripts/router';
  import { syncNow, type SyncResult } from '../scripts/profile-sync';
  import { userData, userDataKey } from '../scripts/user-data';
  import { openWishStore, type Wish, type WishStore } from '../scripts/wish-store';
  import { onSessionChange } from '../scripts/user-data/session';
  import {
    type Avatar, type BackgroundType, type CoverType, type Custom, type Framing, type PickerChar,
    accentHex, applyFraming, colors, colorNames, createEffect, effects, el, emptyCustom, extraColors,
    frameMarks, frames, framingOf, hexOk, iconUrl, img, mediaKeys, readPickerChars,
    fetchShowcase, loadChars, renderAppearance, renderAvatar, renderCover, renderEntryList,
    renderRosterList, renderShowcase, renderWishSummary, safeHref, usesMedia, validCustom, validRoster,
    type Char, type Profile, type RosterEntry, type WishSummary,
  } from '../scripts/profile-view';

  // Избранное по языкам: старые файлы экспорта содержат только ru — остальные языки тогда не трогаем
  type ImportData = { custom: Custom; favs: Partial<Record<'ru' | 'en' | 'es', Entry[]>>; roster: RosterEntry[]; uid: string | null; media: Partial<Record<MediaKey, Blob>> };
  type StagedMedia = { blob: Blob; url: string };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const read = (key: string): unknown => { try { return store.get<unknown>(key, null); } catch { return null; } };
  const isRecord = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
  const uidOk = (value: unknown): value is string => typeof value === 'string' && /^\d{9,10}$/.test(value);

  onPage((signal) => {
  const root = document.querySelector<HTMLElement>('.profile-root');
  if (!root || root.dataset.mode === 'public') return;
  const pickerChars = readPickerChars($('profile-chars'));
  const pickerBySlug = new Map(pickerChars.map((char) => [char.slug, char]));
  const charsById = new Map<number, Char>();
  const charsBySlug = new Map<string, Char>();
  let charsReady = false, currentProfile: Profile | null = null;
  const avatar = $('profile-avatar'), previewAvatar = $('preview-avatar');
  const placeholder = avatar.firstElementChild!.cloneNode(true);
  const dialog = $<HTMLDialogElement>('profile-dialog');
  const editButton = $<HTMLButtonElement>('edit-profile');
  let saved = emptyCustom(), draft = emptyCustom(), avatarTab: Avatar['type'] = 'character';
  const effect = createEffect($<HTMLCanvasElement>('profile-effect'), () => draft, signal);
  const { reduced } = effect;
  reduced.addEventListener('change', () => { $('effect-reduced').hidden = !reduced.matches; }, { signal });
  let pendingImport: ImportData | null = null, confirmedImport: ImportData | null = null, keepChanges = false;
  let editorSession = 0, importSelection = 0, saving = false, exporting = false;
  let sessionGeneration = 0, editorGeneration = 0, customLoad = 0;
  // Снять блокировку элементов редактора текущей операции сохранения (и при успехе, и при смене аккаунта)
  let releaseControls: (() => void) | null = null;
  const exportUrls = new Set<string>();
  let exportTimer: number | undefined;
  const mediaOperations: Record<MediaKey, number> = { avatar: 0, cover: 0, background: 0 };
  const stagedMedia = new Map<MediaKey, StagedMedia>();
  const committedUrls = new Map<MediaKey, string>();
  const stopDragging = new Map<MediaKey, () => void>();
  const status = (message: string, bad = false) => { $('profile-status').textContent = message; $('profile-status').classList.toggle('bad', bad); };
  let showcaseRequest = 0;
  let showcaseController: AbortController | null = null;
  const cancelShowcase = () => { ++showcaseRequest; showcaseController?.abort(); showcaseController = null; $<HTMLButtonElement>('load-showcase').disabled = false; };


  function validEntries(value: unknown) {
    if (!Array.isArray(value)) return null;
    const list: Entry[] = [];
    let valid = true;
    for (const item of value) {
      if (!isRecord(item) || typeof item.href !== 'string' || !safeHref(item.href) || typeof item.name !== 'string' || typeof item.kind !== 'string' ||
        (item.icon !== undefined && item.icon !== null && (typeof item.icon !== 'string' || !iconUrl(item.icon)))) { valid = false; continue; }
      list.push({ href: item.href, name: item.name, kind: item.kind, icon: item.icon as string | null | undefined });
    }
    return { value: list, valid };
  }
  function validCache(value: unknown): Profile | null {
    if (!isRecord(value) || !uidOk(value.uid) || typeof value.time !== 'number' || !isRecord(value.player) || !Array.isArray(value.showcase)) return null;
    const player = value.player;
    if (typeof player.nickname !== 'string' || typeof player.level !== 'number' || typeof player.worldLevel !== 'number' || typeof player.signature !== 'string') return null;
    return { uid: value.uid, time: value.time, player: { nickname: player.nickname, level: player.level, worldLevel: player.worldLevel, signature: player.signature,
      profilePictureId: typeof player.profilePictureId === 'number' ? player.profilePictureId : undefined }, showcase: value.showcase.filter((id): id is number => typeof id === 'number' && Number.isFinite(id)) };
  }
  const mediaSource = (key: MediaKey) => stagedMedia.get(key)?.url ?? committedUrls.get(key) ?? null;
  function renderPersonal() {
    renderAppearance(root, draft, pickerBySlug, mediaSource, draft.nick || currentProfile?.player.nickname || t('Путешественник'), placeholder, effect);
    $('preview-name').textContent = $('profile-name').textContent;
    renderCover($<HTMLImageElement>('preview-cover'), draft, pickerBySlug, mediaSource);
    renderAvatar(previewAvatar, $('preview-avatar-shell'), draft, pickerBySlug, mediaSource, placeholder);
    $('effect-reduced').hidden = !reduced.matches;
    renderFramers();
  }
  function renderProfile() {
    const player = currentProfile?.player;
    const meta = $('profile-meta');
    meta.hidden = !player;
    meta.textContent = player ? t('Ранг приключений {level} · Уровень мира {world}', { level: player.level, world: player.worldLevel }) : '';
    renderPersonal();
    const showcase = $('showcase');
    showcase.hidden = !currentProfile;
    const items = $('showcase-list');
    items.replaceChildren();
    if (currentProfile && charsReady) renderShowcase(items, meta, currentProfile, charsById);
    $('load-showcase').textContent = currentProfile ? t('Обновить') : t('Загрузить витрину');
  }
  function entries(getter: () => Entry[]) {
    let raw: unknown;
    try { raw = getter(); } catch { raw = []; }
    return validEntries(raw)?.value ?? [];
  }
  function renderRoster() {
    const box = $('roster-list');
    box.replaceChildren();
    if (!charsReady) { box.textContent = t('Не удалось загрузить данные персонажей.'); return; }
    // Для показа читаем мягко: validRoster отбрасывает только повреждённые записи, а не весь список
    const raw = read(userDataKey('roster'));
    renderRosterList(box, $('roster-count'), validRoster(raw, pickerBySlug)?.value ?? [], charsBySlug);
  }
  function renderWishes(wishStore: WishStore) {
    const accounts: WishSummary[] = [];
    for (const uid of wishStore.uids()) {
      const list: Wish[] = wishStore.list(uid);
      if (!list.length) continue;
      const pity = { character: 0, weapon: 0, standard: 0 };
      for (const [key, types] of [
        ['character', ['301', '400']], ['weapon', ['302']], ['standard', ['200']],
      ] as [keyof typeof pity, string[]][]) {
        const rows = list.filter((wish) => types.includes(wish.gacha_type));
        for (const wish of rows) pity[key] = wish.rank_type === '5' ? 0 : pity[key] + 1;
      }
      accounts.push({ label: uid === 'manual' ? t('Ручной ввод') : t('UID {uid}', { uid }), total: list.length,
        fives: list.filter((wish) => wish.rank_type === '5').length, pity });
    }
    renderWishSummary($('wishes-list'), accounts);
  }
  function uploadTabOpen(key: MediaKey) {
    return key === 'avatar' ? avatarTab === 'upload' : key === 'cover' ? draft.coverType === 'upload' : draft.background.type === 'upload';
  }
  function renderFramers() {
    const banner = $('profile-banner'), background = $('profile-bg');
    const bannerWidth = banner.clientWidth || banner.parentElement?.clientWidth || root.clientWidth || innerWidth;
    const bannerHeight = banner.clientHeight || (innerWidth <= 700 ? 120 : 180);
    const coverRatio = bannerWidth / bannerHeight;
    $('cover-frame-preview').style.setProperty('--banner-ratio', String(coverRatio));
    $('preview-banner').style.setProperty('--banner-ratio', String(coverRatio));
    const top = parseFloat(getComputedStyle(background).top) || 0;
    const ratio = (background.clientWidth || innerWidth) / (background.clientHeight || Math.max(1, innerHeight - top));
    $('background-frame-preview').style.setProperty('--frame-ratio', String(ratio));
    for (const key of mediaKeys) {
      const src = mediaSource(key);
      const editor = $(`${key}-frame-editor`);
      const image = $<HTMLImageElement>(`${key}-frame-image`);
      editor.hidden = !src || !uploadTabOpen(key);
      if (src) {
        if (image.getAttribute('src') !== src) image.src = src;
        applyFraming(image, framingOf(draft, key));
      } else image.removeAttribute('src');
      const zoom = framingOf(draft, key).zoom;
      $<HTMLInputElement>(`${key}-frame-zoom`).value = String(zoom);
      $(`${key}-frame-value`).textContent = `${zoom}%`;
    }
  }
  function choice(char: PickerChar, selected: boolean, cover = false, focusKey = '') {
    const button = el('button', 'choice');
    button.type = 'button';
    button.title = char.name;
    button.dataset.focusKey = focusKey;
    button.setAttribute('aria-pressed', String(selected));
    const src = iconUrl(cover ? char.namecard : char.icon);
    if (src) button.append(img(src, cover ? 160 : 48));
    button.append(el('span', '', char.name));
    return button;
  }
  function renderPickers() {
    const activeKey = dialog.contains(document.activeElement) ? (document.activeElement as HTMLElement).dataset.focusKey : undefined;
    const avatarBox = $('avatar-choices'), coverBox = $('cover-choices'), favoriteBox = $('favorite-choices'), backgroundBox = $('background-choices');
    avatarBox.replaceChildren(); coverBox.replaceChildren(); favoriteBox.replaceChildren(); backgroundBox.replaceChildren();
    const avatarQuery = $<HTMLInputElement>('avatar-search').value.trim().toLocaleLowerCase();
    const coverQuery = $<HTMLInputElement>('cover-search').value.trim().toLocaleLowerCase();
    const favoriteQuery = $<HTMLInputElement>('favorite-search').value.trim().toLocaleLowerCase();
    const backgroundQuery = $<HTMLInputElement>('background-search').value.trim().toLocaleLowerCase();
    for (const char of pickerChars) {
      const name = char.name.toLocaleLowerCase();
      if (name.includes(avatarQuery)) {
        const button = choice(char, draft.avatar.type === 'character' && draft.avatar.slug === char.slug, false, `avatar:${char.slug}`);
        button.addEventListener('click', () => { mediaOperations.avatar++; draft.avatar = { type: 'character', slug: char.slug }; setAvatarTab('character'); renderPersonal(); renderPickers(); });
        avatarBox.append(button);
      }
      if (char.namecard && name.includes(coverQuery)) {
        const button = choice(char, draft.coverType === 'namecard' && draft.cover === char.slug, true, `cover:${char.slug}`);
        button.addEventListener('click', () => { mediaOperations.cover++; draft.cover = char.slug; draft.coverType = 'namecard'; renderPersonal(); renderPickers(); });
        coverBox.append(button);
      }
      if (char.namecard && name.includes(backgroundQuery)) {
        const button = choice(char, draft.background.type === 'namecard' && draft.background.slug === char.slug, true, `background:${char.slug}`);
        button.addEventListener('click', () => { mediaOperations.background++; draft.background.slug = char.slug; draft.background.type = 'namecard'; renderPersonal(); renderPickers(); });
        backgroundBox.append(button);
      }
      if (name.includes(favoriteQuery)) {
        const button = choice(char, draft.favorites.includes(char.slug), false, `favorite:${char.slug}`);
        button.addEventListener('click', () => {
          const index = draft.favorites.indexOf(char.slug);
          if (index >= 0) draft.favorites.splice(index, 1);
          else if (draft.favorites.length < 6) draft.favorites.push(char.slug);
          renderPersonal(); renderPickers();
        });
        favoriteBox.append(button);
      }
    }
    const selected = $('selected-favorites');
    selected.replaceChildren();
    for (const [index, slug] of draft.favorites.entries()) {
      const row = el('div', 'selected-row');
      row.tabIndex = -1;
      row.dataset.focusKey = `selected:${slug}`;
      row.append(el('span', '', pickerBySlug.get(slug)?.name ?? slug));
      for (const [offset, label] of [[-1, 'Переместить влево'], [1, 'Переместить вправо']] as const) {
        const button = el('button', 'btn', offset < 0 ? '←' : '→');
        button.type = 'button';
        button.title = t(label);
        button.setAttribute('aria-label', t(label));
        button.dataset.focusKey = `move:${slug}:${offset}`;
        button.disabled = index + offset < 0 || index + offset >= draft.favorites.length;
        button.addEventListener('click', () => {
          [draft.favorites[index], draft.favorites[index + offset]] = [draft.favorites[index + offset], draft.favorites[index]];
          renderPersonal(); renderPickers();
        });
        row.append(button);
      }
      selected.append(row);
    }
    const colorBox = $('color-choices');
    colorBox.replaceChildren();
    for (const [index, color] of colors.entries()) addColorChoice(colorBox, color, colorNames[index], `var(--${color})`);
    for (const [key, name, hex] of extraColors) addColorChoice(colorBox, key, name, hex);
    const frameBox = $('frame-choices');
    frameBox.replaceChildren();
    for (const [key, name] of frames) {
      const button = el('button', 'frame-choice');
      button.type = 'button';
      button.setAttribute('aria-pressed', String(draft.frame === key));
      button.dataset.focusKey = `frame:${key}`;
      const shell = el('span', 'avatar-shell preview-shell');
      shell.dataset.frame = key;
      const center = el('span', 'avatar avatar-mini');
      center.append(placeholder.cloneNode(true));
      const decoration = el('span', 'frame-decoration');
      decoration.append(el('span', 'frame-ring'));
      shell.append(center, decoration);
      frameMarks(shell);
      button.append(shell, el('span', '', t(name)));
      button.addEventListener('click', () => { draft.frame = key; renderPersonal(); renderPickers(); });
      frameBox.append(button);
    }
    const effectBox = $('effect-choices');
    effectBox.replaceChildren();
    for (const [key, name] of effects) {
      const button = el('button', 'btn', t(name));
      button.type = 'button';
      button.dataset.focusKey = `effect:${key}`;
      button.setAttribute('aria-pressed', String(draft.effect === key));
      button.addEventListener('click', () => { draft.effect = key; renderPersonal(); renderPickers(); });
      effectBox.append(button);
    }
    syncControls();
    const focusTarget = (key: string) => [...dialog.querySelectorAll<HTMLElement>('[data-focus-key]')].find((node) => node.dataset.focusKey === key && !(node instanceof HTMLButtonElement && node.disabled));
    let target = activeKey ? focusTarget(activeKey) : undefined;
    if (!target && activeKey?.startsWith('move:')) {
      const [, slug, offset] = activeKey.split(':');
      target = focusTarget(`move:${slug}:${offset === '-1' ? 1 : -1}`) ?? focusTarget(`selected:${slug}`) ?? $('favorite-search');
    }
    target?.focus({ preventScroll: true });
  }
  function addColorChoice(box: HTMLElement, color: string, name: string, value: string) {
    const button = el('button', 'color-choice', t(name));
    button.type = 'button';
    button.title = t(name);
    button.dataset.focusKey = `color:${color}`;
    button.setAttribute('aria-pressed', String(draft.color === color));
    button.style.setProperty('--choice-color', value);
    button.addEventListener('click', () => { draft.color = color; $('color-status').textContent = ''; renderPersonal(); renderPickers(); });
    box.append(button);
  }
  function syncControls() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cover-type]')) button.setAttribute('aria-pressed', String(button.dataset.coverType === draft.coverType));
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-background-type]')) button.setAttribute('aria-pressed', String(button.dataset.backgroundType === draft.background.type));
    $('cover-namecard-panel').hidden = draft.coverType !== 'namecard';
    $('cover-upload-panel').hidden = draft.coverType !== 'upload';
    $('background-namecard-panel').hidden = draft.background.type !== 'namecard';
    $('background-upload-panel').hidden = draft.background.type !== 'upload';
    $('cover-position-row').hidden = draft.coverType !== 'namecard';
    $('background-gradient-row').hidden = draft.background.type !== 'color';
    $<HTMLInputElement>('cover-position').value = String(draft.coverPosition);
    $<HTMLInputElement>('background-darken').value = String(draft.background.darken);
    $<HTMLInputElement>('background-blur').value = String(draft.background.blur);
    $<HTMLInputElement>('background-gradient').checked = draft.background.gradient;
    $<HTMLInputElement>('effect-intensity').value = String(draft.intensity);
    $<HTMLInputElement>('color-picker').value = accentHex(draft.color);
    $<HTMLInputElement>('color-hex').value = accentHex(draft.color);
    $('effect-reduced').hidden = !reduced.matches;
  }
  function setAvatarTab(tab: Avatar['type']) {
    avatarTab = tab;
    for (const [kind, id] of [['character', 'avatar-character'], ['upload', 'avatar-upload'], ['none', 'avatar-none']] as const) $(id).setAttribute('aria-pressed', String(kind === tab));
    $('avatar-character-panel').hidden = tab !== 'character';
    $('avatar-upload-panel').hidden = tab !== 'upload';
    renderFramers();
  }
  function setEditorTab(tab: string) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-editor-tab]')) button.setAttribute('aria-pressed', String(button.dataset.editorTab === tab));
    for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) panel.hidden = panel.dataset.panel !== tab;
  }
  function clearStaged() {
    const urls = [...stagedMedia.values()].map((entry) => entry.url);
    stagedMedia.clear();
    return urls;
  }
  function revokeStaged(urls: string[]) {
    for (const url of urls) URL.revokeObjectURL(url);
  }
  function stage(key: MediaKey, blob: Blob) {
    const old = stagedMedia.get(key);
    if (old) URL.revokeObjectURL(old.url);
    stagedMedia.set(key, { blob, url: URL.createObjectURL(blob) });
  }
  function closeEditor() { if (saving) return; for (const stop of stopDragging.values()) stop(); for (const key of mediaKeys) mediaOperations[key]++; importSelection++; editorSession++; dialog.close(); }
  function openEditor() {
    editorGeneration = sessionGeneration;
    editorSession++; for (const key of mediaKeys) mediaOperations[key]++; importSelection++;
    draft = structuredClone(saved);
    revokeStaged(clearStaged());
    keepChanges = false; confirmedImport = null; pendingImport = null;
    $('replace-profile').hidden = true;
    $('confirm-reset').hidden = true;
    for (const id of ['import-status', 'avatar-status', 'cover-status', 'background-status', 'color-status']) $(id).textContent = '';
    for (const id of ['avatar-file', 'cover-file', 'background-file', 'import-file']) $<HTMLInputElement>(id).value = '';
    $<HTMLInputElement>('editor-name').value = draft.nick;
    $<HTMLTextAreaElement>('editor-about').value = draft.about;
    $('about-count').textContent = t('Символов: {n}/300', { n: draft.about.length });
    setAvatarTab(draft.avatar.type);
    setEditorTab('basic');
    renderPickers();
    renderPersonal();
    dialog.showModal();
    $<HTMLInputElement>('editor-name').focus();
  }


  renderEntryList($('favorites-list'), entries(favorites.list), 'Добавляйте персонажей и оружие в избранное кнопкой ☆ на их страницах.');
  renderEntryList($('recent-list'), entries(recent.list), '', true);
  let wishesRequest = 0;
  const loadWishes = async () => {
    const request = ++wishesRequest;
    $('wishes-list').replaceChildren(el('p', 'empty', t('Загружаю…')));
    try {
      const wishStore = await openWishStore(signal);
      if (!signal.aborted && request === wishesRequest) renderWishes(wishStore);
    } catch {
      if (!signal.aborted && request === wishesRequest) $('wishes-list').replaceChildren(el('p', 'empty', t('История круток не загружена')));
    }
  };
  void loadWishes();
  onSessionChange(() => {
    sessionGeneration++;
    cancelShowcase();
    if (dialog.open) { saving = false; releaseControls?.(); closeEditor(); }
    // Оформление прежнего аккаунта нельзя редактировать: перечитываем его, текущая загрузка устаревает
    editButton.disabled = true;
    customLoad++;
    pendingSync.custom = true;
    pendingSync.data = true;
    void refreshSync();
    void loadWishes();
  }, { signal });
  for (const shell of [$('profile-avatar-shell'), $('preview-avatar-shell')]) frameMarks(shell);
  async function initCustom() {
    // Сырое значение: старый формат аватара мигрирует ниже, глубокую проверку делает validCustom
    const storageKey = userDataKey('profileCustom'), generation = sessionGeneration, turn = ++customLoad;
    const active = () => !signal.aborted && turn === customLoad && generation === sessionGeneration;
    // Пока оформление загружается, редактор закрыт: иначе загрузка запишет поверх сохранённых правок
    editButton.disabled = true;
    let raw = read(storageKey);
    if (isRecord(raw) && isRecord(raw.avatar) && raw.avatar.type === 'upload' && typeof raw.avatar.data === 'string') {
      let version = '';
      const stale = new Error();
      try {
        const blob = await dataUrlToBlob(raw.avatar.data, 'avatar');
        if (!active()) throw stale;
        if (!blob) throw new Error();
        version = crypto.randomUUID();
        const committed = await commitMedia({ avatar: blob }, version);
        if (!active()) throw stale;
        if (!committed) throw new Error();
        const migrated = { ...raw, avatar: { type: 'upload' }, media: { ...(isRecord(raw.media) ? raw.media : {}), avatar: version } };
        // Миграция формата, а не правка пользователя — без отметки изменений
        localStorage.setItem(storageKey, JSON.stringify(migrated));
        raw = migrated;
        version = '';
        await deleteMedia('avatar');
      } catch (error) { if (error !== stale && active()) status(t('Не удалось сохранить картинку в этом браузере'), true); }
      finally {
