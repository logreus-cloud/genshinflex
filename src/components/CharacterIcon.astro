---
import { useData, LANGS } from '../lib/data';
const { getCharacter, base, t } = useData(Astro.currentLocale);

interface Props { slug: string; size?: number; label?: boolean; }
const { slug, size = 64, label = true } = Astro.props;
const c = getCharacter(slug);
---
<a class="ci" href={`${base}/characters/${c.slug}`} data-el={c.element} style={`--s:${size}px`} title={c.name}>
  <span class:list={['frame', `r${c.rarity}`, { emblem: c.emblem }]}>
    {c.icon && <img src={c.icon} alt="" width={size} height={size} loading="lazy" />}
    {c.emblem && <img class="skill" src={c.emblem} alt="" width={size / 2} height={size / 2} loading="lazy" />}
    <i class="dot" aria-hidden="true"></i>
    {c.beta && <b class="beta">BETA</b>}
  </span>
  {label && <span class="name">{c.name}</span>}
</a>

<style>
  .ci { display: inline-flex; flex-direction: column; align-items: center; gap: .3rem; text-decoration: none; width: calc(var(--s) + 8px); max-width: 100%; flex: none; min-width: 0; }
  .frame { position: relative; width: min(var(--s), 100%); aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: linear-gradient(160deg, #6c5a8f, #9a7ec9); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .frame.r5 { background: linear-gradient(160deg, #8a5a2b, #d3953e); }
  .frame.emblem { background: linear-gradient(160deg, color-mix(in srgb, var(--el) 55%, #1c2033), color-mix(in srgb, var(--el) 85%, #fff)); }
  .frame .skill { position: absolute; right: 2px; bottom: 2px; width: 32%; height: auto; border-radius: 50%; padding: 2px; background: rgb(15 18 32 / .8); box-shadow: 0 0 0 1.5px var(--el); }
  .frame img:not(.skill) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dot { position: absolute; top: 2px; right: 2px; width: 34%; aspect-ratio: 1; border-radius: 50%; background: var(--el-icon) center / 84% no-repeat, rgb(12 14 24 / .6); }
  .beta { position: absolute; left: 0; right: 0; bottom: 0; background: #e0457b; color: #fff; font-size: max(.5rem, calc(var(--s) * .14)); line-height: 1.3; text-align: center; letter-spacing: .04em; }
  /* Длинные имена («Путешественник (Крио)») переносятся по слогам внутри своей колонки, не налезая на соседей */
  .name {
    width: 100%; font-size: .74rem; text-align: center; line-height: 1.15;
    hyphens: auto; overflow-wrap: anywhere;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }
  .ci:hover .frame { outline: 2px solid var(--accent); outline-offset: 2px; transform: translateY(-2px); box-shadow: 0 6px 16px rgb(0 0 0 / .2); }
</style>
