---
const random = (() => {
  let seed = 0x5eed51a0;
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let n = seed;
    n = Math.imul(n ^ (n >>> 15), n | 1);
    n ^= n + Math.imul(n ^ (n >>> 7), n | 61);
    return ((n ^ (n >>> 14)) >>> 0) / 4294967296;
  };
})();
const between = (min: number, max: number) => min + random() * (max - min);
const f = (value: number) => Number(value.toFixed(1));
const humps: { x: number; width: number; height: number }[] = [];
const lobes: { left: number; width: number; depth: number }[] = [];
let upper = 'M0 55';
let x = 0;
while (x < 1440) {
  // Ровнее: широкие пологие сугробы
  const width = Math.min(Math.round(between(220, 420)), 1440 - x);
  const height = Math.round(between(6, 14));
  const mid = x + width / 2;
  const end = x + width;
  upper += `C${f(x + width * .22)} 55 ${f(x + width * .22)} ${55 - height} ${f(mid)} ${55 - height}`
    + `C${f(x + width * .78)} ${55 - height} ${f(x + width * .78)} 55 ${end} 55`;
  humps.push({ x, width, height });
  x = end;
}
let lower = 'L1440 60';
x = 1440;
while (x > 0) {
  const gap = Math.min(Math.round(between(4, 14)), x);
  x -= gap;
  lower += `L${x} 60`;
  if (x === 0) break;
  const width = Math.min(Math.round(between(120, 260)), x);
  const depth = Math.round(between(6, 18));
  const left = x - width;
  lower += `C${f(x - width * .12)} 60 ${f(x - width * .12)} ${60 + depth} ${f(x - width * .37)} ${60 + depth}`
    + `C${f(x - width * .63)} ${60 + depth} ${f(x - width * .88)} ${60 + depth} ${left} 60`;
  lobes.push({ left, width, depth });
  x = left;
}
const mass = `${upper}${lower}Z`;
const icicles = Array.from({ length: 10 }, (_, i) => {
  const lobe = lobes[Math.floor(i * lobes.length / 10)];
  const x = lobe.left + lobe.width * between(.35, .65);
  const y = 59 + lobe.depth;
  const length = Math.min(Math.round(between(6, 18)), 109 - y);
  const half = between(2.5, 4.5);
  const tip = y + length;
  return {
    shape: `M${f(x - half)} ${y}Q${f(x)} ${f(y - 1)} ${f(x + half)} ${y}L${f(x + .7)} ${f(tip - 2)}Q${f(x)} ${f(tip + .5)} ${f(x - .7)} ${f(tip - 2)}Z`,
    shine: `M${f(x - half + 1)} ${f(y + 1)}L${f(x - .7)} ${f(tip - 2)}`,
  };
});
const sparkles = Array.from({ length: 32 }, (_, i) => {
  const hump = humps[i % humps.length];
  return {
    x: f(hump.x + hump.width * between(.43, .57)),
    y: f(55 - hump.height * between(.2, .75)),
    r: f(between(.8, 1.6)),
    opacity: f(between(.5, .9)),
    duration: f(between(4, 7)),
    delay: f(between(0, 7)),
  };
});
---
<div class="snow-divider" aria-hidden="true">
  <svg viewBox="0 0 1440 110" preserveAspectRatio="none" focusable="false">
    <defs>
      <linearGradient id="snow-fill" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="#f4f8ff" />
        <stop offset=".55" stop-color="#d6e4f5" />
        <stop offset="1" stop-color="#a9bfdc" />
      </linearGradient>
      <linearGradient id="snow-ice" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="rgb(220 236 255 / .95)" />
        <stop offset="1" stop-color="rgb(160 200 240 / .35)" />
      </linearGradient>
    </defs>
    <g class="snow">
      <path d={mass} fill="url(#snow-fill)" />
      {icicles.map((icicle) => <path d={icicle.shape} fill="url(#snow-ice)" />)}
    </g>
    <path d={upper} class="crest" />
    <g class="ice-shine">
      {icicles.map((icicle) => <path d={icicle.shine} />)}
    </g>
    <g class="sparkles">
      {sparkles.map((sparkle, i) => <circle class={i < 4 ? 'twinkle' : undefined} cx={sparkle.x} cy={sparkle.y} r={sparkle.r} opacity={sparkle.opacity} style={`--duration: ${sparkle.duration}s; --delay: -${sparkle.delay}s`} />)}
    </g>
  </svg>
</div>

<style>
  .snow-divider { --footer-bg: #0c0d12; --snow-shadow: rgb(20 40 80 / .35); flex: none; width: 100%; height: 110px; overflow: hidden; pointer-events: none; background: linear-gradient(180deg, transparent 45%, var(--footer-bg) 54%, var(--footer-bg) 100%); }
  svg { display: block; width: 100%; height: 100%; }
  .snow { filter: drop-shadow(0 6px 8px var(--snow-shadow)); }
  .crest { fill: none; stroke: rgb(255 255 255 / .9); stroke-width: 1.5; }
  .ice-shine { fill: none; stroke: rgb(255 255 255 / .7); stroke-width: .8; stroke-linecap: round; }
  .sparkles circle { fill: white; }
  .sparkles .twinkle { animation: snow-twinkle var(--duration) ease-in-out var(--delay) infinite; }
  @keyframes snow-twinkle { 50% { opacity: .2; } }
  :global(:root[data-theme="light"]) .snow-divider { --footer-bg: #2a2f3a; --snow-shadow: rgb(20 40 80 / .18); }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .snow-divider { --footer-bg: #2a2f3a; --snow-shadow: rgb(20 40 80 / .18); }
  }
  @media (max-width: 700px) { .snow-divider { height: 80px; } }
  @media (prefers-reduced-motion: reduce) { .sparkles .twinkle { animation: none; } }
</style>
