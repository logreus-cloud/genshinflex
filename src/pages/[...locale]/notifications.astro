---
import { useData, LANGS } from '../../lib/data';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { t } = useData(Astro.currentLocale);
---
<Layout title={t('Уведомления')} description={t('История ваших уведомлений на сайте.')} noindex>
  <div class="notifications" data-notifications>
    <div class="notifications-head">
      <h1>{t('Уведомления')}</h1>
      <button class="btn" type="button" data-read-all hidden>{t('Прочитать все')}</button>
    </div>
    <p class="status" data-status aria-live="polite"></p>
    <button class="btn" type="button" data-fresh hidden>{t('Есть новые уведомления — показать')}</button>
    <div class="notifications-list" data-list></div>
    <button class="btn" type="button" data-more hidden>{t('Показать ещё')}</button>
  </div>
</Layout>

<script>
  import { onPage } from '../../scripts/router';
  import { initNotifications } from '../../scripts/notifications/page';

  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-notifications]');
    if (root) void initNotifications(root, signal);
  });
</script>

<style>
  .notifications :global([hidden]) { display: none !important; }
  .notifications { display: grid; gap: 1rem; max-width: 760px; }
  .notifications-head { display: flex; align-items: center; justify-content: space-between; gap: .7rem; flex-wrap: wrap; }
  .notifications-head h1 { margin: 0; }
  .notifications-list { display: grid; gap: .7rem; }
  .notifications :global(.notif-row) { display: grid; gap: .5rem; min-width: 0; overflow-wrap: anywhere; }
  .notifications :global(.notif-row.unread) { background: color-mix(in srgb, var(--accent) 10%, transparent); box-shadow: inset 3px 0 0 var(--accent); }
  .notifications :global(.notif-person) { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; min-width: 0; }
  .notifications :global(.notif-row time) { flex: none; }
  .notifications :global(.notif-row p) { margin: 0; }
  .notifications :global(.notif-mark) { justify-self: start; }
  .notifications :global(.forum-author) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .35rem;
    overflow-wrap: anywhere;
  }
  .notifications :global(.forum-avatar) {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
    overflow: hidden;
  }
  .notifications :global(.forum-avatar img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .notifications > [data-fresh], .notifications > [data-more] { justify-self: start; }
</style>
