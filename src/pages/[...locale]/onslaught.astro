---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Discussions from '../../components/Discussions.astro';
import ModeTop from '../../components/ModeTop.astro';
import ModeExtras from '../../components/ModeExtras.astro';
import EndgameGuide from '../../components/EndgameGuide.astro';
import CommunityGuide from '../../components/CommunityGuide.astro';
import { endgameGuide } from '../../lib/community-guides';
import { useData, LANGS } from '../../lib/data';
// Страница режима эндгейма: текущий цикл, баффы, состав и команды
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { t, MODES, lang } = useData(Astro.currentLocale);

const r = (await getCollection('rotations')).find((x) => x.data.mode === 'onslaught')!.data;
const guide = await endgameGuide('onslaught', lang, r.start);
---
<Layout title={t('{mode}: текущий цикл и команды', { mode: MODES.onslaught.title })} description={t('{mode} в Genshin Impact — текущий цикл: враги по боям и сложностям, слабости, команды, советы и видео.', { mode: MODES.onslaught.title })} wide>
  <ModeTop mode="onslaught" start={r.start} end={r.end} tags={r.tags} cycle={r.cycle} draft={r.draft} edit="m=onslaught" />
  {r.note && <p class="notice">{t(r.note)}</p>}
  {r.draft ? (
    !r.note && <p class="notice">{t('Цикл «{c}» ещё не заполнен: нужны враги, баффы и команды.', { c: t(r.cycle) })}</p>
  ) : (
    <>
      <EndgameGuide part="difficulties" difficulties={r.difficulties} />
      <ModeExtras buffs={r.buffs} cast={r.cast} teams={r.teams} teamsTitle={t('Универсальные команды')} sources={[]} />
      <EndgameGuide part="stages" stages={r.stages} />
      <EndgameGuide part="media" videos={r.videos} external={r.external} />
    </>
  )}
  {guide && <CommunityGuide title={t('Советы сообщества')} body={guide.body} authors={guide.data.authors} external={guide.data.external} teams={guide.data.teams} />}
  <Discussions kind="rotation" id={`onslaught-${new Date(r.start).toISOString().slice(0, 10)}`} label={`${MODES.onslaught.title} ${new Date(r.start).toISOString().slice(0, 10)}`} />
  <ModeExtras buffs={[]} teams={[]} sources={r.sources} />
</Layout>
