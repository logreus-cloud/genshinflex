---
import { useData, LANGS } from '../../lib/data';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { base, t } = useData(Astro.currentLocale);
---
<Layout title={t('Гильдии')} description={t('Гильдии игроков GenshinFlex: вступайте и находите единомышленников.')}>
  <div class="guilds" data-guilds>
    <a href={`${base}/forum/`}>{t('Форум')}</a>
    <h1>{t('Гильдии')}</h1>
    <div data-mine></div>
    <p class="status" data-status aria-live="polite"></p>
    <div class="guild-grid" data-list></div>
    <button class="btn" type="button" data-more hidden>{t('Показать ещё')}</button>
    <form class="panel guild-form" data-create hidden>
      <h2>{t('Создать гильдию')}</h2>
      <label>{t('Название')}<input class="input" name="name" minlength="3" maxlength="40" required /></label>
      <label>{t('Тег (2–5 букв или цифр)')}<input class="input" name="tag" minlength="2" maxlength="5" pattern="[A-Za-zА-Яа-яЁё0-9]{2,5}" required /></label>
      <label>{t('Адрес (латиница, цифры и дефис, 3–24 символа)')}<input class="input" name="slug" minlength="3" maxlength="24" pattern="[a-z0-9][a-z0-9\-]{1,22}[a-z0-9]" required /></label>
      <label>{t('Описание')}<textarea class="input" name="description" rows="3" maxlength="500"></textarea></label>
      <p class="small muted">{t('Состоять можно только в одной гильдии. Тег будет виден рядом с вашим именем.')}</p>
      <button class="btn primary" type="submit">{t('Создать')}</button>
      <p class="small status" data-create-status aria-live="polite"></p>
    </form>
  </div>

  <div class="guilds" data-guild hidden>
    <a href={`${base}/guilds/`}>{t('← Все гильдии')}</a>
    <p class="status" data-status aria-live="polite"></p>
    <div data-head></div>
    <div class="guild-actions" data-actions></div>
    <h2>{t('Участники')}</h2>
    <ul class="guild-members" data-members></ul>
    <button class="btn" type="button" data-members-more hidden>{t('Показать ещё')}</button>
  </div>
</Layout>

<script>
  import { onPage } from '../../scripts/router';
  import { initGuildList, initGuildPage } from '../../scripts/guilds/page';

  onPage((signal) => {
    const list = document.querySelector<HTMLElement>('[data-guilds]');
    const page = document.querySelector<HTMLElement>('[data-guild]');
    const slug = new URLSearchParams(location.search).get('g');
    const valid = slug && /^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]$/.test(slug) ? slug : null;
    if (list) list.hidden = !!valid;
    if (page) page.hidden = !valid;
    if (valid && page) void initGuildPage(page, valid, signal);
    else if (list) void initGuildList(list, signal);
  });
</script>

<style>
  .guilds { display: grid; gap: .9rem; max-width: 820px; }
  .guilds[hidden], .guilds :global([hidden]) { display: none !important; }
  .guild-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .7rem; }
  .guilds :global(.guild-card) { display: grid; gap: .3rem; color: var(--text); text-decoration: none; min-width: 0; overflow-wrap: anywhere; }
  .guilds :global(.guild-card p) { margin: 0; color: var(--muted); font-size: .9rem; }
  .guild-form { display: grid; gap: .6rem; }
  .guild-form label { display: grid; gap: .3rem; }
  .guild-actions { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .guild-members { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .guilds :global(.guild-member) { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .8rem; min-width: 0; overflow-wrap: anywhere; }
  .guilds :global(.guild-description) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .guilds :global(.forum-author) { display: flex; align-items: center; flex-wrap: wrap; gap: .35rem; min-width: 0; }
  .guilds :global(.forum-avatar) { display: inline-grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: 50%; background: var(--accent-soft); color: var(--accent-text); overflow: hidden; }
  .guilds :global(.forum-avatar img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
