  .uid select { width: auto; }
  .empty { text-align: center; padding: 2.4rem 1rem; }
  .empty h2 { margin: 0 0 .4rem; }

  .banners { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 12px; }
  .banners :global(.bcard header) { display: flex; justify-content: space-between; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: .8rem; }
  .banners :global(.bcard h3) { margin: 0; }
  .banners :global(.pity) { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; }
