---
import Layout from '../../../layouts/Layout.astro';
import { useData, LANGS, characters as ruCharacters } from '../../../lib/data';
// Каждая страница существует в трёх языках: / (ru), /en/, /es/
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { t } = useData(Astro.currentLocale);

// Стандартный пул 5★: выпадение такого персонажа на баннере события — проигранные 50/50
// История хранится с русскими именами (так её отдаёт игра на наш запрос), поэтому пул — тоже по-русски
const STANDARD = ['qiqi', 'mona', 'jean', 'diluc', 'dehya', 'keqing', 'tighnari', 'yumemizuki-mizuki'].map((s) => {
  const c = ruCharacters.find((x) => x.slug === s)!;
  return [c.name, c.nameEn];
}).flat();
const script = await import('../../../../public/wish-url.ps1?raw').then((m) => m.default as string);
---
<Layout title={t('Трекер круток')} description={t('Счётчик гаранта, история молитв и статистика 50/50 в Genshin Impact. Данные хранятся только в вашем браузере.')}>
  <h1>{t('Трекер круток')}</h1>
  <p class="lead">
    {t('Считает, сколько молитв осталось до гаранта, выиграны ли 50/50 и сколько примогемов ушло на каждого 5★. История хранится только в вашем браузере — на сервер она не отправляется.')}
  </p>

  <div class="wt" data-standard={JSON.stringify(STANDARD)}>
    <section class="panel import">
      <div class="itabs" role="tablist" aria-label={t('Способ импорта')}>
        <button type="button" role="tab" aria-selected="true" data-itab="link">{t('По ссылке из игры')}</button>
        <button type="button" role="tab" aria-selected="false" data-itab="file">{t('Из файла')}</button>
        <button type="button" role="tab" aria-selected="false" data-itab="manual">{t('Вручную')}</button>
      </div>

      <div data-ipanel="link">
        <ol class="steps">
          <li>{t('Откройте игру на ПК и зайдите в «Молитва» → «История».')}</li>
          <li>{t('Откройте PowerShell (Win + X → «Терминал») и выполните команду — она найдёт ссылку в кэше игры и скопирует её:')}
            <div class="cmd"><code id="ps-cmd">iex (irm "https://…/wish-url.ps1")</code><button class="btn" type="button" id="copy-cmd">{t('Скопировать')}</button></div>
            <details><summary class="small">{t('Что делает скрипт')}</summary><pre class="script">{script}</pre></details>
          </li>
          <li>{t('Вставьте ссылку сюда. Она действует сутки и даёт доступ только к истории молитв.')}</li>
        </ol>
        <div class="row">
          <input class="input grow" id="wish-url" placeholder="https://gs.hoyoverse.com/genshin/event/e20190909gacha-v3/index.html?authkey=…" autocomplete="off" />
          <button class="btn primary" type="button" id="import-link">{t('Загрузить историю')}</button>
        </div>
      </div>

      <div data-ipanel="file" hidden>
        <p>{t('Файл в формате')} <b>UIGF</b> {t('(версии 3 и 4) — его выгружают paimon.moe, Starward, SnapHutao и другие трекеры. Новые записи добавятся к уже загруженным без дублей.')}</p>
        <input type="file" id="uigf-file" accept=".json,application/json" />
      </div>

      <div data-ipanel="manual" hidden>
        <p class="muted small">{t('Пригодится для консоли и телефона, где ссылку не достать. Добавляйте молитвы в том порядке, в каком они выпадали.')}</p>
        <div class="manual">
          <label>{t('Баннер')}<select class="input" id="m-banner">
            <option value="301">{t('Событие персонажа')}</option><option value="302">{t('Оружие')}</option><option value="200">{t('Стандартный')}</option><option value="500">{t('Хроники')}</option>
          </select></label>
          <label>{t('Сколько молитв без 4★ и 5★')}<input class="input" id="m-count" type="number" min="1" max="90" value="10" /></label>
          <button class="btn" type="button" id="m-add-filler">{t('Добавить')}</button>
          <label class="grow">{t('4★ или 5★ предмет')}<input class="input" id="m-item" list="m-items" placeholder={t('Имя персонажа или оружия')} /></label>
          <button class="btn" type="button" id="m-add-item">{t('Добавить')}</button>
          <datalist id="m-items"></datalist>
        </div>
      </div>

      <p class="status small" id="status" aria-live="polite"></p>
    </section>

    <section class="toolbar">
      <label class="uid">{t('Аккаунт')} <select class="input" id="uid-select"></select></label>
      <button class="btn" type="button" id="export">{t('Скачать UIGF')}</button>
      <button class="btn" type="button" id="wipe">{t('Удалить историю аккаунта')}</button>
    </section>

    <div class="empty panel" id="empty">
      <h2>{t('Пока пусто')}</h2>
      <p class="muted">{t('Загрузите историю по ссылке из игры или файлом — счётчики гаранта появятся здесь.')}</p>
    </div>

    <div class="banners" id="banners"></div>

    <section id="history-wrap" hidden>
      <h2 class="h-sec">{t('История')} <small><label><input type="checkbox" id="only-rare" checked /> {t('только 4★ и 5★')}</label></small></h2>
      <div class="panel table-wrap"><table><thead><tr><th>{t('Время')}</th><th>{t('Предмет')}</th><th>{t('Баннер')}</th><th>{t('Гарант')}</th></tr></thead><tbody id="history"></tbody></table></div>
    </section>
  </div>
</Layout>

<script>
  import { store } from '../../../scripts/common';
  import { BASE, t, LANG } from '../../../scripts/search';

  type Wish = { id: string; uid: string; gacha_type: string; time: string; name: string; item_type: string; rank_type: string; item_id?: string };
  type Idx = { characters: { id: number | null; s: string; n: string; i: string | null; r: number }[]; weapons: { id: number; s: string; n: string; i: string | null; r: number }[] };

  const root = document.querySelector<HTMLElement>('.wt')!;
  const STANDARD = new Set<string>(JSON.parse(root.dataset.standard!));
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = (t: string, bad = false) => { const s = $('status'); s.textContent = t; s.classList.toggle('bad', bad); };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // Баннеры: 400 — второй баннер события, у него общий гарант с 301
  const GROUPS = [
    { key: 'char', title: t('Событие персонажа'), types: ['301', '400'], pity: 90, soft: 74, fiftyFifty: true },
    { key: 'weapon', title: t('Оружие'), types: ['302'], pity: 80, soft: 63, fiftyFifty: false },
    { key: 'standard', title: t('Стандартный'), types: ['200'], pity: 90, soft: 74, fiftyFifty: false },
    { key: 'chronicled', title: t('Хроники'), types: ['500'], pity: 90, soft: 74, fiftyFifty: false },
  ];
  const TYPE_NAME: Record<string, string> = { '301': t('Событие'), '400': t('Событие 2'), '302': t('Оружие'), '200': t('Стандарт'), '500': t('Хроники'), '100': t('Новичка') };

  const idx: Idx = await fetch(`${BASE}/data/checker.json`).then((r) => r.json());
  const byName = new Map<string, { i: string | null; kind: 'c' | 'w'; s: string; r?: number }>();
  const byId = new Map<string, { n: string; kind: 'c' | 'w'; r?: number }>();
  // История хранится с русскими именами — для показа переводим через слаг
  const ruIdx: Idx = LANG === 'ru' ? idx : await fetch('/data/checker.json').then((r) => r.json());
  const ruNameBySlug = new Map([...ruIdx.characters, ...ruIdx.weapons].map((x) => [x.s, x.n]));
  const slugByRuName = new Map([...ruIdx.characters, ...ruIdx.weapons].map((x) => [x.n.toLowerCase(), x.s]));
  const bySlug = new Map<string, { n: string; i: string | null; kind: 'c' | 'w' }>([
    ...idx.characters.map((c) => [c.s, { n: c.n, i: c.i, kind: 'c' as const }] as const),
    ...idx.weapons.map((w) => [w.s, { n: w.n, i: w.i, kind: 'w' as const }] as const),
  ]);
  const shown = (ruName: string) => { const s = slugByRuName.get(ruName.toLowerCase()); return s ? { ...bySlug.get(s)!, s } : undefined; };
  for (const c of idx.characters) byName.set(c.n.toLowerCase(), { i: c.i, kind: 'c', s: c.s, r: c.r });
  for (const w of idx.weapons) byName.set(w.n.toLowerCase(), { i: w.i, kind: 'w', s: w.s, r: w.r });
  for (const c of ruIdx.characters) if (c.id) byId.set(String(c.id), { n: c.n, kind: 'c', r: c.r });
  for (const w of ruIdx.weapons) byId.set(String(w.id), { n: w.n, kind: 'w', r: w.r });
  $('m-items').innerHTML = [...idx.characters.map((c) => c.n), ...idx.weapons.filter((w) => w.r >= 4).map((w) => w.n)].map((n) => `<option value="${esc(n)}">`).join('');

  // Хранилище: по аккаунту, записи отсортированы по id (в игре id растут со временем)
  const load = (uid: string) => store.get<Wish[]>(`gf:wishes:${uid}`, []);
  const save = (uid: string, list: Wish[]) => {
    store.set(`gf:wishes:${uid}`, list);
    store.set('gf:wish-uids', [...new Set([...store.get<string[]>('gf:wish-uids', []), uid])]);
  };
  const cmpId = (a: Wish, b: Wish) => (a.id.length - b.id.length) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
  function merge(uid: string, incoming: Wish[]) {
    const map = new Map(load(uid).map((w) => [w.id, w]));
    let added = 0;
    for (const w of incoming) if (!map.has(w.id)) { map.set(w.id, { ...w, uid }); added++; }
    save(uid, [...map.values()].sort(cmpId));
    return added;
  }
  let uid = store.get<string>('gf:wish-uid', '') || store.get<string[]>('gf:wish-uids', [])[0] || '';

  // ---------- Импорт по ссылке ----------
  $('ps-cmd').textContent = `iex (irm "${location.origin}/wish-url.ps1")`;
  $('copy-cmd').addEventListener('click', () => navigator.clipboard?.writeText($('ps-cmd').textContent!).then(() => status(t('Команда скопирована.'))));

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  $('import-link').addEventListener('click', async () => {
    const raw = $<HTMLInputElement>('wish-url').value.trim();
    let params: URLSearchParams;
    try { params = new URL(raw).searchParams; } catch { return status(t('Это не похоже на ссылку. Скопируйте её скриптом ещё раз.'), true); }
    if (!params.get('authkey')) return status(t('В ссылке нет authkey. Откройте историю молитв в игре и запустите скрипт снова.'), true);
    const btn = $<HTMLButtonElement>('import-link');
    btn.disabled = true;
    try {
      let total = 0;
      let foundUid = '';
      for (const type of ['301', '302', '200', '500', '100']) {
        let endId = '0';
        const known = new Set(foundUid ? load(foundUid).map((w) => w.id) : []);
        const got: Wish[] = [];
        for (let page = 1; ; page++) {
          status(t('Загружаю «{type}», страница {page}…', { type: TYPE_NAME[type], page }));
          const q = new URLSearchParams({ authkey: params.get('authkey')!, authkey_ver: params.get('authkey_ver') ?? '1', sign_type: params.get('sign_type') ?? '2',
            lang: 'ru', gacha_type: type, page: String(page), end_id: endId, game_biz: params.get('game_biz') ?? 'hk4e_global', region: params.get('region') ?? '' });
          const res = await fetch(`/api/gacha?${q}`);
          const body = await res.json().catch(() => null);
          if (!body) throw new Error(t('Сервер не ответил. Попробуйте ещё раз через минуту.'));
          if (body.retcode === -110) { await sleep(1500); page--; continue; }
          if (body.retcode === -101) throw new Error(t('Ссылка устарела (живёт сутки). Откройте историю в игре и получите новую.'));
          if (body.retcode !== 0) throw new Error(t(body.error ?? body.message ?? 'Не удалось загрузить историю.'));
          const list: Wish[] = body.data?.list ?? [];
          if (!list.length) break;
          foundUid ||= list[0].uid;
          const fresh = list.filter((w) => !known.has(w.id));
          got.push(...fresh);
          if (fresh.length < list.length) break; // дошли до уже сохранённых
          endId = list.at(-1)!.id;
          await sleep(350);
        }
        if (foundUid && got.length) total += merge(foundUid, got);
      }
      if (!foundUid) return status(t('История пуста: на этом аккаунте ещё не было молитв за последние 6 месяцев.'));
      uid = foundUid; store.set('gf:wish-uid', uid);
      status(t('Готово: добавлено {n} новых молитв.', { n: total }));
      render();
    } catch (e) {
      status((e as Error).message, true);
    } finally { btn.disabled = false; }
  });

  // ---------- UIGF ----------
  $<HTMLInputElement>('uigf-file').addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      const accounts: { uid: string; list: Partial<Wish>[] }[] = data.hk4e
        ? data.hk4e.map((a: { uid: string | number; list: Partial<Wish>[] }) => ({ uid: String(a.uid), list: a.list }))
        : [{ uid: String(data.info?.uid ?? ''), list: data.list ?? [] }];
      let total = 0;
      for (const a of accounts) {
        if (!a.uid || !Array.isArray(a.list)) continue;
        const list = a.list.map((w) => {
          const known = w.item_id ? byId.get(String(w.item_id)) : undefined;
          return {
            id: String(w.id), uid: a.uid, gacha_type: String(w.gacha_type), time: String(w.time ?? ''),
            name: w.name ?? known?.n ?? '?', item_type: w.item_type ?? (known?.kind === 'c' ? 'Персонаж' : 'Оружие'),
            rank_type: String(w.rank_type ?? known?.r ?? 3), item_id: w.item_id ? String(w.item_id) : undefined,
          } as Wish;
        }).filter((w) => w.id !== 'undefined');
        total += merge(a.uid, list);
        uid = a.uid;
      }
      store.set('gf:wish-uid', uid);
      status(t('Файл загружен: добавлено {n} новых молитв.', { n: total }));
      render();
    } catch {
      status(t('Не получилось прочитать файл. Нужен JSON в формате UIGF.'), true);
    }
  });
  $('export').addEventListener('click', () => {
    if (!uid) return;
    const list = load(uid);
    const out = {
      info: { export_timestamp: Math.floor(Date.now() / 1000), export_app: 'GenshinFlex', export_app_version: '1.0', version: 'v4.0' },
      hk4e: [{ uid, timezone: 8, lang: 'ru-ru', list: list.map((w) => ({ ...w, uigf_gacha_type: w.gacha_type === '400' ? '301' : w.gacha_type, count: '1' })) }],
    };
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([JSON.stringify(out, null, 1)], { type: 'application/json' }));
    a.download = `genshinflex-wishes-${uid}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // Удаление — в два нажатия, без системных диалогов
  let wipeArmed = false;
  $('wipe').addEventListener('click', () => {
    if (!uid) return;
    if (!wipeArmed) { wipeArmed = true; $('wipe').textContent = t('Точно удалить? Нажмите ещё раз'); setTimeout(() => { wipeArmed = false; $('wipe').textContent = t('Удалить историю аккаунта'); }, 4000); return; }
    store.set(`gf:wishes:${uid}`, []);
    store.set('gf:wish-uids', store.get<string[]>('gf:wish-uids', []).filter((u) => u !== uid));
    uid = store.get<string[]>('gf:wish-uids', [])[0] ?? '';
    wipeArmed = false; $('wipe').textContent = t('Удалить историю аккаунта');
    status(t('История аккаунта удалена из браузера.'));
    render();
  });

  // ---------- Ручной ввод ----------
  const manualUid = () => { if (!uid) { uid = 'manual'; store.set('gf:wish-uid', uid); } return uid; };
  let seq = 0;
  const mk = (type: string, name: string, item_type: string, rank: string): Wish => ({
    id: `9${Date.now()}${String(seq++).padStart(4, '0')}`, uid: manualUid(), gacha_type: type,
    time: new Date().toISOString().slice(0, 19).replace('T', ' '), name, item_type, rank_type: rank,
  });
  $('m-add-filler').addEventListener('click', () => {
    const n = Math.max(1, Math.min(90, Number($<HTMLInputElement>('m-count').value) || 0));
    const type = $<HTMLSelectElement>('m-banner').value;
    merge(manualUid(), Array.from({ length: n }, () => mk(type, 'Оружие 3★', 'Оружие', '3')));
    status(t('Добавлено молитв: {n}.', { n })); render();
  });
  $('m-add-item').addEventListener('click', () => {
    const name = $<HTMLInputElement>('m-item').value.trim();
    const hit = byName.get(name.toLowerCase());
    if (!hit) return status(t('Не нашёл такой предмет — выберите из подсказок.'), true);
    const rank = String(hit.r ?? 4);
    merge(manualUid(), [mk($<HTMLSelectElement>('m-banner').value, ruNameBySlug.get(hit.s) ?? name, hit.kind === 'c' ? 'Персонаж' : 'Оружие', rank)]);
    $<HTMLInputElement>('m-item').value = '';
    status(t('Добавлено: {name}.', { name })); render();
  });

  // ---------- Подсчёт ----------
  type Five = { name: string; pity: number; outcome: 'win' | 'lose' | 'guar' | null; time: string };
  function analyse(list: Wish[], g: typeof GROUPS[number]) {
    const ws = list.filter((w) => g.types.includes(w.gacha_type));
    let p5 = 0, p4 = 0, guaranteed = false;
    const fives: Five[] = [];
    const outcomes = new Map<string, Five['outcome']>();
    for (const w of ws) {
      p5++; p4++;
      if (w.rank_type === '5') {
        let outcome: Five['outcome'] = null;
        if (g.fiftyFifty) {
          const lost = w.item_type === 'Персонаж' && STANDARD.has(w.name);
          outcome = lost ? 'lose' : guaranteed ? 'guar' : 'win';
          guaranteed = lost;
        }
        fives.push({ name: w.name, pity: p5, outcome, time: w.time });
        outcomes.set(w.id, outcome);
        p5 = 0; p4 = 0;
      } else if (w.rank_type === '4') p4 = 0;
    }
    const wins = fives.filter((f) => f.outcome === 'win').length, losses = fives.filter((f) => f.outcome === 'lose').length;
    return {
      total: ws.length, p5, p4, guaranteed, fives, outcomes,
      avg: fives.length ? Math.round(fives.reduce((s, f) => s + f.pity, 0) / fives.length) : null,
      rate: wins + losses ? Math.round((wins / (wins + losses)) * 100) : null,
    };
  }

  const icon = (name: string) => shown(name)?.i;
  const hrefOf = (name: string) => { const h = shown(name); return h ? `${BASE}/${h.kind === 'c' ? 'characters' : 'weapons'}/${h.s}` : null; };
  const label = (name: string) => shown(name)?.n ?? t(name);
  const OUT: Record<string, string> = { win: t('выиграл 50/50'), lose: t('проиграл 50/50'), guar: t('по гаранту') };

  function render() {
    const uids = store.get<string[]>('gf:wish-uids', []);
    const sel = $<HTMLSelectElement>('uid-select');
    sel.innerHTML = uids.map((u) => `<option value="${u}" ${u === uid ? 'selected' : ''}>${u === 'manual' ? t('Ручной ввод') : `UID ${u}`}</option>`).join('');
    const list = uid ? load(uid) : [];
    $('empty').hidden = list.length > 0;
    document.querySelector<HTMLElement>('.toolbar')!.hidden = !uids.length;
    $('history-wrap').hidden = !list.length;
    if (!list.length) { $('banners').innerHTML = ''; return; }

    const all = new Map<string, Five['outcome']>();
    $('banners').innerHTML = GROUPS.map((g) => {
      const a = analyse(list, g);
      a.outcomes.forEach((v, k) => all.set(k, v));
      if (!a.total) return '';
      const pct = Math.min(100, (a.p5 / g.pity) * 100);
      return `<article class="bcard panel">
        <header><h3>${g.title}</h3>${g.fiftyFifty ? `<span class="chip ${a.guaranteed ? 'gold' : ''}">${a.guaranteed ? t('Следующий 5★ — гарант') : t('Следующий 5★ — 50/50')}</span>` : ''}</header>
        <div class="pity">
          <div class="pnum"><b>${a.p5}</b><span class="muted">/ ${g.pity}</span></div>
          <div><span class="small muted">${t('до гаранта 5★: {n}', { n: g.pity - a.p5 })}</span>
            <div class="bar" role="img" aria-label="${t('Гарант {a} из {b}', { a: a.p5, b: g.pity })}"><i style="width:${pct}%"></i><em style="left:${(g.soft / g.pity) * 100}%" title="${t('Мягкий гарант с {n}-й молитвы', { n: g.soft })}"></em></div>
            <span class="small muted">4★: ${a.p4} / 10${a.p5 >= g.soft ? ` · <b class="soft">${t('шанс 5★ уже повышен')}</b>` : ''}</span></div>
        </div>
        <dl class="kv">
          <div><dt>${t('Молитв')}</dt><dd>${a.total}</dd></div>
          <div><dt>${t('Примогемов')}</dt><dd>${(a.total * 160).toLocaleString(document.documentElement.lang)}</dd></div>
          <div><dt>${t('Средний 5★')}</dt><dd>${a.avg ?? '—'}</dd></div>
          ${g.fiftyFifty ? `<div><dt>${t('Выиграно 50/50')}</dt><dd>${a.rate === null ? '—' : a.rate + '%'}</dd></div>` : ''}
        </dl>
        ${a.fives.length ? `<ul class="fives">${a.fives.slice().reverse().map((f) => {
          const i = icon(f.name), h = hrefOf(f.name);
          const tag = h ? 'a' : 'span';
          return `<li class="${f.outcome ?? ''}" title="${esc(label(f.name))}: ${t('{n} молитв', { n: f.pity })}${f.outcome ? ', ' + OUT[f.outcome] : ''}"><${tag} ${h ? `href="${h}"` : ''}>${i ? `<img src="${i}" alt="" width="44" height="44" loading="lazy">` : ''}<b>${f.pity}</b></${tag}><span class="sr-only">${esc(label(f.name))}, ${f.pity}${f.outcome ? ', ' + OUT[f.outcome] : ''}</span></li>`;
        }).join('')}</ul>` : `<p class="muted small">${t('5★ на этом баннере ещё не было.')}</p>`}
      </article>`;
    }).join('');

    const onlyRare = $<HTMLInputElement>('only-rare').checked;
    $('history').innerHTML = list.slice().reverse().filter((w) => !onlyRare || w.rank_type !== '3').slice(0, 200).map((w) => {
      const i = icon(w.name);
      const o = all.get(w.id);
      return `<tr class="r${w.rank_type}"><td class="muted">${esc(w.time)}</td><td><span class="it">${i ? `<img src="${i}" alt="" width="28" height="28" loading="lazy">` : ''}${esc(label(w.name))}</span></td>
        <td class="muted">${TYPE_NAME[w.gacha_type] ?? w.gacha_type}</td><td class="muted">${o ? OUT[o] : ''}</td></tr>`;
    }).join('');
  }

  // Вкладки импорта
  const itabs = [...document.querySelectorAll<HTMLButtonElement>('[data-itab]')];
  itabs.forEach((t) => t.addEventListener('click', () => {
    itabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    document.querySelectorAll<HTMLElement>('[data-ipanel]').forEach((p) => (p.hidden = p.dataset.ipanel !== t.dataset.itab));
  }));
  $<HTMLSelectElement>('uid-select').addEventListener('change', (e) => { uid = (e.target as HTMLSelectElement).value; store.set('gf:wish-uid', uid); render(); });
  $('only-rare').addEventListener('change', render);
  render();
</script>

