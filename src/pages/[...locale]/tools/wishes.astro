  .banners :global(.kv div) { background: var(--surface-2); border-radius: var(--radius-sm); padding: .4rem .5rem; }
  .banners :global(.kv dt) { font-size: .72rem; color: var(--muted); }
  .banners :global(.kv dd) { margin: 0; font-weight: 600; }
  .banners :global(.fives) { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .banners :global(.fives li > a), .banners :global(.fives li > span:not(.sr-only)) { position: relative; display: block; text-decoration: none; }
  .banners :global(.fives img) { border-radius: 10px; background: linear-gradient(170deg, #6b4520, #d1953f); display: block; border: 2px solid transparent; }
  .banners :global(.fives .lose img) { border-color: var(--bad); }
  .banners :global(.fives .win img) { border-color: var(--good); }
  .banners :global(.fives b) { position: absolute; right: -4px; bottom: -4px; font-size: .72rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 0 .3rem; }
  .table-wrap { overflow-x: auto; padding: .4rem .6rem; }
  #history :global(.it) { display: inline-flex; align-items: center; gap: .5rem; }
