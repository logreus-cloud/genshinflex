---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { useData, LANGS } from '../../../lib/data';
// Каждая страница существует в трёх языках: / (ru), /en/, /es/
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { fmtDate, t, base } = useData(Astro.currentLocale);

const abyss = (await getCollection('rotations')).find((r) => r.data.mode === 'abyss')?.data;
---
<Layout title={t('Проверка команды для Бездны')} description={t('Добавьте своих персонажей с их билдами и узнайте, хватит ли команды на текущую Витую бездну.')} wide>
  <h1>{t('Проверка команды для Бездны')}</h1>
  <p class="lead">
    {t('Добавьте своих персонажей — вручную или по UID из игры, — соберите по команде на каждую половину и узнайте, потянут ли они текущую Бездну.')}
    {abyss && t('Текущий цикл — до {date}.', { date: fmtDate(abyss.end) })}
    {t('Оценка сравнивает ваш билд с рекомендованным и проверяет требования этажа; это ориентир, а не симуляция урона.')}
  </p>
  <p class="abyss-context">{t('Требования и рекомендации — для 12-го этажа текущей Бездны.')} <a href={`${base}/abyss/`}>{t('Враги и команды всех этажей')}</a></p>

  <div class="tc">
    <section class="panel roster-panel">
      <div class="panel-head"><h2 class="h-sec">{t('Мои персонажи')} <small id="roster-count"></small></h2><button class="btn small danger" type="button" id="clear-roster" hidden>{t('Очистить список')}</button></div>
      <div class="add">
        <label class="grow">{t('Добавить вручную')}<input class="input" id="add-char" placeholder={t('Имя персонажа')} /></label>
        <label>{t('Или по UID')}<span class="uidrow"><input class="input" id="uid" inputmode="numeric" placeholder="700000000" maxlength="10" /><button class="btn" type="button" id="load-uid">{t('Загрузить')}</button></span></label>
      </div>
      <p class="muted small hint">{t('Для загрузки по UID в игре нужно выставить персонажей на витрину профиля и включить «Показывать подробности».')}</p>
      <button class="btn" type="button" id="open-picker" aria-expanded="false" aria-controls="picker">{t('Выбрать из всех персонажей')}</button>
      <div class="picker" id="picker" hidden>
        <input class="input" id="picker-search" type="search" placeholder={t('Поиск по имени')} aria-label={t('Поиск по имени')} />
        <div class="picker-filters" id="picker-filters"></div>
        <p class="muted small" id="picker-count"></p>
        <div class="picker-grid" id="picker-grid"></div>
      </div>
      <p class="status small" id="status" aria-live="polite"></p>
      <div class="roster" id="roster"></div>
    </section>

    <section class="panel editor-panel" id="editor" hidden></section>

    <section class="teams">
      {[1, 2].map((h) => (
        <div class="panel team" data-half={h}>
          <div class="panel-head"><h2 class="h-sec">{t('{n}-я половина', { n: h })}</h2><button class="btn small" type="button" data-clear-half={h} hidden>{t('Очистить')}</button></div>
          <p class="muted small need" data-need={h}></p>
          <div class="slots" data-slots={h}></div>
          <div class="recommend" data-recommend={h}></div>
        </div>
      ))}
    </section>

    <div class="actions">
      <button class="btn primary big" type="button" id="check">{t('Проверить команды')}</button>
      <button class="btn" type="button" id="autofill">{t('Подобрать из моих персонажей')}</button>
      <button class="btn" type="button" id="reset-teams">{t('Сбросить составы')}</button>
    </div>

    <section id="result" aria-live="polite"></section>
  </div>
</Layout>

<script>
  import { store } from '../../../scripts/common';
  import { BASE, t, LANG } from '../../../scripts/search';
  import { combobox, norm } from '../../../scripts/combobox';

  // ---------- Данные ----------
  type Build = { role: string; healer: boolean; cls: 'dps' | 'sub' | 'support'; weapons: string[]; sets: string[][]; main: Record<'sands' | 'goblet' | 'circlet', string[]>; subs: string[] };
  type Char = { id: number | null; s: string; n: string; el: string; w: string; r: number; i: string; base: Record<string, [number, number, number]>; build?: Build };
  type Weapon = { id: number; s: string; n: string; w: string; r: number; i: string; atk: number };
  type Half = { half: number; label: string; need: string[][]; tip: string; teams: { name?: string; members: string[] }[] };
  type Data = { characters: Char[]; weapons: Weapon[]; artifacts: { id: number; s: string; n: string; i: string }[]; abyss?: { cycle: string; halves: Half[] } };

  type Stats = { hp: number; atk: number; def: number; em: number; cr: number; cd: number; er: number; dmg: number };
  type Entry = {
    key: string; s: string; level: number; cons: number; talents: [number, number, number];
    weapon: string; refine: number; set1: string; set1pc: 4 | 2; set2: string;
    sands: string; goblet: string; circlet: string; stats: Partial<Stats>;
  };

  const data: Data = await fetch(`${BASE}/data/checker.json`).then((r) => r.json());
  const chars = new Map(data.characters.map((c) => [c.s, c]));
  const normName = (s: string) => typeof norm === 'function' ? norm(s) : s.toLowerCase().replace(/ё/g, 'е').trim();
  const byName = new Map(data.characters.map((c) => [normName(c.n), c.s]));
  const weapons = new Map(data.weapons.map((w) => [w.s, w]));
  const arts = new Map(data.artifacts.map((a) => [a.s, a]));
  const halves = data.abyss?.halves ?? [];
  const EL: Record<string, string> = LANG === 'ru' ? { pyro: 'Пиро', hydro: 'Гидро', anemo: 'Анемо', electro: 'Электро', dendro: 'Дендро', cryo: 'Крио', geo: 'Гео' }
    : { pyro: 'Pyro', hydro: 'Hydro', anemo: 'Anemo', electro: 'Electro', dendro: 'Dendro', cryo: 'Cryo', geo: 'Geo' };
  const STAT_OPTS: Record<'sands' | 'goblet' | 'circlet', [string, string][]> = {
    sands: [['atk%', t('Сила атаки %')], ['hp%', 'HP %'], ['def%', t('Защита %')], ['em', t('Мастерство стихий')], ['er', t('Восст. энергии')]],
    goblet: [['dmg', t('Бонус урона стихии')], ['phys', t('Бонус физ. урона')], ['atk%', t('Сила атаки %')], ['hp%', 'HP %'], ['def%', t('Защита %')], ['em', t('Мастерство стихий')]],
    circlet: [['cr', t('Шанс крит. попадания')], ['cd', t('Крит. урон')], ['heal', t('Бонус лечения')], ['atk%', t('Сила атаки %')], ['hp%', 'HP %'], ['def%', t('Защита %')], ['em', t('Мастерство стихий')]],
  };
  const STAT_FIELDS: [keyof Stats, string, string][] = [
    ['hp', 'HP', ''], ['atk', t('Атака'), ''], ['def', t('Защита'), ''], ['em', t('Мастерство стихий'), ''],
    ['cr', t('Шанс крита'), '%'], ['cd', t('Крит. урон'), '%'], ['er', t('Восст. энергии'), '%'], ['dmg', t('Бонус урона'), '%'],
  ];
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = (t: string, bad = false) => { const s = $('status'); s.textContent = t; s.classList.toggle('bad', bad); };

  // ---------- Состояние: ростер и составы живут в браузере ----------
  // Сохранённые данные могут быть старыми или повреждёнными.
  const rawRoster: unknown = store.get('gf:roster', []);
  const rawTeams: unknown = store.get('gf:abyss-teams', { 1: [], 2: [] });
  const validInt = (v: unknown, min: number, max: number, fallback: number) => typeof v === 'number' && Number.isFinite(v) ? Math.max(min, Math.min(max, Math.trunc(v))) : fallback;
  const validSetCount = (v: unknown): 4 | 2 => v === 2 ? 2 : 4;
  const validStat = (v: unknown, key: keyof Stats) => typeof v === 'number' && Number.isFinite(v) ? Math.max(0, Math.min(['cr', 'cd', 'er', 'dmg'].includes(key) ? 1000 : Infinity, v)) : undefined;
  const validKey = (v: unknown) => typeof v === 'string' && /^[a-z0-9-]{1,80}$/.test(v);
  const validSlug = (v: unknown, known: Map<string, unknown>) => typeof v === 'string' && known.has(v) ? v : '';
  const validSlot = (v: unknown, slot: 'sands' | 'goblet' | 'circlet') => v === '' || typeof v === 'string' && STAT_OPTS[slot].some(([key]) => key === v) ? v : STAT_OPTS[slot][0][0];
  const keyMap = new Map<string, string>();
  const seenChars = new Set<string>();
  const seenKeys = new Set<string>();
  let roster: Entry[] = [];
  for (const value of Array.isArray(rawRoster) ? rawRoster : []) {
    if (!value || typeof value !== 'object' || typeof value.s !== 'string' || !chars.has(value.s)) continue;
    if (seenChars.has(value.s)) {
      if (validKey(value.key) && !keyMap.has(value.key)) keyMap.set(value.key, roster.find((e) => e.s === value.s)!.key);
      continue;
    }
    seenChars.add(value.s);
    let key = validKey(value.key) && !seenKeys.has(value.key) ? value.key : fromBuild(value.s).key;
    for (let i = 1; seenKeys.has(key); i++) key = `${value.s}-${Date.now().toString(36)}-${i.toString(36)}`;
    seenKeys.add(key);
    if (validKey(value.key) && !keyMap.has(value.key)) keyMap.set(value.key, key);
    const stats: Partial<Stats> = {};
    if (value.stats && typeof value.stats === 'object') for (const [name, number] of Object.entries(value.stats)) {
      const stat = validStat(number, name as keyof Stats);
      if (STAT_FIELDS.some(([field]) => field === name) && stat !== undefined) stats[name as keyof Stats] = stat;
    }
    roster.push({
      key, s: value.s, level: validInt(value.level, 1, 100, 90), cons: validInt(value.cons, 0, 6, 0),
      talents: [0, 1, 2].map((i) => validInt(value.talents?.[i], 1, 15, 9)) as [number, number, number],
      weapon: weapons.get(value.weapon)?.w === chars.get(value.s)!.w ? value.weapon : '', refine: validInt(value.refine, 1, 5, 1),
      set1: validSlug(value.set1, arts), set1pc: validSetCount(value.set1pc), set2: validSlug(value.set2, arts),
      sands: validSlot(value.sands, 'sands'), goblet: validSlot(value.goblet, 'goblet'), circlet: validSlot(value.circlet, 'circlet'), stats,
    });
  }
  const sourceTeams = rawTeams && typeof rawTeams === 'object' ? rawTeams as Record<number, unknown> : {};
  const usedKeys = new Set<string>();
  let teams: Record<number, string[]> = { 1: [], 2: [] };
  for (const half of [1, 2]) {
    const source = sourceTeams[half];
    for (const oldKey of Array.isArray(source) ? source : []) {
      if (!validKey(oldKey)) continue;
      const key = keyMap.get(oldKey) ?? oldKey;
      if (!seenKeys.has(key) || usedKeys.has(key)) continue;
      teams[half].push(key); usedKeys.add(key);
      if (teams[half].length === 4) break;
    }
  }
  let editing: string | null = null;
  let checked = false;
  let importGen = 0;
  const persist = () => { store.set('gf:roster', roster); store.set('gf:abyss-teams', teams); if (checked) renderResult(false); };

  // Новый персонаж получает рекомендованный билд как отправную точку
  function fromBuild(s: string): Entry {
    const b = chars.get(s)!.build;
    const pick = (slot: 'sands' | 'goblet' | 'circlet') => {
      const k = b?.main[slot][0];
      if (k === 'crit') return 'cr';
      return STAT_OPTS[slot].some(([o]) => o === k) ? k! : STAT_OPTS[slot][0][0];
    };
    const sets = b?.sets[0] ?? [];
    return {
      key: `${s}-${Date.now().toString(36)}`, s, level: 90, cons: 0, talents: [9, 9, 9],
      weapon: b?.weapons[0] ?? '', refine: 1, set1: sets[0] ?? '', set1pc: sets.length > 1 ? 2 : 4, set2: sets[1] ?? '',
      sands: pick('sands'), goblet: pick('goblet'), circlet: pick('circlet'), stats: {},
    };
  }

  // ---------- Импорт по UID (enka.network через наш прокси) ----------
  const PROP: Record<string, string> = {
    FIGHT_PROP_HP_PERCENT: 'hp%', FIGHT_PROP_ATTACK_PERCENT: 'atk%', FIGHT_PROP_DEFENSE_PERCENT: 'def%', FIGHT_PROP_ELEMENT_MASTERY: 'em',
    FIGHT_PROP_CHARGE_EFFICIENCY: 'er', FIGHT_PROP_CRITICAL: 'cr', FIGHT_PROP_CRITICAL_HURT: 'cd', FIGHT_PROP_HEAL_ADD: 'heal',
    FIGHT_PROP_PHYSICAL_ADD_HURT: 'phys', FIGHT_PROP_FIRE_ADD_HURT: 'dmg', FIGHT_PROP_ELEC_ADD_HURT: 'dmg', FIGHT_PROP_WATER_ADD_HURT: 'dmg',
    FIGHT_PROP_GRASS_ADD_HURT: 'dmg', FIGHT_PROP_WIND_ADD_HURT: 'dmg', FIGHT_PROP_ROCK_ADD_HURT: 'dmg', FIGHT_PROP_ICE_ADD_HURT: 'dmg',
  };
  const ELEM_BONUS: Record<string, string> = { pyro: '40', electro: '41', hydro: '42', dendro: '43', anemo: '44', geo: '45', cryo: '46' };
  const charById = new Map(data.characters.filter((c) => c.id).map((c) => [c.id!, c]));
  const weaponById = new Map(data.weapons.map((w) => [w.id, w]));
  const setById = new Map(data.artifacts.map((a) => [a.id, a]));

  $('load-uid').addEventListener('click', async () => {
    const gen = ++importGen;
    const uid = $<HTMLInputElement>('uid').value.trim();
    if (!/^\d{9,10}$/.test(uid)) return status(t('UID — это 9 или 10 цифр из правого нижнего угла экрана в игре.'), true);
    status(t('Загружаю витрину…'));
    try {
      const res = await fetch(`/api/enka/${uid}`);
      if (gen !== importGen) return;
      const body = await res.json();
      if (gen !== importGen) return;
      if (!res.ok) return status(t(body.error ?? 'Не удалось загрузить профиль.'), true);
      const list: any[] = body.avatarInfoList ?? [];
      if (!list.length) return status(t('На витрине нет персонажей или скрыты подробности. Включите «Показывать подробности» в профиле игры.'), true);
      let added = 0, skipped: string[] = [];
      for (const a of list) {
        const c = charById.get(a.avatarId);
        if (!c) { skipped.push(a.avatarId === 10000005 || a.avatarId === 10000007 ? t('Путешественник') : String(a.avatarId)); continue; }
        const e = fromBuild(c.s);
        // Обновление витрины сохраняет выбранные составы и открытый редактор.
        const existing = roster.find((x) => x.s === c.s);
        if (existing) e.key = existing.key;
        e.level = Number(a.propMap?.['4001']?.val ?? 90);
        e.cons = (a.talentIdList ?? []).length;
        const f = a.fightPropMap ?? {};
        e.stats = {
          hp: Math.round(f['2000'] ?? 0), atk: Math.round(f['2001'] ?? 0), def: Math.round(f['2002'] ?? 0), em: Math.round(f['28'] ?? 0),
          cr: +(100 * (f['20'] ?? 0)).toFixed(1), cd: +(100 * (f['22'] ?? 0)).toFixed(1), er: +(100 * (f['23'] ?? 0)).toFixed(1),
          dmg: +(100 * (f[ELEM_BONUS[c.el]] ?? 0)).toFixed(1),
        };
        e.weapon = '';
        e.sands = e.goblet = e.circlet = '';
        e.refine = 1;
        const sets = new Map<string, number>();
        for (const item of a.equipList ?? []) {
          if (item.weapon) {
            const w = weaponById.get(item.itemId);
            if (w) {
              e.weapon = w.s;
              e.refine = 1 + Number(Object.values(item.weapon.affixMap ?? { x: 0 })[0] ?? 0);
            }
          } else if (item.reliquary) {
            const setId = Number(String(item.flat?.icon ?? '').match(/UI_RelicIcon_(\d+)_/)?.[1]);
            const set = setById.get(setId);
            if (set) sets.set(set.s, (sets.get(set.s) ?? 0) + 1);
            const main = PROP[item.flat?.reliquaryMainstat?.mainPropId];
            const slot = ({ EQUIP_SHOES: 'sands', EQUIP_RING: 'goblet', EQUIP_DRESS: 'circlet' } as const)[item.flat?.equipType as string];
            if (slot && main) (e as any)[slot] = main;
          }
        }
        const counted = [...sets.entries()].sort((x, y) => y[1] - x[1]);
        e.set1 = (counted[0]?.[1] ?? 0) >= 2 ? counted[0][0] : ''; e.set1pc = (counted[0]?.[1] ?? 0) >= 4 ? 4 : 2;
        e.set2 = e.set1pc === 2 && (counted[1]?.[1] ?? 0) >= 2 ? counted[1][0] : '';
        const sl = a.skillLevelMap ? Object.values(a.skillLevelMap).map(Number) : [];
        if (sl.length >= 3) e.talents = [sl[0], sl[1], sl.at(-1)!] as [number, number, number];
        roster = [e, ...roster.filter((x) => x.s !== c.s)];
        added++;
      }
      persist(); openEditor(editing); renderTeams();
      status(t('Загружено персонажей: {n}.', { n: added }) + (skipped.length ? ' ' + t('Пропущены: {list} — добавьте вручную.', { list: skipped.join(', ') }) : ''));
    } catch {
      if (gen !== importGen) return;
      status(t('Не удалось связаться с сервером. Проверьте интернет и попробуйте ещё раз.'), true);
    }
  });

  const addChar = (s: string) => {
    const input = $<HTMLInputElement>('add-char');
    const existing = roster.find((entry) => entry.s === s);
    if (existing) {
      input.value = '';
      openEditor(existing.key);
      const message = '{name} уже в списке — открыл его билд';
      status(t(message, { name: chars.get(s)!.n }));
      return;
    }
    const e = fromBuild(s);
    roster = [e, ...roster];
    input.value = '';
    persist(); renderRoster(); openEditor(e.key); renderTeams();
    status(t('{name} добавлен с рекомендованным билдом — поправьте его под свой.', { name: chars.get(s)!.n }));
  };
  typeof combobox === 'function' && combobox($<HTMLInputElement>('add-char'), () => data.characters.map((c) => ({
    value: c.s, label: c.n, icon: c.i, el: c.el, hint: '★'.repeat(c.r) + ' · ' + EL[c.el],
  })), (item) => addChar(item.value));
  $<HTMLInputElement>('add-char').addEventListener('change', (ev) => {
    const s = byName.get(normName((ev.target as HTMLInputElement).value));
    if (s) addChar(s);
  });

  // ---------- Ростер и редактор ----------
  const normalizeName = (name: string) => name.toLocaleLowerCase().replace(/ё/g, 'е');
  let pickerElement = '';
  const renderPicker = () => {
    const search = $<HTMLInputElement>('picker-search');
    const focused = document.activeElement as HTMLElement | null;
    const pick = focused?.closest<HTMLElement>('[data-pick]')?.dataset.pick;
    const filter = focused?.closest<HTMLElement>('[data-filter-el]')?.dataset.filterEl;
    const searchFocused = focused === search;
    const selection = searchFocused && typeof search.selectionStart === 'number' ? [search.selectionStart, search.selectionEnd ?? search.selectionStart] : null;
    const value = search.value;
    const query = normalizeName(value.trim());
    $('picker-count').textContent = t('Выбрано: {n}', { n: roster.length });
    $('picker-filters').innerHTML = Object.entries(EL).map(([el, name]) =>
      `<button class="btn small" type="button" data-filter-el="${esc(el)}" data-el="${esc(el)}" aria-pressed="${pickerElement === el}"><span class="el-dot"></span>${esc(name)}</button>`
    ).join('');
    $('picker-grid').innerHTML = [...data.characters]
      .filter((c) => (!pickerElement || c.el === pickerElement) && normalizeName(c.n).includes(query))
      .sort((a, b) => b.r - a.r || a.n.localeCompare(b.n, LANG))
      .map((c) => `<button type="button" class="pick" data-pick="${esc(c.s)}" data-el="${esc(c.el)}" aria-pressed="${roster.some((e) => e.s === c.s)}">
        <img src="${esc(c.i)}" alt="" width="56" height="56" loading="lazy"><span title="${esc(c.n)}">${esc(c.n)}</span></button>`).join('');
    search.value = value;
    const grid = $('picker-grid');
    const filters = $('picker-filters');
    const next = pick && typeof grid.querySelectorAll === 'function' ? [...grid.querySelectorAll<HTMLElement>('[data-pick]')].find((node) => node.dataset.pick === pick)
      : filter && typeof filters.querySelectorAll === 'function' ? [...filters.querySelectorAll<HTMLElement>('[data-filter-el]')].find((node) => node.dataset.filterEl === filter) : null;
    if (next && typeof next.focus === 'function') next.focus();
    else if (searchFocused) {
      if (typeof search.focus === 'function') search.focus();
      if (selection && typeof search.setSelectionRange === 'function') search.setSelectionRange(selection[0], selection[1]);
    }
  };
  function renderRoster() {
    $('roster-count').textContent = roster.length ? String(roster.length) : '';
    $('clear-roster').hidden = !roster.length;
    $('roster').innerHTML = roster.length ? roster.map((e) => {
      const c = chars.get(e.s)!;
      const filled = Object.values(e.stats).some((v) => v);
      return `<div class="rchip" data-el="${esc(c.el)}">
        <button type="button" class="rchip-edit" data-edit="${esc(e.key)}" aria-pressed="${editing === e.key}" title="${esc(t('Редактировать'))}">
          <img src="${esc(c.i)}" alt="" width="40" height="40" loading="lazy"><span><b>${esc(c.n)}</b><small>${esc(t('ур.'))} ${e.level} · C${e.cons}${filled ? '' : ' · ' + esc(t('без статов'))}</small></span></button>
        <span class="rchip-halves">
          ${[1, 2].map((h) => `<button type="button" class="btn small" data-to-half="${h}" data-key="${esc(e.key)}" aria-pressed="${teams[h]?.includes(e.key) ?? false}" title="${esc(t(h === 1 ? 'В 1-ю половину' : 'Во 2-ю половину'))}">${h}</button>`).join('')}
        </span></div>`;
    }).join('') : `<p class="muted small">${t('Пока никого. Добавьте персонажа по имени или загрузите витрину по UID.')}</p>`;
    renderPicker();
  }

  $('open-picker').addEventListener('click', () => {
    const picker = $('picker');
    picker.hidden = !picker.hidden;
    $('open-picker').textContent = picker.hidden ? t('Выбрать из всех персонажей') : t('Скрыть список');
    $('open-picker').setAttribute('aria-expanded', String(!picker.hidden));
  });
  $<HTMLInputElement>('picker-search').addEventListener('input', renderPicker);
  let clearArmed = false;
  let clearTimer: ReturnType<typeof setTimeout> | undefined;
  $('clear-roster').addEventListener('click', () => {
    if (!roster.length) return;
    if (!clearArmed) {
      clearArmed = true;
      $('clear-roster').textContent = t('Точно очистить? Нажмите ещё раз');
      clearTimer = setTimeout(() => {
        clearArmed = false;
        $('clear-roster').textContent = t('Очистить список');
      }, 4000);
      return;
    }
    clearTimeout(clearTimer);
    clearArmed = false;
    $('clear-roster').textContent = t('Очистить список');
    ++importGen;
    roster = []; teams = { 1: [], 2: [] };
    checked = false;
    $('result').innerHTML = '';
    openEditor(null);
    persist(); renderTeams();
    status(t('Список персонажей очищен.'));
  });

  const opt = (list: [string, string][], v: string) => list.map(([k, l]) => `<option value="${k}" ${k === v ? 'selected' : ''}>${esc(l)}</option>`).join('');
  function openEditor(key: string | null) {
    editing = key;
    const box = $('editor');
    const e = roster.find((x) => x.key === key);
    if (!e) { box.hidden = true; renderRoster(); return; }
    const c = chars.get(e.s)!;
    const ws = data.weapons.filter((w) => w.w === c.w).map((w) => [w.s, `${w.n} ${'★'.repeat(w.r)}`] as [string, string]);
    const sets = [['', '—'] as [string, string], ...data.artifacts.map((a) => [a.s, a.n] as [string, string])];
    box.hidden = false;
    box.innerHTML = `
      <div class="ed-head"><img src="${c.i}" alt="" width="56" height="56"><div><h2>${esc(c.n)}</h2>
        <span class="muted small">${c.build ? esc(c.build.role) : t('Нет рекомендованного билда — проверка будет общей')}</span></div>
        <button class="btn" type="button" data-close>${t('Готово')}</button></div>
      <div class="ed-grid">
        <fieldset><legend>${t('Персонаж')}</legend>
          <label>${t('Уровень')}<input class="input" type="number" min="1" max="100" data-f="level" value="${e.level}"></label>
          <label>${t('Созвездие')}<select class="input" data-f="cons">${opt([0, 1, 2, 3, 4, 5, 6].map((k) => [String(k), `C${k}`]), String(e.cons))}</select></label>
          <label>${t('Таланты (атака / навык / взрыв)')}<span class="tri">${e.talents.map((level, i) => `<input class="input" type="number" min="1" max="15" data-t="${i}" value="${level}" aria-label="${t('Уровень таланта {n}', { n: i + 1 })}">`).join('')}</span></label>
        </fieldset>
        <fieldset><legend>${t('Оружие')}</legend>
          <label>${t('Оружие')}<select class="input" data-f="weapon"><option value="">—</option>${opt(ws, e.weapon)}</select></label>
          <label>${t('Пробуждение')}<select class="input" data-f="refine">${opt([1, 2, 3, 4, 5].map((r) => [String(r), `R${r}`]), String(e.refine))}</select></label>
        </fieldset>
        <fieldset><legend>${t('Артефакты')}</legend>
          <label>${t('Сет')}<select class="input" data-f="set1">${opt(sets, e.set1)}</select></label>
          <label>${t('Предметов')}<select class="input" data-f="set1pc">${opt([['4', t('4 предмета')], ['2', t('2 предмета')]], String(e.set1pc))}</select></label>
          <label ${e.set1pc === 4 ? 'hidden' : ''} data-set2>${t('Второй сет (2 предмета)')}<select class="input" data-f="set2">${opt(sets, e.set2)}</select></label>
          <label>${t('Часы')}<select class="input" data-f="sands">${opt([['', '—'], ...STAT_OPTS.sands], e.sands)}</select></label>
          <label>${t('Кубок')}<select class="input" data-f="goblet">${opt([['', '—'], ...STAT_OPTS.goblet], e.goblet)}</select></label>
          <label>${t('Корона')}<select class="input" data-f="circlet">${opt([['', '—'], ...STAT_OPTS.circlet], e.circlet)}</select></label>
        </fieldset>
        <fieldset class="stats"><legend>${t('Итоговые статы')} <span class="muted small">— ${t('как в игре на экране персонажа')}</span></legend>
          ${STAT_FIELDS.map(([k, l, u]) => `<label>${l}${u ? ', %' : ''}<input class="input" type="number" step="0.1" min="0" data-s="${k}" value="${e.stats[k] ?? ''}" placeholder="—"></label>`).join('')}
        </fieldset>
      </div>
      <button class="btn danger" type="button" data-remove>${t('Убрать из моих персонажей')}</button>`;
    renderRoster();
  }

  document.addEventListener('input', (ev) => {
    const t = ev.target as HTMLInputElement;
    if (!t.closest('#editor')) return;
    const e = roster.find((x) => x.key === editing);
    if (!e) return;
    if (t.dataset.f) {
      const f = t.dataset.f as keyof Entry;
      if (f === 'level') e.level = validInt(Number(t.value), 1, 100, e.level);
      else if (f === 'cons') e.cons = validInt(Number(t.value), 0, 6, e.cons);
      else if (f === 'refine') e.refine = validInt(Number(t.value), 1, 5, e.refine);
      else if (f === 'set1pc') e.set1pc = validSetCount(Number(t.value));
      else (e as any)[f] = t.value;
      if (f === 'set1pc') $('editor').querySelector<HTMLElement>('[data-set2]')!.hidden = e.set1pc === 4;
    } else if (t.dataset.t) e.talents[Number(t.dataset.t)] = validInt(Number(t.value), 1, 15, e.talents[Number(t.dataset.t)]);
    else if (t.dataset.s) e.stats[t.dataset.s as keyof Stats] = t.value === '' ? undefined : validStat(Number(t.value), t.dataset.s as keyof Stats);
    persist(); renderRoster();
  });
  document.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest('button');
    if (!b) return;
    if (b.dataset.filterEl) {
      pickerElement = pickerElement === b.dataset.filterEl ? '' : b.dataset.filterEl;
      renderPicker();
    } else if (b.dataset.pick) {
      const c = chars.get(b.dataset.pick);
      if (!c) return;
      const existing = roster.find((e) => e.s === c.s);
      if (existing) {
        roster = roster.filter((e) => e.key !== existing.key);
        for (const h of [1, 2]) teams[h] = (teams[h] ?? []).filter((k) => k !== existing.key);
        if (editing === existing.key) openEditor(null);
        status(t('{name} убран', { name: c.n }));
      } else {
        roster = [fromBuild(c.s), ...roster];
        status(t('{name} добавлен', { name: c.n }));
      }
      persist(); renderRoster(); renderTeams();
    } else if (b.dataset.toHalf) {
      const h = Number(b.dataset.toHalf), other = h === 1 ? 2 : 1, key = b.dataset.key!;
      if (teams[h]?.includes(key)) teams[h] = teams[h].filter((k) => k !== key);
      else {
        if ((teams[h] ?? []).length >= 4) return status(t('В {n}-й половине уже 4 персонажа', { n: h }), true);
        teams[other] = (teams[other] ?? []).filter((k) => k !== key);
        teams[h] = [...(teams[h] ?? []), key];
      }
      persist(); renderTeams();
    } else if (b.dataset.clearHalf) {
      teams[Number(b.dataset.clearHalf)] = [];
      persist(); renderTeams();
    } else if (b.dataset.takeHalf && b.dataset.takeTeam) {
      const h = Number(b.dataset.takeHalf);
      const half = halves.find((x) => x.half === h);
      const team = half?.teams[Number(b.dataset.takeTeam)];
      if (!team) return;
      const used = new Set(teams[h === 1 ? 2 : 1] ?? []);
      const available = team.members.map((s) => roster.find((e) => e.s === s && !used.has(e.key)));
      teams[h] = available.filter((e): e is Entry => Boolean(e)).map((e) => e.key);
      const missing = team.members.filter((_, i) => !available[i]).map((s) => chars.get(s)?.n ?? s);
      persist(); renderTeams();
      status(missing.length
        ? t('Поставлено {n} из 4. Нет: {list}', { n: teams[h].length, list: missing.join(', ') })
        : t('Команда «{name}» поставлена', { name: t(team.name ?? '') }));
    } else if (b.dataset.edit) openEditor(editing === b.dataset.edit ? null : b.dataset.edit);
    else if (b.hasAttribute('data-close')) openEditor(null);
    else if (b.hasAttribute('data-remove') && editing) {
      roster = roster.filter((x) => x.key !== editing);
      for (const h of [1, 2]) teams[h] = teams[h].filter((k) => k !== editing);
      persist(); openEditor(null); renderTeams();
    }
  });

  // ---------- Команды ----------
  function renderTeams() {
    for (const h of [1, 2]) {
      const half = halves.find((x) => x.half === h);
      const clear = document.querySelector<HTMLButtonElement>(`[data-clear-half="${h}"]`)!;
      const need = document.querySelector<HTMLElement>(`[data-need="${h}"]`)!;
      need.textContent = half ? `${t(half.label)}. ${t('Нужно')}: ${half.need.map((g) => g.map((e) => EL[e]).join(` ${t('или')} `)).join(' + ')}.` : '';
      teams[h] = (teams[h] ?? []).filter((k) => roster.some((e) => e.key === k));
      const used = new Set(teams[h === 1 ? 2 : 1]);
      const options = roster.filter((e) => !used.has(e.key));
      document.querySelector<HTMLElement>(`[data-slots="${h}"]`)!.innerHTML = [0, 1, 2, 3].map((i) => {
        const cur = teams[h][i] ?? '';
        const e = roster.find((x) => x.key === cur);
        const c = e && chars.get(e.s);
        return `<label class="slot" ${c ? `data-el="${c.el}"` : ''}>${c ? `<img src="${c.i}" alt="" width="48" height="48">` : '<span class="ph">+</span>'}
          <select class="input" data-half="${h}" data-i="${i}" aria-label="${t('Персонаж {i}, {h}-я половина', { i: i + 1, h })}"><option value="">${t('Пусто')}</option>
          ${options.filter((o) => o.key === cur || !teams[h].includes(o.key)).map((o) => `<option value="${esc(o.key)}" ${o.key === cur ? 'selected' : ''}>${esc(chars.get(o.s)!.n)}</option>`).join('')}</select></label>`;
      }).join('');
      clear.hidden = !teams[h].length;
      document.querySelector<HTMLElement>(`[data-recommend="${h}"]`)!.innerHTML = half?.teams.length
        ? `<h3>${esc(t('Рекомендуем'))}</h3>${half.teams.map((tm, i) => `<div class="recommended-team">
            <span class="recommended-name">${esc(t(tm.name ?? ''))}</span>
            <span class="recommended-icons">${tm.members.map((s) => {
              const c = chars.get(s);
              return c ? `<img class="${roster.some((e) => e.s === s) ? '' : 'missing'}" src="${esc(c.i)}" alt="${esc(c.n)}" title="${esc(roster.some((e) => e.s === s) ? c.n : t('Нет в ваших персонажах'))}" width="32" height="32" loading="lazy">` : '';
            }).join('')}</span>
            <button class="btn small" type="button" data-take-half="${h}" data-take-team="${i}">${esc(t('Взять'))}</button>
          </div>`).join('')}` : '';
    }
    renderRoster();
  }
  document.addEventListener('change', (ev) => {
    const t = ev.target as HTMLSelectElement;
    if (!t.dataset.half) return;
    const h = Number(t.dataset.half), i = Number(t.dataset.i);
    const arr = [...(teams[h] ?? [])];
    arr[i] = t.value;
    teams[h] = arr.filter(Boolean);
    persist(); renderTeams();
  });

  $('reset-teams').addEventListener('click', () => {
    teams = { 1: [], 2: [] };
    checked = false;
    $('result').innerHTML = '';
    persist(); renderTeams();
  });

  // Подбор: для каждой половины берём ростер и выбираем четвёрку, максимально похожую на рекомендованные команды
  $('autofill').addEventListener('click', () => {
    if (roster.length < 2) return status(t('Добавьте хотя бы двух персонажей.'), true);
    const taken = new Set<string>();
    for (const h of [1, 2]) {
      const half = halves.find((x) => x.half === h);
      const free = roster.filter((e) => !taken.has(e.key));
      const scored = free.map((e) => ({ e, sc: scoreChar(e).score + (half?.teams.some((t) => t.members.includes(e.s)) ? 25 : 0) }))
        .sort((a, b) => b.sc - a.sc);
      const pick: string[] = [];
      for (const group of half?.need ?? []) {
        if (scored.some((x) => pick.includes(x.e.key) && group.includes(chars.get(x.e.s)!.el))) continue;
        const best = scored.find((x) => !pick.includes(x.e.key) && group.includes(chars.get(x.e.s)!.el));
        if (best) pick.push(best.e.key);
      }
      for (const x of scored) if (pick.length < 4 && !pick.includes(x.e.key)) pick.push(x.e.key);
      teams[h] = pick; pick.forEach((k) => taken.add(k));
    }
    persist(); renderTeams();
    status(t('Составы подобраны — поправьте их, если нужно, и нажмите «Проверить».'));
  });

  // ---------- Оценка ----------
  type Note = { ok: boolean | null; text: string };
  const clamp = (v: number) => Math.max(0, Math.min(1, v));
  const lvlKey = (lvl: number) => { const pts = ['1', '20', '40', '50', '60', '70', '80', '90', '95', '100']; return [...pts].reverse().find((p) => lvl >= Number(p)) ?? '1'; };

  function scoreChar(e: Entry): { score: number; notes: Note[] } {
    const c = chars.get(e.s)!;
    const b = c.build;
    const notes: Note[] = [];
    let score = 0;

    // Уровень — 15 баллов
    const lv = e.level >= 90 ? 15 : e.level >= 80 ? 11 : e.level >= 70 ? 6 : 2;
    score += lv;
    if (e.level < 80) notes.push({ ok: false, text: t('Уровень {lvl}: для 12-го этажа (враги 95–100 ур.) стоит поднять хотя бы до 80', { lvl: e.level }) });

    // Оружие — 15
    const w = weapons.get(e.weapon);
    if (!w) notes.push({ ok: false, text: t('Не выбрано оружие') });
    else if (b) {
      const rank = b.weapons.indexOf(e.weapon);
      score += rank === 0 ? 15 : rank >= 1 && rank <= 2 ? 12 : rank >= 3 ? 9 : w.r >= 4 ? 5 : 3;
      notes.push(rank >= 0
        ? { ok: true, text: t('{name} — №{n} в рекомендованном списке', { name: w.n, n: rank + 1 }) }
        : { ok: null, text: t('{name} нет в рекомендованном списке. Лучше: {list}', { name: w.n, list: b.weapons.slice(0, 2).map((s) => weapons.get(s)?.n).join(` ${t('или')} `) }) });
    } else score += w.r >= 5 ? 12 : 8;

    // Артефакты — 15
    const have = e.set1pc === 4 ? [e.set1] : [e.set1, e.set2];
    if (!e.set1) notes.push({ ok: false, text: t('Не выбран сет артефактов') });
    else if (b) {
      const same = (opt: string[]) => opt.length === have.length && [...opt].sort().every((s, i) => s === [...have].sort()[i]);
      const idx = b.sets.findIndex(same);
      const partial = b.sets.some((opt) => opt.some((s) => have.includes(s)));
      score += idx === 0 ? 15 : idx > 0 ? 12 : partial ? 7 : 3;
      const setName = (s: string) => arts.get(s)?.n ?? s;
      notes.push(idx >= 0
        ? { ok: true, text: t('Сет {sets} — {rank}', { sets: have.filter(Boolean).map(setName).join(' + '), rank: idx === 0 ? t('лучший вариант') : t('вариант №{n}', { n: idx + 1 }) }) }
        : { ok: null, text: t('Сет {sets} не из рекомендованных. Лучше: {best}', { sets: have.filter(Boolean).map(setName).join(' + '), best: b.sets[0].map(setName).join(' + ') }) });
    } else score += 10;

    // Основные статы — 15 (по 5 за слот)
    if (b) {
      const names: Record<string, string> = Object.fromEntries([...STAT_OPTS.sands, ...STAT_OPTS.goblet, ...STAT_OPTS.circlet]);
      for (const slot of ['sands', 'goblet', 'circlet'] as const) {
        const want = b.main[slot].flatMap((k) => (k === 'crit' ? ['cr', 'cd'] : [k]));
        const slotName = t({ sands: 'Часы', goblet: 'Кубок', circlet: 'Корона' }[slot]);
        if (!e[slot]) notes.push({ ok: false, text: t('{slot}: не указан', { slot: slotName }) });
        else if (!want.length || want.includes(e[slot])) score += 5;
        else notes.push({ ok: false, text: t('{slot}: {have}, а нужно {want}', { slot: slotName, have: names[e[slot]], want: [...new Set(want)].map((k) => names[k] ?? k).join(` ${t('или')} `) }) });
      }
    } else score += 12;

    // Итоговые статы — 40
    const st = e.stats;
    const filled = Object.values(st).some((v) => v !== undefined);
    if (!filled) {
      score += 16;
      notes.push({ ok: null, text: t('Статы не указаны — оценка неполная. Впишите их с экрана персонажа или загрузите по UID') });
    } else {
      const parts: number[] = [];
      const cls = b?.cls ?? 'sub';
      const usesCrit = !b || b.main.circlet.some((k) => ['crit', 'cr', 'cd'].includes(k));
      if (usesCrit && st.cr !== undefined && st.cd !== undefined) {
        const cv = Math.min(st.cr, 100) * 2 + st.cd;
        const [lo, hi] = cls === 'support' ? [120, 190] : [130, 250];
        parts.push(clamp((cv - lo) / (hi - lo)));
        if (cv < (lo + hi) / 2) notes.push({ ok: false, text: t('Крит {cr}% / {cd}%: для {role} маловато, ориентир — {target}', { cr: st.cr, cd: st.cd, role: cls === 'dps' ? t('основного ДД') : t('этой роли'), target: cls === 'support' ? '50% / 100%' : '65% / 130%' }) });
        else notes.push({ ok: true, text: t('Крит {cr}% / {cd}% — хорошо', { cr: st.cr, cd: st.cd }) });
        if (st.cr > 85) notes.push({ ok: null, text: t('Шанс крита выше 85% — часть статов уходит впустую, можно перекинуть в крит. урон') });
      }
      // Масштабирующий стат: по основному стату часов из билда
      const scale = b?.main.sands.find((k) => ['atk%', 'hp%', 'def%', 'em'].includes(k)) ?? 'atk%';
      const base = c.base[lvlKey(e.level)] ?? c.base['90'];
      if (scale === 'atk%' && st.atk !== undefined) {
        const ratio = st.atk / (base[1] + (w?.atk ?? 500));
        parts.push(clamp((ratio - 1.3) / (2.0 - 1.3)));
        if (ratio < 1.6) notes.push({ ok: false, text: t('Атака {v}: мало относительно базовой — нужно больше Силы атаки % в статах', { v: st.atk }) });
      } else if (scale === 'hp%' && st.hp !== undefined) {
        const ratio = st.hp / base[0];
        parts.push(clamp((ratio - 1.6) / (2.6 - 1.6)));
        if (ratio < 2) notes.push({ ok: false, text: t('HP {v}: для персонажа от HP нужно больше — ориентир от {target}', { v: st.hp, target: Math.round(base[0] * 2.3).toLocaleString() }) });
      } else if (scale === 'def%' && st.def !== undefined) {
        const ratio = st.def / base[2];
        parts.push(clamp((ratio - 1.8) / (2.8 - 1.8)));
        if (ratio < 2.2) notes.push({ ok: false, text: t('Защита {v}: для персонажа от защиты маловато, ориентир — от {target}', { v: st.def, target: Math.round(base[2] * 2.5) }) });
      } else if (scale === 'em' && st.em !== undefined) {
        parts.push(clamp((st.em - 300) / (750 - 300)));
        if (st.em < 500) notes.push({ ok: false, text: t('Мастерство стихий {v}: для реакционного персонажа ориентир — от 600', { v: st.em }) });
      }
      // Энергия: если ВЭ в приоритете у билда — нужен запас
      if (st.er !== undefined) {
        const erFirst = b && (b.subs[0] === 'er' || b.main.sands[0] === 'er');
        const target = erFirst ? (cls === 'support' ? 180 : 160) : 120;
        parts.push(clamp((st.er - 100) / (target - 100)));
        if (st.er < target - 10) notes.push({ ok: false, text: t('Восст. энергии {v}%: для этого персонажа лучше {target}%+, иначе взрыв стихии не будет готов к ротации', { v: st.er, target }) });
      }
      score += 40 * (parts.length ? parts.reduce((s, p) => s + p, 0) / parts.length : 0.6);
    }

    // Созвездия и таланты — небольшой бонус сверху, если что-то сильно отстаёт — предупреждение
    if (Math.max(...e.talents) < 8 && b?.cls !== 'support') notes.push({ ok: false, text: t('Таланты ниже 8 — прокачка основного таланта даст заметный прирост урона') });
    return { score: Math.round(Math.min(100, score + Math.min(e.cons, 2) * 1.5)), notes };
  }

  function checkHalf(h: number) {
    const half = halves.find((x) => x.half === h);
    const members = (teams[h] ?? []).map((k) => roster.find((e) => e.key === k)!).filter(Boolean);
    if (!members.length) return null;
    const scored = members.map((e) => ({ e, c: chars.get(e.s)!, ...scoreChar(e) }));
    const avg = scored.reduce((s, x) => s + x.score, 0) / scored.length;
    const teamNotes: Note[] = [];
    let fit = 1;
    let missingCount = 0;
    if (members.length < 4) { teamNotes.push({ ok: false, text: t('В команде {n} из 4 — пустые слоты сильно снижают урон и выживаемость', { n: members.length }) }); fit -= 0.3; }
    if (half) {
      const els = new Set(scored.map((x) => x.c.el));
      const missing = half.need.filter((g) => !g.some((el) => els.has(el)));
      missingCount = missing.length;
      if (missing.length) { fit -= 0.5 * missing.length; teamNotes.push({ ok: false, text: `${t('Не хватает стихии: {list}.', { list: missing.map((g) => g.map((el) => EL[el]).join(` ${t('или')} `)).join(', ') })} ${t(half.tip)}` }); }
      else teamNotes.push({ ok: true, text: t('Стихии подходят под бафф этажа: {label}', { label: t(half.label) }) });
      const best = half.teams.map((t) => ({ t, n: t.members.filter((s) => scored.some((x) => x.c.s === s)).length })).sort((a, b) => b.n - a.n)[0];
      if (best && best.n >= 3) teamNotes.push({ ok: true, text: t('Почти совпадает с рекомендованной командой «{name}»', { name: t(best.t.name ?? '') }) });
      else if (best) teamNotes.push({ ok: null, text: t('Рекомендованные составы на эту половину: {list}', { list: half.teams.slice(0, 2).map((tm) => tm.members.map((s) => chars.get(s)?.n).join(', ')).join('; ') }) });
    }
    const healers = scored.filter((x) => x.e.circlet === 'heal' || x.c.build?.healer).length;
    const supports = scored.filter((x) => x.c.build?.cls === 'support').length;
    if (!healers && !supports) { fit -= 0.15; teamNotes.push({ ok: null, text: t('В команде нет саппорта или хилера — на 12-м этаже будет сложно выживать') }); }
    let total = Math.round(avg * 0.7 + Math.max(0, fit) * 30);
    // Без нужной стихии бафф этажа не работает, а щиты снимаются медленно — «готова» быть не может
    if (missingCount > 0) total = Math.min(total, missingCount > 1 ? 50 : 64);
    return { half, scored, teamNotes, total };
  }

  const verdict = (v: number) => v >= 80 ? ['good', t('Готова к 9★ в зале')] : v >= 62 ? ['mid', t('Пройдёт, но впритык')] : ['bad', t('Скорее не хватит')];
  const noteLi = (n: Note) => `<li class="${n.ok === true ? 'ok' : n.ok === false ? 'no' : 'tip'}">${esc(n.text)}</li>`;

  const renderResult = (scroll: boolean) => {
    const res = [1, 2].map(checkHalf);
    if (res.every((r) => !r)) { $('result').innerHTML = `<p class="notice">${t('Соберите хотя бы одну команду: выберите персонажей в слотах половин или нажмите «Подобрать из моих персонажей».')}</p>`; return; }
    $('result').innerHTML = `<h2 class="h-sec">${t('Результат')}</h2><div class="results">${res.map((r, i) => {
      if (!r) return `<div class="panel res empty"><h3>${t('{n}-я половина', { n: i + 1 })}</h3><p class="muted">${t('Команда не собрана.')}</p></div>`;
      const [cls, label] = verdict(r.total);
      return `<article class="panel res">
        <header><div><h3>${t('{n}-я половина', { n: i + 1 })}</h3><span class="muted small">${esc(t(r.half?.label ?? ''))}</span></div>
          <div class="score ${cls}"><b>${r.total}</b><span>${label}</span></div></header>
        <ul class="notes">${r.teamNotes.map(noteLi).join('')}</ul>
        <div class="members">${r.scored.map((x) => `<details><summary><img src="${x.c.i}" alt="" width="36" height="36"><b>${esc(x.c.n)}</b><span class="mscore ${verdict(x.score)[0]}">${x.score}</span></summary>
          <ul class="notes">${x.notes.map(noteLi).join('') || `<li class="ok">${t('Билд совпадает с рекомендованным')}</li>`}</ul>
          <a class="small" href="${BASE}/characters/${x.c.s}#build">${t('Рекомендованный билд')}</a></details>`).join('')}</div>
      </article>`;
    }).join('')}</div>
    <p class="muted small">${t('Оценка складывается из уровня, оружия, сета, основных и итоговых статов (до 100 баллов на персонажа) и того, закрывает ли команда требования половины. Реальный урон зависит ещё от ротации и созвездий.')}</p>`;
    if (scroll) $('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  $('check').addEventListener('click', () => { checked = true; renderResult(true); });

  renderRoster(); renderTeams();
</script>

