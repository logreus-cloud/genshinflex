---
import { useData, LANGS } from '../../lib/data';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { t } = useData(Astro.currentLocale);
---
<Layout title={t('Сообщения')} description={t('Личные сообщения.')} noindex>
  <div class="messages" data-messages>
    <h1>{t('Сообщения')}</h1>
    <p class="status" data-status aria-live="polite"></p>
    <div class="messages-list" data-list></div>
    <button class="btn" type="button" data-more hidden>{t('Показать ещё')}</button>
  </div>
  <div class="thread" data-thread hidden>
    <a data-back></a>
    <h1 class="thread-head" data-thread-head></h1>
    <p class="status" data-thread-status aria-live="polite"></p>
    <button class="btn" type="button" data-older hidden>{t('Показать раньше')}</button>
    <div class="thread-list" data-thread-list></div>
    <form data-compose hidden>
      <label for="dm-body">{t('Сообщение')}</label>
      <textarea id="dm-body" name="body" maxlength="2000"></textarea>
      <button class="btn" type="submit">{t('Отправить')}</button>
    </form>
    <p class="status" data-compose-status aria-live="polite"></p>
    <p data-closed hidden>{t('Отправка недоступна: пользователь ограничил сообщения, заблокирован или удалил аккаунт.')}</p>
  </div>
</Layout>

<script>
  import { onPage } from '../../scripts/router';
  import { hasSession } from '../../scripts/user-data/session';
  import { t } from '../../scripts/search';
  import { dmOpen, messageError } from '../../scripts/messages/api';
  import { initConversationList } from '../../scripts/messages/list';
  import { initThread } from '../../scripts/messages/thread';

  onPage((signal) => {
    const list = document.querySelector<HTMLElement>('[data-messages]');
    const thread = document.querySelector<HTMLElement>('[data-thread]');
    const params = new URLSearchParams(location.search);
    const value = params.get('c');
    const id = value && /^[1-9]\d*$/.test(value) ? Number(value) : 0;
    const user = value === null ? params.get('u') : null;
    const openUser = user && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(user) ? user : null;
    const showThread = (Number.isSafeInteger(id) && id > 0) || !!openUser;
    if (list) list.hidden = showThread;
    if (thread) thread.hidden = !showThread;
    const showList = (error?: unknown) => {
      if (thread) thread.hidden = true;
      if (!list) return;
      list.hidden = false;
      void (async () => {
        await initConversationList(list, signal);
        if (error && !signal.aborted) {
          const status = list.querySelector<HTMLElement>('[data-status]');
          if (status && !status.querySelector('a')) status.textContent = messageError(error);
        }
      })();
    };
    if (Number.isSafeInteger(id) && id > 0) {
      if (thread) void initThread(thread, id, signal);
    } else if (openUser && thread) {
      thread.querySelector<HTMLElement>('[data-thread-status]')!.textContent = t('Загрузка...');
      void (async () => {
        if (!hasSession()) { showList(); return; }
        try {
          const conversationId = await dmOpen(openUser);
          if (signal.aborted) return;
          history.replaceState(history.state, '', `${location.pathname}?c=${conversationId}`);
          void initThread(thread, conversationId, signal);
        } catch (error) {
          if (!signal.aborted) showList(error);
        }
      })();
    } else if (list) {
      void initConversationList(list, signal);
    }
  });
</script>

<style>
  .messages :global([hidden]) { display: none !important; }
  .thread-head { margin: 0; font-size: 1.15rem; }
  .messages { display: grid; gap: 1rem; max-width: 760px; }
  .messages-list { display: grid; gap: .7rem; }
  .messages :global(.dm-row) { position: relative; display: grid; gap: .4rem; min-width: 0; overflow-wrap: anywhere; }
  .messages :global(.dm-person) { display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; min-width: 0; }
  .messages :global(.dm-summary) { display: flex; align-items: center; justify-content: space-between; gap: .5rem; min-width: 0; }
  .messages :global(.dm-open) { min-width: 0; overflow-wrap: anywhere; }
  .messages :global(.dm-open)::after { content: ''; position: absolute; inset: 0; }
  .messages :global(.dm-row.unread) { border-color: var(--accent-text); }
  .messages :global(.forum-author) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .35rem;
    overflow-wrap: anywhere;
  }
  .messages :global(.forum-author a) { position: relative; z-index: 1; }
  .messages :global(.forum-avatar) {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
    overflow: hidden;
  }
  .messages :global(.forum-avatar img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .messages :global(.dm-badge) { flex: none; padding: .15rem .45rem; border-radius: 1rem; background: var(--accent-soft); color: var(--accent-text); }
  .messages > [data-more] { justify-self: start; }
  .messages[hidden], .thread[hidden], .thread :global([hidden]) { display: none !important; }
  .thread { display: grid; gap: .75rem; max-width: 760px; min-width: 0; }
  .thread > [data-back], .thread > [data-older] { justify-self: start; }
  .thread-list { display: flex; flex-direction: column; gap: .7rem; min-width: 0; max-height: min(65vh, 640px); overflow-y: auto; }
  .thread :global(.forum-author) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .35rem;
    overflow-wrap: anywhere;
  }
  .thread :global(.forum-avatar) {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
    overflow: hidden;
  }
  .thread :global(.forum-avatar img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .thread :global(.dm-msg) { align-self: flex-start; box-sizing: border-box; width: fit-content; max-width: 80%; padding: .65rem .8rem; border-radius: .8rem; background: var(--surface-2); overflow-wrap: anywhere; }
  .thread :global(.dm-msg.mine) { align-self: flex-end; background: color-mix(in srgb, var(--accent) 18%, transparent); }
  .thread :global(.dm-body) { margin: 0; white-space: pre-wrap; }
  .thread :global(.dm-body.deleted) { font-style: italic; }
  .thread :global(.dm-time) { display: block; margin-top: .3rem; font-size: .75rem; }
  .thread :global(.dm-delete) { display: block; margin-top: .3rem; padding: 0; border: 0; background: none; cursor: pointer; }
  .thread form { display: grid; gap: .5rem; min-width: 0; }
  .thread form button { justify-self: end; }
  .thread textarea { box-sizing: border-box; width: 100%; min-width: 0; resize: vertical; }
</style>
