---
import Layout from '../../../layouts/Layout.astro';
import { useData, LANGS } from '../../../lib/data';
// Редактор гайдов: каждая страница существует в трёх языках, гайд отправляется на языке страницы
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { t, base, TALENTS } = useData(Astro.currentLocale);
const bubbleKinds = [['char', t('Персонаж')], ['weapon', t('Оружие')], ['set', t('Сет')], ['el', t('Стихия')], ['text', t('Текст')], ['gold', t('Золотой')]];
---
<Layout title={t('Редактор гайдов')} description={t('Напишите свой гайд на персонажа Genshin Impact или дополните существующий: билд, команды, текст с превью.')} wide noindex>
  <div class="ge">
    <nav class="crumbs small muted"><a href={`${base}/guides/`}>{t('Руководства')}</a> / {t('Редактор')}</nav>
    <h1>{t('Редактор гайдов')}</h1>
    <p class="muted lead">{t('Напишите новый гайд или дополните существующий. Слева — редактор, справа — как гайд будет выглядеть на сайте. Всё сохраняется в черновик в этом браузере. После отправки гайд проверяет модератор и только потом публикует.')}</p>

    <div class="panel who">
      <div class="seg kind" role="radiogroup" aria-label={t('О чём гайд')}>
        <button type="button" role="radio" aria-checked="true" data-gk="char">{t('Персонаж')}</button>
        <button type="button" role="radio" aria-checked="false" data-gk="weapon">{t('Оружие')}</button>
        <button type="button" role="radio" aria-checked="false" data-gk="endgame">{t('Эндгейм')}</button>
      </div>
      <label class="who-pick" data-for="weapon" hidden>
        <span class="muted small">{t('Оружие')}</span>
        <span class="pick big"><img alt="" width="40" height="40" hidden /><input class="input" id="weap" list="dl-weapon-all" data-kind="weapon" placeholder={t('Название оружия')} autocomplete="off" /></span>
      </label>
      <label class="who-pick" data-for="endgame" hidden>
        <span class="muted small">{t('Этаж или режим')}</span>
        <select class="input" id="eg"></select>
      </label>
      <label class="who-pick" data-for="char">
        <span class="muted small">{t('Персонаж')}</span>
        <span class="pick big"><img alt="" width="40" height="40" hidden /><input class="input" id="char" list="dl-char" data-kind="char" placeholder={t('Начните вводить имя — например, Фурина')} autocomplete="off" /></span>
      </label>
      <span class="chip" id="mode" hidden></span>
      <p class="small muted" id="notice" aria-live="polite"></p>
    </div>

    <div class="view-switch" role="tablist" aria-label={t('Что показать')}>
      <button type="button" role="tab" aria-selected="true" data-view="edit">{t('Редактор')}</button>
      <button type="button" role="tab" aria-selected="false" data-view="preview">{t('Превью')}</button>
    </div>

    <div class="split" data-view="edit">
      <form class="editor" id="ed" novalidate autocomplete="off">
        <details class="panel sec" open data-for="char">
          <summary>{t('Основное')}</summary>
          <div class="cols">
            <label><span class="muted small">{t('Роль')}</span><input class="input" name="role" list="dl-role" maxlength="60" placeholder={t('ДД, Саппорт, Хилер…')} /></label>
            <label><span class="muted small">{t('Патч')}</span><input class="input" name="patch" maxlength="10" placeholder="7.1" /></label>
          </div>
        </details>

        <details class="panel sec" open data-for="char">
          <summary>{t('Оружие')} <small class="muted">{t('от лучшего к запасному')}</small></summary>
          <div class="rows" data-list="weapons"></div>
          <button class="btn add" type="button" data-add="weapons">+ {t('Оружие')}</button>
        </details>

        <details class="panel sec" open data-for="char">
          <summary>{t('Артефакты')} <small class="muted">{t('второй сет — для вариантов 2 + 2')}</small></summary>
          <div class="rows" data-list="artifacts"></div>
          <button class="btn add" type="button" data-add="artifacts">+ {t('Вариант сетов')}</button>
        </details>

        <details class="panel sec" open data-for="char">
          <summary>{t('Статы и таланты')}</summary>
          <div class="cols three">
            <label><span class="muted small">{t('Часы')}</span><input class="input" name="sands" list="dl-sands" maxlength="80" /></label>
            <label><span class="muted small">{t('Кубок')}</span><input class="input" name="goblet" list="dl-goblet" maxlength="80" /></label>
            <label><span class="muted small">{t('Корона')}</span><input class="input" name="circlet" list="dl-circlet" maxlength="80" /></label>
          </div>
          <label><span class="muted small">{t('Доп. статы — по приоритету, через «>»')}</span>
            <input class="input" name="substats" maxlength="300" placeholder={t('Шанс / Крит. урон > Восст. энергии > Сила атаки %')} /></label>
          <div class="cols three">
            {[1, 2, 3].map((n) => (
              <label><span class="muted small">{t('Таланты: {n}-й', { n })}</span>
                <select class="input" name={`t${n}`}>
                  <option value="">—</option>
                  {(['normal', 'skill', 'burst'] as const).map((k) => <option value={k}>{TALENTS[k]}</option>)}
                </select></label>
            ))}
          </div>
        </details>

        <details class="panel sec" open data-for="char endgame">
          <summary>{t('Команды')}</summary>
          <div class="rows" data-list="teams"></div>
          <button class="btn add" type="button" data-add="teams">+ {t('Команда')}</button>
        </details>

        <details class="panel sec" open>
          <summary>{t('Текст гайда')}</summary>
          <div class="tb" role="toolbar" aria-label={t('Форматирование текста')}>
            <button type="button" data-md="h2" title={t('Заголовок')}>{t('Заголовок')}</button>
            <button type="button" data-md="bold" title={t('Жирный (Ctrl+B)')}><b>{t('Ж')}</b></button>
            <button type="button" data-md="italic" title={t('Курсив (Ctrl+I)')}><i>{t('К')}</i></button>
            <button type="button" data-md="mark" title={t('Выделение цветом')}><mark>{t('Выд')}</mark></button>
            <button type="button" data-md="ul" title={t('Список')}>• {t('Список')}</button>
            <button type="button" data-md="ol" title={t('Нумерованный список')}>1. {t('Список')}</button>
            <button type="button" data-md="quote" title={t('Цитата')}>❝ {t('Цитата')}</button>
            <span class="sep" aria-hidden="true"></span>
            <button type="button" data-pop="link" title={t('Ссылка (Ctrl+K)')}>{t('Ссылка')}</button>
            <button type="button" data-pop="bubble" title={t('Бабл: персонаж, оружие, сет, стихия или свой текст')}>{t('Бабл')}</button>
            <button type="button" data-pop="callout" title={t('Блок-выноска')}>{t('Выноска')}</button>
          </div>

          <div class="pop panel" id="pop-link" hidden>
            <label><span class="muted small">{t('Текст ссылки')}</span><input class="input" data-f="text" placeholder={t('Например, разбор ротации')} /></label>
            <label><span class="muted small">{t('Адрес')}</span><input class="input" data-f="url" placeholder={t('https://… или /characters/furina/')} /></label>
            <div class="row"><button type="button" class="btn primary" data-insert="link">{t('Вставить')}</button><button type="button" class="btn" data-close>{t('Отмена')}</button>
              <small class="muted" data-f="err"></small></div>
          </div>

          <div class="pop panel" id="pop-bubble" hidden>
            <div class="seg" role="radiogroup" aria-label={t('Тип бабла')}>
              {bubbleKinds.map(([k, v], i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-kind={k}>{v}</button>
              ))}
            </div>
            <input class="input" data-f="value" list="dl-char" placeholder={t('Имя персонажа')} />
            <div class="row"><span class="muted small">{t('Будет так:')}</span><span class="prose bubble-demo" data-f="demo"></span></div>
            <div class="row"><button type="button" class="btn primary" data-insert="bubble">{t('Вставить')}</button><button type="button" class="btn" data-close>{t('Отмена')}</button></div>
          </div>

          <div class="pop panel" id="pop-callout" hidden>
            <div class="row">
              <button type="button" class="btn" data-callout="tip">{t('Совет')}</button>
              <button type="button" class="btn" data-callout="warn">{t('Важно')}</button>
              <button type="button" class="btn" data-callout="info">{t('На заметку')}</button>
              <button type="button" class="btn" data-close>{t('Отмена')}</button>
            </div>
          </div>

          <textarea class="input body" name="body" rows="16" maxlength="20000" spellcheck="true"
            placeholder={t('Расскажите, как играть персонажем: суть, ротация, на что обратить внимание. Пустая строка — новый абзац.')}></textarea>
          <div class="row between"><small class="muted" id="count">0 / 20 000</small></div>
          <details class="cheat">
            <summary class="small">{t('Шпаргалка по разметке')}</summary>
            <table class="small">
              <tbody>
                <tr><td><code>## {t('Заголовок')}</code></td><td>{t('заголовок раздела')} (<code>###</code> — {t('поменьше')})</td></tr>
                <tr><td><code>**{t('жирный')}**</code>, <code>*{t('курсив')}*</code>, <code>=={t('выделение')}==</code></td><td>{t('оформление текста')}</td></tr>
                <tr><td><code>[{t('текст')}](https://…)</code></td><td>{t('ссылка')}</td></tr>
                <tr><td><code>- {t('пункт')}</code>, <code>1. {t('пункт')}</code></td><td>{t('списки')}</td></tr>
                <tr><td><code>&gt; {t('цитата')}</code></td><td>{t('цитата')}</td></tr>
                <tr><td><code>{'{{char:furina}}'}</code>, <code>{'{{weapon:…}}'}</code>, <code>{'{{set:…}}'}</code>, <code>{'{{el:hydro}}'}</code></td><td>{t('бабл с иконкой и ссылкой — удобнее через кнопку «Бабл»')}</td></tr>
                <tr><td><code>{`{{${t('любой текст')}}}`}</code>, <code>{`{{gold:${t('текст')}}}`}</code></td><td>{t('простой и золотой бабл')}</td></tr>
                <tr><td><code>:::tip</code> … <code>:::</code></td><td>{t('выноска: tip — совет, warn — важно, info — на заметку')}</td></tr>
              </tbody>
            </table>
          </details>
        </details>

        <details class="panel sec" open>
          <summary>{t('Гайды на других сайтах')} <small class="muted">{t('подробные разборы других авторов')}</small></summary>
          <div class="rows" data-list="external"></div>
          <button class="btn add" type="button" data-add="external">+ {t('Ссылка')}</button>
        </details>

        <div class="panel sec send">
          <h2 class="h-sec">{t('Отправка на проверку')}</h2>
          <ul class="checks small" id="checks"></ul>
          <div class="cols">
            <label><span class="muted small">{t('Имя или ник — подпишем гайд')}</span><input class="input" name="author" maxlength="60" required /></label>
            <label><span class="muted small">{t('Как с вами связаться')} <span>{t('(необязательно)')}</span></span><input class="input" name="contact" maxlength="120" placeholder={t('Telegram, Discord или почта')} /></label>
          </div>
          <label><span class="muted small">{t('Комментарий для модератора')} <span>{t('(необязательно)')}</span></span>
            <textarea class="input" name="comment" rows="2" maxlength="1000" placeholder={t('Что изменили и почему, откуда данные')}></textarea></label>
          <label class="trap" aria-hidden="true">{t('Сайт')}<input name="website" tabindex="-1" autocomplete="off" /></label>
          <div class="row">
            <button class="btn primary" type="submit">{t('Отправить гайд')}</button>
            <button class="btn" type="button" id="reset">{t('Сбросить черновик')}</button>
            <p class="status small" id="status" aria-live="polite"></p>
          </div>
          <p class="muted small">{t('Гайд публикуется после проверки модератором, иногда с правками. Сохраняем только сам гайд, подпись и контакт, если вы его указали.')}</p>
        </div>
      </form>

      <aside class="preview" aria-label={t('Превью гайда')}>
        <div class="pv-bar small muted"><span>{t('Превью')}</span><span>{t('так гайд будет выглядеть на сайте')}</span></div>
        <div class="pv" id="pv"><p class="muted">{t('Выберите персонажа — здесь появится превью.')}</p></div>
      </aside>
    </div>
    <div id="lists" hidden></div>
  </div>
</Layout>

<script>
  import { makeLookup, renderGuide, esc } from '../../../lib/guide-markup';
  import { store } from '../../../scripts/common';
  import { BASE, LANG, t } from '../../../scripts/search';

  type Item = { slug: string; name: string; icon: string | null; element?: string; weapon?: string; rarity?: number; splash?: string | null; title?: string };
  type Kind = 'char' | 'weapon' | 'endgame';
  type Guide = {
    kind?: Kind; target?: string; cycle?: string;
    character: string; role: string; patch: string;
    weapons: { slug: string; note?: string }[]; artifacts: { sets: string[]; note?: string }[];
    mainStats: { sands: string; goblet: string; circlet: string }; substats: string[]; talents: string[];
    teams: { name?: string; members: string[]; note?: string }[]; body: string;
    external?: { title: string; url: string; author?: string; lang: string }[];
  };
  type Data = {
    characters: Item[]; weapons: Item[]; artifacts: Item[]; elements: Record<string, string>; weaponTypes: Record<string, string>;
    talents: Record<string, string>; options: Record<'role' | 'sands' | 'goblet' | 'circlet', string[]>;
    builds: Record<string, Guide & { updated: string }>;
    weaponGuides: Record<string, Partial<Guide> & { updated: string }>;
    endgame: Record<string, Partial<Guide> & { mode: string; title: string; cycle: string; hasGuide: boolean }>;
  };
  type Drafts = Record<string, { guide: Guide; ts: number }>;
  type PickKind = 'char' | 'weapon' | 'set';

  // Черновики — отдельно для каждого языка: гайд пишется на языке страницы
  const DRAFTS = LANG === 'ru' ? 'gf:guide-drafts' : `gf:guide-drafts:${LANG}`;
  const ME = 'gf:guide-author';
  const LOCALE = { ru: 'ru-RU', en: 'en-US', es: 'es-ES' }[LANG];
  const CALLOUTS = { tip: t('Совет'), warn: t('Важно'), info: t('На заметку') };
  const form = document.querySelector<HTMLFormElement>('#ed')!;
  const pv = document.querySelector<HTMLElement>('#pv')!;
  const ta = form.elements.namedItem('body') as HTMLTextAreaElement;
  const charInput = document.querySelector<HTMLInputElement>('#char')!;
  const weapInput = document.querySelector<HTMLInputElement>('#weap')!;
  const egSelect = document.querySelector<HTMLSelectElement>('#eg')!;
  const notice = document.querySelector<HTMLElement>('#notice')!;
  const modeChip = document.querySelector<HTMLElement>('#mode')!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const norm = (s: string) => s.trim().toLowerCase().replace(/ё/g, 'е');
  const debounce = (fn: () => void, ms: number) => { let id = 0; return () => { clearTimeout(id); id = window.setTimeout(fn, ms); }; };
  const date = (d: Date | number | string) => new Date(d).toLocaleDateString(LOCALE);

  init();

  async function init() {
    const data: Data = await fetch(`${BASE}/data/editor.json`).then((r) => r.json());
    const lookup = makeLookup(data, BASE);
    const render = (src: string) => renderGuide(src, lookup, CALLOUTS);
    const index = (list: Item[]) => {
      const bySlug = new Map(list.map((i) => [i.slug, i]));
      const byName = new Map(list.map((i) => [norm(i.name), i]));
      return { bySlug, find: (v: string) => byName.get(norm(v)) ?? bySlug.get(v.trim()) };
    };
    const idx = { char: index(data.characters), weapon: index(data.weapons), set: index(data.artifacts) };
    const latestPatch = Object.values(data.builds).map((b) => b.patch).sort((a, b) => b.localeCompare(a, undefined, { numeric: true }))[0] ?? '';
    let cur: Item | undefined;
    // Что редактируем: вид гайда и цель (слаг персонажа/оружия или ключ эндгейма вроде abyss-12)
    let kind: Kind = 'char';
    let key = '';
    egSelect.innerHTML = `<option value="">${esc(t('Выберите…'))}</option>` + Object.entries(data.endgame).map(([k, e]) => `<option value="${k}">${esc(e.title)}</option>`).join('');
    const showKind = () => {
      document.querySelectorAll<HTMLElement>('.ge [data-for]').forEach((el) => { el.hidden = !el.dataset.for!.split(' ').includes(kind); });
      document.querySelectorAll('.ge [data-gk]').forEach((b) => b.setAttribute('aria-checked', String((b as HTMLElement).dataset.gk === kind)));
    };

    // Подсказки для полей ввода
    const options = (list: string[]) => list.map((s) => `<option value="${esc(s)}">`).join('');
    const lists: Record<string, string> = {
      'dl-char': options(data.characters.map((c) => c.name)),
      'dl-weapon': '',
      'dl-weapon-all': data.weapons.map((w) => `<option value="${esc(w.name)}">${'★'.repeat(w.rarity ?? 0)}</option>`).join(''),
      'dl-set': options(data.artifacts.map((a) => a.name)),
      'dl-el': options(Object.values(data.elements)),
      'dl-role': options(data.options.role),
      'dl-sands': options(data.options.sands),
      'dl-goblet': options(data.options.goblet),
      'dl-circlet': options(data.options.circlet),
    };
    document.querySelector('#lists')!.innerHTML = Object.entries(lists).map(([id, html]) => `<datalist id="${id}">${html}</datalist>`).join('');
    const weaponList = document.querySelector<HTMLDataListElement>('#dl-weapon')!;

    // ---------- Поля выбора с иконкой: имя вводится текстом, слаг находится по списку ----------
    const picker = (kind: PickKind, slug = '', placeholder = '') => {
      const it = slug ? idx[kind].bySlug.get(slug) : undefined;
      return `<span class="pick"><img alt="" width="28" height="28" ${it?.icon ? `src="${esc(it.icon)}"` : 'hidden'} />`
        + `<input class="input" list="dl-${kind}" data-kind="${kind}" placeholder="${esc(placeholder)}" value="${esc(it?.name ?? '')}" /></span>`;
    };
    const resolve = (input: HTMLInputElement) => idx[input.dataset.kind as PickKind].find(input.value);
    const paintPick = (input: HTMLInputElement) => {
      const it = resolve(input);
      const img = input.previousElementSibling as HTMLImageElement;
      if (it?.icon) { img.src = it.icon; img.hidden = false; } else img.hidden = true;
      input.toggleAttribute('aria-invalid', Boolean(input.value.trim() && !it));
    };
    const controls = `<span class="ctl"><button type="button" data-act="up" title="${t('Выше')}" aria-label="${t('Выше')}">↑</button><button type="button" data-act="down" title="${t('Ниже')}" aria-label="${t('Ниже')}">↓</button><button type="button" data-act="del" title="${t('Удалить')}" aria-label="${t('Удалить')}">✕</button></span>`;
    const note = (v = '', ph = t('Заметка (необязательно)')) => `<input class="input note" maxlength="200" placeholder="${esc(ph)}" value="${esc(v)}" />`;
    const ROWS = {
      weapons: (w?: Guide['weapons'][number]) => `${picker('weapon', w?.slug, t('Оружие'))}${note(w?.note, t('Заметка: пробуждение, условия…'))}${controls}`,
      artifacts: (a?: Guide['artifacts'][number]) => `${picker('set', a?.sets[0], t('Сет'))}${picker('set', a?.sets[1], t('Второй сет (для 2 + 2)'))}${note(a?.note, t('Заметка: «4 предмета» или «2 + 2»'))}${controls}`,
      teams: (tm?: Guide['teams'][number]) => `<input class="input tname" maxlength="80" placeholder="${esc(t('Название команды'))}" value="${esc(tm?.name ?? '')}" />${controls}`
        + `<div class="members">${[0, 1, 2, 3].map((i) => picker('char', tm?.members[i], t('Участник {n}', { n: i + 1 }))).join('')}</div>${note(tm?.note, t('Заметка к команде'))}`,
      external: (x?: NonNullable<Guide['external']>[number]) => `<input class="input xtitle" maxlength="100" placeholder="${esc(t('Название: «Гайд на Фурину от …»'))}" value="${esc(x?.title ?? '')}" />`
        + `<select class="input xlang">${['ru', 'en', 'es'].map((l) => `<option value="${l}"${(x?.lang ?? LANG) === l ? ' selected' : ''}>${l.toUpperCase()}</option>`).join('')}</select>${controls}`
        + `<input class="input xurl" maxlength="300" inputmode="url" placeholder="https://…" value="${esc(x?.url ?? '')}" /><input class="input xauthor" maxlength="60" placeholder="${esc(t('Автор (необязательно)'))}" value="${esc(x?.author ?? '')}" />`,
    };
    type ListName = keyof typeof ROWS;
    const addRow = (name: ListName, value?: never) => {
      const el = document.createElement('div');
      el.className = `item ${name}`;
      el.innerHTML = ROWS[name](value);
      form.querySelector(`[data-list="${name}"]`)!.append(el);
      return el;
    };

    // ---------- Форма ⇄ объект гайда ----------
    const rowsOf = (name: ListName) => [...form.querySelectorAll<HTMLElement>(`[data-list="${name}"] > .item`)];
    const slugsIn = (row: Element) => [...row.querySelectorAll<HTMLInputElement>('.pick input')].map((i) => resolve(i)?.slug ?? '').filter(Boolean);
    const noteIn = (row: Element) => row.querySelector<HTMLInputElement>('.note')!.value.trim();
    const collect = (): Guide => ({
      kind, target: key, cycle: kind === 'endgame' ? data.endgame[key]?.cycle : undefined,
      character: kind === 'char' ? cur?.slug ?? '' : '',
      role: field('role').value.trim(),
      patch: field('patch').value.trim(),
      weapons: rowsOf('weapons').map((r) => ({ slug: slugsIn(r)[0] ?? '', note: noteIn(r) })).filter((w) => w.slug),
      artifacts: rowsOf('artifacts').map((r) => ({ sets: slugsIn(r), note: noteIn(r) })).filter((a) => a.sets.length),
      mainStats: { sands: field('sands').value.trim(), goblet: field('goblet').value.trim(), circlet: field('circlet').value.trim() },
      substats: field('substats').value.split('>').map((s) => s.trim()).filter(Boolean),
      talents: [...new Set(['t1', 't2', 't3'].map((n) => field(n).value).filter(Boolean))],
      teams: rowsOf('teams').map((r) => ({ name: r.querySelector<HTMLInputElement>('.tname')!.value.trim(), members: slugsIn(r), note: noteIn(r) })).filter((tm) => tm.members.length || tm.name),
      body: ta.value,
      external: rowsOf('external').map((r) => ({
        title: r.querySelector<HTMLInputElement>('.xtitle')!.value.trim(), url: r.querySelector<HTMLInputElement>('.xurl')!.value.trim(),
        author: r.querySelector<HTMLInputElement>('.xauthor')!.value.trim(), lang: r.querySelector<HTMLSelectElement>('.xlang')!.value,
      })).filter((x) => x.title || x.url),
    });
    const fill = (g: Partial<Guide>) => {
      field('role').value = g.role ?? '';
      field('patch').value = g.patch ?? latestPatch;
      for (const k of ['sands', 'goblet', 'circlet'] as const) field(k).value = g.mainStats?.[k] ?? '';
      field('substats').value = (g.substats ?? []).join(' > ');
      ['t1', 't2', 't3'].forEach((n, i) => { field(n).value = g.talents?.[i] ?? ''; });
      ta.value = g.body ?? '';
      for (const name of Object.keys(ROWS) as ListName[]) {
        form.querySelector(`[data-list="${name}"]`)!.innerHTML = '';
        const items = (g[name] ?? []) as never[];
        (items.length ? items : [undefined as never]).forEach((v) => addRow(name, v));
      }
      form.querySelectorAll<HTMLInputElement>('.pick input').forEach(paintPick);
      refresh();
    };

    // ---------- Выбор персонажа и черновики ----------
    const drafts = () => store.get<Drafts>(DRAFTS, {});
    // Ключ черновика: у персонажей — просто слаг (как раньше), у остальных — «weapon:слаг» / «endgame:abyss-12»
    const dk = () => (kind === 'char' ? key : `${kind}:${key}`);
    const saveDraft = debounce(() => {
      if (!key) return;
      const all = drafts();
      all[dk()] = { guide: collect(), ts: Date.now() };
      // Храним черновики пяти последних персонажей
      store.set(DRAFTS, Object.fromEntries(Object.entries(all).sort((a, b) => b[1].ts - a[1].ts).slice(0, 5)));
    }, 400);
    const dropDraft = (slug: string) => { const all = drafts(); delete all[slug]; store.set(DRAFTS, all); };
    const when = (ts: number) => new Date(ts).toLocaleString(LOCALE, { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });

    // Выбор цели: оружие или этаж/режим эндгейма
    const openOther = (k: 'weapon' | 'endgame', target: string) => {
      kind = k; key = target; cur = undefined; showKind();
      const existing = k === 'weapon' ? data.weaponGuides[target] : data.endgame[target]?.hasGuide ? data.endgame[target] : undefined;
      if (k === 'weapon') { const w = idx.weapon.bySlug.get(target)!; weapInput.value = w.name; paintPick(weapInput); history.replaceState(null, '', `?w=${target}`); }
      else { egSelect.value = target; history.replaceState(null, '', `?m=${target}`); }
      modeChip.hidden = false;
      modeChip.textContent = existing ? t('Правка существующего гайда') : t('Новый гайд');
      modeChip.classList.toggle('gold', !existing);
      const draft = drafts()[dk()];
      if (draft) {
        fill(draft.guide);
        notice.innerHTML = `${esc(t('Восстановлен черновик от {date}.', { date: when(draft.ts) }))} <button type="button" class="link" data-restart>${esc(existing ? t('Начать с текущего гайда') : t('Начать с чистого листа'))}</button>`;
      } else if (existing) {
        fill(existing);
        notice.textContent = t('Загружен текущий гайд — правьте и дополняйте что нужно.');
      } else {
        fill(k === 'endgame' ? { teams: data.endgame[target].teams } : {});
        notice.textContent = k === 'endgame' ? t('Подставлены текущие рекомендованные команды — поправьте их и добавьте свои советы.') : t('Гайда здесь ещё нет — вы можете написать первый.');
      }
    };
    const open = (k: Kind, target: string) => (k === 'char' ? setCharacter(target) : openOther(k, target));

    const setCharacter = (slug: string) => {
      cur = idx.char.bySlug.get(slug);
      if (!cur) return;
      kind = 'char'; key = slug; showKind();
      charInput.value = cur.name;
      paintPick(charInput);
      history.replaceState(null, '', `?c=${cur.slug}`);
      weaponList.innerHTML = data.weapons.filter((w) => w.weapon === cur!.weapon).map((w) => `<option value="${esc(w.name)}">${'★'.repeat(w.rarity ?? 0)}</option>`).join('');
      const build = data.builds[cur.slug];
      modeChip.hidden = false;
      modeChip.textContent = build ? t('Правка существующего гайда') : t('Новый гайд');
      modeChip.classList.toggle('gold', !build);
      const draft = drafts()[cur.slug];
      if (draft) {
        fill(draft.guide);
        notice.innerHTML = `${esc(t('Восстановлен черновик от {date}.', { date: when(draft.ts) }))} <button type="button" class="link" data-restart>${esc(build ? t('Начать с текущего гайда') : t('Начать с чистого листа'))}</button>`;
      } else if (build) {
        fill(build);
        notice.textContent = t('Загружен текущий гайд (патч {v}, обновлён {date}) — правьте и дополняйте что нужно.', { v: build.patch, date: date(build.updated) });
      } else {
        fill({});
        notice.textContent = t('Гайда на этого персонажа ещё нет — вы можете написать первый.');
      }
    };
    const restart = () => {
      if (!key) return;
      dropDraft(dk());
      open(kind, key);
    };

    charInput.addEventListener('change', () => {
      const it = resolve(charInput);
      paintPick(charInput);
      if (it && it.slug !== cur?.slug) setCharacter(it.slug);
    });
    charInput.addEventListener('input', () => { const it = resolve(charInput); if (it && it.slug !== cur?.slug) setCharacter(it.slug); });
    weapInput.addEventListener('input', () => { const w = resolve(weapInput); paintPick(weapInput); if (w && w.slug !== key) openOther('weapon', w.slug); });
    egSelect.addEventListener('change', () => { if (egSelect.value) openOther('endgame', egSelect.value); });
    document.querySelector('.ge .kind')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-gk]');
      if (!b || b.dataset.gk === kind) return;
      kind = b.dataset.gk as Kind; key = ''; cur = undefined; showKind();
      modeChip.hidden = true; notice.textContent = '';
      fill({});
    });
    notice.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-restart]')) restart(); });
    document.querySelector('#reset')!.addEventListener('click', restart);

    // ---------- Проверки перед отправкой ----------
    const checksEl = document.querySelector<HTMLElement>('#checks')!;
    const problems = (g: Guide) => {
      const out: string[] = [];
      if (!key) out.push(kind === 'char' ? t('Выберите персонажа.') : t('Выберите, о чём гайд.'));
      const bad = [...form.querySelectorAll<HTMLInputElement>('.pick input[aria-invalid]')].map((i) => `«${i.value.trim()}»`);
      if (bad.length) out.push(t('Не нашли в списке: {list} — выберите вариант из подсказок.', { list: bad.join(', ') }));
      g.teams.forEach((tm, i) => {
        if (tm.members.length !== 4) out.push(t('В команде {name}: {n} из 4 участников.', { name: tm.name ? `«${tm.name}»` : `№${i + 1}`, n: tm.members.length }));
      });
      if (kind === 'char' && !g.weapons.length && !g.artifacts.length && !g.teams.length && g.body.trim().length < 50) out.push(t('Гайд пока пустой: добавьте оружие, артефакты, команды или текст.'));
      if (kind !== 'char' && !g.teams.length && !g.external?.length && g.body.trim().length < 50) out.push(t('Гайд пока пустой: добавьте текст, команды или ссылки.'));
      (g.external ?? []).forEach((x) => { if (!/^https:\/\/\S+\.\S+$/.test(x.url) || !x.title) out.push(t('Ссылка «{name}»: нужны название и адрес https://…', { name: x.title || x.url })); });
      if (!field('author').value.trim()) out.push(t('Укажите имя или ник для подписи.'));
      return out;
    };

    // ---------- Превью ----------
    const slotName = { sands: t('Часы'), goblet: t('Кубок'), circlet: t('Корона') } as const;
    const empty = (text: string) => `<p class="muted small empty">${esc(text)}</p>`;
    const extras = (g: Guide) => `${g.body.trim() ? `<div class="panel prose">${render(g.body)}</div>` : ''}`
      + `${g.external?.length ? `<div class="panel pv-more"><h4>${esc(t('Также можете посмотреть'))}</h4><ul>${g.external.map((x) => `<li>${esc(x.title || x.url)}${x.author ? ` <span class="muted small">— ${esc(x.author)}</span>` : ''} <span class="chip">${esc(x.lang.toUpperCase())}</span></li>`).join('')}</ul></div>` : ''}`;
    const teamCards = (g: Guide) => {
      const member = (s: string) => { const m = idx.char.bySlug.get(s)!; return `<span class="mem" data-el="${m.element}"><img src="${esc(m.icon ?? '')}" alt="" /><small>${esc(m.name)}</small></span>`; };
      return g.teams.length ? `<div class="pv-teams">${g.teams.map((tm) => `<div class="panel team"><h4>${esc(tm.name || t('Без названия'))}</h4><div class="mems">${tm.members.map(member).join('')}${'<span class="mem ghost"></span>'.repeat(Math.max(0, 4 - tm.members.length))}</div>${tm.note ? `<p class="muted small">${esc(tm.note)}</p>` : ''}</div>`).join('')}</div>` : empty(t('Команды не добавлены'));
    };
    const preview = (g: Guide) => {
      if (kind !== 'char') {
        if (!key) { pv.innerHTML = `<p class="muted">${esc(t('Выберите, о чём гайд — здесь появится превью.'))}</p>`; return; }
        if (kind === 'weapon') {
          const w = idx.weapon.bySlug.get(key)!;
          pv.innerHTML = `<header class="pv-head pv-w r${w.rarity}"><img class="pv-wicon" src="${esc(w.icon ?? '')}" alt="" /><div><h2>${esc(w.name)}</h2><div class="row"><span class="chip gold">${'★'.repeat(w.rarity ?? 0)}</span><span class="chip">${esc(data.weaponTypes[w.weapon!] ?? '')}</span></div></div></header>`
            + `<h3 class="h-sec">${esc(t('Гайд'))}</h3>${extras(g) || empty(t('Текст ещё не написан'))}`;
        } else {
          const e = data.endgame[key];
          pv.innerHTML = `<header class="pv-head"><div><p class="muted small">${esc(t('Эндгейм'))}</p><h2>${esc(e.title)}</h2></div></header>`
            + `<h3 class="h-sec">${esc(t('Советы сообщества'))}</h3>${extras(g) || empty(t('Текст ещё не написан'))}<h3 class="h-sec">${esc(t('Команды'))}</h3>${teamCards(g)}`;
        }
        return;
      }
      if (!cur) { pv.innerHTML = `<p class="muted">${esc(t('Выберите персонажа — здесь появится превью.'))}</p>`; return; }
      const c = cur;
      const weapon = (s: string) => idx.weapon.bySlug.get(s)!;
      const set = (s: string) => idx.set.bySlug.get(s)!;
      const member = (s: string) => { const m = idx.char.bySlug.get(s)!; return `<span class="mem" data-el="${m.element}"><img src="${esc(m.icon ?? '')}" alt="" /><small>${esc(m.name)}</small></span>`; };
      pv.innerHTML = `
        <header class="pv-head" data-el="${c.element}">
          ${c.splash ? `<img class="pv-splash" src="${esc(c.splash)}" alt="" />` : ''}
          <div><p class="muted small">${esc(c.title ?? '')}</p><h2>${esc(c.name)}</h2>
            <div class="row"><span class="chip gold">${'★'.repeat(c.rarity ?? 0)}</span><span class="chip" data-el="${c.element}">${esc(data.elements[c.element!] ?? '')}</span><span class="chip">${esc(data.weaponTypes[c.weapon!] ?? '')}</span></div></div>
        </header>
        <h3 class="h-sec">${esc(t('Билд'))} <small>${esc(t('патч {v}, обновлено {date}', { v: g.patch || '—', date: date(Date.now()) }))}</small></h3>
        ${g.role ? `<p class="muted">${esc(g.role)}</p>` : ''}
        <div class="pv-build">
          <div class="panel"><h4>${esc(t('Оружие'))}</h4>${g.weapons.length ? `<ol class="rank">${g.weapons.map((w, i) => { const it = weapon(w.slug); return `<li><span class="n">${i + 1}</span><img class="r${it.rarity}" src="${esc(it.icon ?? '')}" alt="" /><span><b>${esc(it.name)}</b> <span class="muted small">${'★'.repeat(it.rarity ?? 0)}</span>${w.note ? `<small class="muted note">${esc(w.note)}</small>` : ''}</span></li>`; }).join('')}</ol>` : empty(t('Оружие не добавлено'))}</div>
          <div class="panel"><h4>${esc(t('Артефакты'))}</h4>${g.artifacts.length ? `<ol class="rank">${g.artifacts.map((a, i) => `<li><span class="n">${i + 1}</span><span class="sets">${a.sets.map((s) => `<img src="${esc(set(s).icon ?? '')}" alt="" />`).join('')}</span><span><b>${esc(a.sets.map((s) => set(s).name).join(' + '))}</b>${a.note ? `<small class="muted note">${esc(a.note)}</small>` : ''}</span></li>`).join('')}</ol>` : empty(t('Сеты не добавлены'))}</div>
        </div>
        <div class="pv-stats">${(['sands', 'goblet', 'circlet'] as const).map((k) => `<div class="panel"><span class="muted small">${esc(slotName[k])}</span><b>${esc(g.mainStats[k] || '—')}</b></div>`).join('')}</div>
        <div class="panel pv-prio">
          <div><span class="muted small">${esc(t('Доп. статы'))}</span><b>${g.substats.length ? esc(g.substats.join('  >  ')) : '—'}</b></div>
          ${g.talents.length ? `<div><span class="muted small">${esc(t('Прокачка талантов'))}</span><b>${g.talents.map((k) => esc(data.talents[k])).join('  >  ')}</b></div>` : ''}
        </div>
        ${g.body.trim() ? `<div class="panel prose">${render(g.body)}</div>` : ''}
        <h3 class="h-sec">${esc(t('Команды'))}</h3>
        ${g.teams.length ? `<div class="pv-teams">${g.teams.map((tm) => `<div class="panel team"><h4>${esc(tm.name || t('Без названия'))}</h4><div class="mems">${tm.members.map(member).join('')}${'<span class="mem ghost"></span>'.repeat(Math.max(0, 4 - tm.members.length))}</div>${tm.note ? `<p class="muted small">${esc(tm.note)}</p>` : ''}</div>`).join('')}</div>` : empty(t('Команды не добавлены'))}
        ${g.external?.length ? `<div class="panel pv-more"><h4>${esc(t('Также можете посмотреть'))}</h4><ul>${g.external.map((x) => `<li>${esc(x.title || x.url)}${x.author ? ` <span class="muted small">— ${esc(x.author)}</span>` : ''} <span class="chip">${esc(x.lang.toUpperCase())}</span></li>`).join('')}</ul></div>` : ''}`;
    };

    const count = document.querySelector<HTMLElement>('#count')!;
    const refresh = () => {
      const g = collect();
      preview(g);
      const list = problems(g);
      checksEl.innerHTML = list.length ? list.map((p) => `<li>${esc(p)}</li>`).join('') : `<li class="ok">${esc(t('Всё готово к отправке.'))}</li>`;
      count.textContent = `${ta.value.length.toLocaleString(LOCALE)} / ${(20000).toLocaleString(LOCALE)}`;
    };
    const refreshSoon = debounce(refresh, 120);

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.matches('.pick input')) paintPick(el);
      if (el.name === 'author' || el.name === 'contact') store.set(ME, { author: field('author').value, contact: field('contact').value });
      refreshSoon();
      saveDraft();
    });
    form.addEventListener('change', () => { refreshSoon(); saveDraft(); });
    form.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!btn) return;
      if (btn.dataset.add) { const row = addRow(btn.dataset.add as ListName); row.querySelector<HTMLInputElement>('input')!.focus(); }
      const row = btn.closest<HTMLElement>('.item');
      if (btn.dataset.act && row) {
        if (btn.dataset.act === 'up') row.previousElementSibling?.before(row);
        if (btn.dataset.act === 'down') row.nextElementSibling?.after(row);
        if (btn.dataset.act === 'del') row.remove();
      }
      if (btn.dataset.add || btn.dataset.act) { refresh(); saveDraft(); }
    });

    // ---------- Панель форматирования ----------
    const replace = (s: number, e: number, text: string, selS?: number, selE?: number) => {
      ta.focus();
      ta.setSelectionRange(s, e);
      // insertText сохраняет Ctrl+Z; если браузер не умеет — меняем текст напрямую
      if (!document.execCommand('insertText', false, text)) ta.setRangeText(text, s, e, 'end');
      ta.setSelectionRange(selS ?? s + text.length, selE ?? s + text.length);
      refresh(); saveDraft();
    };
    const wrap = (before: string, after: string, placeholder: string) => {
      const { selectionStart: s, selectionEnd: e, value } = ta;
      const sel = value.slice(s, e) || placeholder;
      replace(s, e, before + sel + after, s + before.length, s + before.length + sel.length);
    };
    const prefixLines = (prefix: (i: number) => string) => {
      const v = ta.value;
      const s = v.lastIndexOf('\n', ta.selectionStart - 1) + 1;
      let e = v.indexOf('\n', ta.selectionEnd); if (e < 0) e = v.length;
      const lines = v.slice(s, e).split('\n');
      const on = lines.every((l, i) => l.startsWith(prefix(i)));
      const text = lines.map((l, i) => (on ? l.slice(prefix(i).length) : prefix(i) + l.replace(/^(#{1,3}|[-*•]|\d+[.)]|>)\s+/, ''))).join('\n');
      replace(s, e, text, s, s + text.length);
    };
    // Блочный элемент — на отдельных строках с пустой строкой вокруг
    const block = (text: string, selFrom: number, selLen: number) => {
      const { selectionStart: s, selectionEnd: e, value } = ta;
      const pre = s === 0 ? '' : value.slice(0, s).endsWith('\n\n') ? '' : value.slice(0, s).endsWith('\n') ? '\n' : '\n\n';
      const post = value.slice(e).startsWith('\n') ? '\n' : '\n\n';
      replace(s, e, pre + text + post, s + pre.length + selFrom, s + pre.length + selFrom + selLen);
    };
    const MD: Record<string, () => void> = {
      h2: () => prefixLines(() => '## '),
      bold: () => wrap('**', '**', t('жирный текст')),
      italic: () => wrap('*', '*', t('курсив')),
      mark: () => wrap('==', '==', t('важное')),
      ul: () => prefixLines(() => '- '),
      ol: () => prefixLines((i) => `${i + 1}. `),
      quote: () => prefixLines(() => '> '),
    };

    // Всплывающие окна: ссылка, бабл, выноска
    const pops = { link: '#pop-link', bubble: '#pop-bubble', callout: '#pop-callout' } as const;
    let saved = { s: 0, e: 0 };
    const closePops = () => Object.values(pops).forEach((sel) => { document.querySelector<HTMLElement>(sel)!.hidden = true; });
    const openPop = (name: keyof typeof pops) => {
      const pop = document.querySelector<HTMLElement>(pops[name])!;
      const wasOpen = !pop.hidden;
      closePops();
      if (wasOpen) return;
      saved = { s: ta.selectionStart, e: ta.selectionEnd };
      pop.hidden = false;
      if (name === 'link') {
        pop.querySelector<HTMLInputElement>('[data-f="text"]')!.value = ta.value.slice(saved.s, saved.e);
        pop.querySelector<HTMLInputElement>('[data-f="url"]')!.value = '';
        pop.querySelector<HTMLElement>('[data-f="err"]')!.textContent = '';
        pop.querySelector<HTMLInputElement>(ta.value.slice(saved.s, saved.e) ? '[data-f="url"]' : '[data-f="text"]')!.focus();
      }
      if (name === 'bubble') { bubbleValue.value = ''; paintBubble(); bubbleValue.focus(); }
    };
    const insertAt = (text: string) => { ta.focus(); ta.setSelectionRange(saved.s, saved.e); replace(saved.s, saved.e, text); closePops(); };

    const linkPop = document.querySelector<HTMLElement>('#pop-link')!;
    const insertLink = () => {
      const text = linkPop.querySelector<HTMLInputElement>('[data-f="text"]')!.value.trim();
      let url = linkPop.querySelector<HTMLInputElement>('[data-f="url"]')!.value.trim();
      if (/^[\w-]+(\.[\w-]+)+/.test(url)) url = `https://${url}`;
      const err = linkPop.querySelector<HTMLElement>('[data-f="err"]')!;
      if (!/^(https?:\/\/\S+|\/\S*)$/i.test(url)) { err.textContent = t('Нужен адрес вида https://… или /путь на сайте'); return; }
      insertAt(`[${text || url}](${url})`);
    };

    const bubblePop = document.querySelector<HTMLElement>('#pop-bubble')!;
    const bubbleValue = bubblePop.querySelector<HTMLInputElement>('[data-f="value"]')!;
    const bubbleDemo = bubblePop.querySelector<HTMLElement>('[data-f="demo"]')!;
    const BUBBLE = {
      char: { list: 'dl-char', ph: t('Имя персонажа') }, weapon: { list: 'dl-weapon-all', ph: t('Название оружия') },
      set: { list: 'dl-set', ph: t('Название сета') }, el: { list: 'dl-el', ph: t('Стихия') },
      text: { list: '', ph: t('Любой текст: «C2», «сигнатурное»') }, gold: { list: '', ph: t('Текст золотого бабла') },
    };
    let bubbleKind: keyof typeof BUBBLE = 'char';
    const bubbleCode = () => {
      const v = bubbleValue.value.trim();
      if (!v) return '';
      if (bubbleKind === 'text') return `{{${v}}}`;
      if (bubbleKind === 'gold') return `{{gold:${v}}}`;
      if (bubbleKind === 'el') { const k = Object.entries(data.elements).find(([, n]) => norm(n) === norm(v))?.[0]; return k ? `{{el:${k}}}` : ''; }
      const it = idx[bubbleKind].find(v);
      return it ? `{{${bubbleKind}:${it.slug}}}` : '';
    };
    const paintBubble = () => {
      const code = bubbleCode();
      bubbleDemo.innerHTML = code ? render(code).replace(/^<p>|<\/p>$/g, '') : `<span class="muted small">${esc(t('выберите из подсказок'))}</span>`;
    };
    bubblePop.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-kind]');
      if (!b) return;
      bubbleKind = b.dataset.kind as keyof typeof BUBBLE;
      bubblePop.querySelectorAll('[data-kind]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      const cfg = BUBBLE[bubbleKind];
      if (cfg.list) bubbleValue.setAttribute('list', cfg.list); else bubbleValue.removeAttribute('list');
      bubbleValue.placeholder = cfg.ph;
      bubbleValue.value = '';
      paintBubble();
      bubbleValue.focus();
    });
    bubbleValue.addEventListener('input', paintBubble);
    const insertBubble = () => { const code = bubbleCode(); if (code) insertAt(code); };

    const tb = document.querySelector<HTMLElement>('.tb')!;
    tb.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.dataset.md) { closePops(); MD[b.dataset.md](); }
      if (b.dataset.pop) openPop(b.dataset.pop as keyof typeof pops);
    });
    form.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.dataset.close !== undefined) { closePops(); ta.focus(); }
      if (b.dataset.insert === 'link') insertLink();
      if (b.dataset.insert === 'bubble') insertBubble();
      if (b.dataset.callout) {
        ta.setSelectionRange(saved.s, saved.e);
        closePops();
        const inner = ta.value.slice(saved.s, saved.e) || t('Текст выноски');
        block(`:::${b.dataset.callout}\n${inner}\n:::`, b.dataset.callout.length + 4, inner.length);
      }
    });
    // Enter во всплывающем окне — вставить, Esc — закрыть
    for (const [pop, fn] of [[linkPop, insertLink], [bubblePop, insertBubble]] as const) {
      pop.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); fn(); }
        if (e.key === 'Escape') { closePops(); ta.focus(); }
      });
    }
    ta.addEventListener('keydown', (e) => {
      if (!(e.ctrlKey || e.metaKey)) return;
      const k = e.code;
      if (k === 'KeyB') { e.preventDefault(); MD.bold(); }
      if (k === 'KeyI') { e.preventDefault(); MD.italic(); }
      if (k === 'KeyK') { e.preventDefault(); openPop('link'); }
    });

    // ---------- Отправка ----------
    const status = document.querySelector<HTMLElement>('#status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const g = collect();
      const list = problems(g);
      if (list.length) { status.className = 'status small err'; status.textContent = list[0]; checksEl.scrollIntoView({ block: 'center', behavior: 'smooth' }); return; }
      const btn = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
      btn.disabled = true;
      status.className = 'status small';
      status.textContent = t('Отправляем…');
      try {
        const res = await fetch('/api/guides', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            guide: g, lang: LANG,
            mode: (kind === 'char' ? data.builds[key] : kind === 'weapon' ? data.weaponGuides[key] : data.endgame[key]?.hasGuide) ? 'edit' : 'new',
            author: field('author').value, contact: field('contact').value, comment: field('comment').value, website: field('website').value,
          }),
        });
        const out = await res.json().catch(() => ({}));
        // Сервер отвечает по-русски — переводим сообщение здесь
        if (!res.ok) throw new Error(t(out.error ?? 'Не удалось отправить — попробуйте позже'));
        dropDraft(dk());
        status.className = 'status small ok';
        status.textContent = kind === 'char'
          ? t('Спасибо! Гайд отправлен на проверку. Черновик очищен — после публикации гайд появится на странице персонажа.')
          : t('Спасибо! Гайд отправлен на проверку. Черновик очищен — после публикации он появится на сайте.');
        (form.elements.namedItem('comment') as HTMLTextAreaElement).value = '';
      } catch (err) {
        status.className = 'status small err';
        status.textContent = err instanceof Error && err.message !== 'Failed to fetch' ? err.message : t('Нет связи с сервером — черновик сохранён, попробуйте позже');
      } finally {
        btn.disabled = false;
      }
    });

    // ---------- Переключатель «Редактор / Превью» на узком экране ----------
    const split = document.querySelector<HTMLElement>('.split')!;
    document.querySelector('.view-switch')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-view]');
      if (!b) return;
      split.dataset.view = b.dataset.view;
      document.querySelectorAll('.view-switch [data-view]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    });

    // ---------- Старт: персонаж из ссылки, иначе последний черновик ----------
    const me = store.get<{ author?: string; contact?: string }>(ME, {});
    field('author').value = me.author ?? '';
    field('contact').value = me.contact ?? '';
    // Что открыть: из ссылки (?c= персонаж, ?w= оружие, ?m= эндгейм), иначе последний черновик
    const params = new URLSearchParams(location.search);
    const lastDraft = Object.entries(drafts()).sort((a, b) => b[1].ts - a[1].ts)[0]?.[0] ?? '';
    const fromDraft = lastDraft.includes(':') ? lastDraft.split(':') as [Kind, string] : ['char', lastDraft] as [Kind, string];
    const valid = ([k, v]: [Kind, string | null]) => Boolean(v) && (k === 'char' ? idx.char.bySlug.has(v!) : k === 'weapon' ? idx.weapon.bySlug.has(v!) : Boolean(data.endgame[v!]));
    const start = ([['char', params.get('c')], ['weapon', params.get('w')], ['endgame', params.get('m')], fromDraft] as [Kind, string | null][]).find(valid);
    if (start) open(start[0], start[1]!);
    else { showKind(); fill({}); charInput.focus(); }
  }
</script>

