---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import CalendarWidget from '../../components/CalendarWidget.astro';
import HeroCarousel from '../../components/HeroCarousel.astro';
import FeatureTabs from '../../components/FeatureTabs.astro';
import weaponArt from '../../data/generated/weapon-art.json';
import { siteNews, newsDate } from '../../lib/news';
import { useData, LANGS } from '../../lib/data';
// Каждая страница существует в трёх языках: / (ru), /en/, /es/
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { characters, weapons, artifacts, getCharacter, MODES, resetAt, base, t, lang } = useData(Astro.currentLocale);
const latestNews = (await siteNews(lang))[0];

const now = new Date();
const builds = await getCollection('builds');
const order = Object.keys(MODES);
const rotations = (await getCollection('rotations')).sort((a, b) => order.indexOf(a.data.mode) - order.indexOf(b.data.mode));

// Текущий баннер — тот, чей конец ещё не наступил (на момент сборки)
const banners = (await getCollection('banners')).map((b) => b.data).sort((a, b) => a.start.localeCompare(b.start));
const banner = banners.find((b) => new Date(b.end) > now) ?? banners.at(-1)!;
const nextBanner = banners.find((b) => b.start > banner.start && new Date(b.start) > now);
const slides = [banner, nextBanner].filter((b): b is typeof banner => Boolean(b)).flatMap((b) =>
  b.featured.map((f) => getCharacter(f.slug)).filter((hero) => hero.rarity === 5)
    .map((hero) => ({ banner: b, hero, upcoming: new Date(b.start) > now })));
const featuredWeapon = (banner as { weapons?: (string | { slug: string })[] }).weapons?.[0];
const weaponSlug = typeof featuredWeapon === 'string' ? featuredWeapon : featuredWeapon?.slug;
const weapon = weapons.find((w) => w.slug === weaponSlug);
// weapon-art.json — массив слагов оружия, у которых есть полный арт
const weaponImage = weaponSlug && (weaponArt as string[]).includes(weaponSlug)
  ? `/img/weapons/${weaponSlug}.webp` : weapon?.icon;
const latestArtifact = [...artifacts].sort((a, b) => parseFloat(b.version) - parseFloat(a.version))[0];
const modeNames: Record<string, [string, string]> = {
  abyss: ['Витая бездна', 'spiral'],
  theater: ['Театр воображариума', 'mask'],
  onslaught: ['Натиск', 'flame'],
};
const modeItems = rotations.map(({ data: r }) => ({
  label: modeNames[r.mode]?.[0] ?? MODES[r.mode].short,
  href: `/${r.mode}`,
  icon: modeNames[r.mode]?.[1] ?? 'moon',
  until: resetAt(r.start > now ? r.start : r.end),
}));
const modes = [
  { label: 'Все режимы', href: '/rotation', icon: 'moon', until: modeItems.map((item) => item.until).sort()[0] },
  ...modeItems,
];
const buildSet = new Set(builds.map((b) => b.data.character));

const leaks = characters.filter((c) => c.beta);
const newest = characters.filter((c) => !c.beta).sort((a, b) => parseFloat(b.version) - parseFloat(a.version) || b.rarity - a.rarity).slice(0, 8 - leaks.length);
const newWeapons = weapons.filter((w) => w.version === newest[0].version).slice(0, 6);
---
<Layout>
  <HeroCarousel slides={slides} />
  <FeatureTabs heroIcon={slides[0]?.hero.icon} weaponImage={weaponImage} artifactIcon={latestArtifact?.icon} modes={modes} />

  {latestNews && (
    <a class="site-news" href={`${base}/news/#${latestNews.data.anchor}`}>
      <div class="news-copy">
        <div class="news-meta"><span>{t('Новости сайта')}</span><time datetime={latestNews.data.date.toISOString()}>{newsDate(latestNews.data.date, lang)}</time></div>
        <h2>{latestNews.data.title}</h2>
        <p>{latestNews.data.summary}</p>
      </div>
      <span class="news-link">{t('Все новости и обновления')} <span aria-hidden="true">→</span></span>
    </a>
  )}

  <CalendarWidget />

  <h2 class="h-sec">{t('Новые персонажи')} <small><a href={`${base}/characters`}>{t('Все {n}', { n: characters.length - leaks.length })}</a> · <a href={`${base}/guides`}>{t('Руководства')} ({builds.length})</a></small></h2>
  <div class="cards">{leaks.map((c) => <CharacterCard slug={c.slug} />)}{newest.map((c) => <CharacterCard slug={c.slug} badge={c.version === newest[0].version ? t('новый') : buildSet.has(c.slug) ? t('билд') : undefined} />)}</div>

  {newWeapons.length > 0 && (
    <>
      <h2 class="h-sec">{t('Новое оружие')} <small><a href={`${base}/weapons`}>{t('Всё оружие')}</a></small></h2>
      <div class="weapons">
        {newWeapons.map((w) => (
          <a class:list={['wcard', `r${w.rarity}`]} href={`${base}/weapons/${w.slug}`}>
            <img src={w.icon} alt="" width="64" height="64" loading="lazy" />
            <span>{w.name}</span>
          </a>
        ))}
      </div>
    </>
  )}
</Layout>

<style>
  .site-news { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin: .2rem 0 1.2rem; padding: 1.1rem 1.3rem; border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border)); border-radius: var(--radius-lg); background: linear-gradient(110deg, var(--accent-soft), var(--surface)); text-decoration: none; }
  .site-news:hover { border-color: var(--accent); }
  .news-copy { flex: 1 1 32rem; min-width: 0; overflow-wrap: anywhere; }
  .news-meta { display: flex; flex-wrap: wrap; gap: .35rem 1rem; font-size: .78rem; color: var(--muted); }
  .news-meta > span { color: var(--accent); font-weight: 600; }
  .site-news h2 { margin: .4rem 0; font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.45; }
  .site-news p { margin: 0; color: var(--muted); font-size: .9rem; }
  .news-link { color: var(--accent); font-size: .85rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 10px; }
  .weapons { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .wcard { display: flex; align-items: center; gap: .6rem; padding: .5rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); text-decoration: none; font-size: .86rem; }
  /* Длинные названия оружия переносятся внутри карточки, а не вылезают за неё */
  .wcard span { min-width: 0; line-height: 1.25; overflow-wrap: anywhere; hyphens: auto; }
  .wcard img { border-radius: 8px; background: linear-gradient(160deg, #5b4b82, #9679c4); flex: none; padding: 4px; box-sizing: border-box; }
  .wcard.r5 img { background: linear-gradient(160deg, #7a5226, #d1953f); }
  .wcard:hover { border-color: var(--accent); }

</style>
