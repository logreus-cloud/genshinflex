---
import { useData, LANGS } from '../../../lib/data';
import Layout from '../../../layouts/Layout.astro';
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { base, t } = useData(Astro.currentLocale);
---
<Layout title={t('Подтверждение входа')} noindex>
  <div class="auth-page" id="callback" data-base={base}
    data-loading={t('Подтверждаем вход…')} data-done={t('Почта подтверждена.')}
    data-error={t('Не удалось подтвердить вход. Запросите новую ссылку или войдите снова.')}
    data-identity-taken={t('Этот аккаунт Discord или Google уже привязан к другому аккаунту GenshinFlex. Войдите в тот аккаунт и отвяжите его там или удалите тот аккаунт.')}
    data-confirm={t('Вход в аккаунт {email} по ссылке. Если вы не запрашивали эту ссылку — отмените.')}
    data-declined={t('Вход отменён.')}>
    <h1>{t('Подтверждение входа')}</h1>
    <div class="panel auth-panel">
      <p class="status small" aria-live="polite">{t('Подтверждаем вход…')}</p>
      <div class="auth-confirm" data-auth-confirm hidden>
        <p class="small" data-auth-confirm-message></p>
        <div class="auth-actions">
          <button class="btn primary" type="button" data-auth-continue>{t('Продолжить')}</button>
          <button class="btn" type="button" data-auth-cancel>{t('Отменить')}</button>
        </div>
      </div>
      <a data-page="login" href={`${base}/account/login/`} hidden>{t('Вернуться ко входу')}</a>
    </div>
  </div>
</Layout>

<script>
  import { authUrl, confirmUrlSession, consumeUrlSession, getSupabase, onPage, pageNext, safeNext } from '../../../scripts/auth';
  import { notifySessionChanged } from '../../../scripts/user-data/session';
  onPage('#callback', (root) => {
    const status = root.querySelector<HTMLElement>('.status')!;
    const login = root.querySelector<HTMLAnchorElement>('[data-page]')!;
    const base = root.dataset.base || '';
    const next = pageNext();
    login.href = authUrl(base, 'login', next);
    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    const query = new URLSearchParams(location.search);
    const hash = new URLSearchParams(location.hash.slice(1));
    const failed = () => {
      if (controller.signal.aborted || !root.isConnected) return;
      status.textContent = root.dataset.error || '';
      status.className = 'status small bad';
      login.hidden = false;
    };
    if (query.has('error') || query.has('error_code') || query.has('error_description') || hash.has('error') || hash.has('error_code') || hash.has('error_description')) {
      failed();
      // Привязка Discord/Google, который уже принадлежит другому аккаунту
      if ((query.get('error_code') || hash.get('error_code')) === 'identity_already_exists') {
        status.textContent = root.dataset.identityTaken || '';
        login.href = `${base}/account/`;
      }
      return;
    }
    void (async () => {
      const result = await consumeUrlSession({ confirm: (email) => confirmUrlSession(root, email, controller.signal), signal: controller.signal });
      if (result === 'aborted' || controller.signal.aborted || !root.isConnected) return;
      if (result === 'declined') {
        status.textContent = root.dataset.declined || '';
        status.className = 'status small';
        login.hidden = false;
        return;
      }
      if (result === 'error') { failed(); return; }
      status.textContent = root.dataset.loading || '';
      const auth = getSupabase().auth;
      let done = false;
      const finish = () => {
        if (done || controller.signal.aborted || !root.isConnected) return;
        done = true;
        status.textContent = root.dataset.done || '';
        status.className = 'status small ok';
        notifySessionChanged();
        location.replace(next ? safeNext(next) : authUrl(base, ''));
      };
      const { data: listener } = auth.onAuthStateChange((event, session) => {
        if (session && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION' || event === 'USER_UPDATED')) finish();
      });
      void auth.getSession().then(({ data, error }) => {
        if (data.session) finish();
        else if (error || root.isConnected) failed();
      }).catch(failed);
      document.addEventListener('astro:before-swap', () => listener.subscription.unsubscribe(), { once: true });
    })();
  });
</script>
