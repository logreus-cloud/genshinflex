---
import { useData, LANGS } from '../../../lib/data';
import Layout from '../../../layouts/Layout.astro';
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { base, t } = useData(Astro.currentLocale);
---
<Layout title={t('Аккаунт')} noindex>
  <div class="auth-page" id="account" data-base={base}
    data-error={t('Не удалось загрузить профиль.')}
    data-telegram={t('Telegram')} data-soon={t('Профиль и синхронизация — скоро.')}
    data-export-error={t('Не удалось скачать данные. Попробуйте позже.')}
    data-delete-error={t('Не удалось удалить аккаунт. Попробуйте позже.')}
    data-reauth={t('Для удаления войдите заново.')}
    data-session-changed={t('Сессия изменилась. Проверьте данные аккаунта и повторите действие.')}
    data-delete-word={t('УДАЛИТЬ')}>
    <h1>{t('Аккаунт')}</h1>
    <div class="panel auth-panel">
      <p class="status small" aria-live="polite"></p>
      <div class="account-details" hidden>
        <p><strong>{t('Ник')}:</strong> <span data-field="nickname">—</span></p>
        <p><strong>{t('Отображаемое имя')}:</strong> <span data-field="display_name">—</span></p>
        <p><strong>{t('Email')}:</strong> <span data-field="email">—</span></p>
        <p><strong>{t('Способы входа')}:</strong> <span data-field="providers">—</span></p>
        <p class="muted">{t('Профиль и синхронизация — скоро.')}</p>
        <div class="auth-actions">
          <a class="btn" data-page="reset" href={`${base}/account/reset/`} hidden>{t('Сменить пароль')}</a>
          <a class="btn" href={`${base}/profile/`}>{t('Мой профиль')}</a>
          <button class="btn" type="button" id="signout">{t('Выйти')}</button>
        </div>
      </div>
      <div class="account-details" hidden>
        <h2>{t('Данные и конфиденциальность')}</h2>
        <p><a href={`${base}/privacy/`}>{t('Политика конфиденциальности')}</a></p>
        <button class="btn" type="button" id="export-data">{t('Скачать мои данные')}</button>
        <details id="delete-account">
          <summary>{t('Удалить аккаунт')}</summary>
          <p class="muted">{t('Аккаунт, профиль, данные и аватары будут удалены. Это нельзя отменить.')}</p>
          <label>{t('Введите УДАЛИТЬ')}
            <input class="input" id="delete-word" type="text" autocomplete="off" />
          </label>
          <div class="auth-actions">
            <button class="btn" type="button" id="delete-submit" disabled>{t('Удалить аккаунт')}</button>
            <button class="btn" type="button" id="reauth" hidden>{t('Войти заново')}</button>
          </div>
        </details>
      </div>
      <p class="status small" id="data-status" aria-live="polite"></p>
    </div>
  </div>
</Layout>

<script>
  import { authUrl, getSupabase, onPage, signOut } from '../../../scripts/auth';
  import { API_URL } from '../../../lib/platform';
  import { notifySessionChanged, onSessionChange } from '../../../scripts/user-data/session';
  onPage('#account', (root) => {
    const base = root.dataset.base || '';
    const status = root.querySelector<HTMLElement>('.status')!;
    const details = root.querySelectorAll<HTMLElement>('.account-details');
    const field = (name: string, value: string) => {
      root.querySelector<HTMLElement>(`[data-field="${name}"]`)!.textContent = value || '—';
    };
    const dataStatus = root.querySelector<HTMLElement>('#data-status')!;
    const showDataStatus = (message: string) => {
      dataStatus.textContent = message;
      dataStatus.className = 'status small bad';
    };
    const word = root.querySelector<HTMLInputElement>('#delete-word')!;
    const submit = root.querySelector<HTMLButtonElement>('#delete-submit')!;
    const reauth = root.querySelector<HTMLButtonElement>('#reauth')!;
    let deleting = false;
    let leaving = false;
    let loadedUserId: string | null = null;
    let loadRequest = 0;
    const updateSubmit = () => {
      submit.disabled = deleting || word.value.trim().toLocaleUpperCase() !== (root.dataset.deleteWord || '').toLocaleUpperCase();
    };
    if (location.hash === '#delete') root.querySelector<HTMLDetailsElement>('#delete-account')!.open = true;
    const load = async () => {
      const request = ++loadRequest;
      loadedUserId = null;
      details.forEach((detail) => { detail.hidden = true; });
      status.textContent = '';
      status.className = 'status small';
      try {
        const supabase = getSupabase();
        const { data: session } = await supabase.auth.getSession();
        if (request !== loadRequest || !root.isConnected) return;
        if (!session.session) {
          location.replace(authUrl(base, 'login', location.pathname + location.search + location.hash));
          return;
        }
        const user = session.session.user;
        const { data: profile, error } = await supabase.from('profiles')
          .select('nickname,display_name').eq('id', user.id).maybeSingle();
        if (request !== loadRequest || !root.isConnected) return;
        // Сбой запроса не выдаём за пустой профиль
        if (error) throw error;
        field('nickname', String(profile?.nickname || ''));
        field('display_name', String(profile?.display_name || user.user_metadata?.display_name || ''));
        const telegram = user.app_metadata?.telegram_id;
        const synthetic = /^tg\d+@telegram\.genshinflex\.com$/i.test(user.email || '');
        field('email', synthetic
          ? `${root.dataset.telegram} @${user.user_metadata?.telegram_username || telegram || ''}`
          : user.email || '');
        const providers = new Set((user.identities || []).map((identity) => identity.provider));
        if (telegram) providers.add('telegram');
        field('providers', [...providers].map((provider) => provider === 'telegram' ? root.dataset.telegram || 'Telegram' : provider).join(', '));
        const reset = root.querySelector<HTMLAnchorElement>('[data-page="reset"]')!;
        reset.href = authUrl(base, 'reset');
        reset.hidden = !providers.has('email');
        loadedUserId = user.id;
        details.forEach((detail) => { detail.hidden = false; });
      } catch {
        if (request !== loadRequest || !root.isConnected) return;
        status.textContent = root.dataset.error || '';
        status.className = 'status small bad';
      }
    };
    void load();
    const refreshAccount = () => {
      word.value = '';
      reauth.hidden = true;
      updateSubmit();
      showDataStatus(root.dataset.sessionChanged || '');
      void load();
    };
    onSessionChange(() => { if (!leaving && root.isConnected) refreshAccount(); });
    // Пользователь фиксируется до первого await: пока ждём сессию, страница может успеть загрузить другой аккаунт
    const accessToken = async () => {
      const expected = loadedUserId;
      const { data, error } = await getSupabase().auth.getSession();
      if (error) throw new Error('session');
      if (!expected || loadedUserId !== expected || !data.session || data.session.user.id !== expected) {
        refreshAccount();
        return null;
      }
      return { token: data.session.access_token, userId: expected };
    };
    // Сессия всё ещё того пользователя, для которого начата операция
    const sameUser = async (userId: string) => {
      const { data } = await getSupabase().auth.getSession();
      return loadedUserId === userId && data.session?.user.id === userId;
    };
    root.querySelector<HTMLButtonElement>('#export-data')!.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      dataStatus.textContent = '';
      try {
        const access = await accessToken();
        if (!access) return;
        const response = await fetch(`${API_URL}/me/export`, {
          headers: { Authorization: `Bearer ${access.token}` },
        });
        if (!response.ok) throw new Error('export');
        const url = URL.createObjectURL(await response.blob());
        const link = document.createElement('a');
        link.href = url;
        link.download = 'genshinflex-data.json';
        document.body.append(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      } catch {
        showDataStatus(root.dataset.exportError || '');
      } finally {
        button.disabled = false;
      }
    });
    word.addEventListener('input', () => {
      updateSubmit();
    });
    submit.addEventListener('click', async () => {
      if (deleting || submit.disabled) return;
      deleting = true;
      word.disabled = true;
      updateSubmit();
      dataStatus.textContent = '';
      try {
        const access = await accessToken();
        if (!access) return;
        const response = await fetch(`${API_URL}/me`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${access.token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ confirm: 'DELETE' }),
        });
        // Пока шёл запрос, в другой вкладке могли войти в другой аккаунт: его не трогаем
        if (!await sameUser(access.userId)) { refreshAccount(); return; }
        if (response.status === 401) {
          const data = await response.json() as { code?: string };
          if (data.code === 'reauth_required') {
            showDataStatus(root.dataset.reauth || '');
            reauth.hidden = false;
            return;
          }
        }
        if (!response.ok) throw new Error('delete');
        await getSupabase().auth.signOut({ scope: 'local' });
        leaving = true;
        notifySessionChanged();
        location.assign(`${base}/account/deleted/`);
      } catch {
        showDataStatus(root.dataset.deleteError || '');
      } finally {
        deleting = false;
        word.disabled = false;
        updateSubmit();
      }
    });
    reauth.addEventListener('click', async () => {
      await getSupabase().auth.signOut({ scope: 'local' });
      leaving = true;
      notifySessionChanged();
      location.assign(authUrl(base, 'login', `${base}/account/#delete`));
    });
    root.querySelector<HTMLButtonElement>('#signout')!.addEventListener('click', async () => {
      const { error } = await signOut();
      if (error) {
        status.textContent = root.dataset.error || '';
        status.className = 'status small bad';
        return;
      }
      leaving = true;
      notifySessionChanged();
      location.assign(`${base}/`);
    });
  });
</script>
