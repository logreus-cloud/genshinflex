---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FilterBar from '../../components/FilterBar.astro';
import CharacterIcon from '../../components/CharacterIcon.astro';
import { useData, LANGS } from '../../lib/data';
// Каждая страница существует в трёх языках: / (ru), /en/, /es/
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { artifacts, t } = useData(Astro.currentLocale);

// Кто носит сет: по билдам, где он встречается
const builds = await getCollection('builds');
const users = new Map(artifacts.map((a) => [a.slug, builds.filter((b) => b.data.artifacts.some((x) => x.sets.includes(a.slug))).map((b) => b.data.character)]));
---
<Layout title={t('Артефакты')} wide>
  <h1>{t('Артефакты')}</h1>
  <p class="lead">{t('{n} сетов артефактов с бонусами за 2 и 4 предмета. Под сетом — персонажи из наших билдов, которые его носят.', { n: artifacts.length })}</p>

  <FilterBar target="#sets" placeholder={t('Найти сет')} groups={['rarity']} rarities={[5, 4]} />

  <div class="sets" id="sets">
    {artifacts.map((a) => {
      const who = users.get(a.slug) ?? [];
      return (
        <div data-name={`${a.name} ${a.nameEn}`.toLowerCase().replace(/ё/g, 'е')} data-rarity={String(a.rarity)} id={a.slug} class="panel set">
          <div class="set-head">
            <img class:list={[`r${a.rarity}`]} src={a.icon} alt="" width="56" height="56" loading="lazy" />
            <h2>{a.name}</h2>
          </div>
          {a.bonus2 && <p><span class="chip gold">{t('2 предмета')}</span> {a.bonus2}</p>}
          {a.bonus4 && <p><span class="chip gold">{t('4 предмета')}</span> {a.bonus4}</p>}
          {who.length > 0 && <div class="who">{who.map((s) => <CharacterIcon slug={s} size={36} label={false} />)}</div>}
        </div>
      );
    })}
  </div>
  <p class="empty muted" hidden>{t('Ничего не нашлось.')}</p>
</Layout>

<style>
  .sets { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 12px; align-items: start; }
  .set { scroll-margin-top: calc(var(--top-h) + 16px); }
  .set:target { border-color: var(--accent); }
  .set-head { display: flex; align-items: center; gap: .8rem; margin-bottom: .6rem; }
  .set-head h2 { margin: 0; font-size: 1rem; }
  .set-head img { border-radius: 10px; background: linear-gradient(170deg, #4a3d6d, #9679c4); flex: none; }
  .set-head img.r5 { background: linear-gradient(170deg, #6b4520, #d1953f); }
  .set p { font-size: .88rem; color: var(--muted); margin: 0 0 .5rem; }
  .set .chip { margin-right: .3rem; }
  .who { display: flex; flex-wrap: wrap; gap: 4px; margin-top: .6rem; padding-top: .6rem; border-top: 1px solid var(--border); }
  .empty { text-align: center; margin: 3rem 0; }
  @media (max-width: 420px) { .sets { grid-template-columns: 1fr; } }
</style>
