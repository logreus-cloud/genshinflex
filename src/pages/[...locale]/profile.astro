---
import Layout from '../../layouts/Layout.astro';
import { useData, LANGS } from '../../lib/data';
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { base, t } = useData(Astro.currentLocale);
---
<Layout title={t('Мой профиль')} description={t('Избранное, персонажи и история круток из этого браузера.')}>
  <div class="profile-page">
    <section class="profile-card hero">
      <div class="hero-info">
        <div class="avatar" id="profile-avatar"><svg viewBox="0 0 20 20" width="42" height="42" aria-hidden="true"><circle cx="10" cy="7" r="3.2" /><path d="M4 17c0-3.2 2.6-5.2 6-5.2s6 2 6 5.2" /></svg></div>
        <div class="identity">
          <h1 id="profile-name">{t('Мой профиль')}</h1>
          <p class="muted" id="profile-meta" hidden></p>
          <p id="profile-signature" hidden></p>
        </div>
      </div>
      <form id="showcase-form">
        <label for="profile-uid">{t('UID')}</label>
        <div class="uid-row">
          <input class="input" id="profile-uid" inputmode="numeric" pattern="[0-9]{9,10}" maxlength="10" autocomplete="off" placeholder="700000000" />
          <button class="btn primary" id="load-showcase" type="submit">{t('Загрузить витрину')}</button>
        </div>
      </form>
      <p class="status small" id="profile-status" aria-live="polite"></p>
      <div class="showcase" id="showcase" hidden>
        <h2>{t('Витрина')}</h2>
        <div class="strip" id="showcase-list"></div>
      </div>
    </section>
    <div class="profile-grid">
      <section class="profile-card">
        <h2>{t('Избранное')}</h2>
        <div class="tile-grid" id="favorites-list"></div>
      </section>
      <section class="profile-card">
        <h2>{t('Мои персонажи')} <small id="roster-count"></small></h2>
        <div class="strip" id="roster-list"></div>
        <a class="card-link" href={`${base}/tools/team-check/`}>{t('Изменить в проверке команды')}</a>
      </section>
      <section class="profile-card">
        <h2>{t('Крутки')}</h2>
        <div class="wish-list" id="wishes-list"></div>
        <a class="card-link" href={`${base}/tools/wishes/`}>{t('Открыть трекер круток')}</a>
      </section>
      <section class="profile-card recent-card" hidden>
        <h2>{t('Недавно просмотренное')}</h2>
        <div class="strip" id="recent-list"></div>
      </section>
    </div>
    <noscript><p class="profile-card">{t('Для профиля нужен JavaScript')}</p></noscript>
    <p class="privacy">{t('Все данные профиля хранятся только в этом браузере и никуда не отправляются, кроме запроса витрины по UID.')}</p>
  </div>
</Layout>

<script>
  import { favorites, recent, store, type Entry } from '../../scripts/common';
  import { BASE, t } from '../../scripts/search';

  type Char = { id: number | null; s: string; n: string; i: string };
  type Profile = { uid: string; time: number; player: { nickname: string; level: number; worldLevel: number; signature: string; profilePictureId?: number }; showcase: number[] };
  type Wish = { id: string; uid: string; gacha_type: string; time: string; name: string; item_type: string; rank_type: string };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const read = (key: string): unknown => { try { return store.get<unknown>(key, null); } catch { return null; } };
  const isRecord = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
  const uidOk = (value: unknown): value is string => typeof value === 'string' && /^\d{9,10}$/.test(value);
  const num = (value: unknown) => value !== null && value !== undefined && Number.isFinite(Number(value)) ? Number(value) : null;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', label = '') => { const node = document.createElement(tag); node.className = className; node.textContent = label; return node; };
  const iconUrl = (value: unknown) => { if (typeof value !== 'string') return null; try { const url = new URL(value, location.origin); return ['http:', 'https:'].includes(url.protocol) ? url.href : null; } catch { return null; } };
  const safeHref = (value: string) => { if (!value.startsWith('/') || value.startsWith('//')) return null; try { const url = new URL(value, location.origin); return url.origin === location.origin ? url.pathname + url.search + url.hash : null; } catch { return null; } };
  const img = (src: string, size: number) => { const node = document.createElement('img'); node.src = src; node.alt = ''; node.width = size; node.height = size; node.loading = 'lazy'; return node; };
  const charsById = new Map<number, Char>();
  const charsBySlug = new Map<string, Char>();
  let charsReady = false, currentProfile: Profile | null = null;
  const avatar = $('profile-avatar');
  const placeholder = avatar.firstElementChild!.cloneNode(true);
  const status = (message: string, bad = false) => { $('profile-status').textContent = message; $('profile-status').classList.toggle('bad', bad); };

  function validCache(value: unknown): Profile | null {
    if (!isRecord(value) || !uidOk(value.uid) || typeof value.time !== 'number' || !isRecord(value.player) || !Array.isArray(value.showcase)) return null;
    const player = value.player;
    if (typeof player.nickname !== 'string' || typeof player.level !== 'number' || typeof player.worldLevel !== 'number' || typeof player.signature !== 'string') return null;
    return { uid: value.uid, time: value.time, player: { nickname: player.nickname, level: player.level, worldLevel: player.worldLevel, signature: player.signature,
      profilePictureId: typeof player.profilePictureId === 'number' ? player.profilePictureId : undefined }, showcase: value.showcase.filter((id): id is number => typeof id === 'number' && Number.isFinite(id)) };
  }
  function addChar(parent: HTMLElement, char: Char) {
    const link = document.createElement('a');
    link.href = `${BASE}/characters/${char.s}/`;
    link.title = char.n;
    const src = iconUrl(char.i);
    if (src) link.append(img(src, 56));
    link.append(el('span', '', char.n));
    parent.append(link);
  }
  function renderProfile() {
    const player = currentProfile?.player;
    $('profile-name').textContent = player?.nickname || t('Мой профиль');
    const meta = $('profile-meta');
    meta.hidden = !player;
    meta.textContent = player ? t('Ранг приключений {level} · Уровень мира {world}', { level: player.level, world: player.worldLevel }) : '';
    const signature = $('profile-signature');
    signature.hidden = !player?.signature;
    signature.textContent = player?.signature ?? '';
    avatar.replaceChildren(placeholder.cloneNode(true));
    const picture = player?.profilePictureId && charsById.get(player.profilePictureId);
    const src = picture && iconUrl(picture.i);
    if (src) avatar.replaceChildren(img(src, 80));
    const showcase = $('showcase');
    showcase.hidden = !currentProfile;
    const items = $('showcase-list');
    items.replaceChildren();
    if (currentProfile && charsReady) {
      for (const id of currentProfile.showcase) { const char = charsById.get(id); if (char) addChar(items, char); }
      if (!items.childElementCount) items.textContent = currentProfile.showcase.length ? t('На витрине нет знакомых персонажей.') : t('Витрина пуста или скрыта.');
    }
    $('load-showcase').textContent = currentProfile ? t('Обновить') : t('Загрузить витрину');
  }
  function entries(getter: () => Entry[]) {
    let raw: unknown;
    try { raw = getter(); } catch { raw = []; }
    return Array.isArray(raw) ? raw.filter((item): item is Entry => isRecord(item) && typeof item.href === 'string' && typeof item.name === 'string' && typeof item.kind === 'string' && (item.icon === undefined || item.icon === null || typeof item.icon === 'string')) : [];
  }
  function renderEntries(id: string, list: Entry[], empty: string, hideEmpty = false) {
    const box = $(id);
    box.replaceChildren();
    box.closest('section')!.hidden = hideEmpty && !list.length;
    if (!list.length) { if (!hideEmpty) box.textContent = t(empty); return; }
    for (const item of list.slice(0, 100)) {
      const href = safeHref(item.href);
      if (!href) continue;
      const link = document.createElement('a');
      link.href = href;
      const src = iconUrl(item.icon);
      if (src) link.append(img(src, 40));
      link.append(el('span', '', item.name));
      box.append(link);
    }
    if (!box.childElementCount && !hideEmpty) box.textContent = t(empty);
    if (hideEmpty && !box.childElementCount) box.closest('section')!.hidden = true;
  }
  function renderRoster() {
    const box = $('roster-list');
    box.replaceChildren();
    if (!charsReady) { box.textContent = t('Не удалось загрузить данные персонажей.'); return; }
    const raw = read('gf:roster');
    const seen = new Set<string>();
    const list = (Array.isArray(raw) ? raw : []).filter((item): item is { s: string } => isRecord(item) && typeof item.s === 'string' && charsBySlug.has(item.s) && !seen.has(item.s) && !!seen.add(item.s));
    $('roster-count').textContent = list.length ? t('Персонажей: {n}', { n: list.length }) : '';
    if (!list.length) { box.textContent = t('Добавьте персонажей в проверке команды или загрузите по UID.'); return; }
    for (const item of list.slice(0, 16)) addChar(box, charsBySlug.get(item.s)!);
    if (list.length > 16) box.append(el('span', 'more', `+${list.length - 16}`));
  }
  function renderWishes() {
    const box = $('wishes-list');
    box.replaceChildren();
    const raw = read('gf:wish-uids');
    const uids = Array.isArray(raw) ? [...new Set(raw.filter((uid): uid is string => uidOk(uid) || uid === 'manual'))] : [];
    for (const uid of uids) {
      const saved = read(`gf:wishes:${uid}`);
      const list: Wish[] = Array.isArray(saved) ? saved.filter((item): item is Wish => isRecord(item) && ['id', 'uid', 'gacha_type', 'time', 'name', 'item_type', 'rank_type'].every((key) => typeof item[key] === 'string'))
        .sort((a, b) => a.id.length - b.id.length || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0)) : [];
      if (!list.length) continue;
      const account = el('div', 'account');
      account.append(el('h3', '', uid === 'manual' ? t('Ручной ввод') : t('UID {uid}', { uid })));
      const fives = list.filter((wish) => wish.rank_type === '5').length;
      account.append(el('p', 'summary', t('Молитв: {total} · 5★: {fives}', { total: list.length, fives })));
      for (const [title, types] of [
        [t('Молитва события персонажа'), ['301', '400']], [t('Молитва события оружия'), ['302']], [t('Стандартная молитва'), ['200']],
      ] as [string, string[]][]) {
        const rows = list.filter((wish) => types.includes(wish.gacha_type));
        let pity = 0;
        for (const wish of rows) pity = wish.rank_type === '5' ? 0 : pity + 1;
        const line = el('div', 'pity-row');
        line.append(el('span', '', title), el('span', '', t('Текущий гарант: {n}', { n: pity })));
        account.append(line);
      }
      box.append(account);
    }
    if (!box.childElementCount) box.append(el('p', 'empty', t('История круток не загружена')));
  }

  renderEntries('favorites-list', entries(favorites.list), 'Добавляйте персонажей и оружие в избранное кнопкой ☆ на их страницах.');
  renderEntries('recent-list', entries(recent.list), '', true);
  renderWishes();
  currentProfile = validCache(read('gf:profile-cache'));
  const uidInput = $<HTMLInputElement>('profile-uid');
  // Если показан кэш витрины — в поле его UID, чтобы «Обновить» обновляло тот же аккаунт
  if (currentProfile && uidOk(currentProfile.uid)) uidInput.value = currentProfile.uid;
  else for (const key of ['gf:profile-uid', 'gf:sim-uid', 'gf:wish-uid']) { const value = read(key); if (uidOk(value)) { uidInput.value = value; break; } }
  renderProfile();
  fetch(`${BASE}/data/checker.json`).then(async (response) => { if (!response.ok) throw new Error(); return response.json(); }).then((data: unknown) => {
    if (!isRecord(data) || !Array.isArray(data.characters)) throw new Error();
    for (const value of data.characters) if (isRecord(value) && typeof value.id === 'number' && typeof value.s === 'string' && /^[a-z0-9-]+$/.test(value.s) && typeof value.n === 'string' && typeof value.i === 'string') {
      const char = value as Char; charsById.set(char.id!, char); charsBySlug.set(char.s, char);
    }
    charsReady = true; renderRoster(); renderProfile();
  }).catch(() => { $('roster-list').textContent = t('Не удалось загрузить данные персонажей.'); });
  $('showcase-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const uid = uidInput.value.trim();
    if (!uidOk(uid)) return status(t('UID — это 9 или 10 цифр из правого нижнего угла экрана в игре.'), true);
    const button = $<HTMLButtonElement>('load-showcase');
    button.disabled = true;
    status(t('Загружаю витрину…'));
    try {
      const response = await fetch(`/api/enka/${uid}`);
      const body: unknown = await response.json();
      if (!response.ok) return status(t(isRecord(body) && typeof body.error === 'string' ? body.error : 'Не удалось загрузить профиль.'), true);
      if (!isRecord(body) || !isRecord(body.playerInfo)) return status(t('Не удалось загрузить профиль.'), true);
      const player = body.playerInfo;
      const picture = isRecord(player.profilePicture) ? num(player.profilePicture.avatarId ?? player.profilePicture.id) : null;
      const shown = Array.isArray(player.showAvatarInfoList) && player.showAvatarInfoList.length ? player.showAvatarInfoList : body.avatarInfoList;
      const showcase = Array.isArray(shown) ? shown.map((item) => isRecord(item) ? num(item.avatarId) : null).filter((id): id is number => id !== null) : [];
      currentProfile = { uid, time: Date.now(), player: { nickname: typeof player.nickname === 'string' ? player.nickname : '', level: num(player.level) ?? 0,
        worldLevel: num(player.worldLevel) ?? 0, signature: typeof player.signature === 'string' ? player.signature : '', profilePictureId: picture ?? undefined }, showcase };
      store.set('gf:profile-uid', uid);
      store.set('gf:profile-cache', currentProfile);
      renderProfile();
      status(t('Витрина обновлена.'));
    } catch { status(t('Не удалось связаться с сервером. Проверьте интернет и попробуйте ещё раз.'), true); }
    finally { button.disabled = false; }
  });
</script>

<style>
  .profile-page { display: grid; gap: 14px; }
  .profile-card { min-width: 0; padding: 1.2rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .profile-grid > * { min-width: 0; }
  .hero { display: grid; gap: 1rem; }
  .hero-info { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .avatar { width: 80px; height: 80px; flex: none; display: grid; place-items: center; overflow: hidden; border: 2px solid var(--accent); border-radius: 50%; background: var(--surface-2); color: var(--accent-text); }
  .avatar svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .identity { min-width: 0; overflow-wrap: anywhere; }
  .identity h1 { margin: 0; }
  .identity p { margin: .3rem 0 0; }
  #showcase-form { display: grid; gap: .35rem; }
  #showcase-form label { color: var(--muted); font-size: .82rem; }
  .uid-row { display: flex; gap: .5rem; flex-wrap: wrap; }
  .uid-row .input { width: 190px; max-width: 100%; min-width: 0; }
  .uid-row .btn { white-space: normal; }
  .status { min-height: 1.2em; margin: 0; }
  .status.bad { color: var(--bad); }
  .showcase { border-top: 1px solid var(--border); padding-top: 1rem; }
  .showcase h2 { margin: 0 0 .6rem; font-size: 1rem; }
  .strip { display: flex; gap: .5rem; max-width: 100%; overflow-x: auto; padding-bottom: .3rem; }
  .strip :global(a) { flex: none; width: 76px; display: grid; justify-items: center; gap: .3rem; color: var(--text); text-align: center; text-decoration: none; font-size: .72rem; overflow-wrap: anywhere; }
  .strip :global(img) { border-radius: 10px; background: var(--surface-2); }
  .strip :global(.more) { flex: none; align-self: center; color: var(--muted); }
  .profile-card h2 { margin: 0 0 .8rem; font-size: 1.15rem; }
  .tile-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(135px, 1fr)); gap: .5rem; }
  .tile-grid :global(a) { min-width: 0; display: flex; align-items: center; gap: .5rem; padding: .4rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); color: var(--text); text-decoration: none; overflow-wrap: anywhere; }
  .tile-grid :global(img) { flex: none; border-radius: 8px; }
  .tile-grid :global(span) { min-width: 0; }
  #roster-count { color: var(--muted); font-size: .75rem; font-weight: 400; }
  .wish-list { display: grid; gap: .7rem; }
  .wish-list :global(.account) { padding: .7rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); }
  .wish-list :global(h3) { margin: 0; font-size: .95rem; }
  .wish-list :global(.summary) { margin: .3rem 0 .6rem; color: var(--accent-text); }
  .wish-list :global(.pity-row) { display: flex; justify-content: space-between; gap: .5rem; padding: .25rem 0; font-size: .82rem; }
  .wish-list :global(.pity-row span:first-child) { min-width: 0; overflow-wrap: anywhere; }
  .empty { color: var(--muted); }
  .card-link { display: inline-block; margin-top: .8rem; color: var(--accent-text); }
  .privacy { margin: .3rem 0 1.5rem; color: var(--muted); font-size: .78rem; }
  [hidden] { display: none !important; }
  @media (max-width: 900px) { .profile-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 400px) { .profile-card { padding: .9rem; } .avatar { width: 64px; height: 64px; } .uid-row .input { flex: 1 1 130px; } }
</style>
