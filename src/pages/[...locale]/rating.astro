---
import { getCollection } from 'astro:content';
import { useData, LANGS } from '../../lib/data';
import Layout from '../../layouts/Layout.astro';
import TierTable from '../../components/TierTable.astro';
import CharacterIcon from '../../components/CharacterIcon.astro';
import Team from '../../components/Team.astro';
import rating from '../../data/rating.json';
import investments from '../../data/investments.json';
import damageLimits from '../../data/damage-limits.json';
import manual from '../../data/rating-manual.json';
import externalData from '../../data/rating-external.json';
import bossData from '../../data/rating-bosses.json';
import enemies from '../../data/generated/enemies.json';
import charactersEn from '../../data/generated/characters.en.json';
import { buildOverall, consVariants, elementFromRu, fitsAbyssHalf, fitsTheater, rankTeams, reactionLabel, simUrl, variantKey, type Element, type RatingData, type RatingExternal, type RatingManual, type Role, type TeamRow } from '../../lib/rating/core';
import { BOSS_TAGS, bossGroup, mechanicTags, rankBossTeams, type Boss, type BossMember, type BossTag } from '../../lib/rating/bosses';
import { EXPLORE_CATEGORIES, EXPLORE_TAGS, explorationTags, rankExploration } from '../../lib/rating/exploration';
// Каждая страница существует в трёх языках: / (ru), /en/, /es/
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { base, t, lang, characters, fmtNumber, fmtFullDate } = useData(Astro.currentLocale);
const data = rating as RatingData;
const expert = manual as RatingManual;
const external = externalData as RatingExternal;
const overall = buildOverall(data, expert, external);
const manualTierSources = Object.values(expert.characters).flatMap((character) => character.sources).filter((source, index, sources) => sources.findIndex((item) => item.title === source.title) === index);
const bySlug = new Map(characters.map((c) => [c.slug, c]));
const investmentRows = investments as unknown as Record<string, { cons: (number | null)[]; weapon?: number | null } | undefined>;
const gainOf = (slug: string, level: 0 | 1 | 2, weapon: boolean) => {
  const row = investmentRows[slug];
  const traveler = slug.startsWith('traveler-');
  const constellation = level > 0 && bySlug.get(slug)?.rarity === 5 && !traveler ? row?.cons[level - 1] ?? null : null;
  const weaponValue = row?.weapon;
  const weaponGain = weapon && !traveler && typeof weaponValue === 'number' ? weaponValue : null;
  if (constellation === null) return weaponGain;
  if (weaponGain === null) return constellation;
  return ((1 + constellation / 100) * (1 + weaponGain / 100) - 1) * 100;
};
const enPassives = new Map(charactersEn.map((c) => [c.slug, c.talents?.passives ?? []]));
const bosses = bossData.bosses as unknown as Boss[];
const enemiesByName = enemies as Record<string, { ru: string; en: string; es: string; icon?: string }>;
const bossCharacters = new Map(charactersEn.map((c) => [c.slug, { weapon: c.weapon, mechanics: mechanicTags(JSON.stringify(c.talents ?? {})) }]));
const bossTags = Object.keys(BOSS_TAGS) as BossTag[];
const elementText: Record<Element, string> = { pyro: 'Пиро', hydro: 'Гидро', anemo: 'Анемо', electro: 'Электро', dendro: 'Дендро', cryo: 'Крио', geo: 'Гео' };
const needText = (need: Element[][]) => need.map((group) => group.map((element) => t(elementText[element])).join(' / ')).join(' + ');
const explore = rankExploration(characters.filter((c) => !c.slug.startsWith('traveler-'))
  .map((c) => ({ slug: c.slug, tags: explorationTags(enPassives.get(c.slug) ?? [], expert.exploration?.[c.slug] ?? []) })));
const roles: { id: Role; label: string }[] = [
  { id: 'carry', label: 'Керри' }, { id: 'subdps', label: 'Саб-DPS' },
  { id: 'support', label: 'Поддержка' }, { id: 'sustain', label: 'Сустейн' },
];
const roleCons = new Map(roles.map(({ id }) => [id, consVariants(overall[id], gainOf)] as const));
const tabs = [{ id: 'tiers', label: 'Тир-лист' }, ...roles, { id: 'abyss', label: 'Бездна' }, { id: 'theater', label: 'Театр' }, { id: 'bosses', label: 'Боссы' }, { id: 'explore', label: 'Исследование' }, { id: 'method', label: 'Как считаем' }];
const compact = new Intl.NumberFormat({ ru: 'ru-RU', en: 'en-US', es: 'es-ES' }[lang], { notation: 'compact', maximumFractionDigits: 2 });
const damageCompact = new Intl.NumberFormat({ ru: 'ru-RU', en: 'en-US', es: 'es-ES' }[lang], { notation: 'compact', maximumFractionDigits: 1 });
const teams = data.teams.filter((team) => team.m.length === 4 && team.m.every((slug) => bySlug.has(slug)));
const members = (team: TeamRow) => team.m.map((slug) => bySlug.get(slug)!);
const bossMembers = (team: TeamRow): BossMember[] => team.m.map((slug) => ({
  slug, element: bySlug.get(slug)!.element as Element, weapon: bossCharacters.get(slug)?.weapon ?? '',
  carry: !!data.characters[slug]?.carry, healer: ['heal', 'both'].includes(expert.sustain[slug]?.kind ?? ''),
  mechanics: bossCharacters.get(slug)?.mechanics ?? [],
}));
const elements = (team: TeamRow): Element[] => members(team).map((c) => c.element as Element);
const reaction = (team: TeamRow) => {
  const label = reactionLabel(team.reaction, elements(team));
  return label.startsWith('Моно ') ? t('Моно {element}', { element: t(label.slice(5)) }) : t(label);
};
const rotations = await getCollection('rotations');
const abyss = rotations.find((r) => r.data.mode === 'abyss')?.data;
const theater = rotations.find((r) => r.data.mode === 'theater')?.data;
const seasonElements = theater?.tags.map(elementFromRu).filter((el): el is Element => el !== null) ?? [];
const cast = theater?.cast.flatMap((group) => group.members) ?? [];
const theaterTeams = seasonElements.length
  ? rankTeams(teams, (team) => fitsTheater(members(team).map((c) => ({ slug: c.slug, element: c.element as Element })), seasonElements, cast), 15)
  : [];
const sustainLevels = { plenty: 'с запасом', enough: 'хватает', low: 'мало' } as const;
const sustainKinds = { heal: 'лечение', shield: 'щит', both: 'лечение и щит' } as const;
const supportPct = (value: number) => { const pct = Math.round((value - 1) * 100); return pct < 0 ? `−${-pct}` : `+${pct}`; };
const tierEntries = roles.flatMap(({ id, label }) => overall[id].flatMap((row, order) => {
  const c = bySlug.get(row.slug);
  if (!c) return [];
  const variants = roleCons.get(id)!.get(row.slug)!;
  const cons = Object.fromEntries(([false, true] as const).flatMap((weapon) => ([0, 1, 2] as const).map((level) => {
    const key = variantKey(level, weapon);
    const { score, tier, rank, gain } = id === 'sustain' ? variants['0'] : variants[key];
    return [key, [score, tier, rank, gain]];
  })));
  const noSim = id === 'sustain' || c.rarity !== 5 || row.slug.startsWith('traveler-') ? [] : ([1, 2] as const).filter((level) => typeof investmentRows[row.slug]?.cons[level - 1] !== 'number');
  return [{ role: id, roleLabel: label, row, c, cons: JSON.stringify(cons), noSim: noSim.length ? noSim.join(',') : undefined,
    sources: expert.characters[row.slug]?.sources ?? [], sustain: expert.sustain[row.slug],
    limit: damageLimits.limits[row.slug as keyof typeof damageLimits.limits], supportN: data.characters[row.slug]?.support?.n ?? 0, order }];
}));
---
<Layout title={t('Рейтинг')} description={t('Рейтинг персонажей Genshin Impact по ролям и лучшие команды текущей Бездны и Театра по симуляциям gcsim.')} wide>
  <h1>{t('Рейтинг')}</h1>
  <p class="muted intro">{t('Рейтинг по ролям и командам текущих циклов основан на открытых симуляциях gcsim из базы KQM и наших прогонах. Роли между собой не сравниваются.')}</p>
  <div data-rating-tabs>
    <div class="tabs" role="tablist" aria-label={t('Разделы рейтинга')}>
      {tabs.map(({ id, label }, i) => <button id={`tab-${id}`} type="button" role="tab" aria-controls={id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={id}>{t(label)}</button>)}
    </div>
    <section id="tiers" class="rating-section" role="tabpanel" aria-labelledby="tab-tiers" data-gain-template={t('{variant}: +{pct}% к урону команды')} data-nosim-template={t('C{n}: нет симуляции')} data-nosim-short-template={t('нет C{n}')} data-nosim-title={t('Для этого персонажа нет симуляции созвездий, поэтому балл не умножается на созвездия')}>
      <h2 class="h-sec">{t('Тир-лист')}</h2>
      <TierTable roles={roles} entries={tierEntries} external={external} compact={compact} damageCompact={damageCompact} fmtNumber={fmtNumber} fmtFullDate={fmtFullDate} supportPct={supportPct} />
    </section>
    {roles.map(({ id, label }) => (
      <section id={id} class="rating-section" role="tabpanel" aria-labelledby={`tab-${id}`} data-gain-template={t('{variant}: +{pct}% к урону команды')} data-nosim-template={t('C{n}: нет симуляции')} data-nosim-title={t('Для этого персонажа нет симуляции созвездий, поэтому балл не умножается на созвездия')}>
        <h2 class="h-sec">{t(label)}</h2>
        {id !== 'sustain' && <div class="cons-switch" role="group" aria-label={t('Созвездия 5★')}>
          {([0, 1, 2] as const).map((level) => <button type="button" data-cons={level} aria-pressed={level === 0 ? 'true' : 'false'}>C{level}</button>)}
          <button type="button" class="weapon-toggle" aria-pressed="false">{t('+ 5★ оружие')}</button>
          <span class="muted small">{t('Созвездия 5★ и лучшее 5★ оружие из гайда (R1): прирост урона команды по нашим симуляциям gcsim')}</span>
        </div>}
        <ol class="rating-list">
          {overall[id].filter((row) => bySlug.has(row.slug)).map((row) => {
            const c = bySlug.get(row.slug)!;
            const sustain = expert.sustain[row.slug];
            const sources = expert.characters[row.slug]?.sources ?? [];
            const variants = roleCons.get(id)!.get(row.slug)!;
            const limit = damageLimits.limits[row.slug as keyof typeof damageLimits.limits];
            const cons = Object.fromEntries(([false, true] as const).flatMap((weapon) => ([0, 1, 2] as const).map((level) => {
              const key = variantKey(level, weapon);
              const { score, tier, rank, gain } = variants[key];
              return [key, [score, tier, rank, gain]];
            })));
            const consSimulated = bySlug.get(row.slug)?.rarity !== 5 || row.slug.startsWith('traveler-');
            const noSim = consSimulated ? [] : ([1, 2] as const).filter((level) => typeof investmentRows[row.slug]?.cons[level - 1] !== 'number');
            return <li class="panel rating-row" data-slug={row.slug} data-cons={JSON.stringify(cons)} data-nosim={noSim.length ? noSim.join(',') : undefined}>
              <span class="place">{row.rank}</span>
              <CharacterIcon slug={row.slug} size={44} label={false} />
              <div class="rating-main">
                <div class="rating-head">
                  <a class="name" href={`${base}/characters/${c.slug}/`}>{c.name}</a>
                  <span class="chip tier" data-tier={row.tier}>{row.tier}</span>
                </div>
                <div class="score-line">
                  <span class="score-track"><span style={`width:${row.score}%`}></span></span>
                  <b>{row.score}</b>
                </div>
                <div class="rating-meta muted small">
                  <span class="cons-gain chip" hidden></span>
                  {limit && <a class="chip dmg-limit" href={`https://www.youtube.com/watch?v=${limit.video}`} title={t('Предел урона Miron MinMax: один удар с отрядом, на момент {date}. Справка, в баллы не входит.', { date: fmtFullDate(new Date(limit.asOf)) })} target="_blank" rel="noopener noreferrer">{t('Предел')} {damageCompact.format(limit.team)}</a>}
                  {row.value !== null && (id === 'support'
                    ? <span><span title={t('Насколько урон команды выше, чем со средней поддержкой на том же месте')}>{t('{pct}% к урону команды', { pct: supportPct(row.value) })}</span> <small>{t('по {n} заменам', { n: fmtNumber(data.characters[row.slug]?.support?.n ?? 0) })}</small></span>
                    : <span>{t('{n} DPS', { n: compact.format(row.value) })}</span>)}
                  {row.simScore !== undefined && <span>{t('Симуляция: {score}', { score: row.simScore })}</span>}
                  {row.consensus && <span>
                    {t('Тир-листы: {score}', { score: Math.round(row.consensus.score) })} (
                    {row.consensus.parts.map((part, index) => <>
                      {index > 0 && ' · '}
                      {part.source === 'manual'
                        ? <span>Game8/PG {part.label} {sources.map((source) => <a href={source.url} title={t(source.title)} target="_blank" rel="noopener">↗</a>)}</span>
                        : <a href={external._meta.sources[part.source].url} target="_blank" rel="noopener">{part.source === 'prydwen' ? 'Prydwen' : 'WotPack'} {part.label}</a>}
                    </>)})
                  </span>}
                  {row.kind === 'expert' && <span class="chip">{t('экспертная оценка')}</span>}
                  {sustain && <><span class="chip">{t(sustainLevels[sustain.level])}</span><span>{t(sustainKinds[sustain.kind])}</span></>}
                  {row.note && <span>{t(row.note)}</span>}
                  {row.kind === 'sim' && row.source && <a href={row.source.url} target="_blank" rel="noopener">{t(row.source.title === 'конфиг' ? 'конфиг' : 'симуляция')}</a>}
                  {!row.consensus && sources.map((source) => <a href={source.url} target="_blank" rel="noopener">{t(source.title)}</a>)}
                </div>
                {row.team && <details><summary>{t('Лучшая команда')} {row.teamSource && <a href={row.teamSource.url} target="_blank" rel="noopener">{t('команда: Prydwen')}</a>}</summary><Team members={row.team} /></details>}
              </div>
            </li>;
          })}
        </ol>
      </section>
    ))}
    <section id="abyss" class="rating-section" role="tabpanel" aria-labelledby="tab-abyss">
      <h2 class="h-sec">{t('Бездна')}</h2>
      {abyss && <>
        <p class="muted">{t(abyss.cycle)} · <a href={`${base}/abyss/`}>{t('Текущий цикл →')}</a></p>
        {(abyss.halves.length ? abyss.halves : [{ label: 'Все команды', need: [] }]).map((half) => (
          <div class="team-section">
            <h3>{t(half.label)}</h3>
            <ol class="rating-list">
              {rankTeams(teams, (team) => fitsAbyssHalf(elements(team), half.need as Element[][]), 10).map((team) => (
                <li class="panel team-row">
                  <span class="place">{team.rank}</span>
                  <div class="team-info">
                    <div class="team-icons">{team.m.map((slug) => <CharacterIcon slug={slug} size={44} label={false} />)}</div>
                    <span class="muted small">{reaction(team)}</span>
                  </div>
                  <div class="team-score"><b>{team.score}</b><span class="chip tier" data-tier={team.tier}>{team.tier}</span></div>
                  <span class="muted small">{t('DPS команды {n}', { n: compact.format(team.dps) })}</span>
                  <a href={simUrl(team.id)} target="_blank" rel="noopener">{t(team.id.startsWith('own:') ? 'конфиг' : 'симуляция')}</a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </>}
    </section>
    <section id="theater" class="rating-section" role="tabpanel" aria-labelledby="tab-theater">
      <h2 class="h-sec">{t('Театр')}</h2>
      {theater && <p class="muted">{t(theater.cycle)} · <a href={`${base}/theater/`}>{t('Текущий цикл →')}</a></p>}
      {seasonElements.length ? <ol class="rating-list">
        {theaterTeams.map((team) => (
          <li class="panel team-row">
            <span class="place">{team.rank}</span>
            <div class="team-info">
              <div class="team-icons">{team.m.map((slug) => <CharacterIcon slug={slug} size={44} label={false} />)}</div>
              <span class="muted small">{reaction(team)}</span>
            </div>
            <div class="team-score"><b>{team.score}</b><span class="chip tier" data-tier={team.tier}>{team.tier}</span></div>
            <span class="muted small">{t('DPS команды {n}', { n: compact.format(team.dps) })}</span>
            <a href={simUrl(team.id)} target="_blank" rel="noopener">{t(team.id.startsWith('own:') ? 'конфиг' : 'симуляция')}</a>
          </li>
        ))}
      </ol> : <p class="notice">{t('Данные сезона не заполнены')}</p>}
    </section>
    <section id="bosses" class="rating-section" role="tabpanel" aria-labelledby="tab-bosses">
      <h2 class="h-sec">{t('Боссы')}</h2>
      <p class="muted">{t('Боссы сгруппированы по главной механике. Для каждого — лучшие команды из базы симуляций, которые под неё подходят.')}</p>
      {([{ label: 'Недельные боссы', weekly: true }, { label: 'Обычные боссы', weekly: false }] as const).map(({ label, weekly }) => (
        <div class="team-section">
          <h3>{t(label)}</h3>
          {bossTags.map((tag) => {
            const group = bosses.filter((boss) => !!boss.weekly === weekly && bossGroup(boss) === tag);
            return group.length ? <div class="boss-group">
              <h4>{t(BOSS_TAGS[tag].label)}</h4>
              <p class="muted small">{t(BOSS_TAGS[tag].hint)}</p>
              <ol class="boss-grid">
                {group.map((boss) => {
                  const enemy = enemiesByName[boss.en];
                  const ranked = rankBossTeams(boss, teams, bossMembers, 3);
                  return <li class:list={['panel', 'boss-card', { weekly }]}>
                    <div class="boss-art">
                      {enemy?.icon && <img class="boss-image" src={enemy.icon} width="96" height="96" loading="lazy" alt="" />}
                      {!boss.verified && <span class="boss-badge">{t('механика не проверена')}</span>}
                    </div>
                    <div class="boss-body">
                      <span class="boss-name">{enemy?.[lang as 'ru' | 'en' | 'es'] ?? boss.en}</span>
                      <div class="boss-tags">
                        {boss.tags.map((tag) => <span class="chip">{t(BOSS_TAGS[tag].label)}</span>)}
                      </div>
                      {boss.need && <span class="muted small">{t('Нужно: {elements}', { elements: needText(boss.need) })}</span>}
                      {boss.immune && <span class="muted small">{t('Иммунитет: {element}', { element: [boss.immune].flat().map((element) => t(elementText[element])).join(', ') })}</span>}
                      {ranked.slice(0, 1).map((team) => (
                        <div class="boss-team">
                          <div class="boss-team-icons">
                            {team.m.map((slug) => <CharacterIcon slug={slug} size={36} label={false} />)}
                          </div>
                          <div class="boss-team-meta">
                            <span class="team-score"><b>{team.score}</b><span class="chip tier" data-tier={team.tier}>{team.tier}</span></span>
                            <span class="muted">{t('DPS команды {n}', { n: compact.format(team.dps) })}</span>
                            <a href={simUrl(team.id)} target="_blank" rel="noopener">{t(team.id.startsWith('own:') ? 'конфиг' : 'симуляция')}</a>
                          </div>
                        </div>
                      ))}
                      {ranked.length > 1 && <details>
                        <summary>{t('Лучшие команды')}</summary>
                        <ol class="boss-more">
                          {ranked.slice(1).map((team) => (
                            <li class="boss-team">
                              <div class="boss-team-icons">
                                <span class="boss-rank">{team.rank}</span>
                                {team.m.map((slug) => <CharacterIcon slug={slug} size={36} label={false} />)}
                              </div>
                              <div class="boss-team-meta">
                                <span class="team-score"><b>{team.score}</b><span class="chip tier" data-tier={team.tier}>{team.tier}</span></span>
                                <span class="muted">{t('DPS команды {n}', { n: compact.format(team.dps) })}</span>
                                <a href={simUrl(team.id)} target="_blank" rel="noopener">{t(team.id.startsWith('own:') ? 'конфиг' : 'симуляция')}</a>
                              </div>
                            </li>
                          ))}
                        </ol>
                      </details>}
                      {!ranked.length && <p class="muted small">{t('Подходящих команд в базе нет')}</p>}
                    </div>
                  </li>;
                })}
              </ol>
            </div> : null;
          })}
        </div>
      ))}
      <p class="muted small">{t('Механики — по подсказкам официальной вики HoYoLAB. Дальний бой — керри с луком или катализатором; хил — по экспертной оценке сустейна; Ночная душа, лунные и звёздные реакции, Пневма и Усия — по талантам персонажей.')}</p>
    </section>
    <section id="explore" class="rating-section" role="tabpanel" aria-labelledby="tab-explore">
      <h2 class="h-sec">{t('Исследование')}</h2>
      <ol class="rating-list">
        {explore.map((row) => {
          const c = bySlug.get(row.slug)!;
          return <li class="panel rating-row">
            <span class="place">{row.rank}</span>
            <CharacterIcon slug={row.slug} size={44} label={false} />
            <div class="rating-main">
              <div class="rating-head">
                <a class="name" href={`${base}/characters/${c.slug}/`}>{c.name}</a>
                <span class="chip tier" data-tier={row.tier}>{row.tier}</span>
              </div>
              <div class="score-line">
                <span class="score-track"><span style={`width:${row.score}%`}></span></span>
                <b>{row.score}</b>
              </div>
              <div class="rating-meta muted small">
                {Object.entries(EXPLORE_CATEGORIES).map(([category, label]) => {
                  const tags = row.tags.filter((tag) => EXPLORE_TAGS[tag].category === category);
                  return tags.length ? <span class="explore-group">
                    <span>{t(label)}:</span>
                    {tags.map((tag) => <span class="chip">{t(EXPLORE_TAGS[tag].label)}</span>)}
                  </span> : null;
                })}
              </div>
            </div>
          </li>;
        })}
      </ol>
      <p class="muted small">{t('Баллы: передвижение навыком 2–3, пассивки отряда 1–2, сбор 1–2, польза 1, удобство 0,5. Источник — пассивки персонажей из данных игры; способы передвижения из навыков отмечены вручную.')}</p>
    </section>
    <section id="method" class="rating-section" role="tabpanel" aria-labelledby="tab-method">
      <h2 class="h-sec">{t('Как считаем')}</h2>
      <ul class="method">
        <li>{t('Основа — открытые симуляции из базы KQM на движке gcsim.')}</li>
        <li>{t('База: 5★ C0 и оружие R1, 4★ C6 и оружие R5; уровень 90, таланты 9/9/9, стандарт KQM.')}</li>
        <li>{t('Керри и саб-DPS оцениваются по своему урону. Роли не сравниваются друг с другом.')}</li>
        <li>{t('Поддержка — по парам команд, которые отличаются только ею: насколько урон выше, чем со средней поддержкой на том же месте ({pairs} пар)', { pairs: fmtNumber(data._meta.pairs) })}</li>
        <li>{t('Команды с персонажами, которых нет в базе KQM, считаем сами тем же gcsim с подбором доп. статов по стандарту KQM ({own} команд). Эти ротации ещё не проверены сообществом, поэтому они есть только в списках команд, а оценки ролей не меняют', { own: fmtNumber(data._meta.own) })}</li>
        <li>{t('Итоговый балл роли: 60% — наши симуляции gcsim, 40% — среднее внешних тир-листов (Prydwen по ролям, WotPack, Game8 и Pocket Gamer). Без симуляции — только тир-листы. Шкалы: Prydwen T0 — 100 … T5 — 40, WotPack S+ — 95 … D — 40.')}</li>
        <li>{t('Переключатели C0/C1/C2 и «+ 5★ оружие» умножают балл персонажа на прирост урона команды из наших симуляций gcsim (как в блоке «Стоит ли выбивать») и пересчитывают места. Созвездия учитываются только у 5★, оружие — у всех, для кого есть симуляция; созвездия и оружие считались отдельно, вместе их приросты перемножаются (приближение). Баллы всех пересчитываются от нового лидера.')}</li>
        <li>{t('Боссы — команды из той же базы, отобранные под механику босса: стихию щита, иммунитет, число целей, дальний бой, лечение.')}</li>
        <li>{t('Исследование — чек-лист пассивок и навыков вне боя, без симуляций.')}</li>
        <li>{t('«Предел» у строки — рекорд одного удара из серии «Предел урона» канала Miron MinMax (C6, лучшие артефакты, отряд по правилам автора). Это справка, в баллы не входит; автор сам считает старые цифры устаревшими.')}</li>
        <li>{t('Тиры по баллам роли: T0 от 95, T0.5 от 88, T1 от 80, T1.5 от 70, T2 от 55, T3 от 40, T4 ниже 40.')}</li>
        <li>{t('ELO сообщества появится позже.')}</li>
      </ul>
      <p class="muted small">{t('Данные от {date} · симуляций по базе: {baseline} из {entries}',{ date: data._meta.date, entries: fmtNumber(data._meta.entries), baseline: fmtNumber(data._meta.baseline) })}</p>
      <p class="muted small">{t('Источники')}: {[...Object.values(external._meta.sources), ...manualTierSources].map((source, index) => <>{index > 0 && ' · '}<a href={source.url} target="_blank" rel="noopener">{t(source.title)}</a></>)}</p>
      <p><a href="https://db.kqm.gg/" target="_blank" rel="noopener">db.kqm.gg</a> · <a href="https://gcsim.app/" target="_blank" rel="noopener">gcsim.app</a></p>
    </section>
  </div>
</Layout>

<script>
  import { onPage } from '../../scripts/router';
  import { variantKey, type VariantKey } from '../../lib/rating/core';

  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-rating-tabs]');
    if (!root) return;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.dataset.tab!)!);
    const select = (index: number, updateHash = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (updateHash) history.pushState(null, '', `#${tabs[index].dataset.tab}`);
    };
    const fromHash = () => select(Math.max(0, tabs.findIndex((tab) => `#${tab.dataset.tab}` === location.hash)));
    type Variant = [number, string, number, number | null];
    const sections = (['carry', 'subdps', 'support'] as const).map((id) => {
      const section = root.querySelector<HTMLElement>(`#${id}`)!;
      const list = section.querySelector<HTMLOListElement>('.rating-list')!;
      const rows = [...list.querySelectorAll<HTMLLIElement>('.rating-row')].map((row, index) => ({
        row, index, variants: JSON.parse(row.dataset.cons!) as Record<VariantKey, Variant>,
      }));
      return { section, list, rows };
    });
    const tierSection = root.querySelector<HTMLElement>('#tiers')!;
    const tierSlots = new Map([...tierSection.querySelectorAll<HTMLElement>('.tier-slot')].map((slot): [string, HTMLElement] => [`${slot.dataset.role}-${slot.dataset.tier}`, slot]));
    const tierChars = [...tierSection.querySelectorAll<HTMLButtonElement>('.tier-cell-char')].map((button) => ({ button, index: Number(button.dataset.order), variants: JSON.parse(button.dataset.cons!) as Record<VariantKey, Variant> }));
    const applyCons = (level: 0 | 1 | 2, weapon: boolean) => {
      const key = variantKey(level, weapon);
      const label = `C${level}${weapon ? ' + 5★' : ''}`;
      root.querySelectorAll<HTMLButtonElement>('.cons-switch button[data-cons]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.cons === String(level))));
      root.querySelectorAll<HTMLButtonElement>('.weapon-toggle').forEach((button) => button.setAttribute('aria-pressed', String(weapon)));
      for (const { section, list, rows } of sections) {
        for (const { row, variants } of rows) {
          const [score, tierValue, rank, gain] = variants[key];
          row.querySelector<HTMLElement>('.place')!.textContent = String(rank);
          const tier = row.querySelector<HTMLElement>('.tier')!;
          tier.dataset.tier = tierValue;
          tier.textContent = tierValue;
          row.querySelector<HTMLElement>('.score-track span')!.style.width = `${score}%`;
          row.querySelector<HTMLElement>('.score-line b')!.textContent = String(score);
          const chip = row.querySelector<HTMLElement>('.cons-gain')!;
          const noSim = level > 0 && (row.dataset.nosim ?? '').split(',').includes(String(level));
          chip.hidden = !noSim && ((level === 0 && !weapon) || gain === null);
          chip.title = noSim ? section.dataset.nosimTitle! : '';
          if (noSim) chip.textContent = section.dataset.nosimTemplate!.replace('{n}', String(level));
          else if (!chip.hidden) {
            const pct = Math.round(Math.abs(gain!));
            chip.textContent = section.dataset.gainTemplate!.replace('{variant}', label)
              .replace('+{pct}', gain! < 0 ? `−${pct}` : `+${pct}`);
          }
        }
        list.append(...rows.slice().sort((a, b) => a.variants[key][2] - b.variants[key][2] || a.index - b.index).map(({ row }) => row));
      }
      for (const { button, variants } of tierChars) {
        const [score, tierValue, , gain] = variants[key];
        const card = document.getElementById(button.getAttribute('popovertarget')!)!;
        const tier = card.querySelector<HTMLElement>('.tier')!;
        tier.dataset.tier = tierValue;
        tier.textContent = tierValue;
        card.querySelector<HTMLElement>('.tier-card-score')!.textContent = String(score);
        button.querySelector<HTMLElement>('.tier-cell-score')!.textContent = String(score);
        button.setAttribute('aria-label', `${button.dataset.name}, ${score}`);
        const noSim = level > 0 && (button.dataset.nosim ?? '').split(',').includes(String(level));
        const showGain = noSim || ((level !== 0 || weapon) && gain !== null);
        const badge = button.querySelector<HTMLElement>('.tier-cell-gain')!;
        badge.hidden = !showGain;
        if (showGain) badge.textContent = noSim ? tierSection.dataset.nosimShortTemplate!.replace('{n}', String(level))
          : `${gain! < 0 ? '−' : '+'}${Math.round(Math.abs(gain!))}%`;
        const chip = card.querySelector<HTMLElement>('.tier-card-gain')!;
        chip.hidden = !showGain;
        chip.title = noSim ? tierSection.dataset.nosimTitle! : '';
        if (showGain) chip.textContent = noSim ? tierSection.dataset.nosimTemplate!.replace('{n}', String(level))
          : tierSection.dataset.gainTemplate!.replace('{variant}', label).replace('+{pct}', gain! < 0 ? `−${Math.round(Math.abs(gain!))}` : `+${Math.round(Math.abs(gain!))}`);
        tierSlots.get(`${button.dataset.role}-${tierValue}`)!.append(button);
      }
      for (const slot of tierSlots.values()) {
        slot.append(...tierChars.filter(({ button }) => button.parentElement === slot)
          .sort((a, b) => b.variants[key][0] - a.variants[key][0] || a.index - b.index).map(({ button }) => button));
      }
    };
    let saved = '0';
    let weapon = false;
    try {
      saved = localStorage.getItem('rating-cons') ?? '0';
      weapon = localStorage.getItem('rating-weapon') === '1';
    } catch {}
    let level: 0 | 1 | 2 = saved === '1' ? 1 : saved === '2' ? 2 : 0;
    applyCons(level, weapon);
    root.querySelectorAll<HTMLButtonElement>('.cons-switch button[data-cons]').forEach((button) => {
      button.addEventListener('click', () => {
        level = Number(button.dataset.cons) as 0 | 1 | 2;
        applyCons(level, weapon);
        try { localStorage.setItem('rating-cons', String(level)); } catch {}
      }, { signal });
    });
    root.querySelectorAll<HTMLButtonElement>('.weapon-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        weapon = !weapon;
        applyCons(level, weapon);
        try { localStorage.setItem('rating-weapon', weapon ? '1' : '0'); } catch {}
      }, { signal });
    });
    tierSection.querySelectorAll<HTMLButtonElement>('[data-tier-role]').forEach((button) => {
      button.addEventListener('click', () => {
        const role = button.dataset.tierRole;
        tierSection.querySelectorAll<HTMLButtonElement>('[data-tier-role]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab === button)));
        tierSection.querySelectorAll<HTMLElement>('.tier-column').forEach((column) => column.dataset.mobileHidden = String(column.dataset.role !== role));
      }, { signal });
    });
    tierSection.querySelectorAll<HTMLAnchorElement>('.tier-list-link').forEach((link) => {
      link.addEventListener('click', () => link.closest<HTMLElement>('[popover]')?.hidePopover(), { signal });
    });
    root.classList.add('ready');
    fromHash();
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, true), { signal });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const next = (i + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(next, true);
        tabs[next].focus();
      }, { signal });
    });
    window.addEventListener('popstate', fromHash, { signal });
    window.addEventListener('hashchange', fromHash, { signal });
  });
</script>

<style>
