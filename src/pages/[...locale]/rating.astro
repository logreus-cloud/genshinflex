  .name { font-weight: 600; overflow-wrap: anywhere; }
  .score-line { margin: .35rem 0; }
  .score-track { flex: 1; height: .45rem; overflow: hidden; border-radius: 999px; background: var(--surface-3); }
  .score-track span { display: block; height: 100%; border-radius: inherit; background: var(--accent); }
  .score-line b { min-width: 2em; text-align: right; }
