  .boss-body { display: flex; min-width: 0; flex-direction: column; gap: .45rem; padding: .6rem .7rem .7rem; text-align: center; overflow-wrap: anywhere; }
  .boss-name { font: 600 .95rem var(--font-display); }
  .boss-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: .3rem; }
  .boss-tags .chip { white-space: normal; }
  .boss-team { display: flex; min-width: 0; flex-direction: column; align-items: center; gap: .3rem; }
  .boss-team-icons { display: flex; min-width: 0; flex-wrap: wrap; align-items: center; justify-content: center; gap: .25rem; }
  .boss-rank { color: var(--muted); font-size: .8rem; font-weight: 600; }
  .boss-team-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .2rem .45rem; font-size: .75rem; }
  .boss-body details { min-width: 0; margin-top: 0; }
  .boss-body summary { font-size: .8rem; }
  .boss-more { list-style: none; display: grid; gap: .6rem; padding: 0; margin: .5rem 0 0; }
  .boss-more .boss-team { padding-top: .5rem; border-top: 1px solid var(--border); }
  .tier { font-weight: 700; border-color: transparent; }
