  @media (max-width: 440px) {
    .rating-row, .team-row { padding: .75rem; gap: .45rem; }
    .team-info { flex-basis: 190px; }
    .boss-grid { grid-template-columns: repeat(2, minmax(140px, 1fr)); gap: 10px; }
