---
import { useData, LANGS } from '../../lib/data';
import Layout from '../../layouts/Layout.astro';
// Каждая страница существует в трёх языках: / (ru), /en/, /es/
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { base, t } = useData(Astro.currentLocale);
---
<Layout title={t('Рейтинг')}>
  <h1>{t('Рейтинг')}</h1>
  <p class="muted">{t('Вместо тир-листа — два независимых рейтинга. Оба считаются отдельно для каждого режима и цикла.')}</p>
  <div class="grid">
    <div class="panel">
      <h2>{t('ELO сообщества')}</h2>
      <p>{t('Сайт показывает двух персонажей или две команды под конкретную комнату текущего цикла, вы выбираете, кто лучше. Каждый голос — «матч» для рейтинга.')}</p>
      <span class="chip">{t('в разработке')}</span>
    </div>
    <div class="panel">
      <h2>{t('ELO по забегам')}</h2>
      <p>{t('Игроки отправляют команду и время прохождения. Команда, прошедшая ту же комнату быстрее, «выигрывает». Рейтинг открывается, когда набирается достаточно забегов.')}</p>
      <span class="chip">{t('в разработке')}</span>
    </div>
  </div>
  <p class="notice note">
    {t('Считаем по Glicko-2: вместе с рейтингом хранится неуверенность, поэтому у персонажа с малым числом матчей видно «±», а не случайную цифру.')}
  </p>
</Layout>

<style>
  .panel h2 { margin-top: 0; }
  .note { margin-top: 1.4rem; }
</style>
