---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useData, LANGS } from '../../lib/data';
// Обзор эндгейма: карточка на каждый режим, подробности — на отдельных страницах /abyss, /theater, /onslaught
export const getStaticPaths = () => LANGS.map((l) => ({ params: { locale: l === 'ru' ? undefined : l } }));
const { MODES, fmtDate, resetAt, base, t, getCharacter } = useData(Astro.currentLocale);

const order = Object.keys(MODES);
const rotations = (await getCollection('rotations')).sort((a, b) => order.indexOf(a.data.mode) - order.indexOf(b.data.mode));
const now = new Date();
---
<Layout title={t('Эндгейм: Бездна, Театр и Натиск')} description={t('Текущие циклы эндгейма Genshin Impact: Витая бездна, Театр воображариума и Натиск — враги, баффы и команды.')}>
  <h1>{t('Эндгейм')}</h1>
  <p class="muted">{t('Текущие циклы всех режимов. Откройте режим, чтобы увидеть врагов, баффы и команды.')}</p>

  <div class="modes">
    {rotations.map(({ data: r }) => {
      const upcoming = r.start > now;
      return (
        <a class="panel mode" href={`${base}/${r.mode}/`} data-mode={r.mode}>
          <div class="head">
            <h2>{MODES[r.mode].title}</h2>
            <span class="chip">{fmtDate(r.start)} — {fmtDate(r.end)}</span>
          </div>
          <p class="muted">{t(r.cycle)}</p>
          {!r.draft && r.tags.length > 0 && <div class="row">{r.tags.map((tag) => <span class="chip gold">{t(tag)}</span>)}</div>}
          {r.mode === 'abyss' && r.floors.length > 0 && (
            <ul class="floors small">
              {r.floors.map((f) => <li><b>{t('Этаж {n}', { n: f.floor })}</b> <span class="muted">{f.disorder.map((d) => t(d)).join(' · ') || t('без аномалий')}</span></li>)}
            </ul>
          )}
          {r.cast.length > 0 && <div class="cast">{r.cast[0].members.slice(0, 8).map((m) => { const c = getCharacter(m); return <img src={c.icon} alt={c.name} title={c.name} width="40" height="40" data-el={c.element} loading="lazy" />; })}</div>}
          {r.draft && r.note && <p class="small muted">{t(r.note)}</p>}
          <div class="foot">
            <span><b data-until={resetAt(upcoming ? r.start : r.end)} data-prefix={upcoming ? t('откроется через') + ' ' : ''} data-done={t('обновилось')}>…</b>
              <span class="muted small"> {upcoming ? t('до нового сезона') : t('до обновления')}</span></span>
            <span class="more">{t('Подробнее')} →</span>
          </div>
        </a>
      );
    })}
  </div>
</Layout>

<style>
  .modes { display: grid; gap: 12px; margin-top: 1rem; }
  .mode { display: grid; gap: .6rem; text-decoration: none; color: inherit; }
  .mode:hover { border-color: var(--accent); }
  .head { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; }
  .head h2 { margin: 0; }
  .mode p { margin: 0; }
  .floors { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; }
  .cast { display: flex; flex-wrap: wrap; gap: .3rem; }
  .cast img { border-radius: 50%; background: color-mix(in srgb, var(--el) 35%, var(--surface-3)); }
  .foot { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--border); padding-top: .6rem; }
  .foot b { color: var(--accent-text); font-family: var(--font-display); }
  .more { color: var(--accent-text); font-weight: 600; }
</style>
