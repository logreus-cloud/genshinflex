---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Team from '../../../components/Team.astro';
import LevelStats from '../../../components/LevelStats.astro';
import VideoGuides from '../../../components/VideoGuides.astro';
import Investments from '../../../components/Investments.astro';
import investments from '../../../data/investments.json';
import { useData, LANGS, BETA_SOURCE, BETA_KIT_SOURCE, BETA_TALENT_LEVEL, type Character } from '../../../lib/data';
import { makeLookup, renderGuide } from '../../../lib/guide-markup';
const { characters, weapons, artifacts, getWeapon, getArtifact, getCharacter, TALENTS, ELEMENTS, WEAPON_TYPES, MODES, stars, base, t, fmtFullDate, stat, lang } = useData(Astro.currentLocale);

export function getStaticPaths() {
  return LANGS.flatMap((l) => useData(l).characters.map((c) => ({ params: { locale: l === 'ru' ? undefined : l, slug: c.slug }, props: { c } })));
}

const { c } = Astro.props as { c: Character };
const slug = c.slug;
const allBuilds = await getCollection('builds');
const build = allBuilds.find((b) => b.data.character === c.slug);
// На английском и испанском — переведённый текст разбора; сгенерированные разборы собираем из переведённого шаблона
const i18nEntry = lang !== 'ru' ? (await getCollection('buildsI18n')).find((e) => e.id === `${lang}/${c.slug}`) : undefined;
const templated = lang !== 'ru' && !i18nEntry && build?.body?.startsWith('Краткий билд по данным сообщества');
// Текст разбора — Markdown с баблами и выносками, тот же рендер, что и в превью редактора гайдов
const bodySrc = build && !templated ? (i18nEntry ?? build).body?.trim() : '';
const bodyHtml = bodySrc ? renderGuide(bodySrc, makeLookup({ characters, weapons, artifacts, elements: ELEMENTS }, base), { tip: t('Совет'), warn: t('Важно'), info: t('На заметку') }) : '';
const b = build?.data;

// Где ещё встречается персонаж: команды других билдов и рекомендации текущего эндгейма
const elsewhere = allBuilds
  .filter((x) => x.data.character !== c.slug)
  .flatMap((x) => x.data.teams.filter((t) => t.members.includes(c.slug)).map((t) => ({ ...t, owner: x.data.character })));
const endgame = (await getCollection('rotations'))
  .flatMap((r) => [...r.data.teams, ...r.data.floors.flatMap((f) => f.teams)].filter((t) => t.members.includes(c.slug)).map((t) => ({ ...t, mode: r.data.mode })));
// Один и тот же состав встречается в нескольких билдах — склеиваем по набору участников
const key = (m: string[]) => [...m].sort().join();
const own = new Set((b?.teams ?? []).map((t) => key(t.members)));
const merged = new Map<string, { name?: string; members: string[]; from: string[] }>();
for (const t of [
  ...endgame.map((t) => ({ name: t.name, members: t.members, from: MODES[t.mode].title })),
  ...elsewhere.map((t) => ({ name: t.name, members: t.members, from: getCharacter(t.owner).name })),
]) {
  const k = key(t.members);
  if (own.has(k)) continue;
  const m = merged.get(k);
  if (m) { if (!m.from.includes(t.from)) m.from.push(t.from); } else merged.set(k, { name: t.name, members: t.members, from: [t.from] });
}
const related = [...merged.values()];

const talentKeys = ['normal', 'skill', 'burst'] as const;
// У персонажей из утечек часть созвездий неизвестна — раздел показываем, только если есть хоть одно
const hasCons = c.constellations.some(Boolean);
const missingNames = (c.betaMissing ?? []).map((k) => TALENTS[k as keyof typeof TALENTS] ?? k);
const tabs = [['profile', t('Профиль')], ...(b ? [['build', t('Билд')], ['teams', t('Команды')]] : []), ...(slug in investments ? [['value', t('Стоит ли выбивать')]] : []), ...(b?.videos.length ? [['videos', t('Видео')]] : []), ...(c.beta ? [['materials', t('Материалы')]] : []), ['talents', t('Таланты')], ...(hasCons ? [['constellations', t('Созвездия')]] : []), ...(c.betaAnalysis ? [['analysis', t('Анализ')]] : [])];
// Подписи материалов утечки: ключи из beta-characters.json
const betaLabels: Record<string, string> = {
  mora: t('Мора'), wit: t('Опыт героя'), weekly: t('Материал с еженедельного босса'), crown: t('Корона прозрения'),
  specialty: t('Местный диковинный материал (новый)'), boss: t('Материал с босса'),
  gems: t('Самоцветы: осколок / фрагмент / кусок / камень'), books: t('Книги талантов: учение / руководство / философия'),
  drops: t('Материалы с монстров: 1★ / 2★ / 3★'),
};
const meta = [
  [t('Созвездие'), c.constellationName], [t('Регион'), c.region], [t('День рождения'), c.birthday], [t('В игре с версии'), c.version],
].filter(([, v]) => v);
const slotIcons = {
  sands: 'M6 3h8M6 17h8M7 3c0 4 6 4 6 7s-6 3-6 7M13 3c0 4-6 4-6 7s6 3 6 7',
  goblet: 'M6 3h8l-1 6a3 3 0 0 1-6 0Zm4 9v4m-3 1h6',
  circlet: 'M3 8l3.5 3L10 5l3.5 6L17 8l-1.5 8h-11Z',
};
const slotNames = { sands: t('Часы'), goblet: t('Кубок'), circlet: t('Корона') } as const;

// SEO: заголовок и описание под запросы вида «гайд на Водяницу», «билд Весна»
const seoTitle = c.beta ? t('{name} (BETA): утечки — Genshin Impact', { name: c.name }) : b ? t('{name}: гайд и билд — Genshin Impact {patch}', { name: c.name, patch: b.patch }) : t('{name}: таланты и созвездия — Genshin Impact', { name: c.name });
const seoDescription = b
  ? t('{name} ({el}, {r}★) — гайд и билд: лучшее оружие — {weapon}, артефакты — {sets}, статы, команды и таланты. Актуально для патча {patch}.', { name: c.name, el: c.elementText, r: c.rarity, weapon: getWeapon(b.weapons[0].slug).name, sets: b.artifacts[0].sets.map((s) => getArtifact(s).name).join(' + '), patch: b.patch })
  : t('{name} в Genshin Impact: {el}, {weapon}, таланты с множителями, созвездия и статы на любом уровне.', { name: c.name, el: c.elementText, weapon: c.weaponText.toLowerCase() });
const pageUrl = new URL(`/characters/${c.slug}/`, Astro.site).toString();
const jsonLd = b && {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: seoTitle,
  description: seoDescription,
  image: c.splash ?? c.icon,
  dateModified: b.updated.toISOString().slice(0, 10),
  inLanguage: 'ru',
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: 'GenshinFlex', url: Astro.site?.toString() },
  publisher: { '@type': 'Organization', name: 'GenshinFlex' },
  about: { '@type': 'VideoGame', name: 'Genshin Impact' },
};
---
<Layout title={seoTitle} description={seoDescription} image={c.splash ?? c.icon} type={b ? 'article' : 'website'} jsonLd={jsonLd} noindex={c.beta} wide>
  <article data-pagefind-body data-visit={JSON.stringify({ href: `${base}/characters/${c.slug}`, name: c.name, icon: c.icon, kind: t('Персонаж') })}>
    <nav class="crumbs small muted" aria-label={t('Путь')}><a href={`${base}/characters`}>{t('Персонажи')}</a> / {c.name}</nav>

    <header class="head" data-el={c.element}>
      {c.splash && <img class="splash" src={c.splash} alt="" aria-hidden="true" />}
      <div class="head-info">
        <p class="muted" data-pagefind-ignore>{c.title}</p>
        <h1>{c.name}</h1>
        <div class="row" data-pagefind-ignore>
          {c.beta && <span class="chip beta">BETA</span>}
          <span class="chip gold">{stars(c.rarity)}</span>
          <span class="chip" data-el={c.element}>{c.elementText}</span>
          <span class="chip">{c.weaponText}</span>
        </div>
        <dl class="meta" data-pagefind-ignore>
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <button class="btn fav" type="button" aria-pressed="false" data-pagefind-ignore>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m10 3.5 1.9 4 4.3.5-3.2 3 .9 4.3L10 13.2l-3.9 2.1.9-4.3-3.2-3 4.3-.5Z" /></svg>
          <span>{t('В избранное')}</span>
        </button>
        <a class="btn edit" href={`${base}/guides/editor/?c=${c.slug}`} data-pagefind-ignore>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 16h3l8.5-8.5-3-3L4 13Zm7-10 3 3" /></svg>
          <span>{b ? t('Дополнить гайд') : t('Написать гайд')}</span>
        </a>
      </div>
    </header>

    {c.beta && (
      <p class="notice" data-pagefind-ignore>
        {t('Персонаж из утечек бета-версии: имя, стихия, характеристики и материалы предварительные и могут измениться к релизу.')}
        {' '}{t('Источник')}: <a href={BETA_SOURCE.url} rel="noopener noreferrer" target="_blank">{BETA_SOURCE.title}</a>.
      </p>
    )}

    <nav class="tabs" aria-label={t('Разделы страницы')} data-pagefind-ignore>
      {tabs.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>

    <section id="profile">
      <h2 class="h-sec">{t('Профиль')}</h2>
      <div class="two">
        <div class="panel">
          <p>{c.description}</p>
          <div class="ratings" data-pagefind-ignore>
            <div><span class="muted small">{t('ELO сообщества')}</span><b>{t('скоро')}</b></div>
            <div><span class="muted small">{t('ELO по забегам')}</span><b>{t('скоро')}</b></div>
          </div>
        </div>
        <LevelStats stats={c.stats} substat={c.substat} substatPercent={c.substatPercent} />
      </div>
    </section>

    {b ? (
      <>
        <section id="build">
          <h2 class="h-sec">{t('Билд')} <small>{t('патч {v}, обновлено {date}', { v: b.patch, date: fmtFullDate(b.updated) })}</small></h2>
          <p class="muted">{t(b.role)}</p>
          <div class="build">
            <div class="panel">
              <h3>{t('Оружие')}</h3>
              <ol class="rank">
                {b.weapons.map((w, i) => {
                  const it = getWeapon(w.slug);
                  return (
                    <li>
                      <span class="n">{i + 1}</span>
                      <img class:list={[`r${it.rarity}`]} src={it.icon} alt="" width="40" height="40" loading="lazy" />
                      <span><a href={`${base}/weapons/${it.slug}`}><b>{it.name}</b></a> <span class="muted small">{stars(it.rarity)}</span>
                        {w.note && <small class="muted note">{t(w.note)}</small>}</span>
                    </li>
                  );
                })}
              </ol>
            </div>
            <div class="panel">
              <h3>{t('Артефакты')}</h3>
              <ol class="rank">
                {b.artifacts.map((a, i) => (
                  <li>
                    <span class="n">{i + 1}</span>
                    <span class="sets">{a.sets.map((s) => <img src={getArtifact(s).icon} alt="" width="40" height="40" loading="lazy" />)}</span>
                    <span><b>{a.sets.map((s) => getArtifact(s).name).join(' + ')}</b>{a.note && <small class="muted note">{t(a.note)}</small>}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <div class="stats-row">
            {(['sands', 'goblet', 'circlet'] as const).map((slot) => (
              <div class="panel slot">
                <svg viewBox="0 0 20 20" width="30" height="30" aria-hidden="true"><path d={slotIcons[slot]} /></svg>
                <div><span class="muted small">{slotNames[slot]}</span><b>{stat(b.mainStats[slot])}</b></div>
              </div>
            ))}
          </div>
          <div class="panel prio">
            <div><span class="muted small">{t('Доп. статы')}</span><b>{b.substats.map(stat).join('  >  ')}</b></div>
            {b.talents.length > 0 && <div><span class="muted small">{t('Прокачка талантов')}</span><b>{b.talents.map((t) => TALENTS[t]).join('  >  ')}</b></div>}
          </div>
          {bodyHtml && <div class="panel prose" set:html={bodyHtml} />}
          {b.authors.length > 0 && <p class="muted small">{t('Авторы гайда')}: {b.authors.join(', ')}</p>}
          {templated && <div class="panel prose"><p>{t('Краткий билд по данным сообщества: роль — {role}, порядок вариантов — от лучшего к запасному. Подробный разбор ещё не написан.', { role: t(b.role).toLowerCase() })}</p></div>}
          {b.external.length > 0 && (
            <div class="panel more">
              <h3>{t('Также можете посмотреть')}</h3>
              <ul>
                {b.external.map((g) => (
                  <li>
                    <a href={g.url} rel="noopener" target="_blank">{g.title}</a>
                    {g.author && <span class="muted small"> — {g.author}</span>}
                    <span class="chip">{g.lang.toUpperCase()}</span>
                  </li>
                ))}
              </ul>
              <p class="muted small">{t('Гайды других авторов на сторонних сайтах — подробные разборы, написанные игроками.')}</p>
            </div>
          )}
          {b.sources.length > 0 && (
            <p class="muted small">{t('Источники')}: {b.sources.map((s, i) => <>{i > 0 && ', '}<a href={s.url} rel="noopener">{s.title}</a></>)}. {t('Тексты — наш пересказ.')} <a href={`${base}/feedback/?kind=data&from=/characters/${c.slug}/`}>{t('Нашли ошибку в билде?')}</a>{' · '}<a href={`${base}/guides/editor/?c=${c.slug}`}>{t('Дополнить гайд')}</a></p>
          )}
        </section>

        <section id="teams">
          <h2 class="h-sec">{t('Команды')}</h2>
          <div class="grid">{b.teams.map((t) => <Team {...t} />)}</div>
          {related.length > 0 && (
            <>
              <h3 class="sub">{t('Встречается в других командах')}</h3>
              <div class="grid">
                {related.map((rt) => <Team members={rt.members} name={rt.name} note={t('Где рекомендуют: {list}', { list: rt.from.map((x) => t(x)).join(', ') })} />)}
              </div>
            </>
          )}
        </section>

        <Investments slug={c.slug} />

        {b.videos.length > 0 && (
          <section id="videos" data-pagefind-ignore>
            <h2 class="h-sec">{t('Видео-гайды')} <small>{t('YouTube, по клику')}</small></h2>
            <VideoGuides videos={b.videos} />
          </section>
        )}
      </>
    ) : !c.beta && (
      <p class="notice" data-pagefind-ignore>
        {t('Билда для этого персонажа пока нет — он появится в одном из ближайших обновлений.')}
        {' '}<a href={`${base}/guides/editor/?c=${c.slug}`}>{t('Напишите свой')}</a> {t('— после проверки он появится здесь.')}
      </p>
    )}

    {c.beta && (
      <section id="materials">
        <h2 class="h-sec">{t('Материалы')} <small>{t('на возвышение и все таланты до 10 уровня')}</small></h2>
        <dl class="panel mats">
          {(c.betaMaterials ?? []).map(([k, v]) => <div><dt>{betaLabels[k] ?? k}</dt><dd>{v}</dd></div>)}
        </dl>
      </section>
    )}
    {(<>
    <section id="talents">
      <h2 class="h-sec">{t('Таланты')}
        {c.beta ? (
          <small data-pagefind-ignore>{t('множители на {n} уровне таланта', { n: BETA_TALENT_LEVEL })}</small>
        ) : (
        <small data-pagefind-ignore>
          <label class="lvl">{t('Уровень')} <output>10</output>
            <input type="range" min="1" max={c.talents.skill?.scaling?.[0]?.values.length ?? 15} value="10" data-talent-level /></label>
        </small>
        )}
      </h2>
      {c.beta && (
        <p class="muted small" data-pagefind-ignore>
          {missingNames.length > 0 && <>{t('Ещё не утекло: {list}.', { list: missingNames.join(', ') })} </>}
          {t('Описания навыков')}: <a href={BETA_KIT_SOURCE.url} rel="noopener noreferrer" target="_blank">{BETA_KIT_SOURCE.title}</a>.
        </p>
      )}
      <div class="talents">
        {talentKeys.map((k) => c.talents[k] && (
          <div class="panel talent" data-el={c.element}>
            <div class="t-head">
              {c.talents[k].icon && <img src={c.talents[k].icon} alt="" width="44" height="44" loading="lazy" />}
              <div><span class="muted small">{TALENTS[k]}</span><h3>{c.talents[k].name}</h3></div>
            </div>
            <p class="desc">{c.talents[k].description}</p>
            {c.talents[k].scaling?.length > 0 && (
              <details data-pagefind-ignore>
                <summary>{t('Множители')}</summary>
                <table>
                  <tbody>
                    {c.talents[k].scaling.map((r) => (
                      <tr><th scope="row">{r.name}</th><td data-values={JSON.stringify(r.values)}>{r.values[9] ?? r.values.at(-1)}</td></tr>
                    ))}
                  </tbody>
                </table>
              </details>
            )}
          </div>
        ))}
      </div>
      <h3 class="sub">{t('Пассивные таланты')}</h3>
      <div class="small-grid">
        {c.talents.passives.map((p) => p && (
          <div class="panel talent" data-el={c.element}>
            <div class="t-head">{p.icon && <img src={p.icon} alt="" width="36" height="36" loading="lazy" />}<h3>{p.name}</h3></div>
            <p class="desc">{p.description}</p>
          </div>
        ))}
      </div>
    </section>

    {hasCons && <section id="constellations">
      <h2 class="h-sec">{t('Созвездия')}</h2>
      <div class="small-grid">
        {c.constellations.map((k, i) => k && (
          <div class="panel talent" data-el={c.element}>
            <div class="t-head">
              {k.icon && <img src={k.icon} alt="" width="36" height="36" loading="lazy" />}
              <div><span class="chip gold">C{i + 1}</span><h3>{k.name}</h3></div>
            </div>
            <p class="desc">{k.description}</p>
          </div>
        ))}
      </div>
      {c.beta && <p class="muted small">{t('Остальные созвездия ещё не утекли.')}</p>}
    </section>}
    {c.betaAnalysis && (
      <section id="analysis">
        <h2 class="h-sec">{t('Анализ')} <span class="chip ai">{t('анализ ИИ')}</span></h2>
        <div class="panel analysis">
          {c.betaAnalysis.split(/\n{2,}/).map((para) => <p>{para}</p>)}
          <p class="muted small">{t('Разбор написан ИИ по утёкшим описаниям навыков, без симуляций. Релизная версия персонажа может отличаться.')}</p>
        </div>
      </section>
    )}
    </>)}

    <section class="browse" data-pagefind-ignore>
      <h2 class="h-sec">{t('Другие персонажи')}</h2>
      <div class="panel browse-grid">
        <div><span class="muted small">{t('По редкости')}</span><div class="row">{[5, 4].map((r) => <a class="chip" href={`${base}/characters?rarity=${r}`}>{r}★</a>)}</div></div>
        <div><span class="muted small">{t('По стихии')}</span><div class="row">{Object.entries(ELEMENTS).map(([k, v]) => <a class="chip" href={`${base}/characters?element=${k}`}><span class="el-dot" data-el={k}></span>{v}</a>)}</div></div>
        <div><span class="muted small">{t('По оружию')}</span><div class="row">{Object.entries(WEAPON_TYPES).map(([k, v]) => <a class="chip" href={`${base}/characters?weapon=${k}`}>{v}</a>)}</div></div>
      </div>
    </section>
  </article>
</Layout>

<script>
  import { recent, favorites } from '../../../scripts/common';
  import { t } from '../../../scripts/search';

  const art = document.querySelector<HTMLElement>('[data-visit]')!;
  const entry = JSON.parse(art.dataset.visit!);
  recent.push(entry);

  const fav = document.querySelector<HTMLButtonElement>('.fav')!;
  const paint = (on: boolean) => { fav.setAttribute('aria-pressed', String(on)); fav.querySelector('span')!.textContent = on ? t('В избранном') : t('В избранное'); };
  paint(favorites.has(entry.href));
  fav.addEventListener('click', () => paint(favorites.toggle(entry)));

  // Один ползунок уровня для всех таблиц множителей
  const range = document.querySelector<HTMLInputElement>('[data-talent-level]');
  const cells = [...document.querySelectorAll<HTMLElement>('[data-values]')].map((el) => [el, JSON.parse(el.dataset.values!)] as const);
  range?.addEventListener('input', () => {
    const i = Number(range.value) - 1;
    range.closest('label')!.querySelector('output')!.textContent = range.value;
    for (const [el, values] of cells) el.textContent = values[Math.min(i, values.length - 1)];
  });

  // Подсветка текущего раздела во вкладках
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tabs a')];
  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
  }, { rootMargin: '-45% 0px -50% 0px' });
  links.forEach((a) => { const s = document.querySelector(a.hash); if (s) obs.observe(s); });
</script>

<style>
  .crumbs { margin-bottom: .8rem; }
  .crumbs a { color: var(--muted); }
  .head {
    position: relative; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--border); min-height: 300px;
