---
import Layout from '../../layouts/Layout.astro';
import FilterBar from '../../components/FilterBar.astro';
import { weapons, fmtStat, stars } from '../../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [5, 4, 3].map((r) => ({ r, list: weapons.filter((w) => w.rarity === r) }));
const latest = Math.max(...weapons.map((w) => parseFloat(w.version)));
---
<Layout title="Оружие" wide>
  <h1>Оружие</h1>
  <p class="lead">{weapons.length} видов оружия. Наведите курсор или выделите карточку — появятся статы на 90 уровне и эффект.</p>

  <FilterBar target=".wlist" placeholder="Найти оружие" groups={['rarity', 'weapon']} rarities={[5, 4, 3]} />

  {groups.map(({ r, list }) => (
    <section>
      <h2 class="h-sec">Оружие {r}★ <small>{list.length}</small></h2>
      <div class="wlist">
        {list.map((w) => {
          const top = w.stats.at(-1)!;
          return (
            <div data-name={`${w.name} ${w.nameEn}`.toLowerCase().replace(/ё/g, 'е')} data-rarity={String(w.rarity)} data-weapon={w.weapon}>
              <a class:list={['wc', `r${w.rarity}`]} href={`${base}/weapons/${w.slug}`}>
                <span class="pic">
                  <img src={w.icon} alt="" width="96" height="96" loading="lazy" />
                  {parseFloat(w.version) === latest && <span class="badge">новое</span>}
                </span>
                <span class="nm">{w.name}</span>
                <span class="tip" role="tooltip">
                  <b>{w.name}</b>
                  <span class="muted small">{stars(w.rarity)} {w.weaponText}</span>
                  <span class="kv"><span>Атака</span><b>{top.atk}</b></span>
                  {w.mainStat && <span class="kv"><span>{w.mainStat}</span><b>{fmtStat(top.sub, w.mainStatPercent)}</b></span>}
                  {w.effectName && <span class="eff"><b>{w.effectName}.</b> {w.refinements[0]}</span>}
                </span>
              </a>
            </div>
          );
        })}
      </div>
    </section>
  ))}
  <p class="empty muted" hidden>Ничего не нашлось. Сбросьте фильтры.</p>
</Layout>

<style>
  .wlist { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px; }
  section:has(.wlist > :not([hidden])) ~ .empty { display: none; }
  section:not(:has(.wlist > :not([hidden]))) { display: none; }
  .wc { position: relative; display: grid; gap: .35rem; text-decoration: none; }
  .pic { position: relative; display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--radius); background: linear-gradient(170deg, #36436a, #4b7aa6); }
  .r4 .pic { background: linear-gradient(170deg, #4a3d6d, #9679c4); }
  .r5 .pic { background: linear-gradient(170deg, #6b4520, #d1953f); }
  .pic img { width: 88%; height: auto; }
  .badge { position: absolute; top: 5px; right: 5px; background: var(--accent); color: var(--accent-ink); font-size: .66rem; font-weight: 600; padding: 0 .35rem; border-radius: 4px; }
  .nm { font-size: .8rem; text-align: center; line-height: 1.2; }
  .wc:hover .pic, .wc:focus-visible .pic { outline: 2px solid var(--accent); outline-offset: 2px; }

  .tip {
    position: absolute; z-index: 20; left: 50%; bottom: calc(100% + 8px); translate: -50% 0; width: 300px; display: none; gap: .35rem;
    padding: .8rem .9rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: 0 16px 40px rgb(0 0 0 / .45);
    font-size: .85rem; text-align: left;
  }
  .wc:hover .tip, .wc:focus-visible .tip { display: grid; }
  .kv { display: flex; justify-content: space-between; background: var(--surface-2); padding: .25rem .5rem; border-radius: 6px; }
  .kv span { color: var(--muted); }
  .eff { color: var(--muted); max-height: 12em; overflow: hidden; }
  .eff b { color: var(--text); }
  @media (hover: none) { .tip { display: none !important; } }
</style>
