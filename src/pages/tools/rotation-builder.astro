---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getCharacter } from '../../lib/data';

// Готовые команды из гайдов и эндгейма — чтобы не собирать с нуля
const builds = await getCollection('builds');
const rotations = await getCollection('rotations');
const seen = new Set<string>();
const presets = [
  ...rotations.flatMap((r) => r.data.teams.map((t) => ({ name: t.name ?? 'Команда', members: t.members }))),
  ...builds.flatMap((b) => b.data.teams.map((t) => ({ name: t.name, members: t.members }))),
].filter((p) => { const k = p.members.join(); if (seen.has(k)) return false; seen.add(k); return true; })
  .map((p) => ({ label: `${p.name}: ${p.members.map((m) => getCharacter(m).name).join(', ')}`, name: p.name, members: p.members }));
---
<Layout title="Конструктор ротаций" description="Соберите команду и порядок действий в Genshin Impact и поделитесь ротацией одной ссылкой.">
  <h1>Конструктор ротаций</h1>
  <p class="lead">
    Ротация — порядок, в котором команда тратит навыки. Выберите до четырёх персонажей (первый — тот, кто дольше всех на поле),
    затем добавляйте шаги. Всё сохраняется в ссылке: скопируйте её, чтобы поделиться.
  </p>

  <div class="builder" data-presets={JSON.stringify(presets)}>
    <section class="panel">
      <div class="team-head">
        <label class="grow">Название<input class="input" name="team" placeholder="Например, Лунный заряд Флинса" maxlength="60" /></label>
        <label class="grow">Начать с готовой команды
          <select class="input" name="preset"><option value="">Выберите команду из гайда…</option>{presets.map((p, i) => <option value={i}>{p.label}</option>)}</select>
        </label>
      </div>
      <h2 class="h-sec">Состав</h2>
      <div class="members" id="members"></div>
      <datalist id="char-list"></datalist>
    </section>

    <section class="panel">
      <h2 class="h-sec">Ротация <small id="step-count"></small></h2>
      <div class="picker">
        <div class="who" id="who" role="group" aria-label="Кто действует"></div>
        <div class="actions" id="actions" role="group" aria-label="Действие"></div>
      </div>
      <ol class="steps" id="steps"></ol>
      <p class="muted small hint" id="steps-empty">Выберите персонажа и нажмите действие — шаг появится здесь.</p>
    </section>

    <section class="panel">
      <h2 class="h-sec">Запись и ссылка</h2>
      <p class="notation" id="notation">—</p>
      <div class="share">
        <input class="input" id="share" readonly aria-label="Ссылка на ротацию" />
        <button class="btn primary" type="button" id="copy">Скопировать ссылку</button>
        <button class="btn" type="button" id="clear">Очистить</button>
      </div>
      <p class="muted small" id="copied" aria-live="polite"></p>
    </section>
  </div>
</Layout>

<script>
  import { loadIndex, BASE } from '../../scripts/search';

  type Member = { c: string; w?: string; a?: string; er?: number; k?: number };
  type Step = { m: number; a: string };
  type State = { t: string; m: Member[]; s: Step[] };

  const ACTIONS: [string, string][] = [['E', 'Навык'], ['hE', 'Навык (удерж.)'], ['Q', 'Взрыв'], ['N', 'Обычная атака'], ['C', 'Заряж. атака'], ['P', 'Атака в падении'], ['D', 'Рывок'], ['J', 'Прыжок']];
  const SHORT: Record<string, string> = { E: 'E', hE: 'hE', Q: 'Q', N: 'N', C: 'C', P: 'P', D: 'D', J: 'J' };

  const root = document.querySelector<HTMLElement>('.builder')!;
  const presets: { name: string; members: string[] }[] = JSON.parse(root.dataset.presets!);
  const idx = await loadIndex();
  const chars = new Map(idx.characters.map((c) => [c.s, c]));
  const byName = new Map(idx.characters.flatMap((c) => [[c.n.toLowerCase(), c.s], [c.e.toLowerCase(), c.s]]));
  const weapons = new Map(idx.weapons.map((w) => [w.s, w]));
  const arts = new Map(idx.artifacts.map((a) => [a.s, a]));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // Состояние живёт в hash: base64url(JSON)
  const encode = (s: State) => btoa(unescape(encodeURIComponent(JSON.stringify(s)))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  const decode = (h: string): State | null => {
    try { return JSON.parse(decodeURIComponent(escape(atob(h.replace(/-/g, '+').replace(/_/g, '/'))))); } catch { return null; }
  };
  const valid = (s: State | null): s is State => !!s && Array.isArray(s.m) && Array.isArray(s.s);
  const fromHash = decode(location.hash.slice(1));
  let state: State = valid(fromHash) ? { t: String(fromHash.t ?? ''), m: fromHash.m.filter((m) => chars.has(m.c)).slice(0, 4), s: fromHash.s } : { t: '', m: [], s: [] };
  state.s = state.s.filter((st) => st.m < state.m.length && SHORT[st.a]);
  let actor = 0;

  const teamInput = root.querySelector<HTMLInputElement>('[name="team"]')!;
  const presetSel = root.querySelector<HTMLSelectElement>('[name="preset"]')!;
  document.getElementById('char-list')!.innerHTML = idx.characters.map((c) => `<option value="${esc(c.n)}">`).join('');

  function save() {
    const h = encode(state);
    history.replaceState(null, '', `#${h}`);
    (document.getElementById('share') as HTMLInputElement).value = location.href;
  }

  function renderMembers() {
    const box = document.getElementById('members')!;
    const slots = [...state.m, ...(state.m.length < 4 ? [null] : [])];
    box.innerHTML = slots.map((m, i) => {
      if (!m) return `<div class="slot empty"><label>Персонаж ${i + 1}<input class="input" list="char-list" data-add placeholder="Начните вводить имя"></label></div>`;
      const c = chars.get(m.c)!;
      const wopts = idx.weapons.filter((w) => w.w === c.w).map((w) => `<option value="${w.s}" ${w.s === m.w ? 'selected' : ''}>${esc(w.n)} ${'★'.repeat(w.r)}</option>`).join('');
      const aopts = idx.artifacts.map((a) => `<option value="${a.s}" ${a.s === m.a ? 'selected' : ''}>${esc(a.n)}</option>`).join('');
      const kopts = [0, 1, 2, 3, 4, 5, 6].map((k) => `<option value="${k}" ${k === (m.k ?? 0) ? 'selected' : ''}>C${k}</option>`).join('');
      return `<div class="slot" data-i="${i}" data-el="${c.el}">
        <div class="slot-head"><img src="${c.i}" alt="" width="52" height="52"><div><b>${esc(c.n)}</b><span class="muted small">${i === 0 ? 'На поле' : 'Поддержка'}</span></div>
          <div class="slot-btns">${i > 0 ? `<button class="btn tiny" type="button" data-up aria-label="Поднять выше">↑</button>` : ''}<button class="btn tiny" type="button" data-del aria-label="Убрать ${esc(c.n)}">×</button></div></div>
        <label>Оружие<select class="input" data-f="w"><option value="">—</option>${wopts}</select></label>
        <label>Сет<select class="input" data-f="a"><option value="">—</option>${aopts}</select></label>
        <div class="pair"><label>ВЭ, %<input class="input" data-f="er" type="number" min="100" max="400" step="1" value="${m.er ?? ''}" placeholder="100"></label>
        <label>Созвездие<select class="input" data-f="k">${kopts}</select></label></div>
      </div>`;
    }).join('');
  }

  function renderPicker() {
    const who = document.getElementById('who')!;
    who.innerHTML = state.m.map((m, i) => {
      const c = chars.get(m.c)!;
      return `<button type="button" class="btn who-btn" data-actor="${i}" aria-pressed="${i === actor}"><img src="${c.i}" alt="" width="28" height="28">${esc(c.n)}</button>`;
    }).join('') || '<span class="muted small">Сначала добавьте персонажей в состав</span>';
    document.getElementById('actions')!.innerHTML = state.m.length
      ? ACTIONS.map(([a, label]) => `<button type="button" class="btn" data-act="${a}"><b>${SHORT[a]}</b> ${label}</button>`).join('') : '';
  }

  function renderSteps() {
    const list = document.getElementById('steps')!;
    list.innerHTML = state.s.map((st, i) => {
      const c = chars.get(state.m[st.m].c)!;
      return `<li data-el="${c.el}"><img src="${c.i}" alt="" width="30" height="30"><span><b>${SHORT[st.a]}</b><small>${esc(c.n)}</small></span>
        <span class="step-btns"><button type="button" data-move="-1" data-s="${i}" aria-label="Раньше">‹</button><button type="button" data-move="1" data-s="${i}" aria-label="Позже">›</button><button type="button" data-rm="${i}" aria-label="Удалить шаг">×</button></span></li>`;
    }).join('');
    document.getElementById('steps-empty')!.hidden = state.s.length > 0;
    document.getElementById('step-count')!.textContent = state.s.length ? `Шагов: ${state.s.length}` : '';
    // Запись: подряд идущие шаги одного персонажа склеиваются — «Райдэн E, Син Цю EQ, …»
    const groups: { m: number; acts: string[] }[] = [];
    for (const st of state.s) {
      const last = groups.at(-1);
      if (last && last.m === st.m) last.acts.push(SHORT[st.a]); else groups.push({ m: st.m, acts: [SHORT[st.a]] });
    }
    const text = groups.map((g) => {
      const acts = g.acts.join('').replace(/N{2,}/g, (s) => `N${s.length}`);
      return `${chars.get(state.m[g.m].c)!.n} ${acts}`;
    }).join(' › ');
    document.getElementById('notation')!.textContent = (state.t ? `${state.t}: ` : '') + (text || '—');
  }

  function renderAll() { teamInput.value = state.t; renderMembers(); renderPicker(); renderSteps(); save(); }

  // Удаление участника сдвигает индексы в шагах
  function removeMember(i: number) {
    state.m.splice(i, 1);
    state.s = state.s.filter((s) => s.m !== i).map((s) => ({ ...s, m: s.m > i ? s.m - 1 : s.m }));
    actor = Math.min(actor, Math.max(0, state.m.length - 1));
  }
  function swapMembers(i: number, j: number) {
    [state.m[i], state.m[j]] = [state.m[j], state.m[i]];
    state.s = state.s.map((s) => ({ ...s, m: s.m === i ? j : s.m === j ? i : s.m }));
  }

  root.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement | HTMLSelectElement;
    if (t.matches('[data-add]')) {
      const slug = byName.get(t.value.trim().toLowerCase());
      if (slug && !state.m.some((m) => m.c === slug)) { state.m.push({ c: slug }); renderAll(); }
      return;
    }
    const slot = t.closest<HTMLElement>('.slot[data-i]');
    if (slot && t.dataset.f) {
      const m = state.m[Number(slot.dataset.i)];
      const f = t.dataset.f as keyof Member;
      if (f === 'er' || f === 'k') (m[f] as number | undefined) = t.value ? Number(t.value) : undefined;
      else (m[f] as string | undefined) = t.value || undefined;
      save();
    }
    if (t === presetSel && t.value) {
      const p = presets[Number(t.value)];
      state = { t: p.name, m: p.members.filter((s) => chars.has(s)).map((c) => ({ c })), s: [] };
      actor = 0; t.value = ''; renderAll();
    }
  });
  teamInput.addEventListener('input', () => { state.t = teamInput.value; renderSteps(); save(); });

  root.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    const slot = b.closest<HTMLElement>('.slot[data-i]');
    if (b.hasAttribute('data-del') && slot) { removeMember(Number(slot.dataset.i)); renderAll(); }
    else if (b.hasAttribute('data-up') && slot) { const i = Number(slot.dataset.i); swapMembers(i, i - 1); renderAll(); }
    else if (b.dataset.actor) { actor = Number(b.dataset.actor); renderPicker(); }
    else if (b.dataset.act) { state.s.push({ m: actor, a: b.dataset.act }); renderSteps(); save(); }
    else if (b.dataset.rm) { state.s.splice(Number(b.dataset.rm), 1); renderSteps(); save(); }
    else if (b.dataset.move) {
      const i = Number(b.dataset.s), j = i + Number(b.dataset.move);
      if (j >= 0 && j < state.s.length) { [state.s[i], state.s[j]] = [state.s[j], state.s[i]]; renderSteps(); save(); }
    } else if (b.id === 'copy') {
      navigator.clipboard?.writeText(location.href).then(
        () => (document.getElementById('copied')!.textContent = 'Ссылка скопирована.'),
        () => (document.getElementById('copied')!.textContent = 'Не удалось скопировать — выделите ссылку вручную.'),
      );
    } else if (b.id === 'clear') { state = { t: '', m: [], s: [] }; actor = 0; renderAll(); }
  });

  renderAll();
  void BASE;
</script>

<style>
  .builder { display: grid; gap: 14px; }
  label { display: grid; gap: .3rem; font-size: .82rem; color: var(--muted); }
  .team-head { display: grid; grid-template-columns: 1fr 1.4fr; gap: 12px; }
  .members { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .members :global(.slot) { display: grid; gap: .6rem; background: var(--surface-2); border-radius: var(--radius); padding: .8rem; border-top: 3px solid var(--el, var(--border)); }
  .members :global(.slot.empty) { border: 1px dashed var(--border); background: none; align-content: center; min-height: 120px; }
  .members :global(.slot-head) { display: flex; gap: .6rem; align-items: center; }
  .members :global(.slot-head img) { border-radius: 10px; background: var(--surface-3); }
  .members :global(.slot-head div:not(.slot-btns)) { display: grid; }
  .members :global(.slot-btns) { margin-left: auto; display: flex; gap: 4px; }
  .members :global(.tiny) { padding: .2rem .5rem; }
  .members :global(.pair) { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .members :global(.input) { padding: .4rem .55rem; font-size: .88rem; color: var(--text); }

  .picker { display: grid; gap: .6rem; margin-bottom: 1rem; }
  .who, .actions { display: flex; flex-wrap: wrap; gap: 6px; }
  .picker :global(.who-btn) { padding: .3rem .7rem .3rem .3rem; }
  .picker :global(.who-btn img) { border-radius: 6px; }
  .picker :global(.actions .btn b) { color: var(--accent); }
  .steps { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; counter-reset: s; }
  .steps :global(li) {
    display: flex; align-items: center; gap: .45rem; padding: .3rem .4rem; border-radius: var(--radius);
    background: var(--surface-2); border-bottom: 2px solid var(--el);
  }
  .steps :global(li img) { border-radius: 6px; }
  .steps :global(li > span:not(.step-btns)) { display: grid; line-height: 1.1; }
  .steps :global(li b) { font: 600 .95rem var(--font-display); }
  .steps :global(li small) { color: var(--muted); font-size: .72rem; }
  .steps :global(.step-btns) { display: flex; }
  .steps :global(.step-btns button) { border: 0; background: none; color: var(--muted); cursor: pointer; padding: .1rem .3rem; font-size: 1rem; }
  .steps :global(.step-btns button:hover) { color: var(--text); }
  .hint { margin: .5rem 0 0; }
  .notation { font: 500 1rem var(--font-display); line-height: 1.5; background: var(--surface-2); border-radius: var(--radius); padding: .8rem 1rem; }
  .share { display: flex; gap: 8px; flex-wrap: wrap; }
  .share .input { flex: 1 1 260px; font-size: .82rem; color: var(--muted); }
  @media (max-width: 640px) { .team-head { grid-template-columns: 1fr; } }
</style>
