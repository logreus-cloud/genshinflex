---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Team from '../components/Team.astro';
import CharacterIcon from '../components/CharacterIcon.astro';
import { MODES, fmtDate } from '../lib/data';

const order = Object.keys(MODES);
const rotations = (await getCollection('rotations'))
  .sort((a, b) => order.indexOf(a.data.mode) - order.indexOf(b.data.mode));
---
<Layout title="Ротация">
  <h1>Текущая ротация</h1>
  <p class="muted">Враги, баффы и рекомендованные команды под текущие циклы.</p>

  {rotations.map(({ data: r }) => (
    <section id={r.mode} class="mode">
      <h2>{MODES[r.mode].title} <span class="chip">{fmtDate(r.start)} — {fmtDate(r.end)}</span></h2>
      {r.draft ? (
        <p class="notice">{r.note ?? `Цикл «${r.cycle}» ещё не заполнен: нужны враги, баффы и команды.`}</p>
      ) : (
        <>
          <p class="muted">{r.cycle}</p>
          {r.note && <p class="notice">{r.note}</p>}
          {r.buffs.length > 0 && <ul class="buffs">{r.buffs.map((b) => <li>{b}</li>)}</ul>}
          {r.cast.map((c) => (
            <div class="cast">
              <h3>{c.title}</h3>
              <div class="row">{c.members.map((m) => <CharacterIcon slug={m} size={56} />)}</div>
            </div>
          ))}
          {r.stages.length > 0 && (
            <div class="grid stages">
              {r.stages.map((s) => (
                <div class="panel">
                  <h3>{s.name}</h3>
                  {s.halves.map((h, i) => (
                    <p>
                      {s.halves.length > 1 && <b>{i + 1}-я половина: </b>}
                      {h.enemies.join(', ')}
                      {h.note && <small class="muted"> — {h.note}</small>}
                    </p>
                  ))}
                </div>
              ))}
            </div>
          )}
          {r.teams.length > 0 && (
            <>
              <h3 class="teams-title">Команды</h3>
              <div class="grid">{r.teams.map((t) => <Team {...t} />)}</div>
            </>
          )}
          {r.sources.length > 0 && (
            <p class="muted small">Источники: {r.sources.map((s, i) => <>{i > 0 && ', '}<a href={s.url} rel="noopener">{s.title}</a></>)}</p>
          )}
        </>
      )}
    </section>
  ))}
</Layout>

<style>
  .mode { scroll-margin-top: 80px; margin-bottom: 2.5rem; }
  .panel p { margin: .3rem 0; font-size: .92rem; }
  .buffs { padding-left: 1.2rem; }
  .buffs li { margin: .3rem 0; }
  .cast { margin: 1rem 0; }
  .row { display: flex; flex-wrap: wrap; gap: .4rem; }
  .stages { margin-top: 1rem; }
  .teams-title { margin-top: 1.4rem; }
  .small { font-size: .85rem; }
</style>
