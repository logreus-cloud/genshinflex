---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { characters } from '../../lib/data';

const withBuild = new Set((await getCollection('builds')).map((b) => b.data.character));
const latest = Math.max(...characters.map((c) => parseFloat(c.version)));
---
<Layout title="Персонажи" wide>
  <h1>Персонажи</h1>
  <p class="lead">Все {characters.length} играбельных персонажей со статами, талантами и созвездиями. Отметка «билд» — есть готовое руководство.</p>

  <FilterBar target="#chars" placeholder="Найти персонажа" groups={['rarity', 'element', 'weapon']} extra={{ key: 'build', label: 'Только с билдом' }} />

  <div class="cards" id="chars">
    {characters.map((c) => (
      <div data-name={`${c.name} ${c.nameEn}`.toLowerCase().replace(/ё/g, 'е')} data-element={c.element} data-weapon={c.weapon}
        data-rarity={String(c.rarity)} data-build={withBuild.has(c.slug) ? '1' : ''}>
        <CharacterCard slug={c.slug} badge={parseFloat(c.version) === latest ? 'новый' : withBuild.has(c.slug) ? 'билд' : undefined} />
      </div>
    ))}
  </div>
  <p class="empty muted" hidden>Никого не нашлось. Сбросьте часть фильтров.</p>
</Layout>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px; }
  .empty { text-align: center; margin: 3rem 0; }
</style>
