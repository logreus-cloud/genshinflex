---
import '../styles/global.css';
import QuickSearch from '../components/QuickSearch.astro';

interface Props { title?: string; description?: string; wide?: boolean; image?: string | null; type?: 'website' | 'article'; jsonLd?: object; }
const {
  title, description = 'Справочник по Genshin Impact на русском: билды, команды, проверка команды для Бездны и трекер круток.',
  wide = false, image, type = 'website', jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} — GenshinFlex` : 'GenshinFlex — билды и команды Genshin Impact под текущую Бездну';
// Cloudflare отдаёт страницы с «/» на конце — canonical должен совпадать с реальным адресом
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).toString();
const ogImage = image ?? new URL('/og.png', Astro.site).toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';

const nav = [
  { group: null, items: [['Главная', '/', 'home']] },
  { group: 'База', items: [['Персонажи', '/characters', 'user'], ['Оружие', '/weapons', 'sword'], ['Артефакты', '/artifacts', 'flower']] },
  { group: 'Эндгейм', items: [['Текущая ротация', '/rotation', 'moon'], ['Рейтинг', '/rating', 'chart']] },
  { group: 'Таймлайн', items: [['Баннеры', '/banners', 'moon']] },
  { group: 'Гайды', items: [['Руководства', '/guides', 'book']] },
  { group: 'Инструменты', items: [['Проверка команды', '/tools/team-check', 'check'], ['Трекер круток', '/tools/wishes', 'star'], ['Конструктор ротаций', '/tools/rotation-builder', 'tool']] },
] as const;

// Простые контурные иконки навигации, 20×20
const icons: Record<string, string> = {
  home: 'M3 9.5 10 4l7 5.5V16a1 1 0 0 1-1 1h-3.5v-4.5h-5V17H4a1 1 0 0 1-1-1Z',
  user: 'M10 10a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Zm-6 6.4c.6-2.8 3-4.4 6-4.4s5.4 1.6 6 4.4',
  sword: 'M15.5 3.5 16.5 4.5 8 13l-1-1Zm-8.5 8.5-3 3 1 1 3-3M12 3h5v5',
  flower: 'M10 10m-2 0a2 2 0 1 0 4 0 2 2 0 1 0-4 0M10 3.5c1.6 1.4 1.6 3 0 4.5-1.6-1.5-1.6-3.1 0-4.5Zm0 9c1.6 1.4 1.6 3 0 4.5-1.6-1.5-1.6-3.1 0-4.5ZM3.5 10c1.4-1.6 3-1.6 4.5 0-1.5 1.6-3.1 1.6-4.5 0Zm9 0c1.4-1.6 3-1.6 4.5 0-1.5 1.6-3.1 1.6-4.5 0Z',
  moon: 'M15.5 12.5A6.5 6.5 0 0 1 7.5 4.5a6.5 6.5 0 1 0 8 8Z',
  chart: 'M4 16V9m4 7V5m4 11v-5m4 5V7',
  star: 'm10 3.5 1.9 4 4.3.5-3.2 3 .9 4.3L10 13.2l-3.9 2.1.9-4.3-3.2-3 4.3-.5Z',
  book: 'M4 4.5h4.5A1.5 1.5 0 0 1 10 6v10a1.5 1.5 0 0 0-1.5-1.5H4Zm12 0h-4.5A1.5 1.5 0 0 0 10 6v10a1.5 1.5 0 0 1 1.5-1.5H16Z',
  check: 'M10 3 16 5.5v4.2c0 3.6-2.5 6.3-6 7.3-3.5-1-6-3.7-6-7.3V5.5Zm-2.7 7 2 2 3.7-4',
  tool: 'M12.5 3.5a3.5 3.5 0 0 0-3.3 4.6L4 13.3 6.7 16l5.2-5.2a3.5 3.5 0 0 0 4.6-3.3l-2 1.1-2-2 1.1-2Z',
};
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="GenshinFlex" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&family=Unbounded:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
    <script is:inline>
      try { const t = localStorage.getItem('gf:theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip sr-only" href="#content">К содержимому</a>
    <aside class="side" id="side" aria-label="Навигация">
      <a class="logo" href={`${base}/`}>
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M16 2 29 9.5v13L16 30 3 22.5v-13Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8.5 22.5 12v8L16 23.5 9.5 20v-8Z" fill="currentColor"/></svg>
        <span>Genshin<b>Flex</b></span>
      </a>
      <nav>
        {nav.map(({ group, items }) => (
          <div class="group">
            {group && <p class="gtitle">{group}</p>}
            {items.map(([label, href, icon]) => (
              <a href={`${base}${href}`} aria-current={active(href) ? 'page' : undefined}>
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d={icons[icon]} /></svg>
                {label}
              </a>
            ))}
          </div>
        ))}
      </nav>
      <a class="map-card" href="https://act.hoyolab.com/ys/app/interactive-map/index.html?lang=ru-ru" target="_blank" rel="noopener">
        <svg class="contours" viewBox="0 0 200 90" aria-hidden="true" preserveAspectRatio="none">
          <path d="M-10 70c30-18 55-8 80-22s45-30 80-18 40 6 60-4M-10 84c35-16 60-4 88-18s50-26 82-14 38 8 50 2M20 -4c10 18 30 24 52 20s40 6 48 22" />
        </svg>
        <svg class="compass" viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
          <circle cx="20" cy="20" r="17" class="ring" />
          <circle cx="20" cy="20" r="12.5" class="ring thin" />
          <path d="M20 2 23 17 38 20 23 23 20 38 17 23 2 20 17 17Z" class="star" />
          <path d="M20 8 21.6 18.4 32 20 21.6 21.6 20 32 18.4 21.6 8 20 18.4 18.4Z" class="star-in" />
          <circle cx="20" cy="20" r="2" class="pin" />
        </svg>
        <span class="map-text">
          <b>Карта Тейвата</b>
          <small>Официальная, от HoYoLAB</small>
        </span>
        <svg class="ext" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" /></svg>
        <span class="sr-only">(откроется в новой вкладке)</span>
      </a>
      <div class="side-foot">
        <p>Без рекламы и регистрации.</p>
      </div>
    </aside>
    <div class="scrim" id="scrim" hidden></div>

    <div class="shell">
      <header class="top">
        <button class="icon-btn burger" id="burger" type="button" aria-label="Открыть меню" aria-controls="side" aria-expanded="false">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
        </button>
        <QuickSearch />
        <button class="icon-btn" id="theme" type="button" aria-label="Сменить тему" title="Сменить тему">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3a7 7 0 1 0 0 14Z" fill="currentColor"/><circle cx="10" cy="10" r="7" /></svg>
        </button>
      </header>
      <main id="content" class:list={['content', { wide }]}><slot /></main>
      <footer class="footer muted">
        <p>
          GenshinFlex — справочник без рекламы. Игровые данные — <a href="https://github.com/theBowja/genshin-db">genshin-db</a>,
          изображения — enka.network. Genshin Impact, персонажи и арты © HoYoverse; проект не связан с HoYoverse.
        </p>
      </footer>
    </div>

    <script>
      import '../scripts/common';
      const root = document.documentElement;
      document.getElementById('theme')?.addEventListener('click', () => {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('gf:theme', root.dataset.theme); } catch {}
      });
      const side = document.getElementById('side')!, scrim = document.getElementById('scrim')!, burger = document.getElementById('burger')!;
      const toggle = (open: boolean) => {
        side.classList.toggle('open', open);
        scrim.hidden = !open;
        burger.setAttribute('aria-expanded', String(open));
      };
      burger.addEventListener('click', () => toggle(!side.classList.contains('open')));
      scrim.addEventListener('click', () => toggle(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });
    </script>
  </body>
</html>

<style>
  .side {
    position: fixed; inset: 0 auto 0 0; width: var(--side-w); background: var(--bg-deep); border-right: 1px solid var(--border);
    display: flex; flex-direction: column; z-index: 40; overflow-y: auto;
  }
  .logo { display: flex; align-items: center; gap: .6rem; height: var(--top-h); padding: 0 1.1rem; text-decoration: none; color: var(--accent); flex: none; }
  .logo span { font: 600 1.05rem var(--font-display); color: var(--text); }
  .logo b { color: var(--accent); font-weight: 600; }
  nav { padding: .4rem .6rem 1rem; flex: 1; }
  .gtitle { margin: 1rem .6rem .3rem; font-size: .76rem; color: var(--muted); }
  nav a {
    display: flex; align-items: center; gap: .65rem; padding: .45rem .6rem; border-radius: var(--radius-sm);
    text-decoration: none; color: var(--muted); font-size: .93rem;
  }
  nav svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  nav a:hover { color: var(--text); background: var(--surface); }
  nav a[aria-current] { color: var(--text); background: var(--surface-2); box-shadow: inset 3px 0 0 var(--accent); }
  nav a[aria-current] svg { stroke: var(--accent); }
  /* Кнопка карты: рамка как у окон в игре — двойная золотая линия и ромбы по углам */
  .map-card {
    position: relative; display: flex; align-items: center; gap: .6rem; margin: 0 .8rem 1rem; padding: .7rem .7rem;
    text-decoration: none; border-radius: 4px; isolation: isolate; padding-right: 1.6rem;
    background: radial-gradient(120% 140% at 0% 0%, #2c4a5a 0%, #1d2a44 55%, #171b2e 100%);
    border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent);
    box-shadow: inset 0 0 0 3px #171b2e, inset 0 0 0 4px color-mix(in srgb, var(--accent) 35%, transparent);
    color: #efe6cf;
  }
  .map-card::before, .map-card::after {
    content: ""; position: absolute; width: 7px; height: 7px; background: var(--accent); rotate: 45deg; z-index: 1;
  }
  .map-card::before { top: -4px; left: -4px; }
  .map-card::after { bottom: -4px; right: -4px; }
  .contours { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; border-radius: 4px; fill: none; stroke: #e3b04b; stroke-width: .8; opacity: .22; }
  .compass { flex: none; transition: rotate .5s cubic-bezier(.3, 1.4, .5, 1); }
  .compass .ring { fill: none; stroke: #e3b04b; stroke-width: 1.2; opacity: .8; }
  .compass .ring.thin { stroke-width: .6; stroke-dasharray: 1.5 2.5; }
  .compass .star { fill: #e3b04b; }
  .compass .star-in { fill: #fff3d0; opacity: .85; }
  .compass .pin { fill: #171b2e; }
  .map-text { display: grid; line-height: 1.2; min-width: 0; }
  .map-text b { font: 600 .88rem var(--font-display); color: #f3d38a; white-space: nowrap; }
  .map-text small { font-size: .72rem; color: #c9c2ad; }
  .ext { position: absolute; top: .55rem; right: .55rem; fill: none; stroke: #e3b04b; stroke-width: 1.6; stroke-linecap: round; opacity: .7; }
  .map-card:hover { border-color: var(--accent); box-shadow: inset 0 0 0 3px #171b2e, inset 0 0 0 4px var(--accent), 0 0 18px rgb(227 176 75 / .18); }
  .map-card:hover .compass { rotate: 45deg; }
  .map-card:focus-visible { outline-offset: 3px; }
  .side-foot { padding: 1rem 1.2rem 1.4rem; font-size: .8rem; color: var(--muted); border-top: 1px solid var(--border); }
  .side-foot p { margin: 0; }

  .shell { margin-left: var(--side-w); min-height: 100vh; display: flex; flex-direction: column; overflow-x: clip; }
  .top {
    position: sticky; top: 0; z-index: 30; height: var(--top-h); display: flex; align-items: center; gap: .8rem;
    padding: 0 24px; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .icon-btn { display: grid; place-items: center; width: 38px; height: 38px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); cursor: pointer; flex: none; }
  .icon-btn svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  #theme { margin-left: auto; }
  .burger { display: none; }
  .content { width: 100%; max-width: 1180px; margin: 0 auto; padding: 1.8rem 24px 3rem; flex: 1; }
  .content.wide { max-width: 1400px; }
  .footer { max-width: 1180px; width: 100%; margin: 0 auto; padding: 1.2rem 24px 2rem; font-size: .8rem; border-top: 1px solid var(--border); }
  .footer p { max-width: 90ch; margin: 0; }
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; padding: .5rem 1rem; background: var(--accent); color: var(--accent-ink); z-index: 100; border-radius: var(--radius); }
  .scrim { position: fixed; inset: 0; background: rgb(0 0 0 / .5); z-index: 35; }

  @media (max-width: 900px) {
    .side { transform: translateX(-100%); transition: transform .2s ease; }
    .side.open { transform: none; }
    .shell { margin-left: 0; }
    .burger { display: grid; }
    .top { padding: 0 16px; gap: .5rem; }
    .content { padding: 1.2rem 16px 2.5rem; }
    .footer { padding: 1rem 16px 1.6rem; }
  }
</style>
