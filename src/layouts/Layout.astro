---
import '../styles/global.css';
import QuickSearch from '../components/QuickSearch.astro';
import Splash from '../components/Splash.astro';
import social from '../data/social.json';
import { ogPath } from '../lib/og';
import { icons } from '../lib/nav-icons';
import { useData, LANGS, prefixOf } from '../lib/data';
const { lang, base, t } = useData(Astro.currentLocale);

interface Props { title?: string; description?: string; wide?: boolean; noindex?: boolean; image?: string | null; type?: 'website' | 'article'; jsonLd?: object; }
const {
  title, description = t('Справочник по Genshin Impact на русском: билды, команды, проверка команды для Бездны и трекер круток.'),
  wide = false, image, type = 'website', jsonLd, noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} — GenshinFlex` : `GenshinFlex — ${t('билды и команды Genshin Impact под текущую Бездну')}`;
// Cloudflare отдаёт страницы с «/» на конце — canonical должен совпадать с реальным адресом
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).toString();
const ogImage = image ?? new URL('/og.png', Astro.site).toString();
// Путь без языкового префикса: /en/characters/vesna/ → /characters/vesna
const path = Astro.url.pathname.replace(/^\/(en|es)(?=\/|$)/, '').replace(/\/$/, '') || '/';
// Та же страница на других языках — для переключателя и hreflang
const alt = (l: typeof lang) => new URL(`${prefixOf(l)}${path === '/' ? '' : path}/`, Astro.site).toString();
const OG_LOCALE = { ru: 'ru_RU', en: 'en_US', es: 'es_ES' } as const;
const MAP_LANG = { ru: 'ru-ru', en: 'en-us', es: 'es-es' } as const;

const nav = [
  { group: null, items: [['Главная', '/', 'home']] },
  { group: 'База', items: [['Персонажи', '/characters', 'user'], ['Оружие', '/weapons', 'sword'], ['Артефакты', '/artifacts', 'flower']] },
  { group: 'Эндгейм', items: [['Все режимы', '/rotation', 'moon'], ['Витая бездна', '/abyss', 'spiral'], ['Театр воображариума', '/theater', 'mask'], ['Натиск', '/onslaught', 'flame']] },
  { group: 'Таймлайн', items: [['Календарь', '/calendar', 'calendar'], ['Баннеры', '/banners', 'moon']] },
  { group: 'Гайды', items: [['Руководства', '/guides', 'book']] },
  { group: 'Сайт', items: [['Новости сайта', '/news', 'book']] },
  { group: 'Инструменты', items: [['Симулятор команды', '/tools/simulator', 'chart'], ['Проверка команды', '/tools/team-check', 'check'], ['Трекер круток', '/tools/wishes', 'star'], ['Конструктор ротаций', '/tools/rotation-builder', 'tool'], ['Калькулятор прокачки', '/tools/calculator', 'calc']] },
  // Разделы, которые выйдут не скоро: отдельно и приглушённо, чтобы не путать с готовыми
  { group: 'В разработке', soon: true, items: [['Рейтинг', '/rating', 'chart']] },
] as const;

// Колонки подвала
const footerCols: [string, [string, string][]][] = [
  ['База', [['Персонажи', '/characters/'], ['Оружие', '/weapons/'], ['Артефакты', '/artifacts/'], ['Руководства', '/guides/']]],
  ['Эндгейм', [['Календарь', '/calendar/'], ['Витая бездна', '/abyss/'], ['Театр воображариума', '/theater/'], ['Натиск', '/onslaught/'], ['Баннеры', '/banners/'], ['История баннеров', '/banners/#history'], ['Рейтинг', '/rating/']]],
  ['Инструменты', [['Симулятор команды', '/tools/simulator/'], ['Проверка команды', '/tools/team-check/'], ['Трекер круток', '/tools/wishes/'], ['Конструктор ротаций', '/tools/rotation-builder/'], ['Калькулятор прокачки', '/tools/calculator/'],
    ['Карта Тейвата', `https://act.hoyolab.com/ys/app/interactive-map/index.html?lang=${MAP_LANG[lang]}`]]],
  ['Сайт', [['Новости сайта', '/news/'], ['Telegram-канал', social.telegram], ...(social.discord ? [['Discord-сервер', social.discord] as [string, string]] : []), ['О сайте', '/about/'], ['Обратная связь', '/feedback/'], ['Sitemap', '/sitemap.xml']]],
];
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="GenshinFlex" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alt('ru')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#141726" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&family=Unbounded:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
    <script is:inline>
      try { const t = localStorage.getItem('gf:theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <Splash />
    <a class="skip sr-only" href="#content">{t('К содержимому')}</a>
    <aside class="side" id="side" aria-label={t('Навигация')} aria-hidden="true" inert>
      <div class="side-head">
        <a class="logo" href={`${base}/`}>
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M16 2 29 9.5v13L16 30 3 22.5v-13Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8.5 22.5 12v8L16 23.5 9.5 20v-8Z" fill="currentColor"/></svg>
          <span>Genshin<b>Flex</b></span>
        </a>
        <button class="icon-btn side-close" type="button" aria-label={t('Закрыть меню')}>×</button>
      </div>
      <nav>
        {nav.map(({ group, items, ...rest }) => (
          <div class:list={['group', { soon: 'soon' in rest }]}>
            {group && <p class="gtitle">{t(group)}</p>}
            {items.map(([label, href, icon]) => (
              <a href={`${base}${href}`} aria-current={active(href) ? 'page' : undefined}>
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" set:html={icons[icon]} />
                {t(label)}
                {'soon' in rest && <small class="soon-tag">{t('скоро')}</small>}
              </a>
            ))}
          </div>
        ))}
      </nav>
      <a class="map-card" href={`https://act.hoyolab.com/ys/app/interactive-map/index.html?lang=${MAP_LANG[lang]}`} target="_blank" rel="noopener">
        <svg class="contours" viewBox="0 0 200 90" aria-hidden="true" preserveAspectRatio="none">
          <path d="M-10 70c30-18 55-8 80-22s45-30 80-18 40 6 60-4M-10 84c35-16 60-4 88-18s50-26 82-14 38 8 50 2M20 -4c10 18 30 24 52 20s40 6 48 22" />
        </svg>
        <svg class="compass" viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
          <circle cx="20" cy="20" r="17" class="ring" />
          <circle cx="20" cy="20" r="12.5" class="ring thin" />
          <path d="M20 2 23 17 38 20 23 23 20 38 17 23 2 20 17 17Z" class="star" />
          <path d="M20 8 21.6 18.4 32 20 21.6 21.6 20 32 18.4 21.6 8 20 18.4 18.4Z" class="star-in" />
          <circle cx="20" cy="20" r="2" class="pin" />
        </svg>
        <span class="map-text">
          <b>{t('Карта Тейвата')}</b>
          <small>{t('Официальная, от HoYoLAB')}</small>
        </span>
        <svg class="ext" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" /></svg>
        <span class="sr-only">{t('(откроется в новой вкладке)')}</span>
      </a>
      <div class="side-foot">
        <p>{t('Без рекламы и регистрации.')}</p>
      </div>
    </aside>
    <div class="scrim" id="scrim" hidden></div>

    <div class="shell">
      <header class="top">
        <button class="icon-btn burger" id="burger" type="button" aria-label={t('Открыть меню')} data-close-label={t('Закрыть меню')} aria-controls="side" aria-expanded="false">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
        </button>
        <a class="top-logo" href={`${base}/`}>
          <svg viewBox="0 0 32 32" width="40" height="40" aria-hidden="true"><path d="M16 2 29 9.5v13L16 30 3 22.5v-13Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8.5 22.5 12v8L16 23.5 9.5 20v-8Z" fill="currentColor"/></svg>
          <span><strong>Genshin<b>Flex</b></strong><small>{t('Билды, команды и многое другое!')}</small></span>
        </a>
        <div class="top-actions">
          <button class="search-pill" id="search-pill" type="button" aria-controls="search-panel" aria-expanded="false">{t('Поиск')}</button>
          <button class="icon-btn" id="search-icon" type="button" aria-label={t('Открыть поиск')} aria-controls="search-panel" aria-expanded="false">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="9" cy="9" r="5.5" /><path d="m13.2 13.2 3.3 3.3" /></svg>
          </button>
          <div class="language">
            <button class="icon-btn" id="language-button" type="button" aria-label={t('Выбрать язык')} aria-controls="language-menu" aria-expanded="false">
              <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M3 10h14M10 3c-3 3.5-3 10.5 0 14m0-14c3 3.5 3 10.5 0 14" /></svg>
            </button>
            <div class="langs" id="language-menu" aria-label={t('Язык')} hidden>
              {LANGS.map((l) => <a href={alt(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}
            </div>
          </div>
          <button class="icon-btn" id="theme" type="button" aria-label={t('Сменить тему')} title={t('Сменить тему')}>
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M15.5 12.5A6.5 6.5 0 0 1 7.5 4.5a6.5 6.5 0 1 0 8 8Z" /><path d="M15 3v3m-1.5-1.5h3M17 8v2m-1-1h2" /></svg>
          </button>
          <a class="icon-btn tg" href={social.telegram} target="_blank" rel="noopener" aria-label={t('Telegram-канал проекта')} title={t('Telegram-канал проекта')}>
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M17.5 3.5 2.8 9.2c-.6.2-.6 1 0 1.2l3.6 1.2 1.4 4.3c.2.5.8.6 1.1.2l2-2.2 3.7 2.7c.4.3 1 .1 1.1-.4l2.5-11.8c.1-.6-.5-1.1-1-.9ZM6.4 11.6l8.3-5.3-6.4 6.3" /></svg>
          </a>
          {social.discord && (
            <a class="icon-btn dc" href={social.discord} target="_blank" rel="noopener" aria-label={t('Discord-сервер проекта')} title={t('Discord-сервер проекта')}>
              <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M6.1 5.3a13 13 0 0 1 7.8 0l.5 1.2c1.1.3 2 .8 2.7 1.3.6 2.1.6 4.2 0 6.3-.9.7-1.9 1.2-3 1.6l-.7-1.1m-6.8 0-.7 1.1c-1.1-.4-2.1-.9-3-1.6-.6-2.1-.6-4.2 0-6.3.7-.5 1.6-1 2.7-1.3Zm.5 7.7c2.4 1.2 5.4 1.2 7.8 0M7.1 10.8h.1m5.6 0h.1" /></svg>
            </a>
          )}
        </div>
        <div class="search-panel" id="search-panel" hidden><QuickSearch /></div>
      </header>
      <main id="content" class:list={['content', { wide }]}><slot /></main>
      <footer class="footer">
        <div class="f-grid">
          {footerCols.map(([title, links]) => (
            <nav class="f-col" aria-label={t(title)}>
              <h2>{t(title)}</h2>
              <ul>{links.map(([label, href]) => (
                <li><a href={href.startsWith('http') ? href : `${base}${href}`} {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{t(label)}</a></li>
              ))}</ul>
            </nav>
          ))}
        </div>
        <div class="f-bottom">
          <div class="f-brand">
            <a class="f-logo" href={`${base}/`}>
              <svg viewBox="0 0 32 32" width="34" height="34" aria-hidden="true"><path d="M16 2 29 9.5v13L16 30 3 22.5v-13Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8.5 22.5 12v8L16 23.5 9.5 20v-8Z" fill="currentColor"/></svg>
              <span>Genshin<b>Flex</b></span>
            </a>
            <p>{t('Билды, команды и многое другое!')}</p>
          </div>
          <div class="f-meta">
            <p>{t('Данные')} — <a href="https://github.com/theBowja/genshin-db" rel="noopener">genshin-db</a>, {t('изображения')} — enka.network, {t('история баннеров')} — paimon.moe.
              {t('Genshin Impact, персонажи и арты © HoYoverse. GenshinFlex — фанатский проект и не связан с HoYoverse.')}</p>
            <p>© {new Date().getFullYear()} GenshinFlex · {t('обновлено')} {new Date().toLocaleDateString(OG_LOCALE[lang].replace('_', '-'))}</p>
            <a class="btn dark f-cta" href={`${base}/feedback/?from=${encodeURIComponent(path === '/' ? '/' : path + '/')}`}>{t('Сообщить об ошибке')}</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      import '../scripts/common';
      const root = document.documentElement;
      document.getElementById('theme')?.addEventListener('click', () => {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('gf:theme', root.dataset.theme); } catch {}
      });
      const side = document.getElementById('side')!, scrim = document.getElementById('scrim')!, burger = document.getElementById('burger')!;
      const shell = document.querySelector<HTMLElement>('.shell')!;
      const searchPanel = document.getElementById('search-panel')!;
      const searchButtons = [document.getElementById('search-pill')!, document.getElementById('search-icon')!];
      const languageButton = document.getElementById('language-button')!;
      const languageMenu = document.getElementById('language-menu')!;
      const openMenuLabel = burger.getAttribute('aria-label')!;
      const closeMenuLabel = burger.dataset.closeLabel!;
      let searchTrigger = searchButtons[0];
      const closeSearch = (restore = false) => {
        if (searchPanel.hidden) return;
        searchPanel.hidden = true;
        searchButtons.forEach((button) => button.setAttribute('aria-expanded', 'false'));
        if (restore) searchTrigger.focus({ preventScroll: true });
      };
      const closeLanguage = (restore = false) => {
        if (languageMenu.hidden) return;
        languageMenu.hidden = true;
        languageButton.setAttribute('aria-expanded', 'false');
        if (restore) languageButton.focus({ preventScroll: true });
      };
      const toggle = (open: boolean, restore = false) => {
        if (open) { closeSearch(); closeLanguage(); }
        if (!open) shell.inert = false;
        side.classList.toggle('open', open);
        side.inert = !open;
        side.setAttribute('aria-hidden', String(!open));
        scrim.hidden = !open;
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? closeMenuLabel : openMenuLabel);
        if (open) {
          shell.inert = true;
          side.querySelector<HTMLElement>('.side-close')?.focus({ preventScroll: true });
        }
        else if (restore) burger.focus({ preventScroll: true });
      };
      burger.addEventListener('click', () => toggle(!side.classList.contains('open')));
      side.querySelector('.side-close')?.addEventListener('click', () => toggle(false, true));
      scrim.addEventListener('click', () => toggle(false, true));
      searchButtons.forEach((button) => button.addEventListener('click', () => {
        const open = searchPanel.hidden;
        closeLanguage();
        if (open) {
          searchTrigger = button;
          searchPanel.hidden = false;
          searchButtons.forEach((item) => item.setAttribute('aria-expanded', 'true'));
          searchPanel.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
        } else closeSearch(true);
      }));
      languageButton.addEventListener('click', () => {
        const open = languageMenu.hidden;
        closeSearch();
        languageMenu.hidden = !open;
        languageButton.setAttribute('aria-expanded', String(open));
        if (open) languageMenu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      });
      document.addEventListener('pointerdown', (e) => {
        const target = e.target as Node;
        if (!searchPanel.contains(target) && !searchButtons.some((button) => button.contains(target))) closeSearch();
        if (!languageMenu.contains(target) && !languageButton.contains(target)) closeLanguage();
      });
      document.addEventListener('keydown', (e) => {
        if (!side.classList.contains('open')) return;
        if (e.key === '/') { e.preventDefault(); e.stopPropagation(); }
        if (e.key !== 'Tab') return;
        const items = [...side.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
        const first = items[0], last = items.at(-1);
        if (e.shiftKey && (document.activeElement === first || !side.contains(document.activeElement))) {
          e.preventDefault();
          last?.focus({ preventScroll: true });
        } else if (!e.shiftKey && (document.activeElement === last || !side.contains(document.activeElement))) {
          e.preventDefault();
          first?.focus({ preventScroll: true });
        }
      }, true);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (side.classList.contains('open')) toggle(false, true);
          else if (!searchPanel.hidden) closeSearch(true);
          else closeLanguage(true);
        }
      });
    </script>
  </body>
</html>

<style>
  .side {
    position: fixed; inset: 0 auto 0 0; width: var(--side-w); background: var(--bg-deep); border-right: 1px solid var(--border);
    display: flex; flex-direction: column; z-index: 60; overflow-y: auto; transform: translateX(-100%); transition: transform .5s var(--ease);
  }
  .side.open { transform: none; }
  .side-head { display: flex; align-items: center; flex: none; }
  .logo { display: flex; align-items: center; gap: .6rem; height: var(--top-h); padding: 0 0 0 1.1rem; text-decoration: none; color: var(--accent-text); min-width: 0; flex: 1; }
  .logo svg { flex: none; }
  .side-close { margin: 0 .6rem; font-size: 1.6rem; }
  .logo span { font: 600 1.05rem var(--font-display); color: var(--text); }
  .logo b { color: var(--accent); font-weight: 600; }
  nav { padding: .4rem .6rem 1rem; flex: 1; }
  .gtitle { margin: 1rem .6rem .3rem; font-size: .76rem; color: var(--muted); }
  nav a {
    display: flex; align-items: center; gap: .65rem; padding: .45rem .6rem; border-radius: var(--radius-sm);
    text-decoration: none; color: var(--muted); font-size: .93rem;
  }
  /* Иконки меню — залитые силуэты (src/lib/nav-icons.ts); --icon-cut — цвет «прорезей» под фон панели */
  nav svg { fill: currentColor; flex: none; --icon-cut: var(--bg-deep); }
  nav a:hover { color: var(--text); background: var(--surface); }
  nav a[aria-current] { color: var(--text); background: var(--surface-2); box-shadow: inset 3px 0 0 var(--accent); }
  nav a[aria-current] svg { color: var(--accent); }
  nav a { transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), opacity var(--dur) var(--ease); }
  .group.soon a:not([aria-current]) { opacity: .7; }
  .soon-tag { margin-left: auto; padding: .05rem .4rem; border: 1px solid var(--border); border-radius: 999px; font-size: .68rem; color: var(--muted); }
  /* Кнопка карты: рамка как у окон в игре — двойная золотая линия и ромбы по углам */
  .map-card {
    position: relative; display: flex; align-items: center; gap: .6rem; margin: 0 .8rem 1rem; padding: .7rem .7rem;
    text-decoration: none; border-radius: 4px; isolation: isolate; padding-right: 1.6rem;
    background: radial-gradient(120% 140% at 0% 0%, #2c4a5a 0%, #1d2a44 55%, #171b2e 100%);
    border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent);
    box-shadow: inset 0 0 0 3px #171b2e, inset 0 0 0 4px color-mix(in srgb, var(--accent) 35%, transparent);
    color: #efe6cf;
  }
  .map-card::before, .map-card::after {
    content: ""; position: absolute; width: 7px; height: 7px; background: var(--accent); rotate: 45deg; z-index: 1;
  }
  .map-card::before { top: -4px; left: -4px; }
  .map-card::after { bottom: -4px; right: -4px; }
  .contours { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; border-radius: 4px; fill: none; stroke: #e3b04b; stroke-width: .8; opacity: .22; }
  .compass { flex: none; transition: rotate .5s cubic-bezier(.3, 1.4, .5, 1); }
  .compass .ring { fill: none; stroke: #e3b04b; stroke-width: 1.2; opacity: .8; }
  .compass .ring.thin { stroke-width: .6; stroke-dasharray: 1.5 2.5; }
  .compass .star { fill: #e3b04b; }
  .compass .star-in { fill: #fff3d0; opacity: .85; }
