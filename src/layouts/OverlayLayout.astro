---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { useData } from '../lib/data';
const { lang, base, t } = useData(Astro.currentLocale);
interface Props { title: string; active?: 'search' | 'guide' | 'banners' | 'map'; guideHref?: string; }
const { title, active, guideHref } = Astro.props;
---
<!doctype html>
<!-- Панель всегда тёмная: при светлой теме системы карточки становились белыми на тёмном фоне -->
<!-- transition:animate="none": плавная смена страниц в прозрачном окне показывала игру сквозь панель -->
<html lang={lang} class="ov-root" data-theme="dark" transition:animate="none">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="gf-build" content={__GF_BUILD__} />
    <title>{title} — GenshinFlex</title>
    <script is:inline data-astro-rerun>if (window.__GF_OVERLAY_APP__) document.documentElement.classList.add('ov-app');</script>
  </head>
  <body class="ov-body">
    <div class="ov-backdrop" aria-hidden="true"></div>
    <header class="ov-account" data-ov-account>
      <button type="button" class="ov-drag" data-ov-drag aria-label={t('Переместить панель')} title={t('Переместить панель')}>⠿</button>
      <a data-ov-guest href={`${base}/overlay/login/`}>{t('Войти')}</a>
      <a data-ov-profile href={`${base}/profile/`} target="_blank" rel="noopener" hidden>
        <img data-ov-avatar alt="" width="24" height="24" hidden /><span data-ov-name></span> · {t('Профиль')}
      </a>
      <button type="button" class="ov-settings-toggle" data-ov-settings-toggle aria-label={t('Настройки')} title={t('Настройки')} aria-controls="ov-settings" aria-expanded="false">⚙</button>
    </header>
    <section id="ov-settings" class="ov-settings" data-ov-settings hidden>
      <h2>{t('Настройки')}</h2>
      <label class="ov-settings-row">
        <input type="checkbox" data-ov-launch disabled />
        <span>{t('Запускать при входе в игру')}<small>{t('Оверлей ждёт в трее с запуска Windows и открывает панель, когда стартует игра')}</small></span>
      </label>
      <label class="ov-settings-row">
        <input type="checkbox" data-ov-screen disabled />
        <span>{t('Распознавание экрана')}<small>{t('Сам открывает гайд персонажа, которого видно на экране')}</small></span>
      </label>
    </section>
    <main class="ov-main"><slot /></main>
    <!-- Без transition:persist: правка перенесённого элемента во время смены страницы роняет рендер WebView2
         (STATUS_ACCESS_VIOLATION); полоска и тост сами перерисовываются после astro:after-swap -->
    <div class="ov-update" role="status" hidden>
      <span data-update-message></span>
      <button type="button" data-update-install>{t('Обновить')}</button>
      <button type="button" class="ov-update-dismiss" data-update-dismiss aria-label={t('Скрыть до перезапуска')} title={t('Скрыть до перезапуска')}>×</button>
    </div>
    <nav class="ov-tabs" aria-label={t('Навигация')} style="grid-template-columns: repeat(4, 1fr)">
      <a class="ov-tab" href={`${base}/overlay/`} aria-current={active === 'search' ? 'page' : undefined}>{t('Поиск')}</a>
      <a class="ov-tab" data-guide-tab href={guideHref} aria-disabled={!guideHref ? 'true' : undefined} aria-current={active === 'guide' ? 'page' : undefined}>{t('Гайд')}</a>
      <a class="ov-tab" href={`${base}/overlay/banners/`} aria-current={active === 'banners' ? 'page' : undefined}>{t('Баннеры')}</a>
      <a class="ov-tab" href={`${base}/overlay/map/`} aria-current={active === 'map' ? 'page' : undefined}>{t('Карта')}</a>
    </nav>
    <div class="ov-toast" role="status" hidden></div>
    <script>
      import { onPage } from '../scripts/router';
      onPage(() => {
        const tab = document.querySelector<HTMLAnchorElement>('[data-guide-tab]');
        if (!tab || tab.hasAttribute('href')) return;
        try {
          const path = localStorage.getItem('gf:overlay-guide');
          const base = document.documentElement.lang === 'ru' ? '' : `/${document.documentElement.lang}`;
          if (path?.startsWith(`${base}/overlay/c/`) && /^\/(?:en\/|es\/)?overlay\/c\/[a-z0-9-]+\/$/.test(path)) { tab.href = path; tab.removeAttribute('aria-disabled'); }
        } catch {}
      });
    </script>
    <script>
      if (window.__GF_OVERLAY_APP__) {
        document.addEventListener('pointerdown', (event) => {
          if (event.button !== 0 || !(event.target instanceof Element) || !event.target.closest('[data-ov-drag]')) return;
          event.preventDefault();
          location.href = 'gf-overlay://drag';
        });
      }
    </script>
    <script>
      import { currentUser } from '../scripts/auth';
      import { onPage } from '../scripts/router';
      import { onSessionChange } from '../scripts/user-data/session';

      declare global { interface Window { __GF_OVERLAY_APP__?: string } }

      onPage((signal) => {
        if (/\/overlay\/auth\/?$/.test(location.pathname)) return;
        const root = document.querySelector<HTMLElement>('[data-ov-account]');
        if (!root) return;
        const guest = root.querySelector<HTMLAnchorElement>('[data-ov-guest]')!;
        const profile = root.querySelector<HTMLAnchorElement>('[data-ov-profile]')!;
        const avatar = root.querySelector<HTMLImageElement>('[data-ov-avatar]')!;
        const name = root.querySelector<HTMLElement>('[data-ov-name]')!;
        const refresh = async () => {
          const user = await currentUser().catch(() => null);
          if (signal.aborted) return;
          guest.hidden = !!user;
          profile.hidden = !user;
          if (!user) return;
          name.textContent = user.user_metadata?.user_name || user.user_metadata?.full_name || user.email || '';
          const image = user.user_metadata?.avatar_url;
          avatar.hidden = !image;
          if (image) avatar.src = image;
        };
        void refresh();
        onSessionChange(() => void refresh(), { signal });
      });
    </script>
    <script>
      if (window.__GF_OVERLAY_APP__) {
        type OverlaySettings = { launchWithGame: boolean; screenDetection: boolean };
        let settings: OverlaySettings | undefined;
        let pending: keyof OverlaySettings | undefined;
        let expanded = false;
        const render = () => {
          const panel = document.querySelector<HTMLElement>('[data-ov-settings]');
          const toggle = document.querySelector<HTMLButtonElement>('[data-ov-settings-toggle]');
          if (!panel || !toggle) return;
          panel.hidden = !expanded;
          toggle.setAttribute('aria-expanded', String(expanded));
          const launch = panel.querySelector<HTMLInputElement>('[data-ov-launch]')!;
          const screen = panel.querySelector<HTMLInputElement>('[data-ov-screen]')!;
          launch.checked = settings?.launchWithGame ?? false;
          screen.checked = settings?.screenDetection ?? false;
          launch.disabled = !settings || !!pending;
          screen.disabled = !settings || !!pending;
        };
        window.addEventListener('gf:settings', (event) => {
          const detail = (event as CustomEvent<unknown>).detail;
          if (!detail || typeof detail !== 'object' || !('launchWithGame' in detail) || !('screenDetection' in detail)
            || typeof detail.launchWithGame !== 'boolean' || typeof detail.screenDetection !== 'boolean') return;
          settings = detail as OverlaySettings;
          pending = undefined;
          render();
        });
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-ov-settings-toggle]')) return;
          expanded = !expanded;
          render();
        });
        document.addEventListener('change', (event) => {
          const input = event.target;
          if (!(input instanceof HTMLInputElement) || !settings || pending) return;
          const checked = input.checked;
          if (input.matches('[data-ov-launch]')) {
            pending = 'launchWithGame';
            render();
            location.href = `gf-overlay://settings?launch_with_game=${checked ? 1 : 0}`;
          } else if (input.matches('[data-ov-screen]')) {
            pending = 'screenDetection';
            render();
            location.href = `gf-overlay://settings?screen_detection=${checked ? 1 : 0}`;
          }
        });
        document.addEventListener('astro:after-swap', render);
      }
    </script>
    <script>
      import { t } from '../scripts/search';

      if (window.__GF_OVERLAY_APP__) {
        type Update = { state: 'available' | 'installing' | 'error'; version: string };
        let update: Update | undefined;
        let requested = false;
        let observed: HTMLElement | undefined;
        const observer = new ResizeObserver(() => syncToast());
        const syncToast = () => {
          const banner = document.querySelector<HTMLElement>('.ov-update');
          document.body.style.setProperty('--ov-update-height', banner && !banner.hidden ? `${banner.offsetHeight + 8}px` : '0px');
        };
        const render = () => {
          const banner = document.querySelector<HTMLElement>('.ov-update');
          if (!banner) return;
          if (observed !== banner) {
            if (observed) observer.unobserve(observed);
            observer.observe(banner);
            observed = banner;
          }
          const message = banner.querySelector<HTMLElement>('[data-update-message]')!;
          const install = banner.querySelector<HTMLButtonElement>('[data-update-install]')!;
          const dismiss = banner.querySelector<HTMLButtonElement>('[data-update-dismiss]')!;
          let dismissed = false;
          try { dismissed = !!update && sessionStorage.getItem('gf:update-dismissed') === update.version; } catch {}
          banner.hidden = !update || update.state === 'available' && dismissed;
          if (!update) { syncToast(); return; }
          message.textContent = update.state === 'available'
            ? t('Доступна версия {version}', { version: update.version })
            : update.state === 'installing'
              ? t('Загрузка обновления… приложение перезапустится')
              : t('Не удалось обновить');
          install.hidden = update.state === 'installing';
          install.disabled = requested;
          install.textContent = requested ? t('Загрузка…') : update.state === 'error' ? t('Повторить') : t('Обновить');
          dismiss.hidden = update.state !== 'available';
          syncToast();
        };
        window.addEventListener('gf:update', (event) => {
          const detail = (event as CustomEvent<unknown>).detail;
          // Обновление пропало (или установка не началась) — убираем полоску и снимаем «Загрузка…»
          if (detail && typeof detail === 'object' && 'state' in detail && detail.state === 'none') {
            update = undefined;
            requested = false;
            render();
            return;
          }
          if (!detail || typeof detail !== 'object' || !('state' in detail) || !('version' in detail)
            || !['available', 'installing', 'error'].includes(String(detail.state)) || typeof detail.version !== 'string') return;
          if (update?.version !== detail.version || detail.state === 'error') requested = false;
          update = detail as Update;
          render();
        });
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('[data-update-install]') && update && update.state !== 'installing' && !requested) {
            requested = true;
            render();
            location.href = 'gf-overlay://update';
          } else if (target.closest('[data-update-dismiss]') && update) {
            try { sessionStorage.setItem('gf:update-dismissed', update.version); } catch {}
            render();
          }
        });
        document.addEventListener('astro:after-swap', render);
      }
    </script>
    <script>
      import { store } from '../scripts/common';
      import { t } from '../scripts/search';
      import { openWishStore } from '../scripts/wish-store';
      import { importFromLink, WishImportError } from '../scripts/wish-import';

      if (window.__GF_OVERLAY_APP__) {
        const key = 'gf:overlay-wish-links';
        let pending: { link: string; hash: string } | undefined;
        let current: string | undefined;
        let running = false;
        let incoming: Promise<void> = Promise.resolve();
        let timer: ReturnType<typeof setTimeout> | undefined;
        const hashes = (): string[] => {
          try {
            const saved: unknown = JSON.parse(sessionStorage.getItem(key) ?? '[]');
            return Array.isArray(saved) ? saved.filter((value): value is string => typeof value === 'string').slice(-10) : [];
          } catch { return []; }
        };
        const remember = (hash: string) => {
          try { sessionStorage.setItem(key, JSON.stringify([...hashes().filter((value) => value !== hash), hash].slice(-10))); } catch {}
        };
        const digest = async (link: string) => {
          const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(link));
          return [...new Uint8Array(bytes)].map((byte) => byte.toString(16).padStart(2, '0')).join('');
        };
        // Тост не переносится между страницами: после смены страницы показываем текущее сообщение заново
        let shown: string | undefined;
        const paint = () => {
          const el = document.querySelector<HTMLElement>('.ov-toast');
          if (!el) return;
          el.textContent = shown ?? '';
          el.hidden = shown === undefined;
        };
        const toast = (message: string, hide = false) => {
          clearTimeout(timer);
          shown = message;
          paint();
          if (hide) timer = setTimeout(() => { shown = undefined; paint(); }, 4000);
        };
        document.addEventListener('astro:after-swap', paint);
        const drain = async () => {
          running = true;
          while (pending !== undefined) {
            const { link, hash } = pending;
            pending = undefined;
            current = hash;
            try {
              if (hashes().includes(hash)) continue;
              toast(t('Обновляю историю молитв…'));
              const signal = new AbortController().signal;
              const wishStore = await openWishStore(signal);
              const { uid, added } = await importFromLink(link, wishStore, { signal });
              store.set('gf:wish-uid', uid);
              window.dispatchEvent(new CustomEvent('gf:wishes-changed'));
              remember(hash);
              toast(added ? t('Добавлено {n} новых молитв', { n: added }) : t('Новых молитв нет'), true);
            } catch (error) {
              toast(error instanceof WishImportError && error.code === 'expired'
                ? t('Ссылка из игры устарела — откройте историю молитв ещё раз')
                : t('Не удалось обновить историю молитв'), true);
            } finally {
              current = undefined;
            }
          }
          running = false;
        };
        window.addEventListener('gf:wish-link', (event) => {
          const link = (event as CustomEvent<unknown>).detail;
          if (typeof link !== 'string') return;
          const active = current;
          incoming = incoming.then(async () => {
            const hash = await digest(link);
            if (hashes().includes(hash) || active === hash || current === hash || pending?.hash === hash) return;
            pending = { link, hash };
            if (!running) void drain();
          }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
<style is:global>
  html.ov-root { --bg: rgb(11 14 24 / .9); --bg-deep: rgb(8 11 20 / .92); --surface: rgb(25 30 44 / .82); --surface-2: rgb(39 45 61 / .85); --surface-3: rgb(55 61 78 / .85); --text: #f6f3ec; --muted: #bcc2ce; --border: rgb(255 255 255 / .18); color-scheme: dark; background: transparent; }
  html.ov-root[data-theme] { --bg: rgb(11 14 24 / .9); --bg-deep: rgb(8 11 20 / .92); --surface: rgb(25 30 44 / .82); --surface-2: rgb(39 45 61 / .85); --surface-3: rgb(55 61 78 / .85); --text: #f6f3ec; --muted: #bcc2ce; --border: rgb(255 255 255 / .18); }
  .ov-body { min-width: 0; min-height: 100dvh; margin: 0; background: transparent; color: var(--text); isolation: isolate; overflow-x: hidden; }
  .ov-backdrop { position: fixed; z-index: -1; inset: 0; background: rgb(9 12 22 / .84); backdrop-filter: blur(18px); pointer-events: none; }
  .ov-main { width: min(100%, 480px); min-width: 0; margin: auto; padding: 16px 14px calc(86px + env(safe-area-inset-bottom) + var(--ov-update-height, 0px)); box-sizing: border-box; }
  .ov-main h1 { font-size: 1.5rem; margin: 0 0 .8rem; }
  .ov-main h2 { font-size: 1.05rem; margin: 1.2rem 0 .6rem; }
  .ov-main h3 { font-size: .95rem; margin: 0 0 .5rem; }
  .ov-main :where(p, li, dd, b, span) { overflow-wrap: anywhere; }
  .ov-panel { min-width: 0; padding: .85rem; margin-bottom: 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .ov-row { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; min-width: 0; }
  .ov-link { color: var(--accent-text); }
  .ov-icons { display: grid; grid-template-columns: repeat(auto-fill, minmax(58px, 1fr)); gap: 6px; }
  .ov-icons a { display: grid; justify-items: center; align-content: start; gap: 3px; min-height: 72px; padding: 5px 2px; text-align: center; text-decoration: none; border-radius: 9px; font-size: .67rem; line-height: 1.15; }
  .ov-icons a:hover, .ov-icons a:focus-visible { background: var(--surface-2); }
  .ov-icons img { width: 48px; height: 48px; border-radius: 9px; object-fit: cover; background: var(--surface-3); }
  .ov-tabs { position: fixed; z-index: 20; inset: auto 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 8px max(10px, calc((100vw - 480px) / 2)) calc(8px + env(safe-area-inset-bottom)); border-top: 1px solid var(--border); background: rgb(10 13 23 / .93); backdrop-filter: blur(18px); }
  .ov-update { position: fixed; z-index: 21; inset: auto 14px calc(78px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 8px; box-sizing: border-box; max-width: 452px; margin: auto; padding: .55rem .65rem; border: 1px solid var(--accent); border-radius: 10px; background: rgb(24 29 43); /* непрозрачный: сквозь --surface-2 читался список */ box-shadow: 0 8px 24px rgb(0 0 0 / .3); font-size: .8rem; }
  .ov-update[hidden], .ov-update [hidden] { display: none; }
  .ov-update [data-update-message] { flex: 1; min-width: 0; }
  .ov-update button { flex: none; padding: .35rem .55rem; border: 0; border-radius: 7px; background: var(--accent-soft); color: var(--accent-text); font: inherit; font-weight: 600; cursor: pointer; }
  .ov-update button:disabled { opacity: .6; cursor: default; }
  .ov-update .ov-update-dismiss { padding: .2rem .4rem; background: transparent; color: var(--muted); font-size: 1.2rem; }
  .ov-toast { position: fixed; z-index: 22; inset: auto 14px calc(78px + env(safe-area-inset-bottom) + var(--ov-update-height, 0px)); margin: auto; width: fit-content; max-width: min(400px, calc(100% - 28px)); padding: .55rem .8rem; border: 1px solid var(--border); border-radius: 10px; background: rgb(24 29 43); box-shadow: 0 8px 24px rgb(0 0 0 / .3); text-align: center; font-size: .85rem; pointer-events: none; }
  .ov-toast[hidden] { display: none; }
  .ov-tab { display: grid; place-items: center; min-height: 48px; border-radius: 9px; color: var(--muted); text-decoration: none; font-weight: 600; }
  .ov-tab[aria-current] { background: var(--accent-soft); color: var(--accent-text); }
  .ov-tab[aria-disabled] { opacity: .45; pointer-events: none; }
  .ov-main :where(input, select, button) { font: inherit; }
  .ov-main :where(a, button, summary) { touch-action: manipulation; }
  .ov-main [hidden] { display: none !important; }
  .ov-account { position: relative; z-index: 21; display: flex; justify-content: flex-end; align-items: center; min-height: 36px; padding: 6px 14px 0; font-size: .8rem; }
  .ov-drag { display: none; margin-right: auto; width: 28px; height: 28px; padding: 0; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 1.3rem; cursor: grab; touch-action: none; }
  .ov-app .ov-drag { display: grid; place-items: center; }
  .ov-account a { display: inline-flex; align-items: center; gap: 4px; color: var(--accent-text); }
  .ov-account img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; }
  .ov-account [hidden] { display: none !important; }
  .ov-settings-toggle { display: none; width: 30px; height: 30px; margin-left: 10px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--muted); font: inherit; font-size: 1.25rem; cursor: pointer; }
  .ov-app .ov-settings-toggle { display: grid; place-items: center; }
  .ov-settings-toggle:hover, .ov-settings-toggle[aria-expanded="true"] { background: var(--surface-2); color: var(--accent); }
  .ov-settings { position: relative; z-index: 21; margin: 4px 14px 0; padding: .75rem; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
  .ov-settings[hidden], html:not(.ov-app) .ov-settings { display: none; }
  .ov-settings h2 { margin: 0 0 .6rem; font-size: .9rem; }
  .ov-settings-row { display: flex; align-items: flex-start; gap: .6rem; padding: .35rem 0; font-size: .82rem; cursor: pointer; }
  .ov-settings-row input { flex: none; margin: .15rem 0 0; accent-color: var(--accent); }
  .ov-settings-row input:disabled { cursor: default; }
  .ov-settings-row small { display: block; margin-top: .15rem; color: var(--muted); font-size: .72rem; line-height: 1.35; }
  html.ov-root.ov-app, html.ov-root.ov-app .ov-body { background: transparent; }
  /* В прозрачном окне приложения backdrop-filter не размывает рабочий стол — фон почти непрозрачный, иначе текст под окном мешает читать */
  .ov-app .ov-backdrop { inset: 6px; border: 1px solid var(--border); border-radius: 16px; background: rgb(9 12 22); }
  .ov-app .ov-tabs { inset: auto 6px 6px; border: 1px solid var(--border); border-radius: 0 0 14px 14px; background: rgb(10 13 23); }
  /* В приложении прокручивается сама панель: содержимое обрезается по её скруглённым краям
     и не вылезает в прозрачные поля окна под нижним меню */
  html.ov-root.ov-app { overflow: hidden; }
  .ov-app .ov-body { position: fixed; inset: 6px; min-height: 0; height: auto; overflow-y: auto; border-radius: 16px; scrollbar-width: thin; }
</style>
