{
  "name": "genshinflex",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "import": "node scripts/import-data.mjs && node scripts/import-banners.mjs",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "dev:full": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name genshinflex"
  },
  "dependencies": {
    "astro": "^7.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "genshin-db": "^5.2.14",
    "pagefind": "^1.5.2",
    "wrangler": "^4.137.0"
  }
}
